@model Graduation_Project.ViewModels.AdminClinicsViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Clinic Management";
    ViewData["ActivePage"] = "Clinics";
    ViewData["PageTitle"] = "Clinic Management";
    ViewData["PageSubtitle"] = "Create, edit and delete clinics";
}

<div style="display:flex;justify-content:flex-end;margin-bottom:16px;">
  <a href="/Admin/AddClinic"
     style="display:inline-flex;align-items:center;gap:6px;padding:9px 18px;background:var(--admin-primary);color:white;border-radius:8px;font-size:0.85rem;font-weight:600;text-decoration:none;">
    <i class="fas fa-plus"></i> Add Clinic
  </a>
</div>

<div class="um-stats">
  <div class="um-stat">
    <div class="um-stat-ico purple"><i class="fas fa-hospital"></i></div>
    <div>
      <div class="um-stat-val">@Model.TotalClinics</div>
      <div class="um-stat-lbl">Total Clinics</div>
    </div>
  </div>
  <div class="um-stat">
    <div class="um-stat-ico teal"><i class="fas fa-stethoscope"></i></div>
    <div>
      <div class="um-stat-val">@Model.TotalDoctorsAssigned</div>
      <div class="um-stat-lbl">Doctors Assigned</div>
    </div>
  </div>
  <div class="um-stat">
    <div class="um-stat-ico blue"><i class="fas fa-user-nurse"></i></div>
    <div>
      <div class="um-stat-val">@Model.TotalAssistantsAssigned</div>
      <div class="um-stat-lbl">Assistants Assigned</div>
    </div>
  </div>
  <div class="um-stat">
    <div class="um-stat-ico amber"><i class="fas fa-calendar-check"></i></div>
    <div>
      <div class="um-stat-val">@Model.TotalAppointments</div>
      <div class="um-stat-lbl">Total Appointments</div>
    </div>
  </div>
</div>

<div class="users-table-wrap">
  @if (Model.Clinics.Any())
  {
    <table class="users-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Clinic</th>
          <th>Location</th>
          <th style="text-align:center;">Doctors</th>
          <th style="text-align:center;">Assistants</th>
          <th style="text-align:center;">Appointments</th>
          <th style="text-align:center;">Actions</th>
        </tr>
      </thead>
      <tbody>
        @{ int idx = 1; }
        @foreach (var clinic in Model.Clinics)
        {
          <tr>
            <td style="color:var(--text-muted);font-size:0.82rem;">@idx</td>
            <td>
              <div class="user-name-cell">
                <div class="user-avatar" style="background:rgba(124,58,237,0.12);color:#7c3aed;font-size:1rem;">
                  <i class="fas fa-hospital"></i>
                </div>
                <div>
                  <div class="user-full-name">@clinic.Name</div>
                </div>
              </div>
            </td>
            <td style="color:var(--text-secondary);font-size:0.83rem;">
              <i class="fas fa-map-marker-alt" style="color:#7c3aed;margin-right:4px;"></i>@clinic.Location
            </td>
            <td style="text-align:center;font-weight:600;color:var(--text-primary);">@clinic.DoctorCount</td>
            <td style="text-align:center;font-weight:600;color:var(--text-primary);">@clinic.AssistantCount</td>
            <td style="text-align:center;font-weight:600;color:var(--text-primary);">@clinic.AppointmentCount</td>
            <td>
              <div class="action-btns" style="justify-content:center;">
                <a href="/Admin/EditClinic/@clinic.ClinicID" class="btn-action activate" title="Edit" style="text-decoration:none;">
                  <i class="fas fa-edit"></i>
                </a>
                <button type="button" class="btn-action delete" title="Delete"
                        onclick="confirmDelete(@clinic.ClinicID, '@clinic.Name.Replace("'", "\\'")')">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </td>
          </tr>
          idx++;
        }
      </tbody>
    </table>
  }
  else
  {
    <div class="empty-state">
      <i class="fas fa-hospital"></i>
      No clinics yet. Add your first clinic to get started.
    </div>
  }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal-overlay" id="deleteModal" style="display:none;">
  <div class="modal-box">
    <div class="modal-title" style="color:#ef4444;"><i class="fas fa-exclamation-triangle"></i> Delete Clinic</div>
    <p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:6px;">
      Are you sure you want to delete <strong id="deleteClinicName" style="color:var(--text-primary);"></strong>?
    </p>
    <p style="font-size:0.82rem;color:var(--text-muted);margin-bottom:14px;">This will also remove all clinic-doctor and clinic-assistant associations.</p>
    <form id="deleteForm" method="post">
      @Html.AntiForgeryToken()
      <div class="modal-actions">
        <button type="button" class="btn-modal-cancel" onclick="closeDeleteModal()">Cancel</button>
        <button type="submit" class="btn-modal-confirm" style="background:#dc2626;">
          <i class="fas fa-trash"></i> Delete
        </button>
      </div>
    </form>
  </div>
</div>

@section Scripts {
<script>
  function confirmDelete(id, name) {
    document.getElementById('deleteClinicName').textContent = name;
    document.getElementById('deleteForm').action = '/Admin/DeleteClinic';
    const form = document.getElementById('deleteForm');
    let inp = form.querySelector('input[name="clinicId"]');
    if (!inp) { inp = document.createElement('input'); inp.type = 'hidden'; inp.name = 'clinicId'; form.appendChild(inp); }
    inp.value = id;
    document.getElementById('deleteModal').style.display = 'flex';
  }
  function closeDeleteModal() {
    document.getElementById('deleteModal').style.display = 'none';
  }
  document.getElementById('deleteModal').addEventListener('click', function(e) {
    if (e.target === this) closeDeleteModal();
  });
</script>
}
