@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewData["Title"] = "Product Safety";
    ViewData["ActivePage"] = "Products";
    ViewData["HidePageHeader"] = true;
}

@Html.AntiForgeryToken()

<div class="ps-wrap">

    <!-- ════════ 1. HERO ════════ -->
    <section class="ps-hero">
        <div class="ps-hero-text">
            <span class="ps-hero-badge"><i class="fas fa-shield-heart"></i> Pregnancy Safe</span>
            <h1>Product Safety Check</h1>
            <p>Upload a label or paste the ingredients, and we'll tell you whether a product is
               safe to use during pregnancy — in seconds.</p>
        </div>
        <div class="ps-hero-art">
            <div class="ps-hero-orb"><i class="fas fa-shield-heart"></i></div>
        </div>
    </section>

    <!-- ════════ 2. INPUT ════════ -->
    <section class="ps-input">
        <div class="ps-input-main">
            <div class="ps-section-head">
                <div class="ps-section-ico pink"><i class="fas fa-flask"></i></div>
                <div>
                    <h2>Check a Product</h2>
                    <p>Choose how you'd like to add the product's ingredients.</p>
                </div>
            </div>

            <div class="ps-tabs">
                <button class="ps-tab active" type="button" data-tab="image">
                    <i class="fas fa-camera"></i> Upload Image
                </button>
                <button class="ps-tab" type="button" data-tab="text">
                    <i class="fas fa-keyboard"></i> Paste Ingredients
                </button>
            </div>

            <!-- Image input -->
            <div class="ps-panel active" id="panelImage">
                <div class="ps-upload" id="uploadZone">
                    <div class="ps-upload-ico"><i class="fas fa-cloud-arrow-up"></i></div>
                    <p class="ps-upload-title">Upload a photo of the ingredients label</p>
                    <p class="ps-upload-sub">Tap to browse · JPG, PNG or WebP · max 5 MB</p>
                    <input type="file" id="imageFile" accept="image/jpeg,image/png,image/webp" hidden />
                </div>
                <div class="ps-preview" id="previewWrap" hidden>
                    <img id="previewImg" src="" alt="Selected label" />
                    <button type="button" class="ps-preview-remove" id="removeFile">
                        <i class="fas fa-xmark"></i> Remove
                    </button>
                </div>
            </div>

            <!-- Text input -->
            <div class="ps-panel" id="panelText">
                <textarea id="ingredientsInput" class="ps-textarea" rows="7"
                          placeholder="Paste the product ingredients here, separated by commas or new lines…"></textarea>
            </div>

            <button type="button" class="ps-analyze" id="analyzeBtn">
                <i class="fas fa-magnifying-glass"></i> Analyze Product
            </button>
        </div>

        <!-- Side: what the verdict means -->
        <aside class="ps-input-side">
            <h3>What you'll get</h3>
            <ul class="ps-legend">
                <li class="safe">
                    <span class="ps-legend-ico"><i class="fas fa-circle-check"></i></span>
                    <div><strong>Safe</strong><span>No risky ingredients found</span></div>
                </li>
                <li class="warn">
                    <span class="ps-legend-ico"><i class="fas fa-triangle-exclamation"></i></span>
                    <div><strong>Use With Caution</strong><span>Contains ingredients to limit</span></div>
                </li>
                <li class="danger">
                    <span class="ps-legend-ico"><i class="fas fa-circle-xmark"></i></span>
                    <div><strong>Not Recommended</strong><span>Contains ingredients to avoid</span></div>
                </li>
            </ul>
        </aside>
    </section>

    <!-- ════════ 3. RESULT ════════ -->
    <section class="ps-result-area" id="result" hidden></section>

</div>

@section Styles {
<style>
.ps-wrap {
    --p:        #fb7185;
    --p-dk:     #f43f5e;
    --text:     #3f3550;
    --text-2:   #6b6478;
    --text-3:   #9a93a8;
    --border:   #f0e9ef;
    --bg:       #fffaf7;
    --white:    #fff;
    --safe:     #16a34a;  --safe-bg:  #ecfdf5;  --safe-bd:  #bbf7d0;
    --warn:     #d97706;  --warn-bg:  #fffbeb;  --warn-bd:  #fde68a;
    --danger:   #dc2626;  --danger-bg:#fef2f2;  --danger-bd:#fecaca;
    --r:        18px;
    --shadow:   0 10px 30px rgba(120,80,110,.08);
    --shadow-sm:0 6px 18px rgba(120,80,110,.06);
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 22px;
}

/* ── 1. HERO ── */
.ps-wrap .ps-hero {
    position: relative; overflow: hidden;
    background: linear-gradient(120deg, #ffe1ea 0%, #ffe8dc 45%, #ece4ff 100%);
    border-radius: 26px; padding: 34px 38px;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    box-shadow: var(--shadow);
}
.ps-wrap .ps-hero::after {
    content: ''; position: absolute; right: -40px; bottom: -80px;
    width: 260px; height: 260px; border-radius: 50%;
    background: radial-gradient(circle, rgba(251,113,133,.22), transparent 70%); pointer-events: none;
}
.ps-wrap .ps-hero-text { position: relative; z-index: 1; max-width: 620px; }
.ps-wrap .ps-hero-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: rgba(255,255,255,.75); color: var(--p-dk);
    font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em;
    padding: 6px 14px; border-radius: 30px; box-shadow: 0 2px 8px rgba(120,80,110,.08);
}
.ps-wrap .ps-hero-text h1 { margin: 12px 0 8px; font-size: 2.1rem; font-weight: 800; color: var(--text); letter-spacing: -.5px; }
.ps-wrap .ps-hero-text p  { margin: 0; font-size: 1.02rem; line-height: 1.6; color: var(--text-2); }
.ps-wrap .ps-hero-art { position: relative; z-index: 1; flex-shrink: 0; }
.ps-wrap .ps-hero-orb {
    width: 110px; height: 110px; border-radius: 32px;
    display: flex; align-items: center; justify-content: center; font-size: 2.8rem;
    color: #fff; background: linear-gradient(135deg, var(--p), var(--p-dk));
    box-shadow: 0 14px 30px rgba(244,63,94,.35);
}

/* ── shared section heading ── */
.ps-wrap .ps-section-head { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
.ps-wrap .ps-section-ico {
    width: 42px; height: 42px; border-radius: 12px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 1.05rem;
}
.ps-wrap .ps-section-ico.pink { background: #fff1f3; color: var(--p); }
.ps-wrap .ps-section-head h2 { margin: 0; font-size: 1.15rem; font-weight: 800; color: var(--text); }
.ps-wrap .ps-section-head p  { margin: 1px 0 0; font-size: .85rem; color: var(--text-3); }

/* ── 2. INPUT ── */
.ps-wrap .ps-input { display: grid; grid-template-columns: 1.55fr 1fr; gap: 18px; align-items: start; }
.ps-wrap .ps-input-main {
    background: var(--white); border: 1px solid var(--border); border-radius: var(--r);
    padding: 24px; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 16px;
}

.ps-wrap .ps-tabs {
    display: grid; grid-template-columns: 1fr 1fr; gap: 6px;
    background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 4px;
}
.ps-wrap .ps-tab {
    display: inline-flex; align-items: center; justify-content: center; gap: 7px;
    padding: 10px 12px; border: none; background: transparent; border-radius: 9px;
    font-size: .9rem; font-weight: 600; color: var(--text-3); cursor: pointer; transition: all .18s;
}
.ps-wrap .ps-tab.active { background: var(--white); color: var(--p); box-shadow: 0 2px 8px rgba(120,80,110,.1); }

.ps-wrap .ps-panel { display: none; }
.ps-wrap .ps-panel.active { display: block; }

.ps-wrap .ps-upload {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 6px; text-align: center; cursor: pointer; padding: 46px 20px; min-height: 230px;
    border: 2px dashed #e3d3df; border-radius: 14px; background: var(--bg);
    transition: border-color .2s, background .2s;
}
.ps-wrap .ps-upload:hover, .ps-wrap .ps-upload.drag-over { border-color: var(--p); background: #fff7fb; }
.ps-wrap .ps-upload-ico {
    width: 64px; height: 64px; border-radius: 16px; margin-bottom: 6px;
    display: flex; align-items: center; justify-content: center; font-size: 1.7rem;
    color: var(--p); background: #fff1f3;
}
.ps-wrap .ps-upload-title { margin: 0; font-size: 1rem; font-weight: 700; color: var(--text); }
.ps-wrap .ps-upload-sub   { margin: 0; font-size: .82rem; color: var(--text-3); }

.ps-wrap .ps-preview { position: relative; border-radius: 14px; overflow: hidden; border: 1px solid var(--border); }
.ps-wrap .ps-preview img { width: 100%; max-height: 360px; object-fit: contain; display: block; background: var(--bg); }
.ps-wrap .ps-preview-remove {
    position: absolute; top: 10px; right: 10px;
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(220,38,38,.92); color: #fff; border: none; border-radius: 9px;
    padding: 6px 11px; font-size: .8rem; font-weight: 600; cursor: pointer;
}
.ps-wrap .ps-preview-remove:hover { background: #b91c1c; }

.ps-wrap .ps-textarea {
    width: 100%; box-sizing: border-box; resize: vertical; min-height: 200px;
    border: 1.5px solid var(--border); border-radius: 12px; padding: 14px 16px;
    font-family: inherit; font-size: .95rem; line-height: 1.55; color: var(--text); background: var(--bg);
    outline: none; transition: border-color .2s, box-shadow .2s;
}
.ps-wrap .ps-textarea:focus { border-color: var(--p); background: var(--white); box-shadow: 0 0 0 3px rgba(251,113,133,.12); }

.ps-wrap .ps-analyze {
    display: inline-flex; align-items: center; justify-content: center; gap: 9px;
    width: 100%; border: none; border-radius: 13px; padding: 15px;
    font-size: 1rem; font-weight: 700; color: #fff; cursor: pointer;
    background: linear-gradient(135deg, var(--p), var(--p-dk));
    box-shadow: 0 6px 18px rgba(251,113,133,.38); transition: transform .15s, box-shadow .15s;
}
.ps-wrap .ps-analyze:hover { transform: translateY(-1px); box-shadow: 0 9px 22px rgba(251,113,133,.48); }
.ps-wrap .ps-analyze:disabled { opacity: .65; cursor: not-allowed; transform: none; }

/* side legend */
.ps-wrap .ps-input-side {
    background: var(--white); border: 1px solid var(--border); border-radius: var(--r);
    padding: 22px; box-shadow: var(--shadow-sm);
}
.ps-wrap .ps-input-side h3 {
    margin: 0 0 16px; font-size: .78rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .06em; color: var(--text-3);
}
.ps-wrap .ps-legend { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
.ps-wrap .ps-legend li {
    display: flex; align-items: center; gap: 13px;
    padding: 14px; border-radius: 14px; border: 1px solid var(--border);
}
.ps-wrap .ps-legend li.safe   { background: var(--safe-bg);   border-color: var(--safe-bd); }
.ps-wrap .ps-legend li.warn   { background: var(--warn-bg);   border-color: var(--warn-bd); }
.ps-wrap .ps-legend li.danger { background: var(--danger-bg); border-color: var(--danger-bd); }
.ps-wrap .ps-legend-ico { font-size: 1.4rem; flex-shrink: 0; }
.ps-wrap .ps-legend li.safe   .ps-legend-ico { color: var(--safe); }
.ps-wrap .ps-legend li.warn   .ps-legend-ico { color: var(--warn); }
.ps-wrap .ps-legend li.danger .ps-legend-ico { color: var(--danger); }
.ps-wrap .ps-legend div { display: flex; flex-direction: column; }
.ps-wrap .ps-legend strong { font-size: .92rem; font-weight: 700; color: var(--text); }
.ps-wrap .ps-legend span { font-size: .8rem; color: var(--text-2); }

/* ── 3. RESULT ── */
.ps-wrap .ps-result-area { display: flex; flex-direction: column; gap: 18px; animation: psFade .35s ease; }
@@keyframes psFade { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

/* dominant verdict banner */
.ps-wrap .ps-verdict {
    position: relative; overflow: hidden;
    border-radius: 22px; padding: 38px 34px;
    display: flex; align-items: center; gap: 26px; border: 1.5px solid;
}
.ps-wrap .ps-verdict.safe   { background: linear-gradient(120deg, #ecfdf5, #f0fdf4); border-color: var(--safe-bd); }
.ps-wrap .ps-verdict.warn   { background: linear-gradient(120deg, #fffbeb, #fffdf5); border-color: var(--warn-bd); }
.ps-wrap .ps-verdict.danger { background: linear-gradient(120deg, #fef2f2, #fff5f5); border-color: var(--danger-bd); }
.ps-wrap .ps-verdict-ico {
    width: 96px; height: 96px; border-radius: 28px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 3rem; color: #fff;
}
.ps-wrap .ps-verdict.safe   .ps-verdict-ico { background: linear-gradient(135deg, #22c55e, #16a34a); box-shadow: 0 12px 26px rgba(22,163,74,.32); }
.ps-wrap .ps-verdict.warn   .ps-verdict-ico { background: linear-gradient(135deg, #f59e0b, #d97706); box-shadow: 0 12px 26px rgba(217,119,6,.32); }
.ps-wrap .ps-verdict.danger .ps-verdict-ico { background: linear-gradient(135deg, #ef4444, #dc2626); box-shadow: 0 12px 26px rgba(220,38,38,.32); }
.ps-wrap .ps-verdict-body { flex: 1; min-width: 0; }
.ps-wrap .ps-verdict-kicker { font-size: .74rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--text-3); }
.ps-wrap .ps-verdict-title { margin: 6px 0 12px; font-size: 2.3rem; font-weight: 800; line-height: 1.05; }
.ps-wrap .ps-verdict.safe   .ps-verdict-title { color: var(--safe); }
.ps-wrap .ps-verdict.warn   .ps-verdict-title { color: var(--warn); }
.ps-wrap .ps-verdict.danger .ps-verdict-title { color: var(--danger); }
.ps-wrap .ps-verdict-meta { display: flex; flex-wrap: wrap; gap: 10px; }
.ps-wrap .ps-pill {
    display: inline-flex; align-items: center; gap: 7px;
    background: rgba(255,255,255,.8); border: 1px solid var(--border);
    padding: 8px 16px; border-radius: 30px; font-size: .88rem; font-weight: 700; color: var(--text);
}
.ps-wrap .ps-pill i { color: var(--p-dk); }
.ps-wrap .ps-verdict.safe   .ps-pill i { color: var(--safe); }
.ps-wrap .ps-verdict.warn   .ps-pill i { color: var(--warn); }
.ps-wrap .ps-verdict.danger .ps-pill i { color: var(--danger); }

/* result grid: recommendation + ingredients */
.ps-wrap .ps-result-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 18px; align-items: start; }
.ps-wrap .ps-result-grid.single { grid-template-columns: 1fr; }

.ps-wrap .ps-card {
    background: var(--white); border: 1px solid var(--border); border-radius: var(--r);
    padding: 24px; box-shadow: var(--shadow-sm);
}
.ps-wrap .ps-card-head { display: flex; align-items: center; gap: 11px; margin-bottom: 16px; }
.ps-wrap .ps-card-head .ico {
    width: 38px; height: 38px; border-radius: 11px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: .95rem;
}
.ps-wrap .ps-card-head .ico.rec    { background: #f4f0ff; color: #8b5cf6; }
.ps-wrap .ps-card-head .ico.ing    { background: var(--danger-bg); color: var(--danger); }
.ps-wrap .ps-card-head h3 { margin: 0; font-size: 1rem; font-weight: 700; color: var(--text); }

/* recommendation message */
.ps-wrap .ps-rec p { margin: 0 0 12px; font-size: .95rem; line-height: 1.65; color: var(--text-2); }
.ps-wrap .ps-rec p:last-child { margin-bottom: 0; }

/* ingredient cards */
.ps-wrap .ps-ing-grid { display: flex; flex-direction: column; gap: 10px; }
.ps-wrap .ps-ing {
    display: flex; align-items: center; gap: 11px;
    padding: 12px 14px; border-radius: 12px;
    background: var(--danger-bg); border: 1px solid var(--danger-bd);
}
.ps-wrap .ps-ing-dot {
    width: 30px; height: 30px; border-radius: 9px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: .85rem;
    background: #fff; color: var(--danger);
}
.ps-wrap .ps-ing-name { font-size: .92rem; font-weight: 700; color: #991b1b; text-transform: capitalize; }
.ps-wrap .ps-ing-empty {
    display: flex; align-items: center; gap: 10px; padding: 14px;
    border-radius: 12px; background: var(--safe-bg); border: 1px solid var(--safe-bd);
    font-size: .9rem; font-weight: 600; color: var(--safe);
}

/* disclaimer */
.ps-wrap .ps-disclaimer {
    display: flex; align-items: flex-start; gap: 9px;
    background: var(--white); border: 1px dashed var(--border); border-radius: 14px;
    padding: 14px 18px; font-size: .82rem; color: var(--text-3); line-height: 1.55;
}
.ps-wrap .ps-disclaimer i { margin-top: 2px; color: var(--p); }

/* ── responsive ── */
@@media (max-width: 880px) {
    .ps-wrap .ps-input { grid-template-columns: 1fr; }
    .ps-wrap .ps-result-grid { grid-template-columns: 1fr; }
}
@@media (max-width: 560px) {
    .ps-wrap .ps-hero { flex-direction: column; text-align: center; padding: 26px 22px; }
    .ps-wrap .ps-hero-text h1 { font-size: 1.7rem; }
    .ps-wrap .ps-verdict { flex-direction: column; text-align: center; padding: 28px 22px; }
    .ps-wrap .ps-verdict-title { font-size: 1.9rem; }
    .ps-wrap .ps-verdict-meta { justify-content: center; }
}
</style>
}

@section Scripts {
<script>
(function () {
    'use strict';

    const TOKEN = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    const tabs        = document.querySelectorAll('.ps-tab');
    const panelImage  = document.getElementById('panelImage');
    const panelText   = document.getElementById('panelText');
    const uploadZone  = document.getElementById('uploadZone');
    const imageFile   = document.getElementById('imageFile');
    const previewWrap = document.getElementById('previewWrap');
    const previewImg  = document.getElementById('previewImg');
    const removeFile  = document.getElementById('removeFile');
    const ingredients = document.getElementById('ingredientsInput');
    const analyzeBtn  = document.getElementById('analyzeBtn');
    const result      = document.getElementById('result');

    let activeTab = 'image';

    // ── Tabs ──
    tabs.forEach(tab => tab.addEventListener('click', () => {
        activeTab = tab.dataset.tab;
        tabs.forEach(t => t.classList.toggle('active', t === tab));
        panelImage.classList.toggle('active', activeTab === 'image');
        panelText.classList.toggle('active', activeTab === 'text');
    }));

    // ── Upload handling ──
    uploadZone?.addEventListener('click', () => imageFile.click());
    uploadZone?.addEventListener('dragover', e => { e.preventDefault(); uploadZone.classList.add('drag-over'); });
    uploadZone?.addEventListener('dragleave', () => uploadZone.classList.remove('drag-over'));
    uploadZone?.addEventListener('drop', e => {
        e.preventDefault(); uploadZone.classList.remove('drag-over');
        const file = e.dataTransfer?.files?.[0];
        if (file) applyFile(file);
    });
    imageFile?.addEventListener('change', () => { if (imageFile.files?.length) applyFile(imageFile.files[0]); });

    function applyFile(file) {
        const allowed = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
        if (!allowed.includes(file.type)) { notify('Please upload a JPG, PNG or WebP image.', 'error'); return; }
        if (file.size > 5 * 1024 * 1024) { notify('File size exceeds 5 MB.', 'error'); return; }
        previewImg.src = URL.createObjectURL(file);
        uploadZone.hidden = true;
        previewWrap.hidden = false;
        if (!imageFile.files.length) { const dt = new DataTransfer(); dt.items.add(file); imageFile.files = dt.files; }
    }

    removeFile?.addEventListener('click', () => {
        previewImg.src = ''; previewWrap.hidden = true; uploadZone.hidden = false; imageFile.value = '';
    });

    // ── Analyze ──
    analyzeBtn?.addEventListener('click', async () => {
        let url, options;

        if (activeTab === 'image') {
            if (!imageFile.files?.length) { notify('Please upload a product image first.', 'warning'); return; }
            const fd = new FormData();
            fd.append('image', imageFile.files[0]);
            url = '/ProductScan/AnalyzeImage';
            options = { method: 'POST', headers: { 'RequestVerificationToken': TOKEN }, body: fd };
        } else {
            const text = (ingredients.value ?? '').trim();
            if (!text) { notify('Please paste the product ingredients first.', 'warning'); ingredients.focus(); return; }
            const body = new URLSearchParams();
            body.append('text', text.split(/[\n,]+/).map(s => s.trim()).filter(Boolean).join(', '));
            url = '/ProductScan/AnalyzeText';
            options = {
                method: 'POST',
                headers: { 'RequestVerificationToken': TOKEN, 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body
            };
        }

        setLoading(true);
        try {
            const res = await fetch(url, options);
            const data = await res.json();
            if (!res.ok) { notify(data.error ?? 'Analysis failed. Please try again.', 'error'); return; }
            renderResult(data);
        } catch {
            notify('Network error. Please check your connection and try again.', 'error');
        } finally {
            setLoading(false);
        }
    });

    function setLoading(on) {
        analyzeBtn.disabled = on;
        analyzeBtn.innerHTML = on
            ? '<i class="fas fa-spinner fa-spin"></i> Analyzing…'
            : '<i class="fas fa-magnifying-glass"></i> Analyze Product';
    }

    // ── Result ──
    function renderResult(data) {
        const src   = data?.results ?? data ?? {};
        const safe  = Array.isArray(src.safe)  ? src.safe.filter(Boolean)  : [];
        const risky = Array.isArray(src.risky) ? src.risky.filter(Boolean) : [];
        const avoid = Array.isArray(src.avoid) ? src.avoid.filter(Boolean) : [];

        // Verdict + risk level derived from the API result
        let cls, icon, verdict, risk;
        if (avoid.length) {
            cls = 'danger'; icon = 'fa-circle-xmark'; verdict = 'Not Recommended'; risk = 'High Risk';
        } else if (risky.length) {
            cls = 'warn'; icon = 'fa-triangle-exclamation'; verdict = 'Use With Caution'; risk = 'Moderate Risk';
        } else {
            cls = 'safe'; icon = 'fa-circle-check'; verdict = 'Safe'; risk = 'No Risk Detected';
        }

        // AI explanation messages (concerning entries first; fall back to safe note)
        const messages = (avoid.length || risky.length) ? [...avoid, ...risky] : safe;

        // Distinct detected risky ingredients
        const detected = Array.from(new Set([...avoid, ...risky].flatMap(extractIngredients)));
        const count = detected.length;

        const recCard = `
            <div class="ps-card ps-rec">
                <div class="ps-card-head">
                    <span class="ico rec"><i class="fas fa-lightbulb"></i></span>
                    <h3>Recommendation</h3>
                </div>
                ${messages.length
                    ? messages.map(m => `<p>${escHtml(m)}</p>`).join('')
                    : `<p>No risky ingredients were detected. This product appears safe to use during pregnancy.</p>`}
            </div>`;

        const ingCard = `
            <div class="ps-card">
                <div class="ps-card-head">
                    <span class="ico ing"><i class="fas fa-vials"></i></span>
                    <h3>Risky Ingredients</h3>
                </div>
                ${count
                    ? `<div class="ps-ing-grid">${detected.map(i => `
                        <div class="ps-ing">
                            <span class="ps-ing-dot"><i class="fas fa-exclamation"></i></span>
                            <span class="ps-ing-name">${escHtml(i)}</span>
                        </div>`).join('')}</div>`
                    : `<div class="ps-ing-empty"><i class="fas fa-circle-check"></i> No risky ingredients found.</div>`}
            </div>`;

        result.innerHTML = `
            <div class="ps-verdict ${cls}">
                <div class="ps-verdict-ico"><i class="fas ${icon}"></i></div>
                <div class="ps-verdict-body">
                    <div class="ps-verdict-kicker">Verdict</div>
                    <div class="ps-verdict-title">${verdict}</div>
                    <div class="ps-verdict-meta">
                        <span class="ps-pill"><i class="fas fa-gauge-high"></i> ${risk}</span>
                        <span class="ps-pill"><i class="fas fa-flask"></i> ${count} risky ingredient${count !== 1 ? 's' : ''} found</span>
                    </div>
                </div>
            </div>
            <div class="ps-result-grid${count ? '' : ' single'}">
                ${recCard}
                ${count ? ingCard : ''}
            </div>
            <div class="ps-disclaimer">
                <i class="fas fa-circle-info"></i>
                <span>This is a guide only. Always check with your doctor or pharmacist before using a product during pregnancy.</span>
            </div>`;

        result.hidden = false;
        result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function extractIngredients(text) {
        const matches = [...String(text ?? '').matchAll(/\[([^\]]+)\]/g)];
        if (!matches.length) return [];
        return Array.from(new Set(
            matches.flatMap(m => m[1].split(',')).map(t => t.trim()).filter(t => /[a-zA-Z]/.test(t))
        ));
    }

    function escHtml(str) {
        return String(str ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function notify(msg, type) {
        if (typeof window.showNotification === 'function') window.showNotification(msg, type);
        else console.warn(msg);
    }
}());
</script>
}
