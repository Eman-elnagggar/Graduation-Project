@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewData["Title"] = "NABD AI Assistant";
    ViewData["ActivePage"] = "Chatbot";
    ViewData["HidePageHeader"] = true;
    var patientId = ViewData["PatientId"] as int? ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/patient-chatbot.css" asp-append-version="true" />
}

<div class="nai-shell">

    @* ════════════ CHAT COLUMN ════════════ *@
    <section class="nai-chat">
        @Html.AntiForgeryToken()

        @* ── Header ── *@
        <header class="nai-head">
            <div class="nai-head-id">
                <span class="nai-avatar">
                    <i class="fas fa-robot"></i>
                    <span class="nai-avatar-dot"></span>
                </span>
                <div class="nai-head-meta">
                    <h1 class="nai-head-name">Nabd AI <span class="nai-head-tag">Assistant</span></h1>
                    <span class="nai-head-status">
                        <span class="nai-status-dot"></span>
                        Online · replies in seconds
                    </span>
                </div>
            </div>
            <div class="nai-head-actions">
                <span class="nai-pill"><i class="fas fa-lock"></i> Private</span>
                <button class="nai-icon-btn" id="clearChatBtn" type="button" title="Clear conversation">
                    <i class="fas fa-broom"></i>
                </button>
            </div>
        </header>

        @* ── Day divider ── *@
        <div class="nai-day"><span id="todayLabel"></span></div>

        @* ── Message stream ── *@
        <div class="nai-stream" id="chatMessages">
            <div class="nai-msg nai-msg--bot" id="welcomeMsg">
                <div class="nai-msg-avatar bot"><i class="fas fa-robot"></i></div>
                <div class="nai-msg-body">
                    <div class="nai-bubble bot">
                        <p>Hello! 🤍 I'm your <strong>Nabd AI Assistant</strong> — here to support you at every step of your pregnancy journey.</p>
                        <p>Ask me about:</p>
                        <div class="nai-caps">
                            <span class="nai-cap"><i class="fas fa-baby"></i> Pregnancy stages</span>
                            <span class="nai-cap"><i class="fas fa-apple-alt"></i> Nutrition &amp; diet</span>
                            <span class="nai-cap"><i class="fas fa-pills"></i> Medication safety</span>
                            <span class="nai-cap"><i class="fas fa-person-running"></i> Safe exercises</span>
                            <span class="nai-cap"><i class="fas fa-calendar-check"></i> Appointments</span>
                            <span class="nai-cap"><i class="fas fa-stethoscope"></i> Symptoms</span>
                        </div>
                        <p class="nai-hint">Type a question below or tap a suggestion to begin.</p>
                    </div>
                    <time class="nai-time" id="welcomeTime"></time>
                </div>
            </div>
        </div>

        @* ── Quick replies ── *@
        <div class="nai-quick">
            <button class="nai-quick-chip" type="button" data-msg="Tips for week 24 of pregnancy"><i class="fas fa-baby-carriage"></i> Week 24 tips</button>
            <button class="nai-quick-chip" type="button" data-msg="What are healthy snacks during pregnancy?"><i class="fas fa-apple-alt"></i> Healthy snacks</button>
            <button class="nai-quick-chip" type="button" data-msg="What are the best sleep positions during pregnancy?"><i class="fas fa-moon"></i> Sleep positions</button>
            <button class="nai-quick-chip" type="button" data-msg="What exercises are safe during pregnancy?"><i class="fas fa-person-running"></i> Safe exercises</button>
            <button class="nai-quick-chip" type="button" data-msg="Is paracetamol safe during pregnancy?"><i class="fas fa-pills"></i> Is paracetamol safe?</button>
            <button class="nai-quick-chip" type="button" data-msg="What foods should I avoid during pregnancy?"><i class="fas fa-ban"></i> Foods to avoid</button>
            <button class="nai-quick-chip" type="button" data-msg="How can I stay hydrated during pregnancy?"><i class="fas fa-droplet"></i> Staying hydrated</button>
        </div>

        @* ── Composer ── *@
        <div class="nai-composer">
            <div class="nai-input-wrap">
                <textarea class="nai-textarea" id="chatInput" rows="1" maxlength="500" autocomplete="off"
                          placeholder="Ask me anything about your pregnancy…"></textarea>
                <span class="nai-counter" id="charCount"></span>
            </div>
            <button class="nai-send" id="sendBtn" type="button" title="Send">
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>
        <p class="nai-note">
            <i class="fas fa-shield-heart"></i>
            AI responses are informational only — always consult your doctor.
        </p>
    </section>

    @* ════════════ SIDE RAIL ════════════ *@
    <aside class="nai-rail">

        @* About *@
        <div class="nai-card">
            <div class="nai-card-head">
                <span class="nai-card-ico rose"><i class="fas fa-robot"></i></span>
                <div>
                    <h2 class="nai-card-title">About Nabd AI</h2>
                    <p class="nai-card-sub">Your pregnancy companion</p>
                </div>
            </div>
            <div class="nai-feat-list">
                <div class="nai-feat">
                    <span class="nai-feat-ico"><i class="fas fa-bolt"></i></span>
                    <div><strong>Instant answers</strong><span>Responds in seconds, any time of day</span></div>
                </div>
                <div class="nai-feat">
                    <span class="nai-feat-ico"><i class="fas fa-heart-pulse"></i></span>
                    <div><strong>Pregnancy-focused</strong><span>Grounded in maternal health knowledge</span></div>
                </div>
                <div class="nai-feat">
                    <span class="nai-feat-ico"><i class="fas fa-lock"></i></span>
                    <div><strong>Private &amp; secure</strong><span>Your conversations stay confidential</span></div>
                </div>
            </div>
        </div>

        @* Today's tips *@
        <div class="nai-card">
            <div class="nai-card-head">
                <span class="nai-card-ico amber"><i class="fas fa-lightbulb"></i></span>
                <div>
                    <h2 class="nai-card-title">Today's tips</h2>
                    <p class="nai-card-sub">Healthy habits for you &amp; baby</p>
                </div>
            </div>
            <ul class="nai-tips">
                <li><i class="fas fa-droplet"></i><span>Drink 8–10 glasses of water</span></li>
                <li><i class="fas fa-capsules"></i><span>Take your prenatal vitamins</span></li>
                <li><i class="fas fa-moon"></i><span>Sleep 7–9 hours per night</span></li>
                <li><i class="fas fa-person-walking"></i><span>30 min gentle movement daily</span></li>
                <li><i class="fas fa-leaf"></i><span>Include folate-rich greens</span></li>
            </ul>
        </div>

        @* Popular topics *@
        <div class="nai-card">
            <div class="nai-card-head">
                <span class="nai-card-ico violet"><i class="fas fa-fire"></i></span>
                <div>
                    <h2 class="nai-card-title">Popular topics</h2>
                    <p class="nai-card-sub">Tap to ask instantly</p>
                </div>
            </div>
            <div class="nai-topics">
                <button class="nai-topic" type="button" data-msg="What are the signs of preeclampsia?">
                    <i class="fas fa-heartbeat"></i><span>Preeclampsia signs</span><i class="fas fa-chevron-right nai-topic-arrow"></i>
                </button>
                <button class="nai-topic" type="button" data-msg="What vitamins should I take during pregnancy?">
                    <i class="fas fa-capsules"></i><span>Prenatal vitamins</span><i class="fas fa-chevron-right nai-topic-arrow"></i>
                </button>
                <button class="nai-topic" type="button" data-msg="What are the stages of labor?">
                    <i class="fas fa-baby-carriage"></i><span>Stages of labor</span><i class="fas fa-chevron-right nai-topic-arrow"></i>
                </button>
                <button class="nai-topic" type="button" data-msg="How can I manage morning sickness?">
                    <i class="fas fa-mug-hot"></i><span>Morning sickness</span><i class="fas fa-chevron-right nai-topic-arrow"></i>
                </button>
                <button class="nai-topic" type="button" data-msg="Is it safe to travel during pregnancy?">
                    <i class="fas fa-plane"></i><span>Travel safety</span><i class="fas fa-chevron-right nai-topic-arrow"></i>
                </button>
            </div>
        </div>



    </aside>

</div>

@section Scripts {
<script>
(function () {
    'use strict';

    /* ── Refs ── */
    const messagesEl  = document.getElementById('chatMessages');
    const inputEl     = document.getElementById('chatInput');
    const sendBtn     = document.getElementById('sendBtn');
    const counterEl   = document.getElementById('charCount');
    const clearBtn    = document.getElementById('clearChatBtn');
    const welcomeTime = document.getElementById('welcomeTime');
    const todayLabel  = document.getElementById('todayLabel');
    const apiEndpoint = '@Url.Action("Ask", "Chatbot")';
    const historyEndpoint = '@Url.Action("History", "Chatbot")';
    const clearEndpoint = '@Url.Action("Clear", "Chatbot")';
    const patientId = Number(document.body?.dataset?.patientId || '@patientId' || '0');
    const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    let isLoading = false;

    /* ── Init ── */
    const now = new Date();
    if (welcomeTime) welcomeTime.textContent = fmtTime(now);
    if (todayLabel)  todayLabel.textContent  = fmtDate(now);
    loadHistory().catch(err => {
        console.error('Failed to load chat history:', err);
        toast('Unable to load chat history right now.', 'error');
    });

    /* Auto-grow textarea */
    inputEl?.addEventListener('input', function () {
        this.style.height = 'auto';
        this.style.height = Math.min(this.scrollHeight, 130) + 'px';
        updateCounter(this.value.length);
    });

    /* ── Send triggers ── */
    sendBtn?.addEventListener('click', trySend);
    inputEl?.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); trySend(); }
    });

    /* Quick replies */
    document.querySelectorAll('.nai-quick-chip').forEach(el =>
        el.addEventListener('click', function () {
            const msg = this.dataset.msg || this.textContent.trim();
            fireInput(msg);
        })
    );

    /* Sidebar topic buttons */
    document.querySelectorAll('.nai-topic').forEach(el =>
        el.addEventListener('click', function () {
            const m = this.dataset.msg;
            if (m) fireInput(m);
        })
    );

    /* Clear button */
    clearBtn?.addEventListener('click', async function () {
        if (!messagesEl || isLoading) return;
        try {
            await clearHistory();
            while (messagesEl.children.length > 1) messagesEl.removeChild(messagesEl.lastChild);
            toast('Conversation cleared', 'info');
        } catch (err) {
            console.error('Failed to clear chat history:', err);
            toast('Unable to clear chat history right now.', 'error');
        }
    });

    /* ── Core ── */
    function fireInput(text) {
        if (!inputEl) return;
        inputEl.value = text;
        inputEl.dispatchEvent(new Event('input'));
        trySend();
    }

    async function trySend() {
        if (isLoading) return;
        const text = inputEl?.value?.trim();
        if (!text) return;
        const userEntry = addMsg(text, 'user');
        resetInput();
        const tid = showTyping();
        setLoading(true);
        try {
            const payload = await requestReply(text);
            const reply = normalizeApiResponse(payload);
            const risk = normalizeRiskLevel(reply.riskLevel);
            if (!risk) throw new Error('Invalid risk level');
            if (tid) removeTyping(tid);
            if (reply.userSentAtUtc) updateMessageTime(userEntry?.timeEl, reply.userSentAtUtc);
            addBotReply(reply.response, risk, reply.recommendation, reply.botSentAtUtc);
        } catch (err) {
            if (tid) removeTyping(tid);
            addMsg('Sorry, the assistant is unavailable right now. Please try again later.', 'bot');
        } finally {
            setLoading(false);
        }
    }

    function resetInput() {
        if (!inputEl) return;
        inputEl.value = '';
        inputEl.style.height = 'auto';
        updateCounter(0);
    }

    function updateCounter(len) {
        if (!counterEl) return;
        counterEl.textContent = len > 0 ? `${len}/500` : '';
        counterEl.className = 'nai-counter' +
            (len > 450 ? ' is-limit' : len > 350 ? ' is-warn' : '');
    }

    /* ── Message helpers ── */
    function addMsg(content, type, timestamp) {
        if (!messagesEl) return null;
        const row  = document.createElement('div');
        row.className = `nai-msg nai-msg--${type}`;
        const t = fmtTime(timestamp);
        const htmlContent = formatText(content);
        if (type === 'bot') {
            row.innerHTML =
                `<div class="nai-msg-avatar bot"><i class="fas fa-robot"></i></div>
                 <div class="nai-msg-body">
                   <div class="nai-bubble bot"><p>${htmlContent}</p></div>
                   <time class="nai-time">${t}</time>
                 </div>`;
        } else {
            row.innerHTML =
                `<div class="nai-msg-body">
                   <div class="nai-bubble user"><p>${htmlContent}</p></div>
                   <time class="nai-time">${t}</time>
                 </div>
                 <div class="nai-msg-avatar user"><i class="fas fa-user"></i></div>`;
        }
        messagesEl.appendChild(row);
        scrollEnd();
        return { row, timeEl: row.querySelector('.nai-time') };
    }

    function addBotReply(response, risk, recommendation, timestamp) {
        if (!messagesEl) return;
        const row = document.createElement('div');
        row.className = 'nai-msg nai-msg--bot';
        const t = fmtTime(timestamp);
        const responseHtml = formatText(response);
        const recommendationHtml = formatText(recommendation);
        row.innerHTML =
            `<div class="nai-msg-avatar bot"><i class="fas fa-robot"></i></div>
             <div class="nai-msg-body">
                 <div class="nai-bubble bot">
                     <p>${responseHtml}</p>
                     <div class="nai-meta">
                         <div class="nai-risk">
                             <span>Risk level</span>
                             <span class="nai-risk-pill is-${risk.className}">${risk.label}</span>
                         </div>
                         <div class="nai-reco">
                             <div class="nai-reco-title">Recommendation</div>
                             <div class="nai-reco-text">${recommendationHtml}</div>
                         </div>
                     </div>
                 </div>
                 <time class="nai-time">${t}</time>
             </div>`;
        messagesEl.appendChild(row);
        scrollEnd();
    }

    function showTyping() {
        if (!messagesEl) return null;
        const id  = 'typing-' + Date.now();
        const row = document.createElement('div');
        row.id = id;
        row.className = 'nai-msg nai-msg--bot nai-msg--typing';
        row.innerHTML =
            `<div class="nai-msg-avatar bot"><i class="fas fa-robot"></i></div>
             <div class="nai-msg-body">
               <div class="nai-bubble bot">
                 <div class="nai-typing-dot"></div><div class="nai-typing-dot"></div><div class="nai-typing-dot"></div>
               </div>
             </div>`;
        messagesEl.appendChild(row);
        scrollEnd();
        return id;
    }

    function removeTyping(id) { document.getElementById(id)?.remove(); }

    function scrollEnd() {
        if (messagesEl) messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    /* ── Toast ── */
    function toast(msg, type = 'info') {
        document.querySelector('.nai-toast')?.remove();
        const icons = { info:'fa-circle-info', success:'fa-circle-check', error:'fa-circle-xmark' };
        const el = document.createElement('div');
        el.className = `nai-toast ${type}`;
        el.innerHTML = `<i class="fas ${icons[type] ?? icons.info}"></i><span>${msg}</span>
                        <button class="nai-toast-close" type="button"><i class="fas fa-times"></i></button>`;
        document.body.appendChild(el);
        el.querySelector('.nai-toast-close').addEventListener('click', () => el.remove());
        setTimeout(() => el?.remove(), 3500);
    }

    function setLoading(loading) {
        isLoading = loading;
        if (!sendBtn || !inputEl) return;
        sendBtn.disabled = loading;
        inputEl.disabled = loading;
        if (loading) {
            if (!sendBtn.dataset.originalHtml) sendBtn.dataset.originalHtml = sendBtn.innerHTML;
            sendBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
        } else if (sendBtn.dataset.originalHtml) {
            sendBtn.innerHTML = sendBtn.dataset.originalHtml;
        }
    }

    async function requestReply(message) {
        const headers = new Headers({ 'Content-Type': 'application/json' });
        if (antiForgeryToken) headers.set('RequestVerificationToken', antiForgeryToken);
        const body = { message };
        if (patientId > 0) body.patientId = patientId;
        const response = await fetch(apiEndpoint, {
            method: 'POST',
            headers,
            credentials: 'same-origin',
            body: JSON.stringify(body)
        });
        if (!response.ok) throw new Error('Service unavailable');
        return await response.json();
    }

    async function loadHistory() {
        if (!messagesEl) return;
        const url = buildHistoryUrl();
        const response = await fetch(url, { credentials: 'same-origin' });
        if (!response.ok) throw new Error('History unavailable');
        const history = await response.json();
        if (!Array.isArray(history) || history.length === 0) return;

        history.forEach(item => {
            const role = String(item?.role ?? '').trim().toLowerCase();
            const message = String(item?.message ?? '').trim();
            if (!message) return;

            if (role === 'user') {
                addMsg(message, 'user', item?.sentAtUtc);
                return;
            }

            if (role === 'bot') {
                const riskLevel = item?.risk_level ?? item?.riskLevel;
                const recommendation = String(item?.recommendation ?? '').trim();
                const risk = normalizeRiskLevel(riskLevel);
                if (risk && recommendation) {
                    addBotReply(message, risk, recommendation, item?.sentAtUtc);
                } else {
                    addMsg(message, 'bot', item?.sentAtUtc);
                }
            }
        });
    }

    async function clearHistory() {
        const headers = new Headers({ 'Content-Type': 'application/json' });
        if (antiForgeryToken) headers.set('RequestVerificationToken', antiForgeryToken);
        const body = patientId > 0 ? { patientId } : {};
        const response = await fetch(clearEndpoint, {
            method: 'POST',
            headers,
            credentials: 'same-origin',
            body: JSON.stringify(body)
        });
        if (!response.ok) throw new Error('Clear failed');
        const result = await response.json();
        if (!result?.success) throw new Error('Clear failed');
    }

    function buildHistoryUrl() {
        const url = new URL(historyEndpoint, window.location.origin);
        if (patientId > 0) url.searchParams.set('patientId', patientId);
        return url.toString();
    }

    function normalizeApiResponse(payload) {
        const response = String(payload?.response ?? '').trim();
        const riskLevel = String(payload?.risk_level ?? payload?.riskLevel ?? '').trim();
        const recommendation = String(payload?.recommendation ?? '').trim();
        if (!response || !riskLevel || !recommendation) {
            throw new Error('Invalid API response');
        }
        return {
            response,
            riskLevel,
            recommendation,
            userSentAtUtc: payload?.userMessage?.sentAtUtc ?? null,
            botSentAtUtc: payload?.botMessage?.sentAtUtc ?? null
        };
    }

    function normalizeRiskLevel(level) {
        const key = String(level ?? '').trim().toLowerCase();
        if (key === 'low') return { label: 'Low', className: 'low' };
        if (key === 'medium') return { label: 'Medium', className: 'medium' };
        if (key === 'high') return { label: 'High', className: 'high' };
        return null;
    }

    function updateMessageTime(timeEl, timestamp) {
        if (!timeEl) return;
        timeEl.textContent = fmtTime(timestamp);
    }

    /* ── Utils ── */
    function fmtTime(value) {
        const d = toDate(value);
        return d.toLocaleTimeString([], { hour:'2-digit', minute:'2-digit' });
    }
    function fmtDate(d) {
        return d.toLocaleDateString([], { weekday:'long', month:'long', day:'numeric', year:'numeric' });
    }
    function toDate(value) {
        if (!value) return new Date();
        if (value instanceof Date) return value;
        const d = new Date(value);
        return Number.isNaN(d.getTime()) ? new Date() : d;
    }
    function escHtml(s) {
        return String(s ?? '')
            .replace(/&/g,'&amp;')
            .replace(/</g,'&lt;')
            .replace(/>/g,'&gt;')
            .replace(/"/g,'&quot;')
            .replace(/'/g,'&#39;');
    }
    function formatText(text) {
        return escHtml(text).replace(/\r?\n/g, '<br/>');
    }

}());
</script>
}
