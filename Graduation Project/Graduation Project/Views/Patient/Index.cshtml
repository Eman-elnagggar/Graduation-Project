@using System.Globalization
@using System.Linq
@model PatientDashboardViewModel
@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewData["Title"] = "My Journey";
    ViewData["PatientId"]  = Model.Patient.PatientID;
    ViewData["ActivePage"] = "Dashboard";
    ViewData["UserName"] = Model.UserName;
    ViewData["HidePageHeader"] = true;

    var now = DateTime.Now;
    var greeting = now.Hour < 12 ? "Good morning" : now.Hour < 18 ? "Good afternoon" : "Good evening";
    var greetFlower = now.Hour < 12 ? "🌅" : now.Hour < 18 ? "🌷" : "🌙";
    var patientFirstName = (Model.UserName ?? "Mama").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Mama";

    ViewData["PageTitle"] = "My Journey";
    ViewData["PageTitleHtml"] = $"{greeting}, <span class='topbar-accent'>{patientFirstName}</span> {greetFlower}";
    ViewData["PageSubtitle"] = "Your pregnancy journey companion";

    var week = Math.Clamp(Model.PregnancyWeek, 0, 40);
    var percent = Math.Clamp(Model.PregnancyProgressPercent, 0, 100);
    var weeksLeft = Math.Max(0, 40 - week);

    // Due date + countdown
    DateTime dueParsed;
    bool hasDue = DateTime.TryParse(Model.DueDate, CultureInfo.InvariantCulture, DateTimeStyles.None, out dueParsed);
    int daysRemaining = hasDue
        ? Math.Max(0, (int)(dueParsed.Date - DateTime.Today).TotalDays)
        : Math.Max(0, weeksLeft * 7);

    var baby = GetBabyInfo(week);
    var babyShort = baby.Size;
    if (babyShort.StartsWith("a ", StringComparison.OrdinalIgnoreCase)) babyShort = babyShort.Substring(2);
    else if (babyShort.StartsWith("an ", StringComparison.OrdinalIgnoreCase)) babyShort = babyShort.Substring(3);
    var babyShortCap = babyShort.Length > 0 ? char.ToUpper(babyShort[0]) + babyShort.Substring(1) : babyShort;

    // ── Trimester-aware narrative for the hero "This week" bridge (no new data) ──
    string momPhase = week < 13
        ? "Baby's major organs and neural tube are taking shape, so early symptoms like nausea are common."
        : week < 27
            ? "Often the most comfortable stretch — energy tends to return and you may start to feel movement."
            : "Baby is gaining weight quickly while your body gently prepares for birth.";
    string goodToKnow = week < 13
        ? "Folic acid, hydration, and rest matter most during these first weeks."
        : week < 27
            ? "A good window to schedule your mid-pregnancy anomaly scan."
            : "A great time to plan your birth preferences and pack your hospital bag.";

    // ── Health insights derived from latest readings ──
    var insights = new List<(string Icon, string Type, string Title, string Text)>();
    {
        var bpRaw = Model.LastBloodPressureValue;
        if (!string.IsNullOrWhiteSpace(bpRaw) && bpRaw != "N/A" && bpRaw.Contains('/'))
        {
            var p = bpRaw.Split('/');
            if (p.Length == 2 && int.TryParse(p[0], out int s) && int.TryParse(p[1], out int d))
            {
                if (s < 90 || d < 60)
                    insights.Add(("fa-arrow-down", "info", "Blood pressure is a little low", $"Your last reading was {bpRaw}. Rest and stay nourished — let your doctor know if you feel dizzy."));
                else if (s <= 120 && d <= 80)
                    insights.Add(("fa-check", "good", "Blood pressure looks stable", $"Your last reading was {bpRaw} mmHg — right where we love to see it. 💚"));
                else if (s <= 139 || d <= 89)
                    insights.Add(("fa-exclamation", "warn", "Blood pressure is slightly up", $"Your last reading was {bpRaw}. Try to rest, hydrate, and keep an eye on it."));
                else
                    insights.Add(("fa-exclamation", "warn", "Blood pressure was elevated", $"Your last reading was {bpRaw}. Please monitor closely and reach out to your doctor."));
            }
        }

        var bs = Model.LastBloodSugarValue;
        if (bs > 0)
        {
            if (bs < 70)
                insights.Add(("fa-arrow-down", "info", "Blood sugar was low", $"Last reading {bs:0} mg/dL. Have a small snack and check again soon."));
            else if (bs <= 140)
                insights.Add(("fa-check", "good", "Blood sugar looks healthy", $"Last reading {bs:0} mg/dL — nicely within range. Keep it up!"));
            else
                insights.Add(("fa-exclamation", "warn", "Blood sugar was elevated", $"Last reading {bs:0} mg/dL. Light movement and balanced meals can help bring it down."));
        }
    }
    // Always end on a gentle, supportive note
    insights.Add(("fa-tint", "tip", "Remember to stay hydrated", "Aim for 8–10 glasses of water today — it helps you and baby feel your best. 💧"));
    if (insights.Count > 3) insights = insights.Take(3).ToList();

    // ── Weekly trend points (chronological) ──
    // We keep the plotted value (systolic for BP) plus a human-readable label
    // ("120/80", "95") and the reading date, so every point on the sparkline
    // can show its own value instead of only the latest reading.
    var bpPoints = (Model.WeeklyBloodPressureReadings ?? new List<PatientBloodPressure>())
        .OrderByDescending(r => r.DateTime).Take(8)
        .Select(r => {
            var pp = (r.BloodPressure ?? "").Split('/');
            int sys = 0; if (pp.Length == 2) int.TryParse(pp[0], out sys);
            return new { r.DateTime, Val = (double)sys, Label = (r.BloodPressure ?? "").Trim() };
        })
        .Where(x => x.Val > 0)
        .OrderBy(x => x.DateTime)
        .Select(x => (Val: x.Val, Label: x.Label, Date: x.DateTime)).ToList();
    var bpSeries = bpPoints.Select(x => x.Val).ToList();

    var bsPoints = (Model.WeeklyBloodSugarReadings ?? new List<PatientBloodSugar>())
        .OrderByDescending(r => r.DateTime).Take(8)
        .Select(r => new { r.DateTime, Val = r.BloodSugar })
        .Where(x => x.Val > 0)
        .OrderBy(x => x.DateTime)
        .Select(x => (Val: x.Val, Label: x.Val.ToString("0"), Date: x.DateTime)).ToList();
    var bsSeries = bsPoints.Select(x => x.Val).ToList();

    // Pregnancy tips (curated, swipeable)
    var tips = new List<(string Cat, string Emoji, string Title, string Text)>
    {
        ("Nutrition", "🥗", "Eat the rainbow", "Colorful fruits and veggies give you and baby a rich mix of vitamins and antioxidants."),
        ("Movement", "🚶‍♀️", "Gentle daily walks", "A 20-minute walk boosts circulation, mood, and sleep — no need to push hard."),
        ("Rest", "😴", "Sleep on your side", "Resting on your left side improves blood flow to your baby. Hug a pillow for comfort."),
        ("Wellness", "🧘‍♀️", "Breathe slowly", "Two minutes of slow breathing can ease tension and calm both of you."),
        ("Nutrition", "🥛", "Calcium counts", "Dairy, leafy greens, and fortified foods help build your baby's bones and teeth.")
    };
}

@functions {
    // Flat, 2D vector emoji (Twemoji) — keeps the baby illustration consistent across platforms
    private string TwemojiUrl(string emoji)
    {
        var parts = new List<string>();
        for (int i = 0; i < emoji.Length;)
        {
            int cp = char.ConvertToUtf32(emoji, i);
            i += char.IsSurrogatePair(emoji, i) ? 2 : 1;
            if (cp == 0xFE0F) continue; // skip variation selector
            parts.Add(cp.ToString("x"));
        }
        return "https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/svg/" + string.Join("-", parts) + ".svg";
    }

    private (string Size, string Emoji, string Fact, string Milestone) GetBabyInfo(int w)
    {
        if (w >= 40) return ("a small pumpkin", "🎃", "Your baby is full-term and ready to meet you any day now.", "Fully developed & ready for birth");
        if (w >= 39) return ("a mini watermelon", "🍉", "Baby's brain is still developing rapidly and will keep growing after birth.", "Building healthy fat stores");
        if (w >= 38) return ("a leek", "🥬", "Your baby now has a firm grasp and may grab your finger after birth.", "Practicing grip & reflexes");
        if (w >= 37) return ("a bunch of swiss chard", "🥬", "Baby is considered early-term — the lungs are nearly ready.", "Lungs almost fully mature");
        if (w >= 36) return ("a head of romaine", "🥬", "Baby is shedding the soft downy hair and getting ready for the outside world.", "Settling into position");
        if (w >= 35) return ("a honeydew melon", "🍈", "Most of baby's basic physical development is complete — now it's all about growing.", "Kidneys & liver maturing");
        if (w >= 34) return ("a cantaloupe", "🍈", "Baby's central nervous system and lungs are maturing steadily.", "Lungs continuing to mature");
        if (w >= 33) return ("a pineapple", "🍍", "Baby's bones are hardening, though the skull stays soft for delivery.", "Bones strengthening");
        if (w >= 32) return ("a squash", "🎃", "You may feel more practice contractions as baby gets stronger.", "Toenails & real hair forming");
        if (w >= 31) return ("a coconut", "🥥", "Baby can turn their head and is putting on soft, protective fat.", "Rapid brain development");
        if (w >= 30) return ("a head of cabbage", "🥬", "Baby's eyesight keeps developing, though it stays blurry for a while.", "Eyes opening & focusing");
        if (w >= 29) return ("a butternut squash", "🎃", "Muscles and lungs are maturing and baby's head is growing for the brain.", "Building muscle & bone");
        if (w >= 28) return ("an eggplant", "🍆", "Baby can blink and may dream during REM sleep. Third trimester begins!", "Eyes can open & close");
        if (w >= 27) return ("a cauliflower", "🥦", "Baby may now recognize your voice and your partner's.", "Hearing your voice");
        if (w >= 26) return ("a head of lettuce", "🥬", "Baby's lungs are forming air sacs in preparation for that first breath.", "Lungs developing air sacs");
        if (w >= 25) return ("a rutabaga", "🥔", "Baby is filling out and the skin is becoming less wrinkled.", "Gaining baby fat");
        if (w >= 24) return ("an ear of corn", "🌽", "Baby's face is almost fully formed and is now considered viable.", "Face fully formed");
        if (w >= 23) return ("a grapefruit", "🍊", "You may feel little kicks and flutters more often now.", "Sense of movement");
        if (w >= 22) return ("a papaya", "🥭", "Baby's lips, eyelids and tiny eyebrows are becoming more distinct.", "Features taking shape");
        if (w >= 21) return ("a carrot", "🥕", "Baby's taste buds are forming and they can swallow.", "Developing taste buds");
        if (w >= 20) return ("a banana", "🍌", "You're halfway there! Baby can hear sounds from the outside world.", "Halfway milestone 🎉");
        if (w >= 19) return ("a mango", "🥭", "A protective coating now covers baby's delicate skin.", "Protective vernix forming");
        if (w >= 18) return ("a bell pepper", "🫑", "Baby is yawning, hiccuping, and may be moving a lot.", "Active movements begin");
        if (w >= 17) return ("a pear", "🍐", "Baby's skeleton is shifting from soft cartilage to bone.", "Cartilage turning to bone");
        if (w >= 16) return ("an avocado", "🥑", "Baby can make tiny facial expressions, though not on purpose yet.", "Facial muscles developing");
        if (w >= 15) return ("an apple", "🍎", "Baby is forming taste buds and can sense light.", "Sensing light");
        if (w >= 14) return ("a lemon", "🍋", "Baby's tiny body is now growing faster than the head.", "Body lengthening");
        if (w >= 13) return ("a peapod", "🫛", "Welcome to the second trimester — baby has unique fingerprints!", "Fingerprints forming");
        if (w >= 12) return ("a lime", "🍋", "Baby's reflexes are developing — fingers will soon open and close.", "Reflexes developing");
        if (w >= 11) return ("a fig", "🟣", "Baby is now almost fully formed and busy kicking and stretching.", "Tiny fingers & toes");
        if (w >= 10) return ("a strawberry", "🍓", "Vital organs are working and baby's tiny nails are starting to grow.", "Organs functioning");
        if (w >= 9) return ("a cherry", "🍒", "Baby's heart has divided into four chambers.", "Heart fully chambered");
        if (w >= 8) return ("a raspberry", "🫐", "Baby is now moving, though you can't feel it yet.", "First tiny movements");
        if (w >= 7) return ("a blueberry", "🫐", "Baby's brain is forming and growing incredibly fast.", "Brain forming rapidly");
        if (w >= 6) return ("a sweet pea", "🫛", "A tiny heartbeat has begun to flutter this week.", "Heartbeat begins 💗");
        if (w >= 5) return ("a sesame seed", "🌱", "The neural tube — baby's brain and spine — is forming.", "Neural tube developing");
        if (w >= 4) return ("a poppy seed", "🌱", "The journey has begun — baby is implanting and growing.", "Implantation");
        return ("a tiny seed", "🌱", "Your beautiful journey is just beginning.", "Early days");
    }

    private string BuildAreaPoints(List<double> vals, double width, double height, bool closeArea)
    {
        if (vals == null || vals.Count == 0) return "";
        double max = vals.Max();
        double min = vals.Min();
        double range = Math.Max(1, max - min);
        var pts = new List<string>();
        double pad = 6;
        for (int i = 0; i < vals.Count; i++)
        {
            double x = vals.Count == 1 ? width / 2 : i * (width / (vals.Count - 1));
            double norm = (vals[i] - min) / range;
            double y = height - pad - norm * (height - pad * 2);
            pts.Add($"{x.ToString("0.#", CultureInfo.InvariantCulture)},{y.ToString("0.#", CultureInfo.InvariantCulture)}");
        }
        if (closeArea)
        {
            pts.Add($"{width.ToString("0.#", CultureInfo.InvariantCulture)},{height}");
            pts.Add($"0,{height}");
        }
        return string.Join(" ", pts);
    }

    // Returns each point's position as a percentage of the chart box (so HTML
    // labels can be overlaid on the non-uniformly-stretched SVG without being
    // distorted) together with its display label.
    private List<(double XPct, double YPct, string Label, string Date)> BuildLabels(
        List<(double Val, string Label, DateTime Date)> pts)
    {
        var result = new List<(double, double, string, string)>();
        if (pts == null || pts.Count == 0) return result;
        double max = pts.Max(p => p.Val);
        double min = pts.Min(p => p.Val);
        double range = Math.Max(1, max - min);
        double pad = 6, height = 90;
        for (int i = 0; i < pts.Count; i++)
        {
            double xPct = pts.Count == 1 ? 50 : i * (100.0 / (pts.Count - 1));
            double norm = (pts[i].Val - min) / range;
            double y = height - pad - norm * (height - pad * 2);
            result.Add((xPct, y / height * 100.0, pts[i].Label, pts[i].Date.ToString("MMM d")));
        }
        return result;
    }
}

@section Head {
    <meta name="patient-id" content="@Model.Patient.PatientID" />
    @Html.AntiForgeryToken()
}

<div class="ph" data-patient-dashboard>

    @if (!Model.HasActivePregnancy)
    {
        <div class="ph-noactive">
            <div class="ph-noactive-emoji">🌸</div>
            <h2>Welcome, @patientFirstName</h2>
            <p>You don't have an active pregnancy on record right now. When your journey begins, this space will fill with weekly milestones, gentle insights, and everything to support you and your little one.</p>
            <a class="ph-btn-primary" href="/PatientProfile/Index/@Model.Patient.PatientID"><i class="fas fa-heart"></i> Update my profile</a>
        </div>
    }

    <!-- ══════════════ 1. HERO — Mother (60) · Baby (40) ══════════════ -->
    <section class="ph-hero">
        <div class="ph-hero-aurora"></div>

        <!-- Decorative botanical line-art & sparkles -->
        <div class="ph-hero-botanical" aria-hidden="true">
            <svg class="ph-bot ph-bot-1" viewBox="0 0 100 140" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
                <path d="M50 138 C50 104 50 72 50 32"/>
                <path d="M50 112 C35 107 27 95 31 80 C47 84 54 98 50 112Z"/>
                <path d="M50 112 C65 107 73 95 69 80 C53 84 46 98 50 112Z"/>
                <path d="M50 88 C37 83 31 71 35 58 C49 62 54 76 50 88Z"/>
                <path d="M50 88 C63 83 69 71 65 58 C51 62 46 76 50 88Z"/>
                <path d="M50 66 C40 60 36 50 40 39 C50 43 54 55 50 66Z"/>
                <path d="M50 66 C60 60 64 50 60 39 C50 43 46 55 50 66Z"/>
                <path d="M50 46 C45 38 47 28 53 22"/>
            </svg>
            <svg class="ph-bot ph-bot-2" viewBox="0 0 100 140" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
                <path d="M50 138 C50 104 50 72 50 32"/>
                <path d="M50 112 C35 107 27 95 31 80 C47 84 54 98 50 112Z"/>
                <path d="M50 112 C65 107 73 95 69 80 C53 84 46 98 50 112Z"/>
                <path d="M50 88 C37 83 31 71 35 58 C49 62 54 76 50 88Z"/>
                <path d="M50 88 C63 83 69 71 65 58 C51 62 46 76 50 88Z"/>
                <path d="M50 66 C40 60 36 50 40 39 C50 43 54 55 50 66Z"/>
                <path d="M50 66 C60 60 64 50 60 39 C50 43 46 55 50 66Z"/>
                <path d="M50 46 C45 38 47 28 53 22"/>
            </svg>
            <svg class="ph-bot ph-bot-3" viewBox="0 0 100 140" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
                <path d="M50 138 C50 104 50 72 50 32"/>
                <path d="M50 112 C35 107 27 95 31 80 C47 84 54 98 50 112Z"/>
                <path d="M50 112 C65 107 73 95 69 80 C53 84 46 98 50 112Z"/>
                <path d="M50 88 C37 83 31 71 35 58 C49 62 54 76 50 88Z"/>
                <path d="M50 88 C63 83 69 71 65 58 C51 62 46 76 50 88Z"/>
                <path d="M50 66 C40 60 36 50 40 39 C50 43 54 55 50 66Z"/>
                <path d="M50 66 C60 60 64 50 60 39 C50 43 46 55 50 66Z"/>
                <path d="M50 46 C45 38 47 28 53 22"/>
            </svg>
        </div>

        <div class="ph-hero-grid">

            <!-- ── LEFT · Mother focus ── -->
            <div class="ph-hero-main">
                <span class="ph-hero-eyebrow">@greeting, @patientFirstName</span>

                <h1 class="ph-hero-week">
                    Week <span class="ph-hero-week-num">@week</span>
                    <span class="ph-hero-week-of">of 40</span>
                </h1>
                <p class="ph-hero-lead">of your pregnancy journey</p>
                <span class="ph-hero-tri">@Model.Trimester</span>

                <div class="ph-hero-facts">
                    <div class="ph-hero-fact">
                        <span class="ph-hero-fact-lbl">Expected delivery</span>
                        <span class="ph-hero-fact-val">@(hasDue ? dueParsed.ToString("MMMM dd, yyyy") : "To be confirmed")</span>
                    </div>
                    <span class="ph-hero-fact-sep"></span>
                    <div class="ph-hero-fact">
                        <span class="ph-hero-fact-lbl">Time remaining</span>
                        <span class="ph-hero-fact-val">@daysRemaining days remaining</span>
                    </div>
                </div>

                <div class="ph-hero-bar">
                    <div class="ph-hero-bar-head">
                        <span class="ph-hero-bar-title">Pregnancy progress</span>
                        <span class="ph-hero-bar-count">Week @week of 40</span>
                    </div>
                    <div class="ph-hero-bar-track">
                        <span class="ph-hero-bar-tick" style="left:32.5%"></span>
                        <span class="ph-hero-bar-tick" style="left:67.5%"></span>
                        <div class="ph-hero-bar-fill" style="width:@percent%">
                            <span class="ph-hero-bar-dot"></span>
                        </div>
                    </div>
                    <div class="ph-hero-bar-foot">
                        <span class="@(week < 13 ? "on" : "")">1st trimester</span>
                        <span class="@(week >= 13 && week < 27 ? "on" : "")">2nd</span>
                        <span class="@(week >= 27 ? "on" : "")">3rd</span>
                    </div>
                    <div class="ph-hero-bar-stats">
                        <span><strong>@week</strong> weeks completed</span>
                        <span class="ph-hero-bar-pct">@percent% complete</span>
                        <span><strong>@weeksLeft</strong> weeks to go</span>
                    </div>
                </div>

            </div>

            <!-- ── CENTER · This week at a glance (bridge: mother ↔ baby) ── -->
            <div class="ph-hero-bridge">
                <div class="ph-hero-bridge-head">
                    <span class="ph-hero-bridge-title">This week at a glance</span>
                    <span class="ph-hero-bridge-sub">Week @week · @Model.Trimester</span>
                </div>
                <ul class="ph-hero-hl">
                    <li>
                        <span class="ph-hl-ico violet"><i class="fas fa-seedling"></i></span>
                        <div class="ph-hl-body">
                            <span class="ph-hl-t">This week's development</span>
                            <p class="ph-hl-d">@baby.Fact</p>
                        </div>
                    </li>
                    <li>
                        <span class="ph-hl-ico rose"><i class="fas fa-heart"></i></span>
                        <div class="ph-hl-body">
                            <span class="ph-hl-t">@Model.Trimester</span>
                            <p class="ph-hl-d">@momPhase</p>
                        </div>
                    </li>
                    <li>
                        <span class="ph-hl-ico amber"><i class="fas fa-lightbulb"></i></span>
                        <div class="ph-hl-body">
                            <span class="ph-hl-t">Good to know</span>
                            <p class="ph-hl-d">@goodToKnow</p>
                        </div>
                    </li>
                </ul>
            </div>

            <!-- ── RIGHT · Baby development ── -->
            <aside class="ph-hero-baby">
                <div class="ph-hero-baby-head">
                    <span class="ph-hero-baby-tag"><i class="fas fa-heart"></i> Baby development</span>
                    <span class="ph-hero-baby-wk">Week @week</span>
                </div>
                <div class="ph-hero-baby-main">
                    <div class="ph-hero-baby-orb" style="--ring:@percent">
                        <span class="ph-hero-baby-ring"></span>
                        <span class="ph-hero-baby-emoji">
                            <img src="@TwemojiUrl(baby.Emoji)" alt="@babyShort" loading="lazy"
                                 onerror="this.style.display='none';var f=this.nextElementSibling;if(f)f.style.display='inline';" />
                            <em style="display:none;font-style:normal;">@baby.Emoji</em>
                        </span>
                    </div>
                    <div class="ph-hero-baby-meta">
                        <span class="ph-hero-baby-size">Size of @babyShortCap</span>
                        <span class="ph-hero-baby-sub">@percent% to full term</span>
                    </div>
                </div>
                <ul class="ph-hero-baby-list">
                    <li>
                        <i class="fas fa-calendar-day"></i>
                        <span class="bl-lbl">Current week</span>
                        <span class="bl-val">Week @week of 40</span>
                    </li>
                    <li>
                        <i class="fas fa-ruler-horizontal"></i>
                        <span class="bl-lbl">Size this week</span>
                        <span class="bl-val">@babyShort</span>
                    </li>
                    <li>
                        <i class="fas fa-seedling"></i>
                        <span class="bl-lbl">Milestone</span>
                        <span class="bl-val">@baby.Milestone</span>
                    </li>
                </ul>
            </aside>

        </div>
    </section>

    <!-- ══════════════ Care cards — complement the hero ══════════════ -->
    @{
        int nextBoundary = week < 13 ? 13 : week < 27 ? 27 : 40;
        string nextLabel = week < 13 ? "Second trimester begins" : week < 27 ? "Third trimester begins" : "Meeting your baby";
        int weeksToNext = Math.Max(0, nextBoundary - week);
        string nextDesc = week < 13
            ? "Often brings renewed energy as early symptoms ease."
            : week < 27
                ? "Baby grows quickly and you'll start to feel more movement."
                : "Baby reaches full term and prepares to meet you.";

        bool hasBp = !string.IsNullOrWhiteSpace(Model.LastBloodPressureValue) && Model.LastBloodPressureValue != "N/A";
        string bpStatus = ""; string bpStatusCls = "neutral";
        if (hasBp && Model.LastBloodPressureValue.Contains('/'))
        {
            var pp = Model.LastBloodPressureValue.Split('/');
            if (pp.Length == 2 && int.TryParse(pp[0], out int s) && int.TryParse(pp[1], out int d))
            {
                if (s < 90 || d < 60) { bpStatus = "Low"; bpStatusCls = "warn"; }
                else if (s <= 120 && d <= 80) { bpStatus = "Normal"; bpStatusCls = "good"; }
                else if (s <= 139 || d <= 89) { bpStatus = "Elevated"; bpStatusCls = "warn"; }
                else { bpStatus = "High"; bpStatusCls = "bad"; }
            }
        }
        string bpTrend = "";
        if (bpSeries.Count >= 2)
        {
            var diff = bpSeries[bpSeries.Count - 1] - bpSeries[bpSeries.Count - 2];
            bpTrend = diff > 3 ? "Trending up from last reading"
                : diff < -3 ? "Trending down from last reading"
                : "Stable since your last reading";
        }
    }
    <div class="ph-snap">

        <!-- Upcoming appointment -->
        <div class="ph-snap-card">
            <div class="ph-snap-head">
                <span class="ph-snap-ico sky"><i class="fas fa-calendar-check"></i></span>
                <span class="ph-snap-title">Upcoming appointment</span>
            </div>
            @if (Model.NextAppointment != null)
            {
                var na = Model.NextAppointment;
                var docName = na.Doctor?.User != null ? $"Dr. {na.Doctor.User.FirstName} {na.Doctor.User.LastName}".Trim() : "Your doctor";
                <div class="ph-snap-main">
                    <span class="ph-snap-strong">@na.Date.ToString("dddd, MMM dd")</span>
                    <span class="ph-snap-ctx">@docName · @DateTime.Today.Add(na.Time).ToString("hh:mm tt")</span>
                    <span class="ph-snap-ctx"><i class="fas fa-map-marker-alt"></i> @(na.Clinic?.Name ?? "Clinic")</span>
                </div>
                <a class="ph-snap-action" href="/PatientAppointments/Appointments/@Model.Patient.PatientID">View details <i class="fas fa-arrow-right"></i></a>
            }
            else
            {
                <div class="ph-snap-main">
                    <span class="ph-snap-strong">No upcoming visit</span>
                    <span class="ph-snap-ctx">Regular check-ups help keep you and your baby on track.</span>
                </div>
                <a class="ph-snap-action solid" href="/PatientAppointments/BookAppointment/@Model.Patient.PatientID"><i class="fas fa-plus"></i> Book appointment</a>
            }
        </div>

        <!-- Pregnancy milestone -->
        <div class="ph-snap-card">
            <div class="ph-snap-head">
                <span class="ph-snap-ico violet"><i class="fas fa-flag-checkered"></i></span>
                <span class="ph-snap-title">Pregnancy milestone</span>
            </div>
            <div class="ph-snap-main">
                <span class="ph-snap-strong">@nextLabel</span>
                <div class="ph-snap-chips">
                    <span class="ph-snap-chip">Expected week @nextBoundary</span>
                    <span class="ph-snap-chip ghost">@weeksToNext @(weeksToNext == 1 ? "wk" : "wks") away</span>
                </div>
                <span class="ph-snap-ctx">@nextDesc</span>
            </div>
        </div>

        <!-- Health snapshot -->
        <div class="ph-snap-card">
            <div class="ph-snap-head">
                <span class="ph-snap-ico rose"><i class="fas fa-heartbeat"></i></span>
                <span class="ph-snap-title">Health snapshot</span>
                @if (hasBp)
                {
                    <span class="ph-snap-status @bpStatusCls">@bpStatus</span>
                }
            </div>
            @if (hasBp)
            {
                <div class="ph-snap-main">
                    <span class="ph-snap-strong">@Model.LastBloodPressureValue <small>mmHg</small></span>
                    <span class="ph-snap-ctx">Blood pressure@(bpTrend.Length > 0 ? " · " + bpTrend : "")</span>
                </div>
                <a class="ph-snap-action" href="javascript:void(0)" data-open-tracker="bp">Log new reading <i class="fas fa-arrow-right"></i></a>
            }
            else
            {
                <div class="ph-snap-main">
                    <span class="ph-snap-strong">No readings yet</span>
                    <span class="ph-snap-ctx">Track your blood pressure to spot trends early.</span>
                </div>
                <a class="ph-snap-action solid" href="javascript:void(0)" data-open-tracker="bp"><i class="fas fa-plus"></i> Log reading</a>
            }
        </div>
    </div>

    <!-- ══════════════ 2. PREGNANCY JOURNEY PATH ══════════════ -->
    <section class="ph-card ph-journey">
        <div class="ph-card-head">
            <h2><span class="ph-dot rose"></span> Your Pregnancy Journey</h2>
            <span class="ph-card-sub">@Model.Trimester · Week @week</span>
        </div>
        @{
            var milestones = new (int Week, string Label, string Emoji)[]
            {
                (1, "It begins", "🌱"),
                (13, "2nd trimester", "🌷"),
                (27, "3rd trimester", "🌻"),
                (40, "Meet baby", "👶")
            };
        }
        <div class="ph-path">
            <div class="ph-path-line"><div class="ph-path-line-fill" style="width:@percent%"></div></div>
            <div class="ph-path-nodes">
                @for (int i = 0; i < milestones.Length; i++)
                {
                    var m = milestones[i];
                    var nextWeek = i + 1 < milestones.Length ? milestones[i + 1].Week : 41;
                    var reached = week >= m.Week;
                    var current = week >= m.Week && week < nextWeek;
                    <div class="ph-path-node @(reached ? "reached" : "") @(current ? "current" : "")">
                        <div class="ph-path-bubble">@m.Emoji</div>
                        <span class="ph-path-wk">Week @m.Week</span>
                        <span class="ph-path-lbl">@m.Label</span>
                    </div>
                }
            </div>
            <div class="ph-path-you" style="left:@percent%;">
                <span class="ph-path-you-flag">You're here</span>
            </div>
        </div>
    </section>

    <!-- ══════════════ 3. TODAY'S CARE ══════════════ -->
    <section class="ph-section">
        <div class="ph-section-head">
            <h2>Today's Care</h2>
            <p>Small loving steps for you and baby</p>
        </div>
        <div class="ph-care-grid">
            <button type="button" class="ph-care ph-care-rose" data-open-tracker="bp">
                <span class="ph-care-ico">🩺</span>
                <span class="ph-care-body">
                    <span class="ph-care-title">Log Blood Pressure</span>
                    <span class="ph-care-desc">Quick check-in</span>
                </span>
                <i class="fas fa-chevron-right ph-care-arrow"></i>
            </button>
            <button type="button" class="ph-care ph-care-violet" data-open-tracker="bs">
                <span class="ph-care-ico">🩸</span>
                <span class="ph-care-body">
                    <span class="ph-care-title">Log Blood Sugar</span>
                    <span class="ph-care-desc">Keep levels balanced</span>
                </span>
                <i class="fas fa-chevron-right ph-care-arrow"></i>
            </button>
            <a class="ph-care ph-care-amber" href="/PatientProfile/Index/@Model.Patient.PatientID">
                <span class="ph-care-ico">⚖️</span>
                <span class="ph-care-body">
                    <span class="ph-care-title">Log Weight</span>
                    <span class="ph-care-desc">@(Model.Patient.WeightKg > 0 ? $"Now {Model.Patient.WeightKg:0.#} kg" : "Track your healthy gain")</span>
                </span>
                <i class="fas fa-chevron-right ph-care-arrow"></i>
            </a>
            <a class="ph-care ph-care-mint" href="/PatientTests/TestsUpload/@Model.Patient.PatientID">
                <span class="ph-care-ico">🧪</span>
                <span class="ph-care-body">
                    <span class="ph-care-title">Upload Test Results</span>
                    <span class="ph-care-desc">AI reads them for you</span>
                </span>
                <i class="fas fa-chevron-right ph-care-arrow"></i>
            </a>
            <button type="button" class="ph-care ph-care-sky" data-open-kick>
                <span class="ph-care-ico">👣</span>
                <span class="ph-care-body">
                    <span class="ph-care-title">Track Baby Movement</span>
                    <span class="ph-care-desc">Count those kicks</span>
                </span>
                <i class="fas fa-chevron-right ph-care-arrow"></i>
            </button>
            <a class="ph-care ph-care-peach" href="/Chatbot/Index/@Model.Patient.PatientID">
                <span class="ph-care-ico">💬</span>
                <span class="ph-care-body">
                    <span class="ph-care-title">Record Symptoms</span>
                    <span class="ph-care-desc">Talk to your assistant</span>
                </span>
                <i class="fas fa-chevron-right ph-care-arrow"></i>
            </a>
        </div>
    </section>

    <!-- ══════════════ 5 + 9. INSIGHTS & MOOD ══════════════ -->
    <div class="ph-two">
        <section class="ph-card ph-insights">
            <div class="ph-card-head">
                <h2><span class="ph-dot mint"></span> Health Insights</h2>
                <a class="ph-link" href="/PatientMedicalHistory/MedicalHistory/@Model.Patient.PatientID">History <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="ph-insight-list">
                @foreach (var ins in insights)
                {
                    <div class="ph-insight ph-ins-@ins.Type">
                        <div class="ph-insight-ico"><i class="fas @ins.Icon"></i></div>
                        <div class="ph-insight-body">
                            <span class="ph-insight-title">@ins.Title</span>
                            <span class="ph-insight-text">@ins.Text</span>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="ph-card ph-mood">
            <div class="ph-card-head">
                <h2><span class="ph-dot amber"></span> How are you feeling today?</h2>
            </div>
            <div class="ph-mood-row" id="phMoodRow">
                <button class="ph-mood-btn" data-mood="happy"><span>😊</span><small>Happy</small></button>
                <button class="ph-mood-btn" data-mood="calm"><span>😌</span><small>Calm</small></button>
                <button class="ph-mood-btn" data-mood="tired"><span>😴</span><small>Tired</small></button>
                <button class="ph-mood-btn" data-mood="uncomfortable"><span>🤕</span><small>Achy</small></button>
                <button class="ph-mood-btn" data-mood="worried"><span>😟</span><small>Worried</small></button>
            </div>
            <div class="ph-mood-history">
                <span class="ph-mood-history-lbl">This week</span>
                <div class="ph-mood-week" id="phMoodWeek"></div>
            </div>
        </section>
    </div>

    <!-- ══════════════ 6. APPOINTMENTS TIMELINE ══════════════ -->
    <section class="ph-card ph-appts">
        <div class="ph-card-head">
            <h2><span class="ph-dot sky"></span> Upcoming Care</h2>
            <a class="ph-link" href="/PatientAppointments/Appointments/@Model.Patient.PatientID">All visits <i class="fas fa-arrow-right"></i></a>
        </div>
        <div class="ph-timeline">
            @if (Model.NextAppointment != null)
            {
                var na = Model.NextAppointment;
                var docName = na.Doctor?.User != null ? $"Dr. {na.Doctor.User.FirstName} {na.Doctor.User.LastName}".Trim() : "Your doctor";
                <div class="ph-tl-item next">
                    <div class="ph-tl-marker"></div>
                    <div class="ph-tl-card">
                        <div class="ph-tl-date">@na.Date.ToString("ddd, MMM dd")</div>
                        <div class="ph-tl-title">@docName</div>
                        <div class="ph-tl-meta">
                            <span><i class="fas fa-clock"></i> @DateTime.Today.Add(na.Time).ToString("hh:mm tt")</span>
                            <span><i class="fas fa-map-marker-alt"></i> @(na.Clinic?.Name ?? "Clinic")</span>
                        </div>
                        <span class="ph-tl-badge">Next up</span>
                    </div>
                </div>
            }
            @if (Model.RecentPastAppointments != null && Model.RecentPastAppointments.Any())
            {
                @foreach (var ap in Model.RecentPastAppointments.Take(3))
                {
                    var dn = ap.Doctor?.User != null ? $"Dr. {ap.Doctor.User.FirstName} {ap.Doctor.User.LastName}".Trim() : "Doctor";
                    <div class="ph-tl-item past">
                        <div class="ph-tl-marker"></div>
                        <div class="ph-tl-card">
                            <div class="ph-tl-date">@ap.Date.ToString("ddd, MMM dd")</div>
                            <div class="ph-tl-title">@dn</div>
                            <div class="ph-tl-meta">
                                <span><i class="fas fa-map-marker-alt"></i> @(ap.Clinic?.Name ?? "Clinic")</span>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (Model.NextAppointment == null)
            {
                <div class="ph-empty">
                    <span>🗓️</span>
                    <p>No appointments yet. Booking a check-up keeps you and baby on track.</p>
                </div>
            }
        </div>
        <a class="ph-btn-primary ph-appt-btn" href="/PatientAppointments/BookAppointment/@Model.Patient.PatientID">
            <i class="fas fa-plus"></i> Book an appointment
        </a>
    </section>

    <!-- ══════════════ 7. WEEKLY HEALTH TRENDS ══════════════ -->
    <section class="ph-section">
        <div class="ph-section-head">
            <h2>Your Wellness Trends</h2>
            <p>A gentle look at this week</p>
        </div>
        <div class="ph-two">
            <div class="ph-card ph-trend">
                <div class="ph-trend-head">
                    <span class="ph-trend-title">🩺 Blood Pressure</span>
                    <span class="ph-trend-now">@(string.IsNullOrWhiteSpace(Model.LastBloodPressureValue) || Model.LastBloodPressureValue == "N/A" ? "—" : Model.LastBloodPressureValue)</span>
                </div>
                @if (bpSeries.Count >= 2)
                {
                    <div class="ph-spark-wrap">
                        <svg class="ph-spark" viewBox="0 0 300 90" preserveAspectRatio="none">
                            <defs>
                                <linearGradient id="phGradBp" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#1baebe" stop-opacity="0.35"></stop>
                                    <stop offset="100%" stop-color="#1baebe" stop-opacity="0"></stop>
                                </linearGradient>
                            </defs>
                            <polygon fill="url(#phGradBp)" points="@BuildAreaPoints(bpSeries, 300, 90, true)"></polygon>
                            <polyline fill="none" stroke="#1baebe" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" points="@BuildAreaPoints(bpSeries, 300, 90, false)"></polyline>
                        </svg>
                        @foreach (var p in BuildLabels(bpPoints))
                        {
                            <div class="ph-spark-pt bp" style="left:@p.XPct.ToString("0.#", CultureInfo.InvariantCulture)%; top:@p.YPct.ToString("0.#", CultureInfo.InvariantCulture)%;">
                                <span class="ph-spark-val" title="@p.Date">@p.Label</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="ph-trend-empty">Log a few readings to see your trend bloom 🌱</div>
                }
            </div>

            <div class="ph-card ph-trend">
                <div class="ph-trend-head">
                    <span class="ph-trend-title">🩸 Blood Sugar</span>
                    <span class="ph-trend-now">@(Model.LastBloodSugarValue > 0 ? $"{Model.LastBloodSugarValue:0} mg/dL" : "—")</span>
                </div>
                @if (bsSeries.Count >= 2)
                {
                    <div class="ph-spark-wrap">
                        <svg class="ph-spark" viewBox="0 0 300 90" preserveAspectRatio="none">
                            <defs>
                                <linearGradient id="phGradBs" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0%" stop-color="#22c9db" stop-opacity="0.35"></stop>
                                    <stop offset="100%" stop-color="#22c9db" stop-opacity="0"></stop>
                                </linearGradient>
                            </defs>
                            <polygon fill="url(#phGradBs)" points="@BuildAreaPoints(bsSeries, 300, 90, true)"></polygon>
                            <polyline fill="none" stroke="#22c9db" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" points="@BuildAreaPoints(bsSeries, 300, 90, false)"></polyline>
                        </svg>
                        @foreach (var p in BuildLabels(bsPoints))
                        {
                            <div class="ph-spark-pt bs" style="left:@p.XPct.ToString("0.#", CultureInfo.InvariantCulture)%; top:@p.YPct.ToString("0.#", CultureInfo.InvariantCulture)%;">
                                <span class="ph-spark-val" title="@p.Date">@p.Label</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="ph-trend-empty">Log a few readings to see your trend bloom 🌱</div>
                }
            </div>
        </div>
    </section>

    <!-- ══════════════ 8. PREGNANCY TIPS ══════════════ -->
    <section class="ph-section">
        <div class="ph-section-head">
            <h2>Daily Tips for You</h2>
            <p>Swipe through gentle reminders</p>
        </div>
        <div class="ph-tips" id="phTips">
            @foreach (var t in tips)
            {
                <div class="ph-tip">
                    <span class="ph-tip-cat">@t.Cat</span>
                    <span class="ph-tip-emoji">@t.Emoji</span>
                    <h3>@t.Title</h3>
                    <p>@t.Text</p>
                </div>
            }
        </div>
    </section>

</div>

<!-- ══════════════ TRACKER SHEET (BP / BS logging) ══════════════ -->
<div class="ph-sheet-overlay" id="phSheetOverlay"></div>
<div class="ph-sheet" id="phSheet" aria-hidden="true" role="dialog">
    <div class="ph-sheet-grip"></div>
    <button class="ph-sheet-close" id="phSheetClose" aria-label="Close"><i class="fas fa-times"></i></button>

    <div class="ph-sheet-head">
        <h3>Log a reading</h3>
        <p>It only takes a moment 💗</p>
    </div>

    <div class="ph-sheet-tabs">
        <button class="ph-sheet-tab active" data-tab="bp"><i class="fas fa-heartbeat"></i> Blood Pressure</button>
        <button class="ph-sheet-tab" data-tab="bs"><i class="fas fa-tint"></i> Blood Sugar</button>
    </div>

    <!-- BP -->
    <div class="ph-tab-pane active" id="phPaneBp">
        <div class="ph-field-row">
            <div class="ph-field">
                <label>Systolic <small>top</small></label>
                <input type="number" id="systolic" placeholder="120" min="70" max="200" />
                <span class="ph-field-hint">Normal 90–120</span>
            </div>
            <span class="ph-field-slash">/</span>
            <div class="ph-field">
                <label>Diastolic <small>bottom</small></label>
                <input type="number" id="diastolic" placeholder="80" min="40" max="130" />
                <span class="ph-field-hint">Normal 60–80</span>
            </div>
        </div>
        <div class="ph-field-row">
            <div class="ph-field">
                <label>Pulse <small>optional</small></label>
                <input type="number" id="pulse" placeholder="72" min="40" max="200" />
            </div>
            <div class="ph-field">
                <label>When?</label>
                <select id="bpMeasurementTime">
                    <option value="Morning">Morning</option>
                    <option value="Afternoon">Afternoon</option>
                    <option value="Evening">Evening</option>
                    <option value="Bedtime">Bedtime</option>
                    <option value="Other">Other</option>
                </select>
            </div>
        </div>
        <button class="ph-save" id="saveBP"><i class="fas fa-heart"></i> Save reading</button>
        <div class="ph-result" id="bpResult" style="display:none">
            <span class="ph-result-val" id="bpValue">120/80</span>
            <span class="ph-result-status" id="bpStatus"></span>
            <p class="ph-result-msg" id="bpMessage"></p>
        </div>
    </div>

    <!-- BS -->
    <div class="ph-tab-pane" id="phPaneBs">
        <div class="ph-field-row">
            <div class="ph-field">
                <label>Blood sugar level</label>
                <input type="number" id="bloodSugar" placeholder="95" min="40" max="400" />
                <span class="ph-field-hint">Fasting 70–100 · After meals &lt;140</span>
            </div>
        </div>
        <div class="ph-field-row">
            <div class="ph-field">
                <label>When did you measure?</label>
                <select id="mealTime">
                    <option value="Fasting (Before breakfast)">Fasting (Before breakfast)</option>
                    <option value="After Breakfast (2 hours)">After Breakfast (2 hours)</option>
                    <option value="Before Lunch">Before Lunch</option>
                    <option value="After Lunch (2 hours)">After Lunch (2 hours)</option>
                    <option value="Before Dinner">Before Dinner</option>
                    <option value="After Dinner (2 hours)">After Dinner (2 hours)</option>
                    <option value="Bedtime">Bedtime</option>
                </select>
            </div>
        </div>
        <button class="ph-save ph-save-violet" id="saveBS"><i class="fas fa-heart"></i> Save reading</button>
        <div class="ph-result" id="bsResult" style="display:none">
            <span class="ph-result-val" id="bsValue">95</span>
            <span class="ph-result-status" id="bsStatus"></span>
            <p class="ph-result-msg" id="bsMessage"></p>
        </div>
    </div>
</div>

<!-- ══════════════ KICK COUNTER SHEET ══════════════ -->
<div class="ph-sheet-overlay" id="phKickOverlay"></div>
<div class="ph-sheet ph-kick-sheet" id="phKickSheet" aria-hidden="true" role="dialog">
    <div class="ph-sheet-grip"></div>
    <button class="ph-sheet-close" id="phKickClose" aria-label="Close"><i class="fas fa-times"></i></button>
    <h3 class="ph-kick-h">Baby Movement</h3>
    <p class="ph-kick-sub">Tap each time you feel your baby move today 👣</p>
    <button class="ph-kick-big" id="phKickBtn">
        <span class="ph-kick-count" id="phKickCount">0</span>
        <span class="ph-kick-emoji">👶</span>
        <span class="ph-kick-tap">Tap when baby kicks</span>
    </button>
    <p class="ph-kick-note">Most days you'll feel 10 movements within a couple of hours. Reach out to your doctor if movements feel reduced.</p>
    <button class="ph-kick-reset" id="phKickReset">Reset today's count</button>
</div>

@section Scripts {
<script>
const PATIENT_ID        = parseInt(document.querySelector('meta[name="patient-id"]').content, 10);
const ANTIFORGERY_TOKEN = document.querySelector('input[name="__RequestVerificationToken"]').value;

window.showNotification = window.showNotification || function (message, type = "info") {
    document.querySelector('.ph-toast')?.remove();
    const icons = { success:'fa-check-circle', error:'fa-times-circle', warning:'fa-exclamation-triangle', info:'fa-info-circle' };
    const n = document.createElement('div');
    n.className = `ph-toast ph-toast-${type}`;
    n.innerHTML = `<i class="fas ${icons[type]||icons.info}"></i><span>${message}</span>`;
    document.body.appendChild(n);
    setTimeout(() => n?.remove(), 3800);
};

document.addEventListener('DOMContentLoaded', function () {

    /* ───── Tracker sheet ───── */
    const sheet   = document.getElementById('phSheet');
    const overlay = document.getElementById('phSheetOverlay');

    function openSheet(tab) {
        switchTab(tab || 'bp');
        sheet.classList.add('open');
        overlay.classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    function closeSheet() {
        sheet.classList.remove('open');
        overlay.classList.remove('open');
        document.body.style.overflow = '';
    }
    function switchTab(tab) {
        document.querySelectorAll('.ph-sheet-tab').forEach(t => t.classList.toggle('active', t.dataset.tab === tab));
        document.getElementById('phPaneBp').classList.toggle('active', tab === 'bp');
        document.getElementById('phPaneBs').classList.toggle('active', tab === 'bs');
    }

    document.querySelectorAll('[data-open-tracker]').forEach(b =>
        b.addEventListener('click', () => openSheet(b.dataset.openTracker)));
    document.querySelectorAll('.ph-sheet-tab').forEach(t =>
        t.addEventListener('click', () => switchTab(t.dataset.tab)));
    document.getElementById('phSheetClose').addEventListener('click', closeSheet);
    overlay.addEventListener('click', closeSheet);

    /* ───── Blood Pressure ───── */
    const sysIn = document.getElementById('systolic');
    const diaIn = document.getElementById('diastolic');
    const pulseIn = document.getElementById('pulse');
    const bpTime = document.getElementById('bpMeasurementTime');
    const bpRes = document.getElementById('bpResult');

    [sysIn, diaIn, pulseIn].forEach(i => i?.addEventListener('input', () => { i.value = i.value.replace(/[^0-9]/g,''); }));

    document.getElementById('saveBP')?.addEventListener('click', async function () {
        const sys = parseInt(sysIn.value), dia = parseInt(diaIn.value), meas = bpTime?.value || '';
        if (!sys || !dia) { window.showNotification('Please enter both values.', 'error'); return; }
        if (sys < 70 || sys > 200) { window.showNotification('Systolic must be 70–200.', 'error'); return; }
        if (dia < 40 || dia > 130) { window.showNotification('Diastolic must be 40–130.', 'error'); return; }

        const a = analyzeBP(sys, dia);
        document.getElementById('bpValue').textContent = `${sys}/${dia} mmHg`;
        const st = document.getElementById('bpStatus');
        st.className = 'ph-result-status ' + a.status;
        st.innerHTML = `<i class="fas ${a.icon}"></i> ${a.label}`;
        document.getElementById('bpMessage').textContent = a.message;
        bpRes.style.display = 'block';

        try {
            const fd = new FormData();
            fd.append('patientId', PATIENT_ID); fd.append('systolic', sys); fd.append('diastolic', dia);
            fd.append('measurementTime', meas); fd.append('__RequestVerificationToken', ANTIFORGERY_TOKEN);
            const r = await fetch('/Patient/SaveBloodPressure', { method:'POST', body:fd });
            if (!r.ok) throw new Error();
            const d = await r.json();
            if (d.success) { window.refreshPatientRiskAlerts?.(); window.showNotification('Blood pressure saved 💚', 'success'); }
        } catch { window.showNotification('Could not save. Please try again.', 'error'); }
    });

    function analyzeBP(s, d) {
        if (s < 90 || d < 60)   return { status:'low',  label:'Low',      icon:'fa-arrow-down',   message:'A little low. Rest and stay nourished — tell your doctor if you feel dizzy.' };
        if (s <= 120 && d <= 80) return { status:'good', label:'Normal',  icon:'fa-check-circle', message:'Lovely! Your blood pressure is right where we want it. 💚' };
        if (s <= 139 || d <= 89) return { status:'warn', label:'Elevated',icon:'fa-exclamation-circle', message:'Slightly elevated. Rest, hydrate, and keep an eye on it.' };
        return                          { status:'warn', label:'High',    icon:'fa-exclamation-triangle', message:'High — please monitor closely and contact your doctor.' };
    }

    /* ───── Blood Sugar ───── */
    const bsIn = document.getElementById('bloodSugar');
    const bsTimeSel = document.getElementById('mealTime');
    const bsRes = document.getElementById('bsResult');
    bsIn?.addEventListener('input', () => { bsIn.value = bsIn.value.replace(/[^0-9]/g,''); });

    document.getElementById('saveBS')?.addEventListener('click', async function () {
        const val = parseInt(bsIn.value), meal = bsTimeSel.value;
        if (!val) { window.showNotification('Please enter a blood sugar value.', 'error'); return; }
        if (val < 40 || val > 400) { window.showNotification('Value must be 40–400 mg/dL.', 'error'); return; }

        const a = analyzeBS(val, meal);
        document.getElementById('bsValue').textContent = `${val} mg/dL`;
        const st = document.getElementById('bsStatus');
        st.className = 'ph-result-status ' + a.status;
        st.innerHTML = `<i class="fas ${a.icon}"></i> ${a.label}`;
        document.getElementById('bsMessage').textContent = a.message;
        bsRes.style.display = 'block';

        try {
            const fd = new FormData();
            fd.append('patientId', PATIENT_ID); fd.append('bloodSugar', val);
            fd.append('measurementTime', meal); fd.append('__RequestVerificationToken', ANTIFORGERY_TOKEN);
            const r = await fetch('/Patient/SaveBloodSugar', { method:'POST', body:fd });
            if (!r.ok) throw new Error();
            const d = await r.json();
            if (d.success) { window.refreshPatientRiskAlerts?.(); window.showNotification('Blood sugar saved 💜', 'success'); }
        } catch { window.showNotification('Could not save. Please try again.', 'error'); }
    });

    function analyzeBS(v, meal) {
        const isFast = meal.includes('Fasting') || meal.includes('Before Lunch') || meal.includes('Before Dinner');
        if (v < 70) return { status:'low', label:'Low', icon:'fa-arrow-down', message:'Low — have a small snack and check again soon.' };
        if (isFast) {
            if (v <= 100) return { status:'good', label:'Normal',   icon:'fa-check-circle', message:'Fasting sugar is in a healthy range. Great job!' };
            if (v <= 125) return { status:'warn', label:'Elevated', icon:'fa-exclamation-circle', message:'Slightly elevated fasting sugar. Keep an eye on your meals.' };
            return              { status:'warn', label:'High',     icon:'fa-exclamation-triangle', message:'High fasting sugar — please consult your provider.' };
        }
        if (v <= 140) return { status:'good', label:'Normal',        icon:'fa-check-circle', message:'Post-meal sugar is within a healthy range.' };
        if (v <= 180) return { status:'warn', label:'Slightly High', icon:'fa-exclamation-circle', message:'A bit high after eating. Gentle movement can help.' };
        return              { status:'warn', label:'High',          icon:'fa-exclamation-triangle', message:'High post-meal sugar — consult your healthcare provider.' };
    }

    /* ───── Kick counter ───── */
    const kickSheet = document.getElementById('phKickSheet');
    const kickOverlay = document.getElementById('phKickOverlay');
    const kickKey = () => 'ph_kicks_' + PATIENT_ID + '_' + new Date().toISOString().slice(0,10);
    const kickCountEl = document.getElementById('phKickCount');

    function renderKicks() { kickCountEl.textContent = parseInt(localStorage.getItem(kickKey()) || '0', 10); }
    function openKick() { renderKicks(); kickSheet.classList.add('open'); kickOverlay.classList.add('open'); document.body.style.overflow='hidden'; }
    function closeKick() { kickSheet.classList.remove('open'); kickOverlay.classList.remove('open'); document.body.style.overflow=''; }

    document.querySelector('[data-open-kick]')?.addEventListener('click', openKick);
    document.getElementById('phKickClose').addEventListener('click', closeKick);
    kickOverlay.addEventListener('click', closeKick);
    document.getElementById('phKickBtn').addEventListener('click', function () {
        const n = parseInt(localStorage.getItem(kickKey()) || '0', 10) + 1;
        localStorage.setItem(kickKey(), n);
        kickCountEl.textContent = n;
        this.classList.remove('pulse'); void this.offsetWidth; this.classList.add('pulse');
    });
    document.getElementById('phKickReset').addEventListener('click', function () {
        localStorage.setItem(kickKey(), '0'); renderKicks();
    });

    /* ───── Mood ───── */
    const moodKey = () => 'ph_mood_' + PATIENT_ID + '_' + new Date().toISOString().slice(0,10);
    const moodEmoji = { happy:'😊', calm:'😌', tired:'😴', uncomfortable:'🤕', worried:'😟' };

    function paintMood() {
        const today = localStorage.getItem(moodKey());
        document.querySelectorAll('.ph-mood-btn').forEach(b => b.classList.toggle('sel', b.dataset.mood === today));
        const wrap = document.getElementById('phMoodWeek');
        wrap.innerHTML = '';
        for (let i = 6; i >= 0; i--) {
            const dt = new Date(); dt.setDate(dt.getDate() - i);
            const key = 'ph_mood_' + PATIENT_ID + '_' + dt.toISOString().slice(0,10);
            const m = localStorage.getItem(key);
            const cell = document.createElement('div');
            cell.className = 'ph-mood-cell' + (m ? ' has' : '');
            cell.innerHTML = `<span>${m ? moodEmoji[m] : '·'}</span><small>${dt.toLocaleDateString('en-US',{weekday:'narrow'})}</small>`;
            wrap.appendChild(cell);
        }
    }
    document.querySelectorAll('.ph-mood-btn').forEach(b => b.addEventListener('click', () => {
        const cur = localStorage.getItem(moodKey());
        if (cur === b.dataset.mood) localStorage.removeItem(moodKey());
        else localStorage.setItem(moodKey(), b.dataset.mood);
        paintMood();
    }));
    paintMood();

    /* ───── Countdown soft fade-in ───── */
    const cn = document.getElementById('phCountNum');
    if (cn) { cn.style.opacity = 0; requestAnimationFrame(() => { cn.style.transition='opacity .6s ease'; cn.style.opacity=1; }); }
});
</script>
}

