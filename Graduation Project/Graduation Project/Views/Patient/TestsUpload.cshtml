<!-- ══════════ SHARE WITH DOCTOR MODAL ══════════ -->
<div id="shareReportModal" class="tu-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="shareReportModalTitle" style="display:none">
    <div class="tu-modal" style="max-width:440px">
        <div class="tu-modal-hdr">
            <div class="tu-modal-hdr-left">
                <div class="tu-card-icon-wrap tu-icon-report"><i class="fas fa-share-alt"></i></div>
                <div>
                    <h5 id="shareReportModalTitle" class="tu-modal-title">Share with Doctor</h5>
                    <p>Send your AI report as a PDF</p>
                </div>
            </div>
            <div class="tu-modal-hdr-right">
                <button class="tu-modal-close" id="shareReportModalClose" type="button" aria-label="Close"><i class="fas fa-times"></i></button>
            </div>
        </div>
        <div class="tu-modal-body" style="padding:1.25rem 1.5rem">
            <p style="margin:0 0 1rem;font-size:.86rem;color:var(--ink-2);line-height:1.55">
                The report will be generated as a PDF and sent straight to your doctor’s chat.
            </p>
            <label for="shareReportDoctorSelect" style="display:block;margin-bottom:.45rem;font-size:.82rem;font-weight:700;color:var(--ink)">Select doctor</label>
            <div class="lsel-wrap">
                <select id="shareReportDoctorSelect" class="lsel"></select>
                <i class="fas fa-chevron-down lsel-chevron"></i>
            </div>
        </div>
        <div class="tu-modal-footer">
            <button type="button" class="lbtn lbtn-ghost" id="shareReportCancelBtn">Cancel</button>
            <button type="button" class="lbtn lbtn-primary" id="shareReportConfirmBtn"><i class="fas fa-paper-plane"></i> Send report</button>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/patient-tests.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        window.NABD_TESTS = {
            approvedDoctors: @Html.Raw(ViewBag.ApprovedDoctorsJson ?? "[]"),
            uploadReportUrl: '@Url.Action("UploadChatFile", "Patient", new { id = ViewBag.PatientId })',
            sendReportUrl:   '@Url.Action("SendReportToDoctor", "Patient", new { id = ViewBag.PatientId })'
        };
    </script>
