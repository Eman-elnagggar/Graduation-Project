@model Graduation_Project.ViewModels.PatientAppointmentsViewModel
@using System.Linq
@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewData["Title"] = "Care Journey";
    ViewData["PatientId"] = Model.Patient.PatientID;
    ViewData["ActivePage"] = "Appointments";
    ViewData["UserName"] = Model.UserName;
    ViewData["HidePageHeader"] = true;

    var patientId = Model.Patient.PatientID;
    var firstName = (Model.UserName ?? "Mama").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Mama";

    var week = Math.Clamp(Model.PregnancyWeek, 0, 40);
    var percent = Math.Clamp(Model.PregnancyProgressPercent, 0, 100);
    var weeksLeft = Math.Max(0, 40 - week);

    // ── Next visit (soonest upcoming) ──
    var nextAppt = Model.UpcomingAppointments.FirstOrDefault();
    int? daysToNext = nextAppt != null ? Math.Max(0, (int)(nextAppt.Date.Date - DateTime.Today).TotalDays) : (int?)null;

    var nextDocName = nextAppt?.Doctor?.User != null
        ? $"Dr. {nextAppt.Doctor.User.FirstName} {nextAppt.Doctor.User.LastName}".Trim()
        : "Your doctor";
    var nextReason = nextAppt?.Booking?.Reason;
    if (string.IsNullOrWhiteSpace(nextReason)) nextReason = "Prenatal Visit";
    var nextStatus = nextAppt?.Booking?.Status ?? "Confirmed";
    var nextCanCancel = string.Equals(nextStatus, "Confirmed", StringComparison.OrdinalIgnoreCase)
                     || string.Equals(nextStatus, "Modified", StringComparison.OrdinalIgnoreCase);
    var nextCanReschedule = string.Equals(nextStatus, "Modified", StringComparison.OrdinalIgnoreCase);
    var nextNotes = nextAppt?.Booking?.Notes;

    var clinicName = nextAppt?.Clinic?.Name ?? "Clinic";
    var clinicLoc = nextAppt?.Clinic?.Location ?? "";
    var mapsQuery = Uri.EscapeDataString(string.IsNullOrWhiteSpace(clinicLoc) ? clinicName : $"{clinicName} {clinicLoc}");
    var mapsUrl = $"https://www.google.com/maps/search/?api=1&query={mapsQuery}";

    // ── Primary doctor for hero ──
    var primaryDoc = Model.PrimaryDoctor?.Doctor;
    var primaryDocName = primaryDoc?.User != null
        ? $"Dr. {primaryDoc.User.FirstName} {primaryDoc.User.LastName}".Trim()
        : null;

    // ── Care roadmap milestones (standard antenatal journey) ──
    var milestones = new (int Week, string Title, string Sub, string Emoji)[]
    {
        (8,  "First Trimester Consultation", "Confirm your pregnancy & first checkup", "🩺"),
        (11, "Booking Blood Tests",          "Baseline screening bloodwork",           "🩸"),
        (13, "Dating & NT Scan",             "Your very first ultrasound",             "📡"),
        (20, "Anatomy Scan",                 "Detailed mid-pregnancy scan",            "👶"),
        (28, "Prenatal Checkup",             "Third trimester begins",                 "💗"),
        (34, "Growth Ultrasound",            "Baby's growth & position",               "📏"),
        (37, "Birth Planning Session",       "Prepare your birth plan",                "📝"),
        (40, "Delivery Day",                 "Meeting your little one",                "🌸"),
    };
    int currentIdx = Array.FindIndex(milestones, m => week < m.Week);
    if (currentIdx < 0) currentIdx = milestones.Length - 1;

    // ── Hero "next care step" ──
    string nextStepName;
    string nextStepMeta;
    if (nextAppt != null)
    {
        nextStepName = nextReason;
        nextStepMeta = daysToNext == 0 ? "Today" : daysToNext == 1 ? "Tomorrow" : $"{daysToNext} days remaining";
    }
    else
    {
        nextStepName = milestones[currentIdx].Title;
        nextStepMeta = "Not scheduled yet";
    }

    // ── Preparation note by trimester ──
    string prepNote = week <= 13
        ? "Bring a photo ID and any previous medical records. Note the first day of your last period and any nausea or symptoms you've had."
        : week <= 26
            ? "Prepare your questions about the anatomy scan, bring recent test or lab results, and note any movements you've started to feel."
            : "Bring your maternity notes, track your baby's movements, and be ready to talk through your birth preferences.";

    // ── Smart recommendations for this week ──
    var recs = week <= 13 ? new[]
        {
            ("📡","Dating Ultrasound","Confirm your due date and baby's heartbeat."),
            ("🩸","First Trimester Bloodwork","Baseline screening for a healthy start."),
            ("🥗","Nutrition & Folic Acid","Talk through your diet and supplements."),
        }
        : week <= 19 ? new[]
        {
            ("👶","Schedule Anatomy Scan","Book your detailed 18–22 week scan."),
            ("💗","Routine Prenatal Check","Blood pressure, weight & baby's heartbeat."),
            ("🥗","Nutrition Consultation","Keep your energy and iron levels up."),
        }
        : week <= 26 ? new[]
        {
            ("🧪","Glucose Screening","Gestational diabetes test around now."),
            ("👶","Anatomy Scan Review","Go over your scan results together."),
            ("💗","Wellness & Iron Check","Stay ahead of tiredness and anemia."),
        }
        : week <= 32 ? new[]
        {
            ("📏","Growth Ultrasound","Check baby's growth and position."),
            ("📅","Prenatal Checkup","Visits become a little more frequent."),
            ("🧘‍♀️","Birth Class Enrollment","Prepare for labor with confidence."),
        }
        : week <= 36 ? new[]
        {
            ("📏","Growth Monitoring","Keep an eye on baby's size and position."),
            ("🧫","Group B Strep Test","A simple, routine swab around 36 weeks."),
            ("📝","Birth Plan Discussion","Share your preferences with your team."),
        }
        : new[]
        {
            ("📅","Weekly Prenatal Visit","Close monitoring as you near the finish."),
            ("👶","Position & Growth Check","Confirm baby is ready for arrival."),
            ("🌸","Delivery Preparation","Final steps before you meet your baby."),
        };

}

@{
    // ── Reusable visit-memory timeline item ──
    Func<Graduation_Project.Models.Appointment, object> RenderMemory = @<text>
        @{
            var _ap = item;
            var _dn = _ap.Doctor?.User != null ? $"Dr. {_ap.Doctor.User.FirstName} {_ap.Doctor.User.LastName}".Trim() : "Your doctor";
            var _status = (_ap.Booking?.Status ?? "Completed").Trim().ToLowerInvariant();
            var _reason = _ap.Booking?.Reason;
            if (string.IsNullOrWhiteSpace(_reason)) { _reason = "Prenatal Visit"; }
            var _kind = _status is "cancelled" or "canceled" ? "cancelled" : _status == "missed" ? "missed" : "completed";
            string _note = _kind switch
            {
                "cancelled" => "This visit was cancelled — you can rebook whenever you're ready. 💛",
                "missed" => "This visit was missed. Reaching out to rebook keeps your care on track.",
                _ => "Everything was reviewed and noted — thank you for taking care of yourself and your baby. 💚"
            };
            var _statusLabel = _kind switch { "cancelled" => "Cancelled", "missed" => "Missed", _ => "Completed" };
            var _statusIcon = _kind switch { "cancelled" => "fa-ban", "missed" => "fa-calendar-xmark", _ => "fa-check" };
        }
        <div class="pj-mem-item @_kind">
            <span class="pj-mem-marker"><i class="fas @_statusIcon"></i></span>
            <div class="pj-mem-card">
                <div class="pj-mem-top">
                    <span class="pj-mem-date">@_ap.Date.ToString("MMMM dd, yyyy")</span>
                    <span class="pj-mem-status"><i class="fas @_statusIcon"></i> @_statusLabel</span>
                </div>
                <div class="pj-mem-title">@_reason</div>
                <div class="pj-mem-note">@_note</div>
                <div class="pj-mem-doc">
                    <span><i class="fas fa-user-md"></i> @_dn</span>
                    <span><i class="fas fa-map-marker-alt"></i> @(_ap.Clinic?.Name ?? "Clinic")</span>
                </div>
            </div>
        </div>
    </text>;
}

@section Head {
    @Html.AntiForgeryToken()
    <style>
        /* ══════════════════════════════════════════════════════════
           NABD — Pregnancy Care Journey (Appointments)
           Warm, guided, companion-app aesthetic — matches Home
        ══════════════════════════════════════════════════════════ */
        .pj {
            --rose:#1baebe; --rose-lt:#f0fdfe; --rose-d:#138fa0;
            --violet:#22c9db; --violet-lt:#f0fdfe; --violet-d:#138fa0;
            --mint:#34d399; --mint-lt:#ecfdf5;
            --amber:#fbbf24; --amber-lt:#fffaf0;
            --sky:#60a5fa; --sky-lt:#eff6ff;
            --peach:#fb923c; --peach-lt:#fff4ec;
            --ink:#1e293b; --ink-2:#4a5568; --ink-3:#8896ab;
            --bg:#FFF9FA; --cream:#f3f6fb; --line:#e4eaf2;
            --r:24px; --r-sm:18px;
            --sh:0 10px 30px rgba(15, 23, 42,.08);
            --sh-sm:0 4px 16px rgba(15, 23, 42,.06);
            font-family:'Inter',system-ui,sans-serif; color:var(--ink);
            display:flex; flex-direction:column; gap:26px; padding-bottom:42px;
        }
        .pj h1,.pj h2,.pj h3,.pj h4 { margin:0; }
        .pj-section-head { margin-bottom:2px; }
        .pj-section-head h2 { font-size:1.32rem; font-weight:800; letter-spacing:-.3px; }
        .pj-section-head p { margin:3px 0 0; color:var(--ink-3); font-size:.92rem; }
        .pj-eyebrow {
            display:inline-flex; align-items:center; gap:7px; font-size:.74rem; font-weight:800;
            text-transform:uppercase; letter-spacing:1.2px; color:var(--rose-d);
        }

        /* ── 1 · HEADER (compact) ── */
        .pj-hero {
            position:relative; overflow:hidden; border-radius:24px; padding:22px 28px;
            border:1px solid rgba(255,255,255,.7); box-shadow:var(--sh-sm);
            background:
                radial-gradient(120% 160% at 0% 0%, #e0f7fa 0%, transparent 52%),
                radial-gradient(120% 160% at 100% 100%, #efe2ff 0%, transparent 52%),
                linear-gradient(120deg, #fff3f5 0%, #f0fdfe 48%, #f6effe 100%);
        }
        .pj-hero-botanical { position:absolute; inset:0; z-index:0; pointer-events:none; }
        .pj-hero-botanical .pj-bot { position:absolute; color:#8896ab; opacity:.32; }
        .pj-bot-1 { width:70px; height:98px; left:-14px; bottom:-26px; transform:rotate(-13deg); }
        .pj-bot-2 { width:60px; height:84px; right:-12px; top:-22px; transform:rotate(166deg); opacity:.26; }
        .pj-hero-bar {
            position:relative; z-index:1; display:flex; align-items:center; justify-content:space-between;
            gap:24px; flex-wrap:wrap;
        }
        .pj-hero-intro { min-width:240px; }
        .pj-hero-title { font-size:1.7rem; font-weight:800; letter-spacing:-.6px; margin:4px 0 0; }
        .pj-hero-title b { background:linear-gradient(120deg,var(--rose),#22c9db); -webkit-background-clip:text; background-clip:text; color:transparent; font-weight:800; }
        .pj-hero-sub { font-size:.92rem; color:var(--ink-2); margin:4px 0 0; }

        .pj-hero-chips { display:flex; flex-wrap:wrap; gap:12px; }
        .pj-hchip {
            display:flex; align-items:center; gap:11px; background:rgba(255,255,255,.78);
            border:1px solid rgba(255,255,255,.9); border-radius:16px; padding:10px 15px;
            box-shadow:var(--sh-sm); backdrop-filter:blur(4px);
        }
        .pj-hchip-ico {
            width:38px; height:38px; flex-shrink:0; border-radius:11px; display:flex;
            align-items:center; justify-content:center; font-size:1rem;
        }
        .pj-hchip-ico.rose { background:var(--rose-lt); color:var(--rose); }
        .pj-hchip-ico.violet { background:var(--violet-lt); color:var(--violet-d); }
        .pj-hchip-ico.sky { background:var(--sky-lt); color:var(--sky); }
        .pj-hchip-lbl { display:block; font-size:.66rem; font-weight:700; color:var(--ink-3); text-transform:uppercase; letter-spacing:.6px; }
        .pj-hchip-val { display:block; font-size:.94rem; font-weight:800; color:var(--ink); line-height:1.25; }

        @@media (max-width:860px) {
            .pj-hero { padding:20px 20px; }
            .pj-hero-bar { justify-content:flex-start; }
            .pj-hero-chips { width:100%; }
            .pj-hchip { flex:1; min-width:150px; }
        }

        /* ── Generic card / section ── */
        .pj-card { background:#fff; border:1px solid var(--line); border-radius:var(--r); padding:26px 28px; box-shadow:var(--sh-sm); }
        .pj-card-head { display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; margin-bottom:20px; }
        .pj-card-head h2 { font-size:1.18rem; font-weight:800; display:flex; align-items:center; gap:10px; }
        .pj-dot { width:11px; height:11px; border-radius:50%; }
        .pj-dot.rose{background:var(--rose);} .pj-dot.violet{background:var(--violet);}
        .pj-dot.mint{background:var(--mint);} .pj-dot.amber{background:var(--amber);} .pj-dot.sky{background:var(--sky);}
        .pj-card-sub { font-size:.82rem; font-weight:700; color:var(--ink-3); }
        .pj-link { font-size:.84rem; font-weight:700; color:var(--rose-d); text-decoration:none; display:inline-flex; align-items:center; gap:6px; }
        .pj-link:hover { gap:9px; color:var(--rose-d); }

        /* ── 2 · ROADMAP ── */
        .pj-road { position:relative; padding-left:6px; }
        .pj-road-item { position:relative; display:flex; gap:18px; padding:0 0 24px 0; }
        .pj-road-item:last-child { padding-bottom:0; }
        .pj-road-rail { position:relative; display:flex; flex-direction:column; align-items:center; flex-shrink:0; }
        .pj-road-bubble {
            width:54px; height:54px; border-radius:50%; display:flex; align-items:center; justify-content:center;
            font-size:1.45rem; background:#fff; border:3px solid var(--line); z-index:1;
            transition:transform .3s, border-color .3s, box-shadow .3s;
        }
        .pj-road-line { flex:1; width:3px; background:var(--line); margin:4px 0; border-radius:3px; min-height:18px; }
        .pj-road-item:last-child .pj-road-line { display:none; }
        .pj-road-body {
            flex:1; background:var(--cream); border:1px solid var(--line); border-radius:var(--r-sm);
            padding:15px 18px; transition:transform .25s, box-shadow .25s, background .25s; align-self:flex-start;
        }
        .pj-road-tags { display:flex; align-items:center; gap:8px; margin-bottom:5px; flex-wrap:wrap; }
        .pj-road-wk { font-size:.7rem; font-weight:800; color:var(--ink-3); text-transform:uppercase; letter-spacing:.6px; }
        .pj-road-state { font-size:.66rem; font-weight:800; padding:3px 9px; border-radius:20px; text-transform:uppercase; letter-spacing:.4px; }
        .pj-road-title { font-size:1rem; font-weight:800; color:var(--ink); }
        .pj-road-sub { font-size:.84rem; color:var(--ink-2); margin-top:2px; line-height:1.45; }

        /* done */
        .pj-road-item.done .pj-road-bubble { border-color:var(--mint); background:var(--mint-lt); }
        .pj-road-item.done .pj-road-line { background:linear-gradient(var(--mint),var(--line)); }
        .pj-road-item.done .pj-road-state { background:var(--mint-lt); color:#059669; }
        .pj-road-check { position:absolute; right:-3px; bottom:-3px; width:22px; height:22px; border-radius:50%;
            background:var(--mint); color:#fff; display:flex; align-items:center; justify-content:center; font-size:.66rem;
            border:2px solid #fff; }
        /* current */
        .pj-road-item.current .pj-road-bubble {
            border-color:var(--violet); transform:scale(1.08);
            box-shadow:0 0 0 6px rgba(34, 201, 219,.16), 0 10px 22px rgba(34, 201, 219,.4);
            animation:pjBeat 2.6s ease-in-out infinite;
        }
        .pj-road-item.current .pj-road-body { background:var(--violet-lt); border-color:rgba(34, 201, 219,.4); }
        .pj-road-item.current .pj-road-state { background:var(--violet); color:#fff; }
        .pj-road-item.current .pj-road-title { color:var(--violet-d); }
        /* upcoming */
        .pj-road-item.upcoming .pj-road-bubble { filter:grayscale(.55); opacity:.62; }
        .pj-road-item.upcoming .pj-road-state { background:#fff; color:var(--ink-3); border:1px solid var(--line); }
        .pj-road-item.upcoming .pj-road-title { color:var(--ink-2); }
        @@keyframes pjBeat { 0%,100%{transform:scale(1.08);} 50%{transform:scale(1.16);} }

        /* ── 3 · NEXT CARE STEP (ticket) ── */
        .pj-ticket {
            position:relative; overflow:hidden; border-radius:28px; box-shadow:var(--sh);
            background:linear-gradient(135deg,#fff 0%,#fff7fb 100%); border:1px solid var(--line);
            display:grid; grid-template-columns:230px 1fr;
        }
        .pj-ticket-stub {
            position:relative; padding:30px 26px; color:#fff;
            background:linear-gradient(150deg,#1baebe 0%,#22c9db 52%,#22c9db 100%);
            display:flex; flex-direction:column; justify-content:center; gap:6px; text-align:center;
        }
        .pj-ticket-stub::after {
            content:''; position:absolute; top:0; right:-1px; bottom:0; width:2px;
            background:repeating-linear-gradient(to bottom,#fff 0 7px,transparent 7px 16px); opacity:.55;
        }
        .pj-ticket-stub-lbl { font-size:.7rem; font-weight:800; text-transform:uppercase; letter-spacing:1.2px; opacity:.92; }
        .pj-ticket-day { font-size:3.4rem; font-weight:800; line-height:1; }
        .pj-ticket-mon { font-size:1.05rem; font-weight:700; letter-spacing:2px; text-transform:uppercase; }
        .pj-ticket-year { font-size:.82rem; opacity:.9; font-weight:600; }
        .pj-ticket-count { margin-top:12px; font-size:.78rem; font-weight:700; background:rgba(255,255,255,.22); padding:6px 12px; border-radius:20px; display:inline-block; }
        .pj-ticket-body { padding:28px 30px; display:flex; flex-direction:column; gap:16px; }
        .pj-ticket-reason { font-size:1.4rem; font-weight:800; letter-spacing:-.4px; }
        .pj-ticket-status { font-size:.7rem; font-weight:800; text-transform:uppercase; letter-spacing:.5px; padding:4px 11px; border-radius:20px; background:var(--mint-lt); color:#059669; margin-left:10px; vertical-align:middle; }
        .pj-ticket-status.modified { background:var(--amber-lt); color:#d97706; }
        .pj-ticket-meta { display:grid; grid-template-columns:1fr 1fr; gap:14px 18px; }
        .pj-ticket-meta-item { display:flex; gap:12px; align-items:flex-start; }
        .pj-ticket-meta-ico { width:38px; height:38px; flex-shrink:0; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:.95rem; background:var(--rose-lt); color:var(--rose); }
        .pj-ticket-meta-lbl { font-size:.7rem; font-weight:700; color:var(--ink-3); text-transform:uppercase; letter-spacing:.5px; }
        .pj-ticket-meta-val { font-size:.96rem; font-weight:700; color:var(--ink); line-height:1.3; }
        .pj-ticket-prep {
            display:flex; gap:12px; align-items:flex-start; background:var(--violet-lt);
            border-radius:var(--r-sm); padding:14px 16px;
        }
        .pj-ticket-prep i { color:var(--violet-d); font-size:1rem; margin-top:2px; }
        .pj-ticket-prep-t { font-size:.82rem; font-weight:800; color:var(--violet-d); }
        .pj-ticket-prep-d { font-size:.85rem; color:var(--ink-2); line-height:1.5; margin-top:2px; }
        .pj-ticket-extra { font-size:.85rem; color:var(--ink-2); line-height:1.5; }
        .pj-ticket-extra[hidden] { display:none; }
        .pj-ticket-actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:2px; }

        .pj-btn {
            display:inline-flex; align-items:center; justify-content:center; gap:8px; cursor:pointer;
            border:1px solid var(--line); background:#fff; color:var(--ink); text-decoration:none;
            padding:11px 18px; border-radius:26px; font-weight:700; font-size:.86rem; transition:.2s; font-family:inherit;
        }
        .pj-btn:hover { transform:translateY(-2px); box-shadow:var(--sh-sm); color:var(--ink); }
        .pj-btn-primary {
            border:0; color:#fff; background:linear-gradient(90deg,var(--rose),#22c9db);
            box-shadow:0 6px 16px rgba(27, 174, 190,.32);
        }
        .pj-btn-primary:hover { color:#fff; box-shadow:0 10px 22px rgba(27, 174, 190,.42); }
        .pj-btn-ghost { background:transparent; border:0; color:var(--ink-3); padding:11px 8px; }
        .pj-btn-ghost:hover { color:var(--rose-d); box-shadow:none; transform:none; }
        .pj-btn.danger:hover { color:var(--rose-d); border-color:var(--rose); }

        .pj-ticket-empty { padding:44px 30px; text-align:center; grid-column:1 / -1; }
        .pj-ticket-empty-emoji { font-size:3rem; }
        .pj-ticket-empty h3 { font-size:1.2rem; margin:10px 0 6px; }
        .pj-ticket-empty p { color:var(--ink-2); max-width:440px; margin:0 auto 18px; line-height:1.55; }
        @@media (max-width:720px) {
            .pj-ticket { grid-template-columns:1fr; }
            .pj-ticket-stub { flex-direction:row; justify-content:center; align-items:center; gap:14px; padding:20px; }
            .pj-ticket-stub::after { top:auto; bottom:-1px; left:0; right:0; width:auto; height:2px; background:repeating-linear-gradient(to right,#fff 0 7px,transparent 7px 16px); }
            .pj-ticket-day { font-size:2.6rem; }
            .pj-ticket-meta { grid-template-columns:1fr; }
        }

        /* ── 4 · CARE PLAN + 8 · PREP (checklists) ── */
        .pj-progress { display:flex; align-items:center; gap:12px; margin-bottom:18px; }
        .pj-progress-track { flex:1; height:9px; border-radius:20px; background:rgba(15, 23, 42,.09); overflow:hidden; }
        .pj-progress-fill { height:100%; border-radius:20px; background:linear-gradient(90deg,var(--rose),#22c9db); width:0; transition:width .5s cubic-bezier(.4,0,.2,1); }
        .pj-progress-count { font-size:.82rem; font-weight:800; color:var(--ink-2); white-space:nowrap; }
        .pj-checklist { display:flex; flex-direction:column; gap:10px; }
        .pj-check-row { display:flex; align-items:center; gap:4px; }
        .pj-check {
            flex:1; display:flex; align-items:center; gap:14px; cursor:pointer; text-align:left;
            border:1.5px solid var(--line); background:#fff; border-radius:16px; padding:13px 16px;
            font-family:inherit; transition:.2s; color:var(--ink);
        }
        .pj-check:hover { border-color:var(--rose); transform:translateY(-1px); }
        .pj-check-box {
            width:26px; height:26px; flex-shrink:0; border-radius:9px; border:2px solid var(--line);
            display:flex; align-items:center; justify-content:center; color:#fff; font-size:.72rem; transition:.2s; background:#fff;
        }
        .pj-check-ico { width:34px; height:34px; flex-shrink:0; border-radius:11px; display:flex; align-items:center; justify-content:center; background:var(--rose-lt); color:var(--rose); font-size:.9rem; }
        .pj-check-body { flex:1; min-width:0; }
        .pj-check-title { font-weight:700; font-size:.94rem; line-height:1.25; transition:.2s; }
        .pj-check-sub { font-size:.78rem; color:var(--ink-3); margin-top:1px; }
        .pj-check.pj-checked { background:var(--mint-lt); border-color:rgba(52,211,153,.5); }
        .pj-check.pj-checked .pj-check-box { background:var(--mint); border-color:var(--mint); }
        .pj-check.pj-checked .pj-check-title { text-decoration:line-through; color:var(--ink-3); }
        .pj-check-link { width:38px; height:38px; flex-shrink:0; border-radius:12px; display:flex; align-items:center; justify-content:center; color:var(--ink-3); text-decoration:none; transition:.2s; }
        .pj-check-link:hover { background:var(--rose-lt); color:var(--rose-d); }
        .pj-notes {
            width:100%; box-sizing:border-box; margin-top:10px; border:1.5px solid var(--line); border-radius:14px;
            padding:13px 15px; font-family:inherit; font-size:.9rem; color:var(--ink); background:var(--cream);
            resize:vertical; min-height:84px; transition:.18s;
        }
        .pj-notes:focus { outline:0; border-color:var(--violet); background:#fff; box-shadow:0 0 0 4px rgba(34, 201, 219,.12); }
        .pj-notes::placeholder { color:var(--ink-3); }

        /* ── 5 · CARE TEAM ── */
        .pj-team-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:18px; }
        .pj-team-card {
            position:relative; background:#fff; border:1px solid var(--line); border-radius:var(--r);
            padding:22px; box-shadow:var(--sh-sm); transition:transform .25s, box-shadow .25s; overflow:hidden;
        }
        .pj-team-card::before { content:''; position:absolute; top:0; left:0; right:0; height:64px; background:linear-gradient(120deg,#f0fdfe,#f0fdfe); }
        .pj-team-card:hover { transform:translateY(-4px); box-shadow:var(--sh); }
        .pj-team-top { position:relative; display:flex; flex-direction:column; align-items:center; text-align:center; gap:4px; }
        .pj-team-avatar { width:84px; height:84px; border-radius:50%; border:4px solid #fff; box-shadow:0 8px 20px rgba(15, 23, 42,.16); margin-top:18px; object-fit:cover; }
        .pj-team-name { font-size:1.05rem; font-weight:800; color:var(--ink); }
        .pj-team-name a { color:inherit; text-decoration:none; }
        .pj-team-spec { font-size:.82rem; font-weight:700; color:var(--rose-d); }
        .pj-team-clinic { font-size:.8rem; color:var(--ink-3); display:flex; align-items:center; gap:5px; justify-content:center; }
        .pj-team-primary { position:absolute; top:0; right:0; font-size:.66rem; font-weight:800; color:#fff; background:var(--violet); padding:4px 11px; border-radius:0 0 0 14px; text-transform:uppercase; letter-spacing:.4px; z-index:2; }
        .pj-team-actions { display:flex; gap:9px; margin-top:18px; }
        .pj-team-actions .pj-btn { flex:1; padding:10px; font-size:.84rem; }
        .pj-team-setprimary { width:100%; margin-top:9px; background:transparent; border:0; color:var(--ink-3); font-size:.78rem; font-weight:700; cursor:pointer; padding:6px; font-family:inherit; transition:.2s; }
        .pj-team-setprimary:hover { color:var(--violet-d); }

        /* ── 6 · RECOMMENDATIONS ── */
        .pj-recs { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; }
        .pj-rec {
            background:#fff; border:1px solid var(--line); border-radius:var(--r); padding:22px;
            box-shadow:var(--sh-sm); transition:transform .25s, box-shadow .25s; display:flex; flex-direction:column; gap:8px;
            border-top:4px solid var(--rose);
        }
        .pj-rec:hover { transform:translateY(-4px); box-shadow:var(--sh); }
        .pj-rec:nth-child(2) { border-top-color:var(--violet); }
        .pj-rec:nth-child(3) { border-top-color:var(--mint); }
        .pj-rec-emoji { font-size:2rem; }
        .pj-rec-title { font-size:1.02rem; font-weight:800; }
        .pj-rec-desc { font-size:.85rem; color:var(--ink-2); line-height:1.5; flex:1; }
        .pj-rec-link { font-size:.84rem; font-weight:800; color:var(--rose-d); text-decoration:none; display:inline-flex; align-items:center; gap:6px; margin-top:4px; }
        .pj-rec-link:hover { gap:9px; }

        /* ── 7 · VISIT MEMORIES ── */
        .pj-mem { position:relative; padding-left:8px; }
        .pj-mem-item { position:relative; padding:0 0 18px 32px; }
        .pj-mem-item:last-child { padding-bottom:0; }
        .pj-mem-item::before { content:''; position:absolute; left:11px; top:24px; bottom:-2px; width:2px; background:var(--line); }
        .pj-mem-item:last-child::before { display:none; }
        .pj-mem-marker {
            position:absolute; left:0; top:6px; width:24px; height:24px; border-radius:50%;
            display:flex; align-items:center; justify-content:center; color:#fff; font-size:.6rem;
            border:3px solid #fff; z-index:1;
        }
        .pj-mem-item.completed .pj-mem-marker { background:var(--mint); box-shadow:0 0 0 4px var(--mint-lt); }
        .pj-mem-item.missed    .pj-mem-marker { background:var(--amber); box-shadow:0 0 0 4px var(--amber-lt); }
        .pj-mem-item.cancelled .pj-mem-marker { background:var(--rose); box-shadow:0 0 0 4px var(--rose-lt); }
        .pj-mem-card { background:var(--cream); border:1px solid var(--line); border-radius:var(--r-sm); padding:14px 18px; }
        .pj-mem-top { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:5px; }
        .pj-mem-date { font-size:.74rem; font-weight:800; color:var(--ink-3); text-transform:uppercase; letter-spacing:.5px; }
        .pj-mem-status {
            flex-shrink:0; font-size:.62rem; font-weight:800; text-transform:uppercase; letter-spacing:.4px;
            padding:3px 10px; border-radius:20px; display:inline-flex; align-items:center; gap:5px;
        }
        .pj-mem-item.completed .pj-mem-status { background:var(--mint-lt); color:#059669; }
        .pj-mem-item.missed    .pj-mem-status { background:var(--amber-lt); color:#d97706; }
        .pj-mem-item.cancelled .pj-mem-status { background:var(--rose-lt); color:var(--rose-d); }
        .pj-mem-title { font-size:1rem; font-weight:800; margin:0 0 4px; }
        .pj-mem-note { font-size:.86rem; color:var(--ink-2); line-height:1.5; }
        .pj-mem-doc { font-size:.78rem; color:var(--ink-3); margin-top:8px; padding-top:8px; border-top:1px dashed var(--line); display:flex; gap:14px; flex-wrap:wrap; }
        .pj-mem-doc i { margin-right:4px; }

        .pj-empty { text-align:center; padding:34px 20px; color:var(--ink-3); }
        .pj-empty span { font-size:2.2rem; display:block; margin-bottom:8px; }
        .pj-empty p { margin:0; font-size:.9rem; line-height:1.55; }

        /* Visit memories — show all */
        .pj-mem-more { display:flex; justify-content:center; margin-top:18px; }

        /* Memories modal */
        .pj-modal.pj-modal-lg { width:min(640px,100%); display:flex; flex-direction:column; max-height:88vh; }
        .pj-modal-head .pj-modal-sub { font-size:.78rem; font-weight:700; color:var(--ink-3); margin-top:2px; }
        .pj-modal-head .pj-modal-title-wrap { min-width:0; }
        .pj-modal-scroll {
            padding:20px 24px 24px; overflow-y:auto; scrollbar-width:thin; scrollbar-color:#e7dce7 transparent;
            background:linear-gradient(180deg,#fff 0%, var(--cream) 100%);
        }
        .pj-modal-scroll::-webkit-scrollbar { width:6px; }
        .pj-modal-scroll::-webkit-scrollbar-thumb { background:#e7dce7; border-radius:6px; }

        /* Modal restyles the timeline into separated, color-tinted cards */
        .pj-modal-scroll .pj-mem { padding-left:0; display:flex; flex-direction:column; gap:14px; }
        .pj-modal-scroll .pj-mem-item { padding:0; }
        .pj-modal-scroll .pj-mem-item::before { display:none; }
        .pj-modal-scroll .pj-mem-marker {
            position:absolute; left:16px; top:16px; width:34px; height:34px; font-size:.85rem; border-width:0;
        }
        .pj-modal-scroll .pj-mem-card {
            position:relative; overflow:hidden; border:1px solid var(--line);
            border-radius:18px; padding:16px 20px 16px 64px; box-shadow:var(--sh-sm);
            transition:transform .2s, box-shadow .2s, border-color .2s;
        }
        .pj-modal-scroll .pj-mem-card::before {
            content:''; position:absolute; left:0; top:0; bottom:0; width:6px;
        }
        .pj-modal-scroll .pj-mem-item.completed .pj-mem-card { background:linear-gradient(120deg,#fff 60%, var(--mint-lt)); }
        .pj-modal-scroll .pj-mem-item.missed    .pj-mem-card { background:linear-gradient(120deg,#fff 60%, var(--amber-lt)); }
        .pj-modal-scroll .pj-mem-item.cancelled .pj-mem-card { background:linear-gradient(120deg,#fff 60%, var(--rose-lt)); }
        .pj-modal-scroll .pj-mem-item.completed .pj-mem-card::before { background:linear-gradient(180deg,var(--mint),#10b981); }
        .pj-modal-scroll .pj-mem-item.missed    .pj-mem-card::before { background:linear-gradient(180deg,var(--amber),#f59e0b); }
        .pj-modal-scroll .pj-mem-item.cancelled .pj-mem-card::before { background:linear-gradient(180deg,var(--rose),#138fa0); }
        .pj-modal-scroll .pj-mem-card:hover { transform:translateY(-2px); box-shadow:var(--sh); }
        .pj-modal-scroll .pj-mem-doc { border-top-color:rgba(15, 23, 42,.12); }

        /* ── Upcoming visits list ── */
        .pj-up { display:flex; flex-direction:column; gap:12px; }
        .pj-up-item {
            display:flex; align-items:center; gap:16px; background:var(--cream);
            border:1px solid var(--line); border-radius:var(--r-sm); padding:14px 18px;
            transition:transform .2s, box-shadow .2s;
        }
        .pj-up-item:hover { transform:translateY(-2px); box-shadow:var(--sh-sm); }
        .pj-up-date {
            flex-shrink:0; width:60px; text-align:center; border-radius:14px; padding:9px 0; color:#fff;
            background:linear-gradient(150deg,var(--rose),#22c9db); box-shadow:0 6px 14px rgba(34, 201, 219,.3);
        }
        .pj-up-date .d { display:block; font-size:1.5rem; font-weight:800; line-height:1; }
        .pj-up-date .m { display:block; font-size:.64rem; font-weight:800; text-transform:uppercase; letter-spacing:1px; margin-top:3px; }
        .pj-up-body { flex:1; min-width:0; }
        .pj-up-reason { font-size:.98rem; font-weight:800; color:var(--ink); }
        .pj-up-meta { font-size:.8rem; color:var(--ink-3); margin-top:4px; display:flex; gap:16px; flex-wrap:wrap; }
        .pj-up-meta i { margin-right:4px; }
        .pj-up-when { flex-shrink:0; text-align:right; }
        .pj-up-badge {
            display:inline-block; font-size:.72rem; font-weight:800; color:var(--violet-d);
            background:var(--violet-lt); padding:5px 12px; border-radius:20px;
        }
        @@media (max-width:560px) {
            .pj-up-item { flex-wrap:wrap; }
            .pj-up-when { width:100%; text-align:left; }
        }

        /* ── Reschedule modal ── */
        .pj-modal-overlay { position:fixed; inset:0; z-index:1300; background:rgba(63,53,80,.42); backdrop-filter:blur(3px);
            display:flex; align-items:center; justify-content:center; padding:20px; opacity:0; visibility:hidden; transition:.28s; }
        .pj-modal-overlay.open { opacity:1; visibility:visible; }
        .pj-modal { width:min(480px,100%); background:#fff; border-radius:24px; overflow:hidden; box-shadow:0 28px 60px rgba(63,53,80,.32);
            transform:scale(.96); transition:transform .28s cubic-bezier(.4,0,.2,1); }
        .pj-modal-overlay.open .pj-modal { transform:scale(1); }
        .pj-modal-head { display:flex; align-items:center; justify-content:space-between; padding:20px 24px;
            background:linear-gradient(135deg,#f0fdfe,#f0fdfe); border-bottom:1px solid var(--line); }
        .pj-modal-head h3 { font-size:1.1rem; font-weight:800; display:flex; align-items:center; gap:9px; }
        .pj-modal-close { border:0; background:#fff; width:34px; height:34px; border-radius:50%; cursor:pointer; color:var(--ink-3); transition:.2s; }
        .pj-modal-close:hover { background:var(--rose-lt); color:var(--rose-d); }
        .pj-modal-body { padding:22px 24px; }
        .pj-modal-current { display:flex; gap:10px; align-items:center; background:var(--cream); border:1px solid var(--line);
            border-radius:13px; padding:12px 14px; margin-bottom:16px; font-weight:600; color:var(--ink-2); }
        .pj-modal-current i { color:var(--violet-d); }
        .pj-modal-body label { display:block; font-size:.85rem; font-weight:700; color:var(--ink-2); margin-bottom:7px; }
        .pj-modal-body input, .pj-modal-body select {
            width:100%; box-sizing:border-box; border:1.5px solid var(--line); border-radius:13px; padding:12px 14px;
            font-size:.95rem; font-family:inherit; font-weight:600; color:var(--ink); background:var(--cream); transition:.18s;
        }
        .pj-modal-body input:focus, .pj-modal-body select:focus { outline:0; border-color:var(--rose); background:#fff; box-shadow:0 0 0 4px rgba(27, 174, 190,.12); }
        .pj-modal-field { margin-top:14px; }
        .pj-modal-hint { margin-top:8px; font-size:.82rem; color:var(--ink-3); min-height:18px; }
        .pj-modal-foot { display:flex; justify-content:space-between; gap:10px; padding:16px 24px; border-top:1px solid var(--line); background:var(--cream); }

        /* ── Toast ── */
        .pj-toast { position:fixed; bottom:24px; left:50%; transform:translateX(-50%); background:#fff; border-radius:30px;
            padding:12px 22px; display:flex; align-items:center; gap:10px; box-shadow:0 10px 30px rgba(63,53,80,.18);
            z-index:1400; font-size:.9rem; font-weight:600; color:var(--ink); animation:pjToast .3s ease; }
        .pj-toast i { font-size:1.1rem; }
        .pj-toast.success i { color:#059669; } .pj-toast.error i { color:#dc2626; } .pj-toast.info i { color:var(--sky); }
        @@keyframes pjToast { from{transform:translate(-50%,16px);opacity:0;} to{transform:translate(-50%,0);opacity:1;} }

        @@media (max-width:560px) {
            .pj-card { padding:20px; }
            .pj-hero-week { font-size:2.6rem; }
        }
    </style>
}

<div class="pj">

    <!-- ════════ 1 · JOURNEY HEADER ════════ -->
    <section class="pj-hero">
        <div class="pj-hero-botanical" aria-hidden="true">
            <svg class="pj-bot pj-bot-1" viewBox="0 0 100 140" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
                <path d="M50 138 C50 104 50 72 50 32"/>
                <path d="M50 112 C35 107 27 95 31 80 C47 84 54 98 50 112Z"/>
                <path d="M50 112 C65 107 73 95 69 80 C53 84 46 98 50 112Z"/>
                <path d="M50 88 C37 83 31 71 35 58 C49 62 54 76 50 88Z"/>
                <path d="M50 88 C63 83 69 71 65 58 C51 62 46 76 50 88Z"/>
                <path d="M50 66 C40 60 36 50 40 39 C50 43 54 55 50 66Z"/>
                <path d="M50 66 C60 60 64 50 60 39 C50 43 46 55 50 66Z"/>
            </svg>
            <svg class="pj-bot pj-bot-2" viewBox="0 0 100 140" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
                <path d="M50 138 C50 104 50 72 50 32"/>
                <path d="M50 112 C35 107 27 95 31 80 C47 84 54 98 50 112Z"/>
                <path d="M50 112 C65 107 73 95 69 80 C53 84 46 98 50 112Z"/>
                <path d="M50 88 C37 83 31 71 35 58 C49 62 54 76 50 88Z"/>
                <path d="M50 88 C63 83 69 71 65 58 C51 62 46 76 50 88Z"/>
            </svg>
        </div>

        <div class="pj-hero-bar">
            <div class="pj-hero-intro">
                <span class="pj-eyebrow"><i class="fas fa-calendar-heart"></i> Your Care Journey</span>
                <h1 class="pj-hero-title">@firstName's <b>Appointments</b></h1>
                <p class="pj-hero-sub">Keep every visit on track — here's what's coming up next.</p>
            </div>

            <div class="pj-hero-chips">
                @if (Model.HasActivePregnancy || week > 0)
                {
                    <div class="pj-hchip">
                        <span class="pj-hchip-ico violet">🤰</span>
                        <span>
                            <span class="pj-hchip-lbl">Pregnancy</span>
                            <span class="pj-hchip-val">Week @week · @Model.Trimester</span>
                        </span>
                    </div>
                }
                <div class="pj-hchip">
                    <span class="pj-hchip-ico rose"><i class="fas fa-user-md"></i></span>
                    <span>
                        <span class="pj-hchip-lbl">Primary Doctor</span>
                        <span class="pj-hchip-val">@(primaryDocName ?? "Not chosen yet")</span>
                    </span>
                </div>
                <div class="pj-hchip">
                    <span class="pj-hchip-ico sky"><i class="fas fa-calendar-check"></i></span>
                    <span>
                        <span class="pj-hchip-lbl">Next Visit</span>
                        <span class="pj-hchip-val">@(nextAppt != null ? (daysToNext == 0 ? "Today" : daysToNext == 1 ? "Tomorrow" : $"In {daysToNext} days") : "Not scheduled")</span>
                    </span>
                </div>
            </div>
        </div>
    </section>

    <!-- ════════ 3 · NEXT CARE STEP (spotlight ticket) ════════ -->
    <section>
        <div class="pj-section-head" style="margin-bottom:14px;">
            <span class="pj-eyebrow"><i class="fas fa-star"></i> Your Next Important Step</span>
            <h2 style="font-size:1.32rem;font-weight:800;margin-top:6px;">The visit to look forward to</h2>
        </div>

        <div class="pj-ticket">
            @if (nextAppt != null)
            {
                <div class="pj-ticket-stub">
                    <span class="pj-ticket-stub-lbl">Care Pass</span>
                    <span class="pj-ticket-day">@nextAppt.Date.Day</span>
                    <span class="pj-ticket-mon">@nextAppt.Date.ToString("MMM")</span>
                    <span class="pj-ticket-year">@nextAppt.Date.ToString("yyyy")</span>
                    <span class="pj-ticket-count">@(daysToNext == 0 ? "Today" : daysToNext == 1 ? "Tomorrow" : $"In {daysToNext} days")</span>
                </div>
                <div class="pj-ticket-body">
                    <div>
                        <span class="pj-ticket-reason">@nextReason</span>
                        <span class="pj-ticket-status @(string.Equals(nextStatus,"Modified",StringComparison.OrdinalIgnoreCase) ? "modified" : "")">@nextStatus</span>
                    </div>
                    <div class="pj-ticket-meta">
                        <div class="pj-ticket-meta-item">
                            <span class="pj-ticket-meta-ico"><i class="fas fa-user-md"></i></span>
                            <span>
                                <span class="pj-ticket-meta-lbl">With</span><br />
                                <span class="pj-ticket-meta-val">@nextDocName</span>
                            </span>
                        </div>
                        <div class="pj-ticket-meta-item">
                            <span class="pj-ticket-meta-ico"><i class="fas fa-clock"></i></span>
                            <span>
                                <span class="pj-ticket-meta-lbl">Time</span><br />
                                <span class="pj-ticket-meta-val">@DateTime.Today.Add(nextAppt.Time).ToString("h:mm tt")</span>
                            </span>
                        </div>
                        <div class="pj-ticket-meta-item">
                            <span class="pj-ticket-meta-ico"><i class="fas fa-calendar-day"></i></span>
                            <span>
                                <span class="pj-ticket-meta-lbl">Date</span><br />
                                <span class="pj-ticket-meta-val">@nextAppt.Date.ToString("dddd, MMM dd")</span>
                            </span>
                        </div>
                        <div class="pj-ticket-meta-item">
                            <span class="pj-ticket-meta-ico"><i class="fas fa-map-marker-alt"></i></span>
                            <span>
                                <span class="pj-ticket-meta-lbl">Location</span><br />
                                <span class="pj-ticket-meta-val">@clinicName</span>
                            </span>
                        </div>
                    </div>

                    <div class="pj-ticket-prep">
                        <i class="fas fa-clipboard-list"></i>
                        <span>
                            <span class="pj-ticket-prep-t">How to prepare</span>
                            <span class="pj-ticket-prep-d">@prepNote</span>
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(nextNotes))
                    {
                        <div class="pj-ticket-extra" id="pjTicketExtra" hidden>
                            <strong>Your note:</strong> @nextNotes
                        </div>
                    }

                    <div class="pj-ticket-actions">
                        @if (!string.IsNullOrWhiteSpace(nextNotes))
                        {
                            <button type="button" class="pj-btn" id="pjViewDetailsBtn"><i class="fas fa-circle-info"></i> View Details</button>
                        }
                        @if (nextCanReschedule)
                        {
                            <button type="button" class="pj-btn pj-btn-primary reschedule-btn"
                                    data-appointment-id="@nextAppt.AppointmentID"
                                    data-patient-id="@patientId"
                                    data-doctor-id="@nextAppt.DoctorID"
                                    data-clinic-id="@nextAppt.ClinicID"
                                    data-date="@nextAppt.Date.ToString("yyyy-MM-dd")"
                                    data-time="@DateTime.Today.Add(nextAppt.Time).ToString("hh:mm tt")">
                                <i class="fas fa-edit"></i> Reschedule
                            </button>
                        }
                        <a class="pj-btn" href="@mapsUrl" target="_blank" rel="noopener"><i class="fas fa-route"></i> Get Directions</a>
                        <a class="pj-btn" href="/Patient/Messages/@patientId"><i class="fas fa-comment-medical"></i> Contact Clinic</a>
                        @if (nextCanCancel)
                        {
                            <button type="button" class="pj-btn pj-btn-ghost danger cancel-btn"
                                    data-appointment-id="@nextAppt.AppointmentID"
                                    data-patient-id="@patientId">
                                <i class="fas fa-times"></i> Cancel visit
                            </button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="pj-ticket-empty">
                    <div class="pj-ticket-empty-emoji">🌸</div>
                    <h3>No visit scheduled yet</h3>
                    <p>Regular check-ups are the heartbeat of a healthy pregnancy. Let's find a time that works for you and your little one.</p>
                    <a class="pj-btn pj-btn-primary" href="@Url.Action("BookAppointment", "PatientAppointments", new { id = patientId })">
                        <i class="fas fa-plus-circle"></i> Book your next visit
                    </a>
                </div>
            }
        </div>
    </section>

    <!-- ════════ UPCOMING VISITS (beyond the next one) ════════ -->
    @if (Model.UpcomingAppointments.Count > 1)
    {
        <section class="pj-card">
            <div class="pj-card-head">
                <h2><span class="pj-dot sky"></span> More Upcoming Visits</h2>
                <span class="pj-card-sub">@(Model.UpcomingAppointments.Count - 1) more scheduled</span>
            </div>
            <div class="pj-up">
                @foreach (var ap in Model.UpcomingAppointments.Skip(1))
                {
                    var upDoc = ap.Doctor?.User != null ? $"Dr. {ap.Doctor.User.FirstName} {ap.Doctor.User.LastName}".Trim() : "Your doctor";
                    var upReason = ap.Booking?.Reason;
                    if (string.IsNullOrWhiteSpace(upReason)) upReason = "Prenatal Visit";
                    var upDaysLeft = Math.Max(0, (int)(ap.Date.Date - DateTime.Today).TotalDays);
                    <div class="pj-up-item">
                        <div class="pj-up-date">
                            <span class="d">@ap.Date.Day</span>
                            <span class="m">@ap.Date.ToString("MMM")</span>
                        </div>
                        <div class="pj-up-body">
                            <div class="pj-up-reason">@upReason</div>
                            <div class="pj-up-meta">
                                <span><i class="fas fa-user-md"></i> @upDoc</span>
                                <span><i class="fas fa-map-marker-alt"></i> @(ap.Clinic?.Name ?? "Clinic")</span>
                                <span><i class="fas fa-clock"></i> @DateTime.Today.Add(ap.Time).ToString("h:mm tt")</span>
                            </div>
                        </div>
                        <div class="pj-up-when">
                            <span class="pj-up-badge">@(upDaysLeft == 0 ? "Today" : upDaysLeft == 1 ? "Tomorrow" : $"In {upDaysLeft} days")</span>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- ════════ 5 · CARE TEAM ════════ -->
    <section>
        <div class="pj-card-head" style="margin-bottom:16px;">
            <h2 style="font-size:1.32rem;font-weight:800;display:flex;align-items:center;gap:10px;"><span class="pj-dot violet"></span> Your Care Team</h2>
            <a class="pj-link" href="@Url.Action("BookAppointment", "PatientAppointments", new { id = patientId })">Find a doctor <i class="fas fa-arrow-right"></i></a>
        </div>
        @if (Model.MyDoctors.Any())
        {
            <div class="pj-team-grid">
                @foreach (var pd in Model.MyDoctors)
                {
                    var doc = pd.Doctor;
                    if (doc == null) { continue; }
                    var docName = doc.User != null ? $"Dr. {doc.User.FirstName} {doc.User.LastName}".Trim() : "Doctor";
                    var docClinic = doc.ClinicDoctors?.FirstOrDefault()?.Clinic?.Name ?? "Clinic";
                    var profileUrl = Url.Action("Details", "PublicDoctor", new { doctorId = doc.DoctorID, patientId = patientId });
                    <div class="pj-team-card" data-doctor-id="@doc.DoctorID">
                        @if (pd.IsPrimary)
                        {
                            <span class="pj-team-primary"><i class="fas fa-star"></i> Primary</span>
                        }
                        <div class="pj-team-top">
                            <a href="@profileUrl">
                                <img class="pj-team-avatar" src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(docName)&background=fb7185&color=fff&size=120" alt="@docName" />
                            </a>
                            <div class="pj-team-name"><a href="@profileUrl">@docName</a></div>
                            <div class="pj-team-spec"><i class="fas fa-stethoscope"></i> @doc.Specialization</div>
                            <div class="pj-team-clinic"><i class="fas fa-map-marker-alt"></i> @docClinic</div>
                        </div>
                        <div class="pj-team-actions">
                            <a class="pj-btn" href="/Patient/Messages/@patientId"><i class="fas fa-comment"></i> Message</a>
                            <a class="pj-btn pj-btn-primary" href="@Url.Action("BookAppointment", "PatientAppointments", new { id = patientId, doctorId = doc.DoctorID })"><i class="fas fa-calendar-plus"></i> Book</a>
                        </div>
                        @if (!pd.IsPrimary)
                        {
                            <button type="button" class="pj-team-setprimary set-primary-btn" data-doctor-id="@doc.DoctorID" data-patient-id="@patientId">
                                <i class="fas fa-star"></i> Make primary doctor
                            </button>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="pj-card">
                <div class="pj-empty">
                    <span>👩‍⚕️</span>
                    <p>You haven't connected with a doctor yet. Choosing a doctor lets you book visits and receive personal care guidance.</p>
                    <a class="pj-btn pj-btn-primary" style="margin-top:14px;" href="@Url.Action("BookAppointment", "PatientAppointments", new { id = patientId })"><i class="fas fa-search"></i> Find your doctor</a>
                </div>
            </div>
        }
    </section>

    <!-- ════════ 2 · CARE ROADMAP ════════ -->
    <section class="pj-card">
        <div class="pj-card-head">
            <h2><span class="pj-dot rose"></span> Your Care Roadmap</h2>
            <span class="pj-card-sub">@(currentIdx + (week >= milestones[currentIdx].Week ? 1 : 0)) of @milestones.Length milestones reached</span>
        </div>
        <div class="pj-road">
            @for (int i = 0; i < milestones.Length; i++)
            {
                var m = milestones[i];
                var state = i < currentIdx ? "done" : i == currentIdx ? "current" : "upcoming";
                var stateLabel = state == "done" ? "Completed" : state == "current" ? "Up next" : "Upcoming";
                <div class="pj-road-item @state">
                    <div class="pj-road-rail">
                        <div class="pj-road-bubble">
                            @m.Emoji
                            @if (state == "done")
                            {
                                <span class="pj-road-check"><i class="fas fa-check"></i></span>
                            }
                        </div>
                        <div class="pj-road-line"></div>
                    </div>
                    <div class="pj-road-body">
                        <div class="pj-road-tags">
                            <span class="pj-road-wk">Around week @m.Week</span>
                            <span class="pj-road-state">@stateLabel</span>
                        </div>
                        <div class="pj-road-title">@m.Title</div>
                        <div class="pj-road-sub">@m.Sub</div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- ════════ 4 · THIS WEEK'S CARE PLAN ════════ -->
    <section class="pj-card" data-progress-group>
        <div class="pj-card-head">
            <h2><span class="pj-dot mint"></span> This Week's Care Plan</h2>
            <span class="pj-card-sub">Week @week · prepare &amp; care for your next visit</span>
        </div>
        <div class="pj-progress">
            <div class="pj-progress-track"><div class="pj-progress-fill"></div></div>
            <span class="pj-progress-count">0/6</span>
        </div>
        <div class="pj-checklist">
            <div class="pj-check-row">
                <button type="button" class="pj-check" data-key="pj_care_@(patientId)_@(week)_readings">
                    <span class="pj-check-box"><i class="fas fa-check"></i></span>
                    <span class="pj-check-ico"><i class="fas fa-heart-pulse"></i></span>
                    <span class="pj-check-body">
                        <span class="pj-check-title">Update your health readings</span>
                        <span class="pj-check-sub">Log your blood pressure &amp; blood sugar</span>
                    </span>
                </button>
                <a class="pj-check-link" href="/Patient/Index/@patientId" title="Log readings"><i class="fas fa-arrow-right"></i></a>
            </div>

            <div class="pj-check-row">
                <button type="button" class="pj-check" data-key="pj_care_@(patientId)_@(week)_visit">
                    <span class="pj-check-box"><i class="fas fa-check"></i></span>
                    <span class="pj-check-ico"><i class="fas fa-calendar-check"></i></span>
                    <span class="pj-check-body">
                        <span class="pj-check-title">Attend your prenatal visit</span>
                        <span class="pj-check-sub">@(nextAppt != null ? $"On {nextAppt.Date:MMM dd}" : "Book one when you're ready")</span>
                    </span>
                </button>
            </div>

            <div class="pj-check-row">
                <button type="button" class="pj-check" data-key="pj_care_@(patientId)_@(week)_sym">
                    <span class="pj-check-box"><i class="fas fa-check"></i></span>
                    <span class="pj-check-ico"><i class="fas fa-notes-medical"></i></span>
                    <span class="pj-check-body">
                        <span class="pj-check-title">Note symptoms to discuss</span>
                        <span class="pj-check-sub">Anything new or unusual this week</span>
                    </span>
                </button>
            </div>

            <div class="pj-check-row">
                <button type="button" class="pj-check" data-key="pj_care_@(patientId)_@(week)_q">
                    <span class="pj-check-box"><i class="fas fa-check"></i></span>
                    <span class="pj-check-ico"><i class="fas fa-circle-question"></i></span>
                    <span class="pj-check-body">
                        <span class="pj-check-title">Prepare questions to ask</span>
                        <span class="pj-check-sub">Jot them below so you don't forget</span>
                    </span>
                </button>
            </div>
            <textarea class="pj-notes" data-key="pj_prep_notes_@(patientId)" placeholder="e.g. Is my weight gain on track? Which symptoms should I watch for?"></textarea>

            <div class="pj-check-row">
                <button type="button" class="pj-check" data-key="pj_care_@(patientId)_@(week)_rep">
                    <span class="pj-check-box"><i class="fas fa-check"></i></span>
                    <span class="pj-check-ico"><i class="fas fa-file-medical"></i></span>
                    <span class="pj-check-body">
                        <span class="pj-check-title">Upload recent reports</span>
                        <span class="pj-check-sub">Let your doctor see your latest results</span>
                    </span>
                </button>
                <a class="pj-check-link" href="/PatientTests/TestsUpload/@patientId" title="Upload reports"><i class="fas fa-arrow-right"></i></a>
            </div>

            <div class="pj-check-row">
                <button type="button" class="pj-check" data-key="pj_care_@(patientId)_@(week)_med">
                    <span class="pj-check-box"><i class="fas fa-check"></i></span>
                    <span class="pj-check-ico"><i class="fas fa-pills"></i></span>
                    <span class="pj-check-body">
                        <span class="pj-check-title">Review your medication notes</span>
                        <span class="pj-check-sub">Bring an up-to-date list</span>
                    </span>
                </button>
                <a class="pj-check-link" href="/PatientMedication/Index/@patientId" title="View medications"><i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
    </section>





    <!-- ════════ 7 · VISIT MEMORIES ════════ -->
    <section class="pj-card">
        <div class="pj-card-head">
            <h2><span class="pj-dot amber"></span> Visit Memories</h2>
            <span class="pj-card-sub">Moments from your journey so far</span>
        </div>
        @{
            var pastList = Model.PastAppointments.ToList();
        }
        @if (pastList.Any())
        {
            <div class="pj-mem">
                @foreach (var ap in pastList.Take(5))
                {
                    @RenderMemory(ap)
                }
            </div>
            @if (pastList.Count > 5)
            {
                <div class="pj-mem-more">
                    <button type="button" class="pj-btn" id="pjShowAllMem">
                        <i class="fas fa-clock-rotate-left"></i> Show all @pastList.Count visits
                    </button>
                </div>
            }
        }
        else
        {
            <div class="pj-empty">
                <span>📖</span>
                <p>Your visit memories will gather here. Each appointment becomes a gentle milestone in your story.</p>
            </div>
        }
    </section>

</div>

<!-- ════════ All visit memories modal ════════ -->
@if (Model.PastAppointments.Count > 5)
{
    <div class="pj-modal-overlay" id="memoriesModal" aria-hidden="true">
        <div class="pj-modal pj-modal-lg" role="dialog" aria-modal="true" aria-labelledby="memoriesModalTitle">
            <div class="pj-modal-head">
                <div class="pj-modal-title-wrap">
                    <h3 id="memoriesModalTitle"><i class="fas fa-clock-rotate-left"></i> All Visit Memories</h3>
                    <div class="pj-modal-sub">@Model.PastAppointments.Count visits across your journey</div>
                </div>
                <button class="pj-modal-close" id="closeMemoriesModalBtn" type="button" aria-label="Close"><i class="fas fa-times"></i></button>
            </div>
            <div class="pj-modal-scroll">
                <div class="pj-mem">
                    @foreach (var ap in Model.PastAppointments)
                    {
                        @RenderMemory(ap)
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- ════════ Reschedule modal ════════ -->
<div class="pj-modal-overlay" id="rescheduleModal" aria-hidden="true">
    <div class="pj-modal" role="dialog" aria-modal="true" aria-labelledby="rescheduleModalTitle">
        <div class="pj-modal-head">
            <h3 id="rescheduleModalTitle"><i class="fas fa-edit"></i> Change Appointment Time</h3>
            <button class="pj-modal-close" id="closeRescheduleModalBtn" type="button" aria-label="Close"><i class="fas fa-times"></i></button>
        </div>
        <div class="pj-modal-body">
            <div class="pj-modal-current">
                <i class="fas fa-clock"></i>
                <span id="rescheduleCurrentInfo">Current time:</span>
            </div>
            <div>
                <label for="rescheduleDate">Pick a new date</label>
                <input id="rescheduleDate" type="date" />
            </div>
            <div class="pj-modal-field">
                <label for="rescheduleSlot">Available times</label>
                <select id="rescheduleSlot"><option value="">Choose a time</option></select>
                <p id="rescheduleHint" class="pj-modal-hint">Pick a date to load available times.</p>
            </div>
        </div>
        <div class="pj-modal-foot">
            <button type="button" class="pj-btn" id="cancelRescheduleBtn">Cancel</button>
            <button type="button" class="pj-btn pj-btn-primary" id="confirmRescheduleBtn"><i class="fas fa-check"></i> Save</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const antiForgeryToken = document.querySelector('[name="__RequestVerificationToken"]')?.value ?? "";

            // ── Toast fallback ──
            window.showNotification = window.showNotification || function (message, type = "info") {
                document.querySelector(".pj-toast")?.remove();
                const icons = { success: "fa-check-circle", error: "fa-times-circle", info: "fa-info-circle" };
                const n = document.createElement("div");
                n.className = "pj-toast " + type;
                n.innerHTML = '<i class="fas ' + (icons[type] || icons.info) + '"></i><span>' + message + "</span>";
                document.body.appendChild(n);
                setTimeout(() => n.remove(), 3800);
            };

            // ── View details (expand note on ticket) ──
            const viewDetailsBtn = document.getElementById("pjViewDetailsBtn");
            const ticketExtra = document.getElementById("pjTicketExtra");
            viewDetailsBtn?.addEventListener("click", function () {
                if (!ticketExtra) return;
                const show = ticketExtra.hasAttribute("hidden");
                ticketExtra.toggleAttribute("hidden", !show);
                this.innerHTML = show
                    ? '<i class="fas fa-circle-info"></i> Hide Details'
                    : '<i class="fas fa-circle-info"></i> View Details';
            });

            // ── Show all visit memories (modal) ──
            const memoriesModal = document.getElementById("memoriesModal");
            const showAllMemBtn = document.getElementById("pjShowAllMem");
            const closeMemoriesBtn = document.getElementById("closeMemoriesModalBtn");
            function openMemories() {
                if (!memoriesModal) return;
                memoriesModal.classList.add("open");
                memoriesModal.setAttribute("aria-hidden", "false");
                document.body.style.overflow = "hidden";
            }
            function closeMemories() {
                if (!memoriesModal) return;
                memoriesModal.classList.remove("open");
                memoriesModal.setAttribute("aria-hidden", "true");
                document.body.style.overflow = "";
            }
            showAllMemBtn?.addEventListener("click", openMemories);
            closeMemoriesBtn?.addEventListener("click", closeMemories);
            memoriesModal?.addEventListener("click", function (e) { if (e.target === memoriesModal) closeMemories(); });
            document.addEventListener("keydown", function (e) { if (e.key === "Escape" && memoriesModal?.classList.contains("open")) closeMemories(); });

            // ── Interactive checklists (localStorage) ──
            function updateGroup(group) {
                if (!group) return;
                const checks = group.querySelectorAll(".pj-check");
                const done = group.querySelectorAll(".pj-check.pj-checked").length;
                const fill = group.querySelector(".pj-progress-fill");
                const count = group.querySelector(".pj-progress-count");
                if (fill) fill.style.width = checks.length ? (done / checks.length * 100) + "%" : "0%";
                if (count) count.textContent = done + "/" + checks.length;
            }

            document.querySelectorAll(".pj-check").forEach(function (btn) {
                const key = btn.dataset.key;
                if (key && localStorage.getItem(key) === "1") btn.classList.add("pj-checked");
                btn.addEventListener("click", function () {
                    const on = btn.classList.toggle("pj-checked");
                    if (key) {
                        if (on) localStorage.setItem(key, "1");
                        else localStorage.removeItem(key);
                    }
                    updateGroup(btn.closest("[data-progress-group]"));
                });
            });
            document.querySelectorAll("[data-progress-group]").forEach(updateGroup);

            // ── Prep notes autosave ──
            document.querySelectorAll(".pj-notes").forEach(function (area) {
                const key = area.dataset.key;
                if (key) {
                    area.value = localStorage.getItem(key) || "";
                    area.addEventListener("input", function () { localStorage.setItem(key, area.value); });
                }
            });

            // ── Reschedule modal ──
            const rescheduleModal = document.getElementById("rescheduleModal");
            const closeRescheduleModalBtn = document.getElementById("closeRescheduleModalBtn");
            const cancelRescheduleBtn = document.getElementById("cancelRescheduleBtn");
            const confirmRescheduleBtn = document.getElementById("confirmRescheduleBtn");
            const rescheduleDate = document.getElementById("rescheduleDate");
            const rescheduleSlot = document.getElementById("rescheduleSlot");
            const rescheduleCurrentInfo = document.getElementById("rescheduleCurrentInfo");
            const rescheduleHint = document.getElementById("rescheduleHint");

            let ctx = { patientId: null, currentAppointmentId: null, doctorId: null, clinicId: null };

            function openModal() {
                rescheduleModal.classList.add("open");
                rescheduleModal.setAttribute("aria-hidden", "false");
                document.body.style.overflow = "hidden";
            }
            function closeModal() {
                rescheduleModal.classList.remove("open");
                rescheduleModal.setAttribute("aria-hidden", "true");
                document.body.style.overflow = "";
                if (rescheduleSlot) rescheduleSlot.innerHTML = '<option value="">Choose a time</option>';
                if (rescheduleHint) rescheduleHint.textContent = "Pick a date to load available times.";
            }

            async function loadSlots() {
                if (!rescheduleDate.value || !ctx.patientId || !ctx.doctorId) return;
                rescheduleSlot.innerHTML = '<option value="">Loading...</option>';
                if (rescheduleHint) rescheduleHint.textContent = "Loading available times...";
                try {
                    let url = `/PatientAppointments/GetDoctorSlots?patientId=${ctx.patientId}&doctorId=${ctx.doctorId}&date=${rescheduleDate.value}`;
                    if (ctx.clinicId) url += `&clinicId=${ctx.clinicId}`;
                    const slots = await (await fetch(url)).json();
                    rescheduleSlot.innerHTML = '<option value="">Choose a time</option>';
                    if (!Array.isArray(slots) || slots.length === 0) {
                        if (rescheduleHint) rescheduleHint.textContent = "No available times on this date.";
                        return;
                    }
                    if (rescheduleHint) rescheduleHint.textContent = `${slots.length} available time slot(s).`;
                    slots.forEach(function (slot) {
                        const o = document.createElement("option");
                        o.value = String(slot.appointmentId);
                        o.textContent = slot.timeDisplay;
                        rescheduleSlot.appendChild(o);
                    });
                } catch {
                    rescheduleSlot.innerHTML = '<option value="">Choose a time</option>';
                    if (rescheduleHint) rescheduleHint.textContent = "Unable to load times. Please try another date.";
                }
            }

            async function dateHasAvailability(dateValue) {
                if (!dateValue || !ctx.patientId || !ctx.doctorId) return false;
                const sel = new Date(dateValue + "T00:00:00");
                try {
                    let url = `/PatientAppointments/GetAvailableDates?patientId=${ctx.patientId}&doctorId=${ctx.doctorId}&year=${sel.getFullYear()}&month=${sel.getMonth() + 1}`;
                    if (ctx.clinicId) url += `&clinicId=${ctx.clinicId}`;
                    const dates = await (await fetch(url)).json();
                    return Array.isArray(dates) && dates.includes(dateValue);
                } catch { return false; }
            }

            document.querySelectorAll(".reschedule-btn").forEach(function (btn) {
                btn.addEventListener("click", async function () {
                    ctx.patientId = parseInt(this.dataset.patientId);
                    ctx.currentAppointmentId = parseInt(this.dataset.appointmentId);
                    ctx.doctorId = parseInt(this.dataset.doctorId);
                    ctx.clinicId = parseInt(this.dataset.clinicId);
                    if (rescheduleCurrentInfo) rescheduleCurrentInfo.textContent = `Current: ${this.dataset.date} at ${this.dataset.time}`;
                    const today = new Date().toISOString().split("T")[0];
                    rescheduleDate.min = today;
                    rescheduleDate.value = this.dataset.date || today;
                    rescheduleSlot.innerHTML = '<option value="">Choose a time</option>';
                    openModal();
                    if (await dateHasAvailability(rescheduleDate.value)) await loadSlots();
                    else { if (rescheduleHint) rescheduleHint.textContent = "No available times on this date."; }
                });
            });

            rescheduleDate?.addEventListener("change", async function () {
                if (!rescheduleDate.value) return;
                if (await dateHasAvailability(rescheduleDate.value)) await loadSlots();
                else {
                    rescheduleSlot.innerHTML = '<option value="">Choose a time</option>';
                    if (rescheduleHint) rescheduleHint.textContent = "No available times on this date.";
                }
            });

            closeRescheduleModalBtn?.addEventListener("click", closeModal);
            cancelRescheduleBtn?.addEventListener("click", closeModal);
            rescheduleModal?.addEventListener("click", function (e) { if (e.target === rescheduleModal) closeModal(); });
            document.addEventListener("keydown", function (e) { if (e.key === "Escape" && rescheduleModal.classList.contains("open")) closeModal(); });

            confirmRescheduleBtn?.addEventListener("click", async function () {
                const newAppointmentId = parseInt(rescheduleSlot.value || "0");
                if (!newAppointmentId) { window.showNotification("Please select a new time.", "error"); return; }
                confirmRescheduleBtn.disabled = true;
                confirmRescheduleBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
                try {
                    const r = await fetch("/PatientAppointments/RescheduleAppointment", {
                        method: "POST",
                        headers: { "Content-Type": "application/x-www-form-urlencoded" },
                        body: new URLSearchParams({
                            __RequestVerificationToken: antiForgeryToken,
                            patientId: String(ctx.patientId),
                            currentAppointmentId: String(ctx.currentAppointmentId),
                            newAppointmentId: String(newAppointmentId),
                        }),
                    });
                    const result = await r.json();
                    if (result.success) {
                        window.showNotification("Appointment rescheduled. 💗", "success");
                        closeModal();
                        setTimeout(() => window.location.reload(), 700);
                    } else {
                        window.showNotification(result.message || "Failed to reschedule.", "error");
                    }
                } catch {
                    window.showNotification("Error while rescheduling.", "error");
                } finally {
                    confirmRescheduleBtn.disabled = false;
                    confirmRescheduleBtn.innerHTML = '<i class="fas fa-check"></i> Save';
                }
            });

            // ── Cancel appointment ──
            document.querySelectorAll(".cancel-btn").forEach(function (btn) {
                btn.addEventListener("click", async function () {
                    if (!confirm("Are you sure you want to cancel this visit?")) return;
                    try {
                        const r = await fetch("/PatientAppointments/CancelAppointment", {
                            method: "POST",
                            headers: { "Content-Type": "application/x-www-form-urlencoded" },
                            body: new URLSearchParams({
                                __RequestVerificationToken: antiForgeryToken,
                                patientId: this.dataset.patientId,
                                appointmentId: this.dataset.appointmentId,
                            }),
                        });
                        const result = await r.json();
                        if (result.success) {
                            window.showNotification("Visit cancelled.", "success");
                            setTimeout(() => window.location.reload(), 700);
                        } else {
                            window.showNotification(result.message || "Failed to cancel.", "error");
                        }
                    } catch {
                        window.showNotification("Error cancelling visit.", "error");
                    }
                });
            });

            // ── Set primary doctor ──
            document.querySelectorAll(".set-primary-btn").forEach(function (btn) {
                btn.addEventListener("click", async function () {
                    try {
                        const r = await fetch("/PatientAppointments/SetPrimaryDoctor", {
                            method: "POST",
                            headers: { "Content-Type": "application/x-www-form-urlencoded" },
                            body: new URLSearchParams({
                                __RequestVerificationToken: antiForgeryToken,
                                patientId: this.dataset.patientId,
                                doctorId: this.dataset.doctorId,
                            }),
                        });
                        const result = await r.json();
                        if (result.success) {
                            window.showNotification("Primary doctor updated. 💜", "success");
                            setTimeout(() => window.location.reload(), 700);
                        } else {
                            window.showNotification(result.message || "Failed to set primary doctor.", "error");
                        }
                    } catch {
                        window.showNotification("Error updating primary doctor.", "error");
                    }
                });
            });
        });
    </script>
}
