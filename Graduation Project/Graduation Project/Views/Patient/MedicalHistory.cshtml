}

.mh-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    animation: fadeIn 0.2s ease;
}

.mh-modal {
    background: var(--mh-white);
    border-radius: var(--mh-radius-xl);
    max-width: 500px;
    width: 90%;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    animation: slideUp 0.3s ease;
}

.mh-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--mh-border);
}

.mh-modal-header h3 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--mh-text);
    margin: 0;
}

.mh-modal-close {
    width: 32px;
    height: 32px;
    background: var(--mh-bg);
    border: none;
    border-radius: 8px;
    color: var(--mh-text-light);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
}

.mh-modal-close:hover {
    background: var(--mh-danger-light);
    color: var(--mh-danger);
}

.mh-modal-body {
    padding: 2rem;
}

.mh-modal-desc {
    font-size: 0.95rem;
    color: var(--mh-text-light);
    margin: 0 0 1.5rem 0;
}

.mh-export-options {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.mh-export-option input {
    display: none;
}

.mh-export-option-content {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--mh-bg);
    border: 2px solid var(--mh-border);
    border-radius: var(--mh-radius);
    cursor: pointer;
    transition: all 0.2s ease;
}

.mh-export-option input:checked + .mh-export-option-content {
    background: var(--mh-primary-light);
    border-color: var(--mh-primary);
}

.mh-export-option-content i {
    font-size: 2rem;
    color: var(--mh-primary);
}

.mh-export-option-content strong {
    display: block;
    font-size: 1rem;
    color: var(--mh-text);
    margin-bottom: 0.25rem;
}

.mh-export-option-content span {
    display: block;
    font-size: 0.85rem;
    color: var(--mh-text-light);
}

.mh-modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 1.5rem 2rem;
    background: var(--mh-bg);
    border-top: 1px solid var(--mh-border);
}

.mh-modal-btn {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: var(--mh-radius);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
}

.mh-modal-btn-cancel {
    background: var(--mh-white);
    color: var(--mh-text);
    border: 1.5px solid var(--mh-border);
}

.mh-modal-btn-cancel:hover {
    background: var(--mh-bg);
}

.mh-modal-btn-export {
    background: linear-gradient(135deg, var(--mh-primary), var(--mh-primary-dark));
    color: var(--mh-white);
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.mh-modal-btn-export:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(27, 174, 190, 0.3);
}

.mh-modal-btn-export:disabled {
    opacity: 0.7;
    cursor: not-allowed;
}

.mh-notification {
    position: fixed;
    top: 2rem;
    right: 2rem;
    background: var(--mh-white);
    padding: 1rem 1.5rem;
    border-radius: var(--mh-radius);
    box-shadow: var(--mh-shadow-lg);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    z-index: 10000;
    animation: slideInRight 0.3s ease;
    max-width: 400px;
}

.mh-notification-success {
    border-left: 4px solid var(--mh-success);
}

.mh-notification-success i {
    color: var(--mh-success);
    font-size: 1.25rem;
}

.mh-notification span {
    flex: 1;
    font-size: 0.9rem;
    color: var(--mh-text);
    font-weight: 500;
}

.mh-notification-close {
    background: none;
    border: none;
    color: var(--mh-text-lighter);
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
}

.mh-notification-close:hover {
    color: var(--mh-text);
}

@@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@@keyframes slideInRight {
    from {
        opacity: 0;
        transform: translateX(100px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@@media (max-width: 1024px) {
    .mh-main-layout {
        grid-template-columns: 1fr;
    }

    .mh-sidebar {
        position: static;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        max-height: none;
        overflow: visible;
        padding-right: 0;
    }

    .mh-hero-content {
        flex-direction: column;
        align-items: flex-start;
    }

    .mh-hero-right {
        width: 100%;
        justify-content: flex-start;
    }
}

@@media (max-width: 768px) {
    .mh-hero {
        padding: 1.5rem;
    }

    .mh-hero-title {
        font-size: 1.5rem;
    }

    .mh-sidebar {
        grid-template-columns: 1fr;
    }

    .mh-timeline-items {
        padding-left: 1.5rem;
    }

    .mh-timeline-items::before {
        left: 7px;
    }

    .mh-timeline-dot {
        left: -1.5rem;
        width: 32px;
        height: 32px;
        font-size: 0.75rem;
    }

    .mh-card-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .mh-lab-details {
        grid-template-columns: 1fr;
    }

    .mh-vitals-value {
        font-size: 1.75rem;
    }

    .mh-action-btn span {
        display: none;
    }

    .mh-action-btn {
        padding: 0.75rem;
        width: 40px;
        height: 40px;
        justify-content: center;
    }
}

@@media (max-width: 480px) {
    .mh-container {
        padding: 0 0.5rem;
    }

    .mh-hero {
        padding: 1.25rem;
        border-radius: var(--mh-radius);
    }

    .mh-card-body {
        padding: 1rem;
    }

    .mh-card-footer {
        padding: 0.75rem 1rem;
        flex-direction: column;
        gap: 0.5rem;
        align-items: flex-start;
    }
}

@@media print {
    .mh-hero-right,
    .mh-sidebar,
    .mh-timeline-dot,
    .mh-lab-actions,
    .mh-action-btn {
        display: none !important;
    }

    .mh-main-layout {
        grid-template-columns: 1fr;
    }

    .mh-timeline-card {
        break-inside: avoid;
        page-break-inside: avoid;
    }

    .mh-timeline-items::before {
        display: none;
    }
}

/* ══ Lab Report Modal ══ */
:root { --mhrm-primary:#1BAEBE; --mhrm-border:#e2e8f0; --mhrm-muted:#64748b; --mhrm-text:#1e293b; --mhrm-light:#f8fafc; }

.mhrm-overlay {
    position:fixed; inset:0; z-index:9999;
    background:rgba(15,35,60,.65); backdrop-filter:blur(4px);
    display:flex; align-items:center; justify-content:center;
    padding:1rem; animation:mhrmFadeIn .2s ease;
}
@@keyframes mhrmFadeIn { from{opacity:0} to{opacity:1} }
@@keyframes mhrmSlideUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }

.mhrm-dialog {
    background:#fff; border-radius:20px; width:100%; max-width:860px; max-height:92vh;
    display:flex; flex-direction:column; box-shadow:0 24px 80px rgba(0,0,0,.22);
    overflow:hidden; animation:mhrmSlideUp .25s ease;
}
.mhrm-header {
    display:flex; align-items:center; justify-content:space-between; gap:.75rem; flex-wrap:wrap;
    padding:1.3rem 1.5rem; border-bottom:1.5px solid var(--mhrm-border);
    background:linear-gradient(135deg,#0f2942 0%,#1a4a6e 50%,#0d3d5c 100%); flex-shrink:0;
}
.mhrm-header-left { display:flex; align-items:center; gap:.75rem; }
.mhrm-header-left h3 { margin:0 0 .1rem; font-size:1rem; font-weight:800; color:#f1f5f9; }
.mhrm-header-left p  { margin:0; font-size:.78rem; color:#94a3b8; }
.mhrm-icon {
    width:40px; height:40px; border-radius:12px; flex-shrink:0;
    background:rgba(27,174,190,.25); color:#7de8f4;
    display:flex; align-items:center; justify-content:center; font-size:1.1rem;
}
.mhrm-close-btn {
    width:34px; height:34px; border-radius:50%; border:1.5px solid rgba(255,255,255,.25);
    background:rgba(255,255,255,.1); color:#e2e8f0; cursor:pointer;
    display:flex; align-items:center; justify-content:center; font-size:.85rem; transition:background .2s;
}
.mhrm-close-btn:hover { background:rgba(255,255,255,.22); }
.mhrm-body { overflow-y:auto; flex:1; scrollbar-width:thin; scrollbar-color:var(--mhrm-border) transparent; }
.mhrm-loading {
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:3.5rem 1.5rem; color:var(--mhrm-muted); gap:.85rem;
}
.mhrm-spinner { font-size:2.4rem; color:var(--mhrm-primary); animation:mhrmSpin 1.4s ease-in-out infinite; }
@@keyframes mhrmSpin { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.4;transform:scale(.8)} }
.mhrm-loading p { margin:0; font-size:.9rem; }
.mhrm-footer {
    padding:.9rem 1.5rem; border-top:1.5px solid var(--mhrm-border);
    background:#fafbfc; display:flex; align-items:center; justify-content:flex-end; flex-shrink:0;
}
.mhrm-btn {
    display:inline-flex; align-items:center; gap:.4rem; padding:.55rem 1.1rem;
    border-radius:10px; border:1.5px solid var(--mhrm-border); background:#fff;
    color:var(--mhrm-muted); font-size:.85rem; font-weight:600; cursor:pointer; transition:background .2s;
}
.mhrm-btn:hover { background:var(--mhrm-light); }

/* Verdict */
.mhrm-verdict-row { display:flex; align-items:center; gap:1rem; flex-wrap:wrap; padding:1rem 1.5rem; border-bottom:1px solid var(--mhrm-border); }
.mhrm-verdict-badge { display:inline-flex; align-items:center; gap:.45rem; padding:.45rem 1.05rem; border-radius:22px; font-size:.82rem; font-weight:800; white-space:nowrap; }
.mhrm-verdict-badge.safe    { background:#e8f5e9; color:#1b5e20; border:1.5px solid #a5d6a7; }
.mhrm-verdict-badge.warning { background:#fff3e0; color:#b84700; border:1.5px solid #ffcc80; }
.mhrm-verdict-badge.danger  { background:#ffebee; color:#b71c1c; border:1.5px solid #ef9a9a; }
.mhrm-verdict-summary { margin:0; font-size:.84rem; color:var(--mhrm-muted); }

/* Sections */
.mhrm-section { padding:1.1rem 1.5rem; border-bottom:1px solid var(--mhrm-border); }
.mhrm-section:last-of-type { border-bottom:none; }
.mhrm-section-h { display:flex; align-items:center; gap:.5rem; margin:0 0 .85rem; font-size:.9rem; font-weight:700; color:var(--mhrm-text); padding-left:.65rem; border-left:3px solid var(--mhrm-primary); }
.mhrm-section-h i { color:var(--mhrm-primary); flex-shrink:0; }
.mhrm-ai-section { }
.mhrm-ai-block { background:#fafbfc; border-radius:10px; border:1px solid var(--mhrm-border); overflow:hidden; }
.mhrm-ai-block-body { padding:.85rem 1.1rem; line-height:1.72; }
.mhrm-report-heading { margin:.7rem 0 .3rem; font-size:.88rem; font-weight:700; color:var(--mhrm-text); }
.mhrm-report-para { margin:.2rem 0; font-size:.85rem; color:#334155; }
.mhrm-report-bullet { margin:.2rem 0; font-size:.85rem; color:#334155; list-style:none; display:flex; align-items:baseline; gap:.4rem; }
.mhrm-report-bullet i { color:var(--mhrm-primary); font-size:.7rem; }

/* Insight cards */
.mhrm-insight-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:.8rem; }
.mhrm-insight-card { padding:.8rem 1rem; border-radius:12px; border:1.5px solid var(--mhrm-border); display:flex; flex-direction:column; }
.mhrm-insight-card.normal  { border-color:#a5d6a7; background:#f6fff8; }
.mhrm-insight-card.warning { border-color:#fde68a; background:#fffdf5; }
.mhrm-insight-card.high    { border-color:#ef9a9a; background:#fff8f8; }
.mhrm-insight-label { font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--mhrm-muted); margin-bottom:.28rem; }
.mhrm-insight-value { font-size:1rem; font-weight:800; line-height:1.25; margin-bottom:.2rem; display:flex; align-items:center; }
.mhrm-insight-unit { font-size:.68em; font-weight:600; margin-left:.18rem; }
.mhrm-insight-card.normal  .mhrm-insight-value { color:#1b5e20; }
.mhrm-insight-card.warning .mhrm-insight-value { color:#b84700; }
.mhrm-insight-card.high    .mhrm-insight-value { color:#b71c1c; }
.mhrm-insight-range { font-size:.7rem; color:var(--mhrm-muted); }
.mhrm-insight-detail { margin-top:.35rem; font-size:.74rem; color:#475569; line-height:1.45; }
.mhrm-insight-dot { display:inline-block; width:6px; height:6px; border-radius:50%; margin-right:.3rem; }
.mhrm-insight-card.normal  .mhrm-insight-dot { background:#4caf50; }
.mhrm-insight-card.warning .mhrm-insight-dot { background:#ff9800; }
.mhrm-insight-card.high    .mhrm-insight-dot { background:#f44336; }

/* Patient info strip */
.mhrm-pi-strip { display:flex; overflow-x:auto; gap:.5rem; padding:.2rem .1rem .5rem; scrollbar-width:none; }
.mhrm-pi-strip::-webkit-scrollbar { display:none; }
.mhrm-pi-chip { display:flex; flex-direction:column; flex-shrink:0; min-width:80px; padding:.6rem .9rem; border-radius:10px; background:var(--mhrm-light); border:1.5px solid var(--mhrm-border); }
.mhrm-pi-label { font-size:.63rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--mhrm-muted); margin-bottom:.2rem; white-space:nowrap; }
.mhrm-pi-value { font-size:.88rem; font-weight:700; color:var(--mhrm-text); white-space:nowrap; }

/* Confidence pill */
.mhrm-confidence-pill { display:inline-flex; align-items:center; gap:.3rem; padding:.22rem .7rem; border-radius:14px; background:rgba(27,174,190,.1); color:var(--mhrm-primary); font-size:.73rem; font-weight:700; border:1px solid rgba(27,174,190,.2); margin-left:.75rem; }
</style>
