@model Graduation_Project.ViewModels.MedicalHistoryViewModel
@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewData["Title"] = "Medical History";
    ViewData["PatientId"] = Model.Patient.PatientID;
    ViewData["ActivePage"] = "MedicalHistory";
    ViewData["HidePageHeader"] = true;
    var groups = Model.TimelineEntries
        .GroupBy(e => e.DateTime.Date)
        .OrderByDescending(g => g.Key)
        .ToList();

    // shared per-event maps (accent class + icon)
    string AccentClass(string? t) => t switch
    {
        "bp-reading" => "t-bp",
        "blood-sugar" => "t-bs",
        "lab-test" => "t-lab",
        "ultrasound" => "t-ultrasound",
        "appointment" => "t-appointment",
        "alert" => "t-alert",
        "doctor-note" => "t-doctor",
        "medication" => "t-medication",
        "medication-log" => "t-medication",
        _ => "t-default"
    };
    string AccentIcon(string? t) => t switch
    {
        "bp-reading" => "fas fa-heartbeat",
        "blood-sugar" => "fas fa-tint",
        "lab-test" => "fas fa-flask",
        "ultrasound" => "fas fa-baby",
        "appointment" => "fas fa-calendar-check",
        "alert" => "fas fa-exclamation-triangle",
        "doctor-note" => "fas fa-user-md",
        "medication" => "fas fa-pills",
        "medication-log" => "fas fa-pills",
        "pregnancy-started" => "fas fa-play-circle",
        "pregnancy-ended" => "fas fa-flag-checkered",
        _ => "fas fa-circle"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/patient-medical-history.css" asp-append-version="true" />
}

<div class="mh">

    <!-- ══════ PRINT-ONLY DOCUMENT HEADER ══════ -->
    <div class="mh-print-doc">
        <span class="mh-print-brand">NABD · نبض</span>
        <h1>Medical History</h1>
        <div class="mh-print-meta">
            Patient: <strong>@Model.UserName</strong> &nbsp;·&nbsp;
            Generated: @DateTime.Now.ToString("MMMM dd, yyyy 'at' h:mm tt")
        </div>
    </div>

    <!-- ══════ HERO ══════ -->
    <header class="mh-hero">
        <div class="mh-hero-aurora"></div>
        <div class="mh-hero-row">
            <div>
                <span class="mh-hero-eyebrow"><i class="fas fa-heartbeat"></i> Medical Records</span>
                <h1 class="mh-hero-title">Health Timeline</h1>
                <p class="mh-hero-subtitle">Your complete pregnancy journey and medical records, all in one place.</p>
            </div>
            <button class="mh-print-btn" id="printHistory" type="button">
                <i class="fas fa-print"></i>
                <span>Print / Save as PDF</span>
            </button>
        </div>
    </header>

    @if (Model.TimelineEntries.Any())
    {
        <!-- ══════ QUICK-FILTER CHIPS (functional stats) ══════ -->
        <div class="mh-chips" id="mhChips" role="group" aria-label="Filter by record type">
            <button type="button" class="mh-chip mh-chip-all" data-type="all" aria-pressed="true">
                <span class="mh-chip-ico"><i class="fas fa-layer-group"></i></span>
                <span class="mh-chip-text">
                    <span class="mh-chip-count">@Model.TimelineEntries.Count</span>
                    <span class="mh-chip-label">All Records</span>
                </span>
            </button>
            <button type="button" class="mh-chip t-lab" data-type="lab-test" aria-pressed="false">
                <span class="mh-chip-ico"><i class="fas fa-flask"></i></span>
                <span class="mh-chip-text">
                    <span class="mh-chip-count">@Model.LabTestCount</span>
                    <span class="mh-chip-label">Lab Tests</span>
                </span>
            </button>
            <button type="button" class="mh-chip t-ultrasound" data-type="ultrasound" aria-pressed="false">
                <span class="mh-chip-ico"><i class="fas fa-baby"></i></span>
                <span class="mh-chip-text">
                    <span class="mh-chip-count">@Model.UltrasoundCount</span>
                    <span class="mh-chip-label">Ultrasounds</span>
                </span>
            </button>
            <button type="button" class="mh-chip t-appointment" data-type="appointment" aria-pressed="false">
                <span class="mh-chip-ico"><i class="fas fa-calendar-check"></i></span>
                <span class="mh-chip-text">
                    <span class="mh-chip-count">@Model.AppointmentCount</span>
                    <span class="mh-chip-label">Appointments</span>
                </span>
            </button>
            <button type="button" class="mh-chip t-bp" data-type="bp-reading" aria-pressed="false">
                <span class="mh-chip-ico"><i class="fas fa-heartbeat"></i></span>
                <span class="mh-chip-text">
                    <span class="mh-chip-count">@Model.BloodPressureCount</span>
                    <span class="mh-chip-label">Blood Pressure</span>
                </span>
            </button>
            <button type="button" class="mh-chip t-alert" data-type="alert" aria-pressed="false">
                <span class="mh-chip-ico"><i class="fas fa-bell"></i></span>
                <span class="mh-chip-text">
                    <span class="mh-chip-count">@Model.AlertCount</span>
                    <span class="mh-chip-label">Health Alerts</span>
                </span>
            </button>
        </div>

        <!-- ══════ FILTER BAR ══════ -->
        <div class="mh-filterbar">
            <div class="mh-search">
                <i class="fas fa-search"></i>
                <input type="text" id="historySearch" placeholder="Search records by keyword..." />
            </div>
            <select id="eventTypeFilter" class="mh-select" aria-label="Event type">
                <option value="all">All Events</option>
                <option value="lab-test">Lab Tests</option>
                <option value="ultrasound">Ultrasounds</option>
                <option value="appointment">Appointments</option>
                <option value="bp-reading">Blood Pressure</option>
                <option value="blood-sugar">Blood Sugar</option>
                <option value="alert">Alerts</option>
                <option value="doctor-note">Doctor Notes</option>
                <option value="medication">Medications</option>
                <option value="medication-log">Medication Logs</option>
                <option value="pregnancy-started">Pregnancy Started</option>
                <option value="pregnancy-ended">Pregnancy Updates</option>
            </select>
            <select id="statusFilter" class="mh-select" aria-label="Status">
                <option value="all">All Status</option>
                <option value="normal">Normal</option>
                <option value="attention">Needs Attention</option>
                <option value="critical">Critical</option>
            </select>
            <span class="mh-results" id="resultsCount"></span>
        </div>

        <!-- ══════ TIMELINE ══════ -->
        <div class="mh-timeline" id="timelineContainer">
            @foreach (var group in groups)
            {
                string dayLabel;
                if (group.Key == DateTime.Today) dayLabel = "Today";
                else if (group.Key == DateTime.Today.AddDays(-1)) dayLabel = "Yesterday";
                else dayLabel = group.Key.ToString("dddd");

                <section class="mh-group timeline-date-group">
                    <div class="mh-date">
                        <div class="mh-date-badge @(group.Key == DateTime.Today ? "today" : "")">
                            <span class="mh-date-day">@dayLabel</span>
                            <span class="mh-date-full">@group.Key.ToString("MMM dd, yyyy")</span>
                        </div>
                        <span class="mh-date-line"></span>
                    </div>

                    <div class="mh-items">
                        @foreach (var entry in group.OrderByDescending(e => e.DateTime))
                        {
                            string accent = AccentClass(entry.EventType);
                            string icon = AccentIcon(entry.EventType);
                            bool isCritical = entry.Status == "critical" || entry.Status == "attention";

                            <div class="mh-item timeline-item @accent"
                                 data-type="@entry.EventType"
                                 data-status="@entry.Status"
                                 data-text="@(entry.Title + " " + entry.SubTitle + " " + entry.DoctorName)">

                                <div class="mh-dot"><i class="@icon"></i></div>

                                <article class="mh-card @(isCritical ? "critical" : "")">
                                    <div class="mh-card-head">
                                        <div class="mh-card-head-l">
                                            <span class="mh-badge"><i class="@icon"></i> @(entry.EventType?.Replace("-", " ") ?? "Record")</span>
                                            <h4 class="mh-card-title">@entry.Title</h4>
                                        </div>
                                        <span class="mh-card-time"><i class="fas fa-clock"></i> @entry.DateTime.ToString("h:mm tt")</span>
                                    </div>

                                    <div class="mh-card-body">

                                        @* ── Blood Pressure ── *@
                                        @if (entry.BloodPressure != null)
                                        {
                                            string sc = entry.Status == "critical" ? "critical" : entry.Status == "attention" ? "warning" : "normal";
                                            string st = entry.Status == "critical" ? "Critical" : entry.Status == "attention" ? "Elevated" : "Normal";
                                            <div class="mh-vitals">
                                                <div class="mh-vitals-read">
                                                    <span class="mh-vitals-val">@entry.BloodPressure.BloodPressure</span>
                                                    <span class="mh-vitals-unit">mmHg</span>
                                                </div>
                                                <span class="mh-status @sc"><i class="fas fa-circle"></i> @st</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(entry.BloodPressure.MeasurementTime))
                                            {
                                                <p class="mh-card-meta"><i class="fas fa-clock"></i> Measured: @entry.BloodPressure.MeasurementTime</p>
                                            }
                                        }

                                        @* ── Blood Sugar ── *@
                                        @if (entry.BloodSugar != null)
                                        {
                                            string sc = entry.Status == "critical" ? "critical" : entry.Status == "attention" ? "warning" : "normal";
                                            string st = entry.Status == "critical" ? "Critical" : entry.Status == "attention" ? "High" : "Normal";
                                            <div class="mh-vitals">
                                                <div class="mh-vitals-read">
                                                    <span class="mh-vitals-val">@entry.BloodSugar.BloodSugar</span>
                                                    <span class="mh-vitals-unit">mg/dL</span>
                                                </div>
                                                <span class="mh-status @sc"><i class="fas fa-circle"></i> @st</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(entry.BloodSugar.MeasurementTime))
                                            {
                                                <p class="mh-card-meta"><i class="fas fa-utensils"></i> @entry.BloodSugar.MeasurementTime</p>
                                            }
                                        }

                                        @* ── Lab Test ── *@
                                        @if (entry.LabTest != null)
                                        {
                                            bool hasAI = !string.IsNullOrWhiteSpace(entry.LabTest.AI_AnalysisJSON);
                                            <div class="mh-lab">
                                                <div class="mh-lab-grid">
                                                    <div class="mh-lab-cell">
                                                        <i class="fas fa-vial"></i>
                                                        <div>
                                                            <span class="mh-lab-lbl">Test Type</span>
                                                            <span class="mh-lab-val">@entry.LabTest.TestType</span>
                                                        </div>
                                                    </div>
                                                    <div class="mh-lab-cell">
                                                        <i class="fas fa-calendar-alt"></i>
                                                        <div>
                                                            <span class="mh-lab-lbl">Date</span>
                                                            <span class="mh-lab-val">@entry.LabTest.UploadDate.ToString("MMM dd, yyyy")</span>
                                                        </div>
                                                    </div>
                                                    @if (hasAI)
                                                    {
                                                        <div class="mh-lab-cell">
                                                            <i class="fas fa-robot"></i>
                                                            <div>
                                                                <span class="mh-lab-lbl">Analysis</span>
                                                                <span class="mh-lab-val">AI Analyzed</span>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="mh-lab-actions">
                                                    <button class="mh-lab-btn mh-lab-btn-primary"
                                                            data-labid="@entry.LabTest.LabTestID"
                                                            data-testtype="@entry.LabTest.TestType"
                                                            data-uploaddate="@entry.LabTest.UploadDate.ToString("MMMM dd, yyyy")"
                                                            data-imagepath="@entry.LabTest.ImagePath"
                                                            data-hasai="@hasAI.ToString().ToLower()"
                                                            data-aijson="@(hasAI ? System.Net.WebUtility.HtmlEncode(entry.LabTest.AI_AnalysisJSON) : "")">
                                                        <i class="fas fa-file-medical-alt"></i> View Full Report
                                                    </button>
                                                    @if (!string.IsNullOrWhiteSpace(entry.LabTest.ImagePath))
                                                    {
                                                        <a href="/@entry.LabTest.ImagePath.TrimStart('/')" target="_blank" class="mh-lab-btn mh-lab-btn-secondary">
                                                            <i class="fas fa-image"></i> View Image
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        @* ── Ultrasound ── *@
                                        @if (entry.Ultrasound != null)
                                        {
                                            bool noAnomaly = string.IsNullOrWhiteSpace(entry.Ultrasound.DetectedAnomaly);
                                            <div class="mh-ai @(noAnomaly ? "success" : "warning")">
                                                <div class="mh-ai-head"><i class="fas fa-robot"></i> AI Analysis</div>
                                                <p class="mh-ai-text">@(noAnomaly ? "No anomalies detected. Fetal development appears normal." : entry.Ultrasound.DetectedAnomaly)</p>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(entry.Ultrasound.DoctorComments))
                                            {
                                                <div class="mh-doctor-comment">
                                                    <i class="fas fa-comment-medical"></i>
                                                    <div>
                                                        <strong>Doctor's Note</strong>
                                                        <p>@entry.Ultrasound.DoctorComments</p>
                                                    </div>
                                                </div>
                                            }
                                        }

                                        @* ── Appointment ── *@
                                        @if (entry.Appointment != null)
                                        {
                                            bool isPast = entry.Appointment.Date < DateTime.Now;
                                            var apptDt = entry.Appointment.Date.Date.Add(entry.Appointment.Time);
                                            <div class="mh-appt">
                                                <span class="mh-appt-status @(isPast ? "completed" : "upcoming")">
                                                    <i class="fas @(isPast ? "fa-check-circle" : "fa-clock")"></i> @(isPast ? "Completed" : "Upcoming")
                                                </span>
                                                <div class="mh-appt-details">
                                                    @if (!string.IsNullOrWhiteSpace(entry.DoctorName))
                                                    {
                                                        <div class="mh-appt-detail"><i class="fas fa-user-md"></i> <span>@entry.DoctorName</span></div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(entry.ClinicName))
                                                    {
                                                        <div class="mh-appt-detail"><i class="fas fa-hospital"></i> <span>@entry.ClinicName</span></div>
                                                    }
                                                    <div class="mh-appt-detail"><i class="fas fa-calendar"></i> <span>@apptDt.ToString("MMM dd, yyyy 'at' h:mm tt")</span></div>
                                                </div>
                                            </div>
                                        }

                                        @* ── Alert ── *@
                                        @if (entry.Alert != null)
                                        {
                                            string at = (entry.Alert.AlertType ?? "info").ToLower();
                                            string ac = at is "danger" or "critical" ? "danger" : at == "warning" ? "warning" : at == "success" ? "success" : "info";
                                            <div class="mh-alert @ac">
                                                <div class="mh-alert-head">
                                                    <span class="mh-alert-sev"><i class="fas fa-exclamation-triangle"></i> @entry.Alert.AlertType</span>
                                                    @if (!entry.Alert.IsRead)
                                                    {
                                                        <span class="mh-alert-unread"></span>
                                                    }
                                                </div>
                                                <p class="mh-alert-msg">@entry.Alert.Message</p>
                                                <div class="mh-alert-foot">
                                                    <i class="fas @(entry.Alert.IsRead ? "fa-envelope-open" : "fa-envelope")"></i> @(entry.Alert.IsRead ? "Read" : "Unread")
                                                </div>
                                            </div>
                                        }

                                        @* ── Doctor Note ── *@
                                        @if (entry.DoctorNote != null)
                                        {
                                            <div class="mh-note">
                                                <i class="fas fa-quote-left"></i>
                                                <p>@entry.DoctorNote.Content</p>
                                            </div>
                                        }

                                        @* ── Medication / Prescription ── *@
                                        @if (entry.Prescription != null)
                                        {
                                            <div class="mh-meds">
                                                @if (entry.Prescription.Items != null && entry.Prescription.Items.Any())
                                                {
                                                    @foreach (var item in entry.Prescription.Items)
                                                    {
                                                        <div class="mh-med">
                                                            <span class="mh-med-ico"><i class="fas fa-capsules"></i></span>
                                                            <div class="mh-med-info">
                                                                <strong>@item.MedicineName</strong>
                                                                <span>@item.Dosage · @item.Frequency</span>
                                                                @if (!string.IsNullOrWhiteSpace(item.Instructions))
                                                                {
                                                                    <em>@item.Instructions</em>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                                else if (!string.IsNullOrWhiteSpace(entry.Prescription.Notes))
                                                {
                                                    <p class="mh-card-meta">@entry.Prescription.Notes</p>
                                                }
                                            </div>
                                        }

                                    </div>

                                    <div class="mh-card-foot">
                                        @if (!string.IsNullOrWhiteSpace(entry.DoctorName) && entry.Appointment == null)
                                        {
                                            <span class="mh-foot-info"><i class="fas fa-user-md"></i> @entry.DoctorName</span>
                                        }
                                        else if (entry.BloodPressure != null || entry.BloodSugar != null)
                                        {
                                            <span class="mh-foot-info"><i class="fas fa-user"></i> Self-recorded</span>
                                        }
                                        else if (entry.Alert != null)
                                        {
                                            <span class="mh-foot-info"><i class="fas fa-robot"></i> System Alert</span>
                                        }
                                        else
                                        {
                                            <span></span>
                                        }
                                        <span class="mh-foot-date">@entry.DateTime.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    }
    else
    {
        <div class="mh-empty">
            <div class="mh-empty-ico"><i class="fas fa-clipboard-list"></i></div>
            <h3 class="mh-empty-title">No Medical Records Yet</h3>
            <p class="mh-empty-text">Your health records and timeline will appear here as you add data.</p>
            <a href="/PatientDashboard/Dashboard/@Model.Patient.PatientID" class="mh-empty-btn">
                <i class="fas fa-plus"></i> Go to Dashboard
            </a>
        </div>
    }

</div>

<!-- ══════════════ LAB REPORT MODAL ══════════════ -->
<div id="mhReportModal" class="mhrm-overlay" role="dialog" aria-modal="true" aria-labelledby="mhModalTitle" style="display:none">
    <div class="mhrm-dialog">
        <div class="mhrm-header">
            <div class="mhrm-header-left">
                <div class="mhrm-icon"><i class="fas fa-file-medical-alt"></i></div>
                <div>
                    <h3 id="mhModalTitle">Test Report</h3>
                    <p id="mhModalSubtitle">Loading…</p>
                </div>
            </div>
            <button class="mhrm-close-btn" id="mhModalClose" type="button" aria-label="Close"><i class="fas fa-times"></i></button>
        </div>
        <div class="mhrm-body">
            <div id="mhModalLoading" class="mhrm-loading">
                <div class="mhrm-spinner"><i class="fas fa-brain"></i></div>
                <p>Fetching report…</p>
            </div>
            <div id="mhModalContent" style="display:none">
                <div id="mhModalVerdictRow" class="mhrm-verdict-row"></div>
                <div id="mhModalReportContent"></div>
            </div>
            <div id="mhModalError" style="display:none;text-align:center;padding:3rem 1.5rem;color:#9a93a8">
                <i class="fas fa-exclamation-circle" style="font-size:2rem;display:block;margin-bottom:.75rem;color:#fb7185"></i>
                <p id="mhModalErrorMsg">Could not load the report.</p>
            </div>
        </div>
        <div class="mhrm-footer">
            <button class="mhrm-btn" id="mhModalCloseFooter" type="button"><i class="fas fa-times"></i> Close</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const searchInput = document.getElementById("historySearch");
    const eventTypeFilter = document.getElementById("eventTypeFilter");
    const statusFilter = document.getElementById("statusFilter");
    const printBtn = document.getElementById("printHistory");
    const resultsCount = document.getElementById("resultsCount");
    const chips = Array.from(document.querySelectorAll("#mhChips .mh-chip"));

    function getItems() { return document.querySelectorAll(".timeline-item"); }

    function syncChips() {
        const type = eventTypeFilter ? eventTypeFilter.value : "all";
        chips.forEach(c => c.setAttribute("aria-pressed", c.dataset.type === type ? "true" : "false"));
    }

    function filterTimeline() {
        const search = (searchInput?.value ?? "").toLowerCase();
        const eventType = eventTypeFilter?.value ?? "all";
        const status = statusFilter?.value ?? "all";
        let visible = 0;

        getItems().forEach(item => {
            const t = (item.dataset.type ?? "").toLowerCase();
            const s = (item.dataset.status ?? "").toLowerCase();
            const tx = (item.dataset.text ?? "").toLowerCase();

            const show = (!search || tx.includes(search))
                      && (eventType === "all" || t === eventType)
                      && (status === "all" || s === status);

            item.style.display = show ? "" : "none";
            if (show) visible++;
        });

        document.querySelectorAll(".timeline-date-group").forEach(g => {
            const hasVisible = Array.from(g.querySelectorAll(".timeline-item")).some(i => i.style.display !== "none");
            g.style.display = hasVisible ? "" : "none";
        });

        if (resultsCount) {
            resultsCount.innerHTML = `<i class="fas fa-check-circle"></i> ${visible} record${visible !== 1 ? 's' : ''} found`;
        }
        syncChips();
    }

    function debounce(fn, ms) {
        let t;
        return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); };
    }

    searchInput?.addEventListener("input", debounce(filterTimeline, 250));
    eventTypeFilter?.addEventListener("change", filterTimeline);
    statusFilter?.addEventListener("change", filterTimeline);

    chips.forEach(chip => chip.addEventListener("click", () => {
        if (eventTypeFilter) eventTypeFilter.value = chip.dataset.type;
        filterTimeline();
    }));

    printBtn?.addEventListener("click", () => window.print());

    filterTimeline();

    // ── Lab Report Modal ──
    const mhModal            = document.getElementById('mhReportModal');
    const mhModalClose       = document.getElementById('mhModalClose');
    const mhModalCloseFooter = document.getElementById('mhModalCloseFooter');
    const mhModalTitle       = document.getElementById('mhModalTitle');
    const mhModalSubtitle    = document.getElementById('mhModalSubtitle');
    const mhModalLoading     = document.getElementById('mhModalLoading');
    const mhModalContent     = document.getElementById('mhModalContent');
    const mhModalError       = document.getElementById('mhModalError');
    const mhModalErrorMsg    = document.getElementById('mhModalErrorMsg');
    const mhModalVerdictRow    = document.getElementById('mhModalVerdictRow');
    const mhModalReportContent = document.getElementById('mhModalReportContent');

    function mhOpenModal()  { mhModal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
    function mhCloseModal() { mhModal.style.display = 'none'; document.body.style.overflow = ''; }

    mhModalClose?.addEventListener('click', mhCloseModal);
    mhModalCloseFooter?.addEventListener('click', mhCloseModal);
    mhModal?.addEventListener('click', e => { if (e.target === mhModal) mhCloseModal(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && mhModal?.style.display === 'flex') mhCloseModal(); });

    function mhShowLoading() { mhModalLoading.style.display='flex'; mhModalContent.style.display='none'; mhModalError.style.display='none'; }
    function mhShowContent() { mhModalLoading.style.display='none'; mhModalContent.style.display='block'; mhModalError.style.display='none'; }
    function mhShowError(msg) { mhModalLoading.style.display='none'; mhModalContent.style.display='none'; mhModalError.style.display='block'; mhModalErrorMsg.textContent=msg||'Could not load the report.'; }

    function mhEsc(s) { return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    function mhFormatText(text) {
        if (!text) return '';
        return text.split('\n').map(line => {
            line = line.trim();
            if (!line) return '';
            if (line.startsWith('*')) return '<li class="mhrm-report-bullet"><i class="fas fa-angle-right"></i>' + mhEsc(line.replace(/^\*\s*/, '')) + '</li>';
            if (line.endsWith(':') && line.length < 120) return '<h6 class="mhrm-report-heading">' + mhEsc(line) + '</h6>';
            return '<p class="mhrm-report-para">' + mhEsc(line) + '</p>';
        }).join('');
    }

    function mhIsMetaKey(k) { return ['test_name','confidence'].includes(String(k||'').toLowerCase()); }
    function mhToLabel(k) { return String(k||'').replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase()); }

    function mhDiagStatus(val) { return Array.isArray(val) ? String(val[0]??'') : String(val??''); }
    function mhDiagDetail(val) {
        if (!Array.isArray(val)) return '';
        if (val.length===1 && Array.isArray(val[0])) return val[0].join(', ');
        return val.slice(1).flat().filter(Boolean).join(' ');
    }
    function mhDiagClass(status) {
        const s = String(status||'').toLowerCase();
        if (!s || s==='normal') return 'normal';
        if (s.includes('trace')||s.includes('elevated')||s.includes('mild')||s.includes('moderate')||s.includes('borderline')||s.includes('low specific')) return 'warning';
        if (s.includes('low')||s.includes('below')||s.includes('deficiency')||s.includes('anemia')||s.includes('acidic')||s.includes('alkaline')) return 'warning';
        return 'high';
    }
    function mhExtractRange(d) { if (!d) return ''; const m=d.match(/normal\s+range\s+([^\n]+?)(?:\s*$)/i); return m?m[1].trim():''; }
    function mhExtractMeasured(d) { if (!d) return ''; const m=d.match(/^The value\s+(.+?)\s+(?:is\s+)?(?:within|not in)/i); return m?m[1].trim():''; }

    function mhHasDiag(test) { return Object.keys(test||{}).some(k=>!mhIsMetaKey(k)&&Array.isArray(test[k])); }

    function mhDiagCards(test) {
        const diagList=[];
        const fieldKeys = Object.keys(test||{}).filter(k=>{
            if (mhIsMetaKey(k)) return false;
            if (k.toLowerCase()==='other_diagnoses') { const v=test[k]; (Array.isArray(v)?v:[v]).forEach(d=>{if(d)diagList.push(String(d));}); return false; }
            return true;
        });
        let cards = fieldKeys.map(k=>{
            const v=test[k]; const status=mhDiagStatus(v); const detail=mhDiagDetail(v);
            const cls=mhDiagClass(status); const nr=mhExtractRange(detail); const mv=mhExtractMeasured(detail);
            return '<div class="mhrm-insight-card '+cls+'">'
                +'<div class="mhrm-insight-label">'+mhEsc(mhToLabel(k))+'</div>'
                +'<div class="mhrm-insight-value"><span class="mhrm-insight-dot"></span>'+mhEsc(status||'Normal')
                +(mv?'<span class="mhrm-insight-unit">'+mhEsc(mv)+'</span>':'')
                +'</div>'+(nr?'<div class="mhrm-insight-range">Normal: '+mhEsc(nr)+'</div>':(detail?'<div class="mhrm-insight-detail">'+mhEsc(detail)+'</div>':''))
                +'</div>';
        }).join('');
        if (diagList.length) {
            cards += '<div class="mhrm-insight-card high" style="grid-column:1/-1;flex-direction:row;align-items:flex-start;gap:.7rem">'
                +'<div style="flex-shrink:0;margin-top:.1rem"><i class="fas fa-exclamation-triangle" style="color:#e11d48"></i></div>'
                +'<div><div class="mhrm-insight-label">Additional Diagnoses</div>'
                +diagList.map(d=>'<div class="mhrm-insight-value"><span class="mhrm-insight-dot"></span>'+mhEsc(d)+'</div>').join('')
                +'</div></div>';
        }
        return cards;
    }

    const mhTestConfigs = {
        'cbc (complete blood count)': [
            {key:'hb',name:'Hemoglobin',unit:'g/dL'},{key:'wbc',name:'WBC',unit:'/µL'},{key:'rbcs_count',name:'RBC',unit:'million/µL'},
            {key:'mcv',name:'MCV',unit:'fL'},{key:'mch',name:'MCH',unit:'pg'},{key:'rdw',name:'RDW',unit:'%'},
            {key:'mchc',name:'MCHC',unit:'g/dL'},{key:'lymphocytes',name:'Lymphocytes',unit:'%'},{key:'platelet_count',name:'Platelets',unit:'/µL'}
        ],
        'urinalysis': [
            {key:'color',name:'Color',unit:''},{key:'ph',name:'pH',unit:''},{key:'specific_gravity',name:'Specific Gravity',unit:''},
            {key:'protein',name:'Protein',unit:''},{key:'glucose',name:'Glucose',unit:''},{key:'ketones',name:'Ketones',unit:''},
            {key:'blood',name:'Blood',unit:''},{key:'rbcs',name:'RBCs',unit:'/HPF'},{key:'leukocytes',name:'Leukocytes',unit:'/HPF'},{key:'nitrite',name:'Nitrite',unit:''}
        ],
        'tsh (thyroid)': [{key:'tsh',name:'TSH',unit:'mIU/L'}],
        'ferritin': [{key:'ferritin_value',name:'Ferritin',unit:'ng/mL'}],
        'fasting blood glucose': [{key:'fbg',name:'FBG',unit:'mg/dL'}],
        'hba1c (sugar test)': [{key:'hba1c',name:'HbA1c',unit:'%'}],
        'hcv (hepatitis c)': [{key:'hcv',name:'HCV',unit:''}],
        'hbsag (hepatitis b)': [{key:'hbsag',name:'HBsAg',unit:''}],
        'blood group': [{key:'abo_group',name:'ABO Group',unit:''},{key:'rh_factor',name:'Rh Factor',unit:''}]
    };
    function mhResolveParams(testName) {
        if (!testName) return null;
        const n = testName.toLowerCase();
        return mhTestConfigs[n] || Object.entries(mhTestConfigs).find(([k])=>n.includes(k))?.[1] || null;
    }
    function mhExtractVal(src, key) {
        if (!src) return null;
        const k = Object.keys(src).find(k=>k.toLowerCase()===key.toLowerCase());
        const v = k ? src[k] : null;
        return Array.isArray(v) ? (v[0]??null) : v;
    }

    function mhRenderReport(analysis) {
        const iconMap = {safe:'fa-check-circle', warning:'fa-exclamation-circle', danger:'fa-exclamation-triangle'};
        mhModalVerdictRow.innerHTML =
            '<span class="mhrm-verdict-badge '+analysis.verdict+'">'
            +'<i class="fas '+iconMap[analysis.verdict]+'"></i> '+mhEsc(analysis.overall)+'</span>'
            +'<p class="mhrm-verdict-summary">'+mhEsc(analysis.riskLevel||'See detailed breakdown below')+'</p>';

        let html = '';

        if (analysis.personalInfo) {
            const pi = analysis.personalInfo;
            const piFields = [
                {label:'Name',value:pi.name},{label:'Age',value:pi.age,suffix:' yrs'},{label:'Trimester',value:pi.trimester},
                {label:'Week',value:pi.week},{label:'Height',value:pi.height,suffix:' cm'},{label:'Weight',value:pi.weight,suffix:' kg'},
                {label:'Risk',value:pi.risk_state}
            ];
            let chips='';
            piFields.forEach(f=>{
                if (f.value==null||f.value==='') return;
                chips+='<div class="mhrm-pi-chip"><span class="mhrm-pi-label">'+mhEsc(f.label)+'</span><span class="mhrm-pi-value">'+mhEsc(String(f.value))+(f.suffix||'')+'</span></div>';
            });
            if (chips) html+='<div class="mhrm-section"><h5 class="mhrm-section-h"><i class="fas fa-id-card"></i> Patient Information</h5><div class="mhrm-pi-strip">'+chips+'</div></div>';
        }

        if (analysis.tests && analysis.tests.length) {
            analysis.tests.forEach(test => {
                const params = mhResolveParams(test.test_name);
                const isDiag = mhHasDiag(test);
                if (!params && !isDiag) return;
                const confVal = test.confidence;
                let cards = isDiag ? mhDiagCards(test) : params.map(p=>{
                    const val = mhExtractVal(test,p.key)??'—';
                    return '<div class="mhrm-insight-card normal">'
                        +'<div class="mhrm-insight-label">'+mhEsc(p.name)+'</div>'
                        +'<div class="mhrm-insight-value"><span class="mhrm-insight-dot"></span>'+mhEsc(String(val))
                        +(p.unit?'<span class="mhrm-insight-unit">'+mhEsc(p.unit)+'</span>':'')
                        +'</div></div>';
                }).join('');
                html+='<div class="mhrm-section"><h5 class="mhrm-section-h"><i class="fas fa-vial"></i> '+mhEsc(test.test_name||'Lab Test')
                    +(confVal?'<span class="mhrm-confidence-pill"><i class="fas fa-brain"></i> '+(parseFloat(confVal)*100).toFixed(0)+'% confidence</span>':'')
                    +'</h5><div class="mhrm-insight-grid">'+cards+'</div></div>';
            });
        }

        if (analysis.report) {
            html+='<div class="mhrm-section mhrm-ai-section"><h5 class="mhrm-section-h"><i class="fas fa-file-medical-alt"></i> AI Medical Report</h5>'
                +'<div class="mhrm-ai-block"><div class="mhrm-ai-block-body">'+mhFormatText(analysis.report)+'</div></div></div>';
        }

        mhModalReportContent.innerHTML = html || '<p style="padding:1.5rem;color:#9a93a8">No detailed data available for this report.</p>';
        mhShowContent();
    }

    function mhMapAnalysis(data) {
        const tests = data.tests || [];
        let hasHigh=false, hasLow=false;
        tests.forEach(test=>{
            if (mhHasDiag(test)) {
                Object.keys(test).forEach(k=>{
                    if (mhIsMetaKey(k)||k.toLowerCase()==='other_diagnoses') return;
                    const cls=mhDiagClass(mhDiagStatus(test[k]));
                    if (cls==='high') hasHigh=true;
                    if (cls==='warning') hasLow=true;
                });
            }
        });
        const riskRaw=data.riskPrediction; let riskObj={};
        if (riskRaw&&typeof riskRaw==='object'&&!Array.isArray(riskRaw)) riskObj=riskRaw;
        else if (Array.isArray(riskRaw)) { for (let i=riskRaw.length-1;i>=0;i--) { if(riskRaw[i]&&typeof riskRaw[i]==='object'&&Object.keys(riskRaw[i]).length){riskObj=riskRaw[i];break;} } }
        const riskText=String(riskObj.risk_level||'').toLowerCase();
        if (riskText.includes('high')) hasHigh=true;
        if (riskText.includes('moderate')||riskText.includes('medium')) hasLow=true;
        const verdict=hasHigh?'danger':hasLow?'warning':'safe';
        const overall=hasHigh?'Abnormal Values Detected':hasLow?'Some Values Below Normal':'All Values Normal';
        return { verdict, overall, personalInfo:data.personalInfo||null, tests, riskLevel:riskObj.risk_level||null, report:data.report||null };
    }

    document.addEventListener('click', function(e) {
        const btn = e.target.closest('.mh-lab-btn-primary');
        if (!btn) return;
        const labId    = btn.dataset.labid;
        const testType = btn.dataset.testtype;
        const date     = btn.dataset.uploaddate;

        mhModalTitle.textContent    = testType ? testType.toUpperCase() + ' Test Report' : 'Test Report';
        mhModalSubtitle.textContent = date || '';
        mhShowLoading();
        mhOpenModal();

        fetch('/api/analysis/' + labId)
            .then(r => { if (!r.ok) throw new Error('Report not found.'); return r.json(); })
            .then(data => {
                if (data.status && data.status !== 'Completed')
                    throw new Error('This report is still being processed (' + data.status + ').');
                mhRenderReport(mhMapAnalysis(data));
            })
            .catch(err => mhShowError(err?.message || 'Failed to load report.'));
    });
});
</script>
}
