.mh-timeline-item.alert .mh-timeline-dot { border-color: var(--mh-danger); color: var(--mh-danger); background: var(--mh-danger-light); }
.mh-timeline-item.doctor .mh-timeline-dot { border-color: var(--mh-doctor); color: var(--mh-doctor); background: var(--mh-doctor-light); }
.mh-timeline-item.medication .mh-timeline-dot { border-color: var(--mh-medication); color: var(--mh-medication); background: var(--mh-medication-light); }

