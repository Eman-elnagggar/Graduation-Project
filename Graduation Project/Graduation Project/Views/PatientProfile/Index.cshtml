@model Graduation_Project.ViewModels.PatientProfileViewModel
@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewData["Title"] = "My Profile";
    ViewData["PatientId"] = Model.Patient.PatientID;
    ViewData["ActivePage"] = "Profile";
    ViewData["HidePageHeader"] = true;

    var emailVerified = Model.User?.EmailConfirmed == true;
    var hasPregnancy = Model.HasActivePregnancy;
    var weekPct = Math.Max(0, Math.Min(100, Model.PregnancyProgressPercent));
    var daysTotal = 280;
    var daysPct = Model.DaysRemaining > 0
        ? Math.Max(0, Math.Min(100, (int)Math.Round((daysTotal - Model.DaysRemaining) / (double)daysTotal * 100)))
        : (hasPregnancy ? 100 : 0);
    var bmiPct = Model.Bmi > 0 ? Math.Max(0, Math.Min(100, (int)Math.Round(Model.Bmi / 40.0 * 100))) : 0;
    var avatarName = Uri.EscapeDataString(string.IsNullOrWhiteSpace(Model.FullName) ? "Patient" : Model.FullName);
    var memberSince = Model.User?.CreatedDate is { Year: > 2000 } dt ? dt.ToString("MMM yyyy") : "—";
}

@section Head {
    <meta name="patient-id" content="@Model.Patient.PatientID" />
    @Html.AntiForgeryToken()
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
}

<!-- ════════════════════════ PROFILE HERO ════════════════════════ -->
<header class="pp-hero">
    <div class="pp-hero-orbs">
        <span class="pp-orb pp-orb-1"></span>
        <span class="pp-orb pp-orb-2"></span>
        <span class="pp-orb pp-orb-3"></span>
    </div>

    <div class="pp-hero-glass">
        <div class="pp-hero-identity">
            <div class="pp-avatar">
                <img src="https://ui-avatars.com/api/?name=@avatarName&background=fb7185&color=fff&size=160&bold=true&font-size=0.4"
                     alt="@Model.FullName" />
                @if (emailVerified)
                {
                    <span class="pp-avatar-verify" title="Verified account">
                        <i data-lucide="badge-check"></i>
                    </span>
                }
            </div>

            <div class="pp-hero-text">
                <div class="pp-hero-nameline">
                    <h1 class="pp-hero-name">@Model.FullName</h1>
                    <span class="pp-verify @(emailVerified ? "is-verified" : "is-pending")">
                        <i data-lucide="@(emailVerified ? "shield-check" : "shield-alert")"></i>
                        @(emailVerified ? "Verified" : "Unverified")
                    </span>
                </div>
                <p class="pp-hero-email"><i data-lucide="mail"></i> @Model.Email</p>

                <div class="pp-hero-badges">
                    <span class="pp-badge @(hasPregnancy ? "pp-badge-active" : "pp-badge-idle")">
                        <i data-lucide="@(hasPregnancy ? "heart-pulse" : "circle-dashed")"></i>
                        @(hasPregnancy ? "Active Pregnancy" : "No Active Pregnancy")
                    </span>
                    @if (hasPregnancy)
                    {
                        <span class="pp-badge pp-badge-week"><i data-lucide="baby"></i> Week @Model.PregnancyWeek</span>
                        <span class="pp-badge pp-badge-trim"><i data-lucide="calendar-range"></i> @Model.Trimester</span>
                        @if (Model.DueDate != "N/A")
                        {
                            <span class="pp-badge pp-badge-due"><i data-lucide="calendar-clock"></i> Due @Model.DueDate</span>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="pp-hero-progress">
            <div class="pp-hero-ring" style="--pct:@weekPct">
                <svg viewBox="0 0 36 36" aria-hidden="true">
                    <defs>
                        <linearGradient id="ppHeroGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#1baebe" />
                            <stop offset="100%" stop-color="#22c9db" />
                        </linearGradient>
                    </defs>
                    <circle class="pp-ring-bg" cx="18" cy="18" r="15.9155" />
                    <circle class="pp-ring-fg" cx="18" cy="18" r="15.9155"
                            stroke="url(#ppHeroGrad)" stroke-dasharray="@weekPct 100" />
                </svg>
                <div class="pp-hero-ring-center">
                    <span class="pp-hero-ring-num">@(hasPregnancy ? Model.PregnancyWeek.ToString() : "—")</span>
                    <span class="pp-hero-ring-lbl">@(hasPregnancy ? "of 40 wks" : "no data")</span>
                </div>
            </div>
        </div>
    </div>
</header>

@if (TempData["PregnancyStatusMessage"] is string pregnancyStatusMessage && !string.IsNullOrWhiteSpace(pregnancyStatusMessage))
{
    <div class="pp-flash"><i data-lucide="info"></i><span>@pregnancyStatusMessage</span></div>
}

<!-- ════════════════════════ TWO-COLUMN LAYOUT ════════════════════════ -->
<div class="pp-layout">

    <!-- ── STICKY SUMMARY ── -->
    <aside class="pp-summary">
        <div class="pp-summary-inner">
            <div class="pp-summary-head">
                <h2>Snapshot</h2>
                <p>Live profile metrics</p>
            </div>

            <div class="pp-stat-grid">
            <div class="pp-stat" style="--pct:@weekPct">
                <div class="pp-stat-ring pp-ring-teal">
                    <svg viewBox="0 0 36 36"><circle class="pp-ring-bg" cx="18" cy="18" r="15.9155"/><circle class="pp-ring-fg" cx="18" cy="18" r="15.9155" stroke-dasharray="@weekPct 100"/></svg>
                    <i data-lucide="baby"></i>
                </div>
                <div class="pp-stat-meta">
                    <span class="pp-stat-num">@(hasPregnancy ? Model.PregnancyWeek.ToString() : "—")</span>
                    <span class="pp-stat-lbl">Week</span>
                </div>
            </div>

            <div class="pp-stat" style="--pct:@daysPct">
                <div class="pp-stat-ring pp-ring-amber">
                    <svg viewBox="0 0 36 36"><circle class="pp-ring-bg" cx="18" cy="18" r="15.9155"/><circle class="pp-ring-fg" cx="18" cy="18" r="15.9155" stroke-dasharray="@daysPct 100"/></svg>
                    <i data-lucide="hourglass"></i>
                </div>
                <div class="pp-stat-meta">
                    <span class="pp-stat-num">@(hasPregnancy ? Model.DaysRemaining.ToString() : "—")</span>
                    <span class="pp-stat-lbl">Days Left</span>
                </div>
            </div>

            <div class="pp-stat" style="--pct:@bmiPct">
                <div class="pp-stat-ring pp-ring-purple">
                    <svg viewBox="0 0 36 36"><circle class="pp-ring-bg" cx="18" cy="18" r="15.9155"/><circle class="pp-ring-fg" cx="18" cy="18" r="15.9155" stroke-dasharray="@bmiPct 100"/></svg>
                    <i data-lucide="scale"></i>
                </div>
                <div class="pp-stat-meta">
                    <span class="pp-stat-num">@(Model.Bmi > 0 ? Model.Bmi.ToString("F1") : "—")</span>
                    <span class="pp-stat-lbl">BMI</span>
                </div>
            </div>

            <div class="pp-stat">
                <div class="pp-stat-icon pp-ic-green"><i data-lucide="cake"></i></div>
                <div class="pp-stat-meta">
                    <span class="pp-stat-num">@Model.Age</span>
                    <span class="pp-stat-lbl">Age</span>
                </div>
            </div>

            <div class="pp-stat">
                <div class="pp-stat-icon pp-ic-pink"><i data-lucide="pill"></i></div>
                <div class="pp-stat-meta">
                    <span class="pp-stat-num">@(Model.Medications?.Count ?? 0)</span>
                    <span class="pp-stat-lbl">Medications</span>
                </div>
            </div>
            </div>
        </div>
    </aside>

    <!-- ── MAIN CONTENT ── -->
    <div class="pp-main">

        <!-- Segmented tabs -->
        <nav class="pp-tabs" role="tablist" aria-label="Profile sections">
            <button class="pf-tab active" data-tab="personal" role="tab"><i data-lucide="user-round"></i><span>Personal</span></button>
            <button class="pf-tab" data-tab="pregnancy" role="tab"><i data-lucide="baby"></i><span>Pregnancy</span></button>
            <button class="pf-tab" data-tab="medical" role="tab"><i data-lucide="stethoscope"></i><span>Medical</span></button>
            <button class="pf-tab" data-tab="lifestyle" role="tab"><i data-lucide="heart"></i><span>Lifestyle</span></button>
            <button class="pf-tab" data-tab="security" role="tab"><i data-lucide="shield"></i><span>Security</span></button>
        </nav>

        <!-- ═══════════ TAB: PERSONAL ═══════════ -->
        <div class="pf-tab-content active" id="personal-tab">
            <form id="personalForm" class="pp-stack">

                <!-- Account Information -->
                <section class="pp-card">
                    <div class="pp-card-head">
                        <div class="pp-card-title">
                            <span class="pp-card-icon pp-grad-teal"><i data-lucide="at-sign"></i></span>
                            <div>
                                <h3>Account Information</h3>
                                <p>Your login identity and account status</p>
                            </div>
                        </div>
                        <span class="pp-readonly-tag"><i data-lucide="lock"></i> Read only</span>
                    </div>
                    <div class="pp-card-body">
                        <div class="pp-grid">
                            <div class="pp-field">
                                <label>Email Address</label>
                                <div class="pp-input-icon">
                                    <i data-lucide="mail"></i>
                                    <input type="email" id="email" class="pf-input" value="@Model.Email" disabled readonly />
                                    <span class="pp-inline-verify @(emailVerified ? "is-verified" : "is-pending")">
                                        <i data-lucide="@(emailVerified ? "check" : "alert-circle")"></i>
                                        @(emailVerified ? "Verified" : "Pending")
                                    </span>
                                </div>
                            </div>
                            <div class="pp-field">
                                <label>Username</label>
                                <div class="pp-input-icon">
                                    <i data-lucide="user-round"></i>
                                    <input type="text" class="pf-input" value="@Model.UserName" disabled readonly />
                                </div>
                            </div>
                        </div>
                        <div class="pp-readout-row">
                            <div class="pp-readout"><i data-lucide="shield-check"></i><div><span>Status</span><strong>@(Model.User?.IsActive == false ? "Inactive" : "Active")</strong></div></div>
                            <div class="pp-readout"><i data-lucide="calendar-days"></i><div><span>Member since</span><strong>@memberSince</strong></div></div>
                            <div class="pp-readout"><i data-lucide="id-card"></i><div><span>Patient ID</span><strong>#@Model.Patient.PatientID</strong></div></div>
                        </div>
                    </div>
                </section>

                <!-- Personal Details -->
                <section class="pp-card">
                    <div class="pp-card-head">
                        <div class="pp-card-title">
                            <span class="pp-card-icon pp-grad-indigo"><i data-lucide="user-round"></i></span>
                            <div>
                                <h3>Personal Details</h3>
                                <p>Your name and date of birth</p>
                            </div>
                        </div>
                        <button type="button" class="pp-edit-btn" id="editPersonalBtn"><i data-lucide="pencil"></i> Edit</button>
                    </div>
                    <div class="pp-card-body">
                        <div class="pp-grid">
                            <div class="pp-field">
                                <label>First Name</label>
                                <input type="text" id="firstName" class="pf-input" value="@Model.User?.FirstName" disabled />
                            </div>
                            <div class="pp-field">
                                <label>Last Name</label>
                                <input type="text" id="lastName" class="pf-input" value="@Model.User?.LastName" disabled />
                            </div>
                            <div class="pp-field">
                                <label>Date of Birth</label>
                                <input type="date" id="dateOfBirth" class="pf-input" value="@(Model.User?.DateOfBirth.ToString("yyyy-MM-dd"))" disabled />
                            </div>
                            <div class="pp-field">
                                <label>Age (calculated)</label>
                                <input type="text" id="ageDisplay" class="pf-input pp-calc-input" value="@Model.Age years" disabled readonly />
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Contact Information -->
                <section class="pp-card">
                    <div class="pp-card-head">
                        <div class="pp-card-title">
                            <span class="pp-card-icon pp-grad-teal"><i data-lucide="contact-round"></i></span>
                            <div>
                                <h3>Contact Information</h3>
                                <p>How we reach you</p>
                            </div>
                        </div>
                        <button type="button" class="pp-edit-btn pp-proxy-edit" data-target="editPersonalBtn"><i data-lucide="pencil"></i> Edit</button>
                    </div>
                    <div class="pp-card-body">
                        <div class="pp-grid">
                            <div class="pp-field">
                                <label>Phone Number</label>
                                <div class="pp-input-icon">
                                    <i data-lucide="phone"></i>
                                    <input type="tel" id="phone" class="pf-input" value="@Model.Phone" disabled />
                                </div>
                            </div>
                            <div class="pp-field pp-col-full">
                                <label>Address</label>
                                <div class="pp-input-icon">
                                    <i data-lucide="map-pin"></i>
                                    <input type="text" id="address" class="pf-input" value="@Model.Patient.Address" disabled placeholder="No address on file" />
                                </div>
                            </div>
                        </div>

                        <div class="pf-form-actions pp-actions" id="personalActions" style="display:none">
                            <button type="button" class="pp-btn-ghost" id="cancelPersonal"><i data-lucide="x"></i> Cancel</button>
                            <button type="submit" class="pp-btn-primary"><i data-lucide="check"></i> Save Changes</button>
                        </div>
                    </div>
                </section>
            </form>

            <!-- Body Measurements -->
            <section class="pp-card">
                <div class="pp-card-head">
                    <div class="pp-card-title">
                        <span class="pp-card-icon pp-grad-purple"><i data-lucide="ruler"></i></span>
                        <div>
                            <h3>Body Measurements</h3>
                            <p>Weight, height and BMI tracking</p>
                        </div>
                    </div>
                    <button type="button" class="pp-edit-btn" id="editMeasurementsBtn"><i data-lucide="pencil"></i> Edit</button>
                </div>
                <div class="pp-card-body">
                    <form class="pp-stack-tight" id="measurementsForm">
                        <div class="pp-grid pp-grid-3">
                            <div class="pp-field">
                                <label>Weight</label>
                                <div class="pf-input-unit">
                                    <input type="number" id="weightKg" class="pf-input" step="0.1" value="@Model.Patient.WeightKg" disabled />
                                    <span class="pf-unit-badge">kg</span>
                                </div>
                            </div>
                            <div class="pp-field">
                                <label>Height</label>
                                <div class="pf-input-unit">
                                    <input type="number" id="heightCm" class="pf-input" value="@Model.Patient.HeightCm" disabled />
                                    <span class="pf-unit-badge">cm</span>
                                </div>
                            </div>
                            <div class="pp-field">
                                <label>BMI (calculated)</label>
                                <div class="pf-input-unit">
                                    <input type="text" id="bmiDisplay" class="pf-input" value="@Model.Bmi" disabled readonly />
                                    <span class="pf-unit-badge pf-bmi-badge @Model.BmiStatus.ToLower()" id="bmiStatus">@Model.BmiStatus</span>
                                </div>
                            </div>
                        </div>
                        <div class="pf-form-actions pp-actions" id="measurementsActions" style="display:none">
                            <button type="button" class="pp-btn-ghost" id="cancelMeasurements"><i data-lucide="x"></i> Cancel</button>
                            <button type="submit" class="pp-btn-primary"><i data-lucide="check"></i> Save Changes</button>
                        </div>
                    </form>
                </div>
            </section>
        </div>

        <!-- ═══════════ TAB: PREGNANCY ═══════════ -->
        <div class="pf-tab-content" id="pregnancy-tab">
            @{
                var wk = Model.PregnancyWeek;
                var (babyEmoji, babySize) = wk switch
                {
                    <= 5  => ("🌱", "an apple seed"),
                    6     => ("🫛", "a sweet pea"),
                    7     => ("🫐", "a blueberry"),
                    8     => ("🫘", "a kidney bean"),
                    9     => ("🍇", "a grape"),
                    10    => ("🍒", "a cherry"),
                    11    => ("🍓", "a strawberry"),
                    12    => ("🍋", "a lime"),
                    13    => ("🍋", "a lemon"),
                    14    => ("🍑", "a peach"),
                    15    => ("🍎", "an apple"),
                    16    => ("🥑", "an avocado"),
                    17    => ("🍐", "a pear"),
                    18    => ("🫑", "a bell pepper"),
                    19    => ("🍅", "a tomato"),
                    20    => ("🍌", "a banana"),
                    21    => ("🥕", "a carrot"),
                    22    => ("🥥", "a coconut"),
                    23    => ("🍆", "an eggplant"),
                    24    => ("🌽", "an ear of corn"),
                    25    => ("🥬", "a cabbage"),
                    26    => ("🥒", "a cucumber"),
                    27    => ("🥦", "a head of cauliflower"),
                    28    => ("🍆", "a large eggplant"),
                    29    => ("🎃", "a butternut squash"),
                    30    => ("🥥", "a large coconut"),
                    31    => ("🍍", "a pineapple"),
                    32    => ("🥬", "a jicama"),
                    33    => ("🍍", "a large pineapple"),
                    34    => ("🍈", "a cantaloupe"),
                    35    => ("🍈", "a honeydew melon"),
                    36    => ("🥬", "a head of romaine lettuce"),
                    37    => ("🥬", "a bunch of swiss chard"),
                    38    => ("🥬", "a leek"),
                    39    => ("🍉", "a mini watermelon"),
                    _     => ("🍉", "a small watermelon"),
                };
                var genderClass = Model.BabyGender == "Male" ? "pp-gender-male"
                                : Model.BabyGender == "Female" ? "pp-gender-female"
                                : "pp-gender-unknown";
            }

            <div class="pp-preg-wrap @genderClass" id="pregWrap">
            <section class="pp-journey">
                <div class="pp-journey-deco" aria-hidden="true">
                    <span class="pp-deco pp-deco-1">🍼</span>
                    <span class="pp-deco pp-deco-2">⭐</span>
                    <span class="pp-deco pp-deco-3">☁️</span>
                    <span class="pp-deco pp-deco-4">💕</span>
                    <span class="pp-deco pp-deco-5">🧸</span>
                </div>

                @if (hasPregnancy)
                {
                    <div class="pp-journey-top">
                        <div class="pp-journey-ring" style="--pct:@weekPct">
                            <svg viewBox="0 0 36 36" aria-hidden="true">
                                <circle class="pp-jring-bg" cx="18" cy="18" r="15.9155" />
                                <circle class="pp-jring-fg" cx="18" cy="18" r="15.9155" stroke-dasharray="@weekPct 100" />
                            </svg>
                            <div class="pp-journey-ring-c">
                                <span class="pp-journey-emoji">👶</span>
                                <span class="pp-journey-week">@Model.PregnancyWeek</span>
                                <span class="pp-journey-wk">weeks</span>
                            </div>
                        </div>

                        <div class="pp-journey-info">
                            <span class="pp-journey-tag">@Model.Trimester · @Model.PregnancyDays days in</span>
                            <h2 class="pp-journey-title">Your little one is growing 💗</h2>
                            <p class="pp-journey-size">
                                <span class="pp-size-emoji">@babyEmoji</span>
                                <span>This week, baby is about the size of <strong>@babySize</strong></span>
                            </p>
                            <div class="pp-journey-chips">
                                @if (Model.DueDate != "N/A")
                                {
                                    <span class="pp-jchip pp-jchip-due"><i data-lucide="calendar-heart"></i> Due @Model.DueDate</span>
                                }
                                @if (Model.DaysRemaining > 0)
                                {
                                    <span class="pp-jchip pp-jchip-count"><i data-lucide="hourglass"></i> @Model.DaysRemaining days to go</span>
                                }
                                <span class="pp-jchip pp-jchip-progress"><i data-lucide="sparkles"></i> @weekPct% of the way</span>
                            </div>
                        </div>
                    </div>

                    <div class="pp-milestones">
                        <div class="pp-mile-track">
                            <div class="pp-mile-fill" style="width:@weekPct%"></div>
                            <div class="pp-mile-foot" style="left:calc(@weekPct% - 16px)">👣</div>
                        </div>
                        <div class="pp-mile-stops">
                            <div class="pp-mile @(wk >= 1 ? "done" : "")">
                                <span class="pp-mile-dot">🌱</span>
                                <span class="pp-mile-l">1st Trimester</span>
                                <span class="pp-mile-s">Weeks 1–12</span>
                            </div>
                            <div class="pp-mile @(wk >= 13 ? "done" : "")">
                                <span class="pp-mile-dot">🌸</span>
                                <span class="pp-mile-l">2nd Trimester</span>
                                <span class="pp-mile-s">Weeks 13–27</span>
                            </div>
                            <div class="pp-mile @(wk >= 28 ? "done" : "")">
                                <span class="pp-mile-dot">🍼</span>
                                <span class="pp-mile-l">3rd Trimester</span>
                                <span class="pp-mile-s">Weeks 28–40</span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="pp-journey-empty">
                        <span class="pp-journey-empty-emoji">🌸</span>
                        <h2>Your journey starts here</h2>
                        <p>Begin tracking a new pregnancy to watch your baby grow, week by week.</p>
                        <button type="button" class="pp-btn-primary" onclick="document.getElementById('startPregnancyBtn')?.click()">
                            <i data-lucide="circle-play"></i> Start New Pregnancy
                        </button>
                    </div>
                }
            </section>

            <section class="pp-card">
                <div class="pp-card-head">
                    <div class="pp-card-title">
                        <span class="pp-card-icon pp-grad-baby"><i data-lucide="baby"></i></span>
                        <div>
                            <h3>Current Pregnancy</h3>
                            <p>Update your dates — we'll do the math</p>
                        </div>
                    </div>
                    <div class="pp-head-actions">
                        @if (Model.HasActivePregnancy)
                        {
                            <form asp-action="EndCurrentPregnancy" asp-controller="Patient" method="post" onsubmit="return confirm('Are you sure you want to end the current pregnancy? This will reset active pregnancy progress.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Patient.PatientID" />
                                <input type="hidden" name="returnUrl" value="@($"/PatientProfile/Index/{Model.Patient.PatientID}")" />
                                <button type="submit" class="pp-btn-danger-soft"><i data-lucide="circle-stop"></i> End Pregnancy</button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="pp-btn-primary" id="startPregnancyBtn"><i data-lucide="circle-play"></i> Start New Pregnancy</button>
                        }
                        <button type="button" class="pp-edit-btn" id="editPregnancyBtn"><i data-lucide="pencil"></i> Edit</button>
                    </div>
                </div>
                <div class="pp-card-body">
                    @if (!Model.HasActivePregnancy)
                    {
                        <div class="pp-note pp-note-info">
                            <i data-lucide="info"></i>
                            <div>
                                <h4>No active pregnancy</h4>
                                <p>Tap <strong>Edit</strong>, set your last period date, then save to start tracking.</p>
                            </div>
                        </div>
                    }
                    <form class="pp-stack-tight" id="pregnancyForm">

                        <!-- Step 1 — what you enter -->
                        <div class="pp-step"><span class="pp-step-badge">1</span><h4 class="pp-step-title">What you tell us</h4></div>

                        <div class="pp-field">
                            <label>Date of your last period</label>
                            <input type="date" id="pregnancyDate" class="pf-input"
                                   value="@(Model.ActivePregnancyStartDate?.ToString("yyyy-MM-dd"))" disabled />
                            <span class="pp-hint"><i data-lucide="info"></i> The first day of your last menstrual period</span>
                        </div>

                        <div class="pp-field">
                            <label>Baby's gender</label>
                            <div class="pp-gender-pick">
                                <label class="pp-gender-opt pp-g-boy">
                                    <input type="radio" name="babyGenderOpt" value="Male" disabled @(Model.BabyGender == "Male" ? "checked" : "") />
                                    <span class="pp-gender-emoji">👦</span><span>Boy</span>
                                </label>
                                <label class="pp-gender-opt pp-g-girl">
                                    <input type="radio" name="babyGenderOpt" value="Female" disabled @(Model.BabyGender == "Female" ? "checked" : "") />
                                    <span class="pp-gender-emoji">👧</span><span>Girl</span>
                                </label>
                                <label class="pp-gender-opt pp-g-unknown">
                                    <input type="radio" name="babyGenderOpt" value="" disabled @(string.IsNullOrWhiteSpace(Model.BabyGender) ? "checked" : "") />
                                    <span class="pp-gender-emoji">🤍</span><span>Not sure yet</span>
                                </label>
                            </div>
                            <input type="hidden" id="babyGender" value="@Model.BabyGender" />
                        </div>

                        <!-- Step 2 — what we calculate -->
                        <div class="pp-step"><span class="pp-step-badge">2</span><h4 class="pp-step-title">What we calculate <span class="pp-step-auto"><i data-lucide="sparkles"></i> automatic</span></h4></div>

                        <div class="pp-calc-strip">
                            <div class="pp-calc-tile">
                                <span class="pp-calc-ico">🗓️</span>
                                <div>
                                    <span class="pp-calc-k">How far along</span>
                                    <strong id="gestWeeks">@Model.PregnancyWeek weeks, @Model.PregnancyDays days</strong>
                                    <small>@Model.Trimester</small>
                                </div>
                            </div>
                            <div class="pp-calc-tile">
                                <span class="pp-calc-ico">🎀</span>
                                <div>
                                    <span class="pp-calc-k">Estimated due date</span>
                                    <strong>@Model.DueDate</strong>
                                    @if (Model.DaysRemaining > 0)
                                    {
                                        <small>@Model.DaysRemaining days to go</small>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Step 3 — history -->
                        <div class="pp-step"><span class="pp-step-badge">3</span><h4 class="pp-step-title">Your pregnancy history</h4></div>

                        <div class="pp-field">
                            <label>Is this your first pregnancy?</label>
                            <div class="pf-radio-row">
                                <label class="pf-radio-opt">
                                    <input type="radio" name="firstPregnancy" value="yes" disabled @(Model.Patient.IsFirstPregnancy ? "checked" : "") />
                                    <span class="pf-radio-box"><i data-lucide="check"></i></span><span>Yes</span>
                                </label>
                                <label class="pf-radio-opt">
                                    <input type="radio" name="firstPregnancy" value="no" disabled @(!Model.Patient.IsFirstPregnancy ? "checked" : "") />
                                    <span class="pf-radio-box"><i data-lucide="check"></i></span><span>No</span>
                                </label>
                            </div>
                        </div>

