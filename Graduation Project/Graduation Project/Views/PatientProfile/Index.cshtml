@section Scripts {
    <script>
        (function () {
            const PATIENT_ID = parseInt(document.querySelector('meta[name="patient-id"]').content, 10);
            const TOKEN      = document.querySelector('input[name="__RequestVerificationToken"]').value;

            // ── Lucide helper ─────────────────────────────────────────────────
            function icons() { try { window.lucide?.createIcons(); } catch (e) {} }
            icons();

            // ── Toast notification ────────────────────────────────────────────
            function toast(msg, type = 'success') {
                document.querySelector('.pf-toast')?.remove();
                const map = { success: 'check-circle-2', error: 'x-circle', warning: 'alert-triangle', info: 'info' };
                const n = document.createElement('div');
                n.className = `pf-toast pf-toast-${type}`;
                n.innerHTML = `<i data-lucide="${map[type] ?? map.info}"></i><span>${msg}</span><button class="pf-toast-close"><i data-lucide="x"></i></button>`;
                document.body.appendChild(n);
                icons();
                n.querySelector('.pf-toast-close').addEventListener('click', () => n.remove());
                setTimeout(() => n?.remove(), 4500);
            }
            window.showNotification = (msg, type) => toast(msg, type);

            // ── Tab switching ─────────────────────────────────────────────────
            document.querySelectorAll('.pf-tab').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('.pf-tab').forEach(t => t.classList.remove('active'));
                    document.querySelectorAll('.pf-tab-content').forEach(c => c.classList.remove('active'));
                    this.classList.add('active');
                    const panel = document.getElementById(this.dataset.tab + '-tab');
                    panel.classList.add('active');
                    // retrigger entrance animation
                    panel.style.animation = 'none';
                    void panel.offsetWidth;
                    panel.style.animation = '';
                });
            });

            // ── Proxy edit buttons (per-card edit triggers shared toggle) ──────
            document.querySelectorAll('.pp-proxy-edit').forEach(b => {
                b.addEventListener('click', () => document.getElementById(b.dataset.target)?.click());
            });

            // ── Generic edit section ──────────────────────────────────────────
            function setEditLabel(btn, editing) {
                if (!btn) return;
                btn.innerHTML = editing
                    ? '<i data-lucide="x"></i> Cancel'
                    : '<i data-lucide="pencil"></i> Edit';
                icons();
            }

            function setupEdit(editBtnId, formId, actionsId, cancelBtnId) {
                const editBtn   = document.getElementById(editBtnId);
                const form      = document.getElementById(formId);
                const actions   = document.getElementById(actionsId);
                const cancelBtn = document.getElementById(cancelBtnId);
                if (!editBtn) return;

                editBtn.addEventListener('click', function () {
                    const inputs = form ? form.querySelectorAll('input:not([readonly]), select, textarea') : [];
                    const isDisabled = inputs[0]?.disabled ?? true;
                    if (isDisabled) {
                        inputs.forEach(i => i.disabled = false);
                        if (actions) actions.style.display = 'flex';
                        setEditLabel(editBtn, true);
                        document.querySelectorAll('.pf-med-remove').forEach(b => b.style.display = 'inline-flex');
                        const addBtn = document.getElementById('showAddMedBtn');
                        if (addBtn) addBtn.style.display = 'inline-flex';
                        icons();
                    } else {
                        cancelSection(form, actions, editBtn);
                    }
                });

                cancelBtn?.addEventListener('click', () => cancelSection(form, actions, editBtn));
            }

            function cancelSection(form, actions, editBtn) {
                form?.querySelectorAll('input:not([readonly]), select, textarea').forEach(i => i.disabled = true);
                if (actions) actions.style.display = 'none';
                setEditLabel(editBtn, false);
                document.querySelectorAll('.pf-med-remove').forEach(b => b.style.display = 'none');
                const addBtn = document.getElementById('showAddMedBtn');
                if (addBtn) addBtn.style.display = 'none';
            }

            setupEdit('editPersonalBtn',     'personalForm',     'personalActions',     'cancelPersonal');
            setupEdit('editMeasurementsBtn', 'measurementsForm', 'measurementsActions', 'cancelMeasurements');
            setupEdit('editPregnancyBtn',    'pregnancyForm',    'pregnancyActions',    'cancelPregnancy');
            setupEdit('editBPBtn',           'bpForm',           'bpActions',           'cancelBP');
            setupEdit('editMedsBtn',         null,               null,                  null);
            setupEdit('editLifestyleBtn',    'lifestyleForm',    'lifestyleActions',    'cancelLifestyle');

            document.getElementById('startPregnancyBtn')?.addEventListener('click', function () {
                const editBtn = document.getElementById('editPregnancyBtn');
                if (!editBtn) return;
                const pregnancyDateInput = document.getElementById('pregnancyDate');
                if (pregnancyDateInput?.disabled) editBtn.click();
                setTimeout(() => pregnancyDateInput?.focus(), 0);
            });

            // ── Busy state helper for submit buttons ──────────────────────────
            function busy(btn, label) {
                btn.dataset.html = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = `<i data-lucide="loader-2" class="pp-spin"></i> ${label}`;
                icons();
            }
            function unbusy(btn) {
                btn.disabled = false;
                if (btn.dataset.html) { btn.innerHTML = btn.dataset.html; icons(); }
            }

            // ── Save Personal ─────────────────────────────────────────────────
            document.getElementById('personalForm')?.addEventListener('submit', async function (e) {
                e.preventDefault();
                const sbtn = this.querySelector('button[type="submit"]'); busy(sbtn, 'Saving…');
                const fd = new FormData();
                fd.append('patientId',   PATIENT_ID);
                fd.append('firstName',   document.getElementById('firstName').value);
                fd.append('lastName',    document.getElementById('lastName').value);
                fd.append('phone',       document.getElementById('phone').value);
                fd.append('address',     document.getElementById('address').value);
                fd.append('dateOfBirth', document.getElementById('dateOfBirth').value);
                fd.append('__RequestVerificationToken', TOKEN);
                try {
                    const d = await (await fetch('/PatientProfile/SavePersonal', { method: 'POST', body: fd })).json();
                    if (d.success) { toast('Personal information saved!'); cancelSection(this, document.getElementById('personalActions'), document.getElementById('editPersonalBtn')); }
                    else toast(d.message || 'Save failed.', 'error');
                } catch { toast('Could not save. Please try again.', 'error'); }
                finally { unbusy(sbtn); }
            });

            // ── Save Measurements + live BMI ──────────────────────────────────
            function calcBmi() {
                const w = parseFloat(document.getElementById('weightKg').value);
                const h = parseFloat(document.getElementById('heightCm').value) / 100;
                if (w > 0 && h > 0) {
                    const bmi    = (w / (h * h)).toFixed(1);
                    const status = bmi < 18.5 ? 'Underweight' : bmi < 25 ? 'Normal' : bmi < 30 ? 'Overweight' : 'Obese';
                    const disp   = document.getElementById('bmiDisplay');
                    const badge  = document.getElementById('bmiStatus');
                    if (disp)  disp.value = bmi;
                    if (badge) { badge.textContent = status; badge.className = 'pf-unit-badge pf-bmi-badge ' + status.toLowerCase(); }
                }
            }
            document.getElementById('weightKg')?.addEventListener('input', calcBmi);
            document.getElementById('heightCm')?.addEventListener('input', calcBmi);

            document.getElementById('measurementsForm')?.addEventListener('submit', async function (e) {
                e.preventDefault();
                const sbtn = this.querySelector('button[type="submit"]'); busy(sbtn, 'Saving…');
                const fd = new FormData();
                fd.append('patientId', PATIENT_ID);
                fd.append('weightKg',  document.getElementById('weightKg').value);
                fd.append('heightCm',  document.getElementById('heightCm').value);
                fd.append('__RequestVerificationToken', TOKEN);
                try {
                    const d = await (await fetch('/PatientProfile/SaveMeasurements', { method: 'POST', body: fd })).json();
                    if (d.success) { toast('Measurements saved!'); cancelSection(this, document.getElementById('measurementsActions'), document.getElementById('editMeasurementsBtn')); }
                    else toast(d.message || 'Save failed.', 'error');
                } catch { toast('Could not save. Please try again.', 'error'); }
                finally { unbusy(sbtn); }
            });

            // ── Save Pregnancy ─────────────────────────────────────────────────
            document.getElementById('pregnancyForm')?.addEventListener('submit', async function (e) {
                e.preventDefault();
                const sbtn = this.querySelector('button[type="submit"]'); busy(sbtn, 'Saving…');
                const fp = document.querySelector('input[name="firstPregnancy"]:checked')?.value === 'yes';
                const fd = new FormData();
                fd.append('patientId',           PATIENT_ID);
                fd.append('pregnancyDate',       document.getElementById('pregnancyDate').value);
                fd.append('isFirstPregnancy',    fp);
                fd.append('previousPregnancies', document.getElementById('previousPregnancies')?.value || 0);
                fd.append('abortions',           document.getElementById('abortions')?.value || 0);
                fd.append('babyGender',          document.getElementById('babyGender')?.value || '');
                fd.append('births',              document.getElementById('births')?.value || 0);
                fd.append('__RequestVerificationToken', TOKEN);
                try {
                    const d = await (await fetch('/PatientProfile/SavePregnancy', { method: 'POST', body: fd })).json();
                    if (d.success) { toast('Pregnancy info saved!'); cancelSection(this, document.getElementById('pregnancyActions'), document.getElementById('editPregnancyBtn')); }
                    else toast(d.message || 'Save failed.', 'error');
                } catch { toast('Could not save. Please try again.', 'error'); }
                finally { unbusy(sbtn); }
            });

            document.querySelectorAll('input[name="firstPregnancy"]').forEach(r => {
                r.addEventListener('change', function () {
                    const sec = document.getElementById('previousPregnancySection');
                    if (sec) sec.style.display = this.value === 'no' ? '' : 'none';
                });
            });

            // ── Baby gender pills → drive hidden value + live colour theme ────
            const pregWrap = document.getElementById('pregWrap');
            const babyGenderHidden = document.getElementById('babyGender');
            function applyGenderTheme(val) {
                if (!pregWrap) return;
                pregWrap.classList.remove('pp-gender-male', 'pp-gender-female', 'pp-gender-unknown');
                pregWrap.classList.add(val === 'Male' ? 'pp-gender-male' : val === 'Female' ? 'pp-gender-female' : 'pp-gender-unknown');
            }
            document.querySelectorAll('input[name="babyGenderOpt"]').forEach(r => {
                r.addEventListener('change', function () {
                    if (babyGenderHidden) babyGenderHidden.value = this.value;
                    applyGenderTheme(this.value);
                });
            });

            // ── Save Medical (BP) / Lifestyle ─────────────────────────────────
            async function saveMedical(successMsg, cancelForm, cancelActionsId, cancelBtnId, sbtn) {
                const bp = document.querySelector('input[name="bloodPressure"]:checked')?.value === 'yes';
                const sm = document.querySelector('input[name="smoking"]:checked')?.value === 'yes';
                const al = document.querySelector('input[name="alcohol"]:checked')?.value === 'yes';
                const fd = new FormData();
                fd.append('patientId',          PATIENT_ID);
                fd.append('bloodPressureIssue', bp);
                fd.append('smoking',            sm);
                fd.append('alcoholUse',         al);
                fd.append('__RequestVerificationToken', TOKEN);
                try {
                    const d = await (await fetch('/PatientProfile/SaveMedical', { method: 'POST', body: fd })).json();
                    if (d.success) {
                        toast(successMsg);
                        cancelSection(cancelForm, document.getElementById(cancelActionsId), document.getElementById(cancelBtnId));
                        const chip = document.getElementById('bpStatusChip');
                        if (chip) {
                            chip.className = 'pf-bp-status-chip ' + (bp ? 'pf-chip-risk' : 'pf-chip-ok');
                            chip.innerHTML = `<i data-lucide="${bp ? 'alert-circle' : 'check-circle-2'}"></i><span>${bp ? 'Risk — blood pressure issues reported' : 'Normal — no blood pressure issues'}</span>`;
                            icons();
                        }
                    } else toast(d.message || 'Save failed.', 'error');
                } catch { toast('Could not save. Please try again.', 'error'); }
                finally { if (sbtn) unbusy(sbtn); }
            }

            document.getElementById('bpForm')?.addEventListener('submit', async function (e) {
                e.preventDefault();
                const sbtn = this.querySelector('button[type="submit"]'); busy(sbtn, 'Saving…');
                await saveMedical('Blood pressure status saved!', this, 'bpActions', 'editBPBtn', sbtn);
            });

            document.getElementById('lifestyleForm')?.addEventListener('submit', async function (e) {
                e.preventDefault();
                const sbtn = this.querySelector('button[type="submit"]'); busy(sbtn, 'Saving…');
                await saveMedical('Lifestyle info saved!', this, 'lifestyleActions', 'editLifestyleBtn', sbtn);
                ['smoking', 'alcohol'].forEach(name => {
                    const isYes = document.querySelector(`input[name="${name}"]:checked`)?.value === 'yes';
                    const statusEl = document.getElementById(name + 'Status');
                    if (!statusEl) return;
                    statusEl.className = 'pf-ls-status ' + (isYes ? 'pf-ls-risk' : 'pf-ls-safe');
                    statusEl.innerHTML = `<i data-lucide="${isYes ? 'x-circle' : 'check-circle-2'}"></i><span>${isYes ? 'Risk' : 'Safe'}</span>`;
                });
                icons();
            });

            // ── Medication modal ──────────────────────────────────────────────
            document.getElementById('showAddMedBtn')?.addEventListener('click', () => {
                document.getElementById('addMedModal').style.display = 'flex';
                document.body.style.overflow = 'hidden';
            });

            function closeMedModal() {
                document.getElementById('addMedModal').style.display = 'none';
                document.body.style.overflow = '';
                ['medName','medReason','medDose','medDuration'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.value = '';
                });
            }
            document.getElementById('closeMedModal')?.addEventListener('click', closeMedModal);
            document.getElementById('cancelAddMed')?.addEventListener('click', closeMedModal);
            document.getElementById('addMedModal')?.addEventListener('click', e => { if (e.target === e.currentTarget) closeMedModal(); });

            document.getElementById('saveNewMed')?.addEventListener('click', async function () {
                const name     = document.getElementById('medName').value.trim();
                const reason   = document.getElementById('medReason').value.trim();
                const dose     = parseFloat(document.getElementById('medDose').value);
                const duration = parseInt(document.getElementById('medDuration').value) || 0;
                if (!name || !reason || !dose) { toast('Please fill in Name, Reason and Dosage.', 'warning'); return; }

                const fd = new FormData();
                fd.append('patientId',      PATIENT_ID);
                fd.append('drugName',       name);
                fd.append('reason',         reason);
                fd.append('doseMgPerDay',   dose);
                fd.append('durationMonths', duration);
                fd.append('__RequestVerificationToken', TOKEN);

                const btn = this; busy(btn, 'Saving…');
                try {
                    const d = await (await fetch('/PatientProfile/AddMedication', { method: 'POST', body: fd })).json();
                    if (d.success) {
                        appendMedRow(d.id, d.name, d.reason, d.dose, d.duration);
                        closeMedModal();
                        document.getElementById('noMedsMsg')?.remove();
                        toast('Medication added!');
                    } else toast(d.message || 'Could not add medication.', 'error');
                } catch { toast('Could not save. Please try again.', 'error'); }
                finally { unbusy(btn); }
            });

            function appendMedRow(id, name, reason, dose, duration) {
                const list = document.getElementById('medicationList');
                if (!list) return;
                const row = document.createElement('div');
                row.className = 'pf-med-row';
                row.dataset.drugId = id;
                row.innerHTML = `
                    <div class="pf-med-pill-icon"><i data-lucide="pill"></i></div>
                    <div class="pf-med-details">
                        <span class="pf-med-name">${esc(name)}</span>
                        <div class="pf-med-chips">
                            <span class="pf-med-chip pf-chip-reason"><i data-lucide="tag"></i> ${esc(reason)}</span>
                            <span class="pf-med-chip pf-chip-dose"><i data-lucide="syringe"></i> ${dose} mg/day</span>
                            <span class="pf-med-chip pf-chip-dur"><i data-lucide="calendar-days"></i> ${duration} months</span>
                        </div>
                    </div>
                    <button type="button" class="pf-med-remove" data-drug-id="${id}" title="Remove" style="display:inline-flex">
                        <i data-lucide="trash-2"></i>
                    </button>`;
                list.insertBefore(row, list.firstChild);
                row.querySelector('.pf-med-remove').addEventListener('click', removeHandler);
                icons();
            }

            // ── Remove Medication ─────────────────────────────────────────────
            async function removeHandler() {
                const drugId = parseInt(this.dataset.drugId, 10);
                if (!confirm('Remove this medication?')) return;
                const fd = new FormData();
                fd.append('drugId', drugId);
                fd.append('patientId', PATIENT_ID);
                fd.append('__RequestVerificationToken', TOKEN);
                try {
                    const d = await (await fetch('/PatientProfile/DeleteMedication', { method: 'POST', body: fd })).json();
                    if (d.success) {
                        const row = this.closest('.pf-med-row');
                        row.style.animation = 'pfFadeOut .3s ease forwards';
                        setTimeout(() => { row.remove(); toast('Medication removed.', 'info'); }, 300);
                    } else toast('Could not remove medication.', 'error');
                } catch { toast('Could not remove. Please try again.', 'error'); }
            }
            document.querySelectorAll('.pf-med-remove').forEach(btn => btn.addEventListener('click', removeHandler));

            // ── Password toggle ───────────────────────────────────────────────
            document.querySelectorAll('.pf-pw-eye').forEach(btn => {
                btn.addEventListener('click', function () {
                    const inp  = this.previousElementSibling;
                    const icon = this.querySelector('i');
                    if (inp.type === 'password') { inp.type = 'text';     icon.setAttribute('data-lucide', 'eye-off'); }
                    else                         { inp.type = 'password'; icon.setAttribute('data-lucide', 'eye'); }
                    icons();
                });
            });

            // ── Password strength ─────────────────────────────────────────────
            document.getElementById('newPassword')?.addEventListener('input', function () {
                const pw = this.value;
                const checks = { length: pw.length >= 8, upper: /[A-Z]/.test(pw), lower: /[a-z]/.test(pw), number: /[0-9]/.test(pw), special: /[!@@#$%^&*]/.test(pw) };
                let score = Object.values(checks).filter(Boolean).length;
                Object.entries(checks).forEach(([k, v]) => {
                    const el = document.getElementById('req-' + k);
                    if (!el) return;
                    el.classList.toggle('pf-req-ok', v);
                    const ic = el.querySelector('i');
                    ic.setAttribute('data-lucide', v ? 'check-circle-2' : 'circle');
                });
                icons();
                const mapArr = [[0,'0%','',''],[1,'20%','Very Weak','#ef4444'],[2,'40%','Weak','#f59e0b'],[3,'60%','Fair','#f59e0b'],[4,'80%','Good','#22c55e'],[5,'100%','Strong','#16a34a']];
                const [,w,text,color] = mapArr[score] ?? mapArr[0];
                const fill = document.getElementById('pwFill'); const label = document.getElementById('pwLabel');
                if (fill)  { fill.style.width = w; fill.style.background = color || '#e2e8f0'; }
                if (label) label.textContent = text || 'Password strength';
            });

            document.getElementById('passwordForm')?.addEventListener('submit', async function (e) {
                e.preventDefault();
                const cur = document.getElementById('currentPassword').value;
                const nw  = document.getElementById('newPassword').value;
                const cf  = document.getElementById('confirmPassword').value;
                if (!cur || !nw || !cf) { toast('Please fill in all password fields.', 'warning'); return; }
                if (nw !== cf)          { toast('New passwords do not match.', 'error'); return; }
                if (nw.length < 8)      { toast('Password must be at least 8 characters.', 'error'); return; }

                const sbtn = this.querySelector('button[type="submit"]'); busy(sbtn, 'Updating…');
                const fd = new FormData();
                fd.append('currentPassword', cur);
                fd.append('newPassword', nw);
                fd.append('confirmPassword', cf);
                fd.append('__RequestVerificationToken', TOKEN);
                try {
                    const d = await (await fetch('/Account/ChangePassword', { method: 'POST', body: fd })).json();
                    if (d.success) {
                        toast('Password updated successfully!');
                        this.reset();
                        const fill = document.getElementById('pwFill');
                        const label = document.getElementById('pwLabel');
                        if (fill) { fill.style.width = '0%'; fill.style.background = '#e2e8f0'; }
                        if (label) label.textContent = 'Password strength';
                    } else { toast(d.message || 'Could not update password.', 'error'); }
                } catch { toast('Could not update password. Please try again.', 'error'); }
                finally { unbusy(sbtn); }
            });

            // ── Download My Data ─────────────────────────────────────────────
            document.getElementById('downloadDataBtn')?.addEventListener('click', async function () {
                const fd = new FormData();
                fd.append('__RequestVerificationToken', TOKEN);
                const btn = this; busy(btn, 'Preparing…');
                try {
                    const response = await fetch('/Account/DownloadMyData', { method: 'POST', body: fd });
                    if (!response.ok) { toast('Could not download data. Please try again.', 'error'); return; }
                    const blob = await response.blob();
                    const url = window.URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    const cd = response.headers.get('Content-Disposition') || '';
                    const match = cd.match(/filename="?([^";]+)"?/i);
                    link.href = url;
                    link.download = match?.[1] || 'my-data.csv';
                    document.body.appendChild(link);
                    link.click();
                    link.remove();
                    window.URL.revokeObjectURL(url);
                    toast('Data downloaded successfully!');
                } catch { toast('Could not download data. Please try again.', 'error'); }
                finally { unbusy(btn); }
            });

            // ── Delete Account ────────────────────────────────────────────────
            document.getElementById('deleteAccountBtn')?.addEventListener('click', async function () {
                if (!confirm('Are you sure you want to delete your account? This action cannot be undone.')) return;
                const fd = new FormData();
                fd.append('__RequestVerificationToken', TOKEN);
                const btn = this; busy(btn, 'Deleting…');
                try {
                    const response = await fetch('/Account/DeleteAccount', { method: 'POST', body: fd });
                    const data = await response.json();
                    if (data.success) {
                        toast('Your account has been deleted.', 'info');
                        setTimeout(() => { window.location.href = data.redirectUrl || '/Account/Login'; }, 700);
                        return;
                    }
                    toast(data.message || 'Could not delete account.', 'error');
                } catch { toast('Could not delete account. Please try again.', 'error'); }
                finally { unbusy(btn); }
            });

            function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
        })();
    </script>

    <style>
        /* ══════════════════════════════════════════════════════════
           PATIENT PROFILE — Premium Healthcare SaaS (2026 redesign)
        ══════════════════════════════════════════════════════════ */
        :root {
            --pp-primary: #1baebe;
            --pp-primary-dk: #138fa0;
            --pp-primary-lt: #f0fdfe;
            --pp-violet: #22c9db;
            --pp-ink: #1e293b;
            --pp-text: #4a4458;
            --pp-muted: #4a5568;
            --pp-faint: #8896ab;
            --pp-line: #e4eaf2;
            --pp-bg: #fdf6f4;
            --pp-card: #ffffff;
            --pp-r-lg: 24px;
            --pp-r-md: 18px;
            --pp-r-sm: 12px;
            --pp-sh-sm: 0 4px 16px rgba(15, 23, 42,.06);
            --pp-sh-md: 0 10px 30px rgba(15, 23, 42,.1);
            --pp-sh-hero: 0 12px 30px rgba(15, 23, 42,.12);
        }

        .page-content { background: var(--pp-bg); }

        /* Lucide renders each <i data-lucide> as <svg class="lucide">. Size icons in
           em so they track surrounding text; structural rings are plain <svg> (no .lucide). */
        svg.lucide { width: 1.15em; height: 1.15em; stroke-width: 2; flex-shrink: 0; }
        .pf-med-chip svg.lucide { width: .85rem; height: .85rem; }
        .pp-hint svg.lucide { width: .9rem; height: .9rem; }
        .pf-pw-reqs li svg.lucide { width: 1rem; height: 1rem; }
        .pf-radio-box svg.lucide { width: .7rem; height: .7rem; }
        .pf-ls-status svg.lucide { width: 1.3rem; height: 1.3rem; }
        .pf-toast svg.lucide { width: 1.2rem; height: 1.2rem; }
        .pp-readout > svg.lucide { width: 1.15rem; height: 1.15rem; color: var(--pp-primary); }
        .pp-card-icon svg.lucide, .pp-habit-icon svg.lucide, .pf-med-pill-icon svg.lucide { width: 1.2rem; height: 1.2rem; }

        .pp-spin { animation: ppSpin .85s linear infinite; }
        @@keyframes ppSpin { to { transform: rotate(360deg); } }

        /* ── HERO ──────────────────────────────────────────── */
        .pp-hero {
            position: relative;
            border-radius: 28px;
            padding: 2.4rem;
            margin-bottom: 1.5rem;
            overflow: hidden;
            background:
                radial-gradient(125% 150% at 0% 0%, #e0f7fa 0%, transparent 55%),
                radial-gradient(130% 150% at 100% 100%, #e0f7fa 0%, transparent 55%),
                linear-gradient(120deg, #f0fdfe 0%, #f0fdfe 50%, #f0fdfe 100%);
            border: 1px solid rgba(255,255,255,.7);
            box-shadow: var(--pp-sh-hero);
        }
        .pp-hero-orbs { position: absolute; inset: 0; pointer-events: none; }
        .pp-orb { position: absolute; border-radius: 50%; filter: blur(10px); opacity: .55; }
        .pp-orb-1 { width: 260px; height: 260px; top: -90px; right: -60px; background: radial-gradient(circle, rgba(34, 201, 219,.28), transparent 70%); }
        .pp-orb-2 { width: 200px; height: 200px; bottom: -110px; left: 20%; background: radial-gradient(circle, rgba(27, 174, 190,.26), transparent 70%); }
        .pp-orb-3 { width: 140px; height: 140px; top: 20%; left: -50px; background: radial-gradient(circle, rgba(34, 201, 219,.24), transparent 70%); }

        .pp-hero-glass {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .pp-hero-identity { display: flex; align-items: center; gap: 1.3rem; }

        .pp-avatar { position: relative; flex-shrink: 0; }
        .pp-avatar img {
            width: 92px; height: 92px; border-radius: 24px;
            object-fit: cover;
            border: 3px solid rgba(255,255,255,.85);
            box-shadow: 0 14px 30px rgba(15, 23, 42,.25);
        }
        .pp-avatar-verify {
            position: absolute; right: -6px; bottom: -6px;
            width: 30px; height: 30px; border-radius: 50%;
            background: linear-gradient(135deg, #34d399, #10b981);
            border: 3px solid #fff;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: .8rem;
        }

        .pp-hero-text { display: flex; flex-direction: column; gap: .5rem; }
        .pp-hero-nameline { display: flex; align-items: center; gap: .7rem; flex-wrap: wrap; }
        .pp-hero-name { margin: 0; font-size: 1.75rem; font-weight: 800; color: var(--pp-ink); letter-spacing: -.02em; }

        .pp-verify {
            display: inline-flex; align-items: center; gap: .35rem;
            padding: .28rem .75rem; border-radius: 30px;
            font-size: .72rem; font-weight: 800;
        }
        .pp-verify.is-verified { background: #ecfdf5; color: #059669; border: 1px solid #b8efd4; }
        .pp-verify.is-pending  { background: #fffaf0; color: #d97706; border: 1px solid #fde68a; }

        .pp-hero-email { margin: 0; font-size: .9rem; color: var(--pp-muted); display: flex; align-items: center; gap: .45rem; }

        .pp-hero-badges { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .25rem; }
        .pp-badge {
            display: inline-flex; align-items: center; gap: .4rem;
            padding: .38rem .85rem; border-radius: 30px;
            font-size: .76rem; font-weight: 700;
            border: 1px solid rgba(255,255,255,.9); color: var(--pp-muted); background: rgba(255,255,255,.7);
            box-shadow: 0 3px 10px rgba(15, 23, 42,.05);
        }
        .pp-badge-active { background: #ecfdf5; color: #059669; border-color: #b8efd4; }
        .pp-badge-idle   { background: rgba(255,255,255,.7); color: var(--pp-muted); }
        .pp-badge-week   { background: #eff6ff; color: #2563eb; border-color: #bcd8ff; }
        .pp-badge-trim   { background: #f0fdfe; color: #138fa0; border-color: #e0f7fa; }
        .pp-badge-due    { background: #fffaf0; color: #d97706; border-color: #fde68a; }

        /* hero ring */
        .pp-hero-progress { flex-shrink: 0; }
        .pp-hero-ring { position: relative; width: 128px; height: 128px; }
        .pp-hero-ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
        .pp-hero-ring .pp-ring-bg { fill: none; stroke: rgba(15, 23, 42,.14); stroke-width: 2.6; }
        .pp-hero-ring .pp-ring-fg { fill: none; stroke-width: 2.6; stroke-linecap: round; transition: stroke-dasharray .8s cubic-bezier(.4,0,.2,1); }
        .pp-hero-ring-center {
            position: absolute; inset: 0; display: flex; flex-direction: column;
            align-items: center; justify-content: center; gap: .1rem;
        }
        .pp-hero-ring-num { font-size: 2rem; font-weight: 800; color: var(--pp-ink); line-height: 1; }
        .pp-hero-ring-lbl { font-size: .68rem; font-weight: 600; color: var(--pp-muted); text-transform: uppercase; letter-spacing: .05em; }

        /* ── FLASH ─────────────────────────────────────────── */
        .pp-flash {
            display: flex; align-items: center; gap: .6rem;
            padding: .9rem 1.2rem; margin-bottom: 1.25rem;
            background: var(--pp-primary-lt); color: var(--pp-primary-dk);
            border: 1px solid #fde0e6; border-radius: var(--pp-r-sm); font-size: .9rem; font-weight: 500;
        }

        /* ── LAYOUT ────────────────────────────────────────── */
        .pp-layout {
            display: grid;
            grid-template-columns: 300px minmax(0, 1fr);
            gap: 1.5rem;
            align-items: start;
        }
        /* min-width:0 lets grid children shrink below content width so wide
           rows (tabs, snapshot strip, chips) scroll instead of widening the page */
        .pp-summary, .pp-main { min-width: 0; }
        @@media (max-width: 1024px) { .pp-layout { grid-template-columns: minmax(0, 1fr); } }

        /* ── STICKY SUMMARY ────────────────────────────────── */
        .pp-summary-inner {
            position: sticky; top: 1rem;
            background: var(--pp-card);
            border: 1px solid var(--pp-line);
            border-radius: var(--pp-r-md);
            box-shadow: var(--pp-sh-sm);
            padding: 1.3rem;
            display: flex; flex-direction: column; gap: .85rem;
        }
        .pp-summary-head h2 { margin: 0; font-size: 1.05rem; font-weight: 800; color: var(--pp-ink); }
        .pp-summary-head p { margin: .15rem 0 .3rem; font-size: .78rem; color: var(--pp-muted); }

        .pp-stat-grid { display: flex; flex-direction: column; gap: .85rem; }

        .pp-stat {
            display: flex; align-items: center; gap: .9rem;
            padding: .7rem; border-radius: var(--pp-r-sm);
            background: #f3f6fb; border: 1px solid var(--pp-line);
            transition: transform .18s, box-shadow .18s;
        }
        .pp-stat:hover { transform: translateY(-2px); box-shadow: var(--pp-sh-sm); }

        .pp-stat-ring { position: relative; width: 50px; height: 50px; flex-shrink: 0; }
        .pp-stat-ring svg:not(.lucide) { width: 100%; height: 100%; transform: rotate(-90deg); }
        .pp-stat-ring .pp-ring-bg { fill: none; stroke: #eef2f6; stroke-width: 3; }
        .pp-stat-ring .pp-ring-fg { fill: none; stroke-width: 3; stroke-linecap: round; transition: stroke-dasharray .8s cubic-bezier(.4,0,.2,1); }
        .pp-stat-ring svg.lucide {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
            width: 1.15rem; height: 1.15rem; color: var(--pp-muted);
        }
        .pp-ring-teal   .pp-ring-fg { stroke: #1baebe; } .pp-ring-teal svg.lucide { color: #1baebe; }
        .pp-ring-amber  .pp-ring-fg { stroke: #f59e0b; } .pp-ring-amber svg.lucide { color: #d97706; }
        .pp-ring-purple .pp-ring-fg { stroke: #22c9db; } .pp-ring-purple svg.lucide { color: #138fa0; }

        .pp-stat-icon {
            width: 50px; height: 50px; border-radius: 14px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center; font-size: 1.2rem; color: #fff;
        }
        .pp-ic-green { background: linear-gradient(135deg, #34d399, #059669); }
        .pp-ic-pink  { background: linear-gradient(135deg, #22c9db, #138fa0); }

        .pp-stat-meta { display: flex; flex-direction: column; }
        .pp-stat-num { font-size: 1.5rem; font-weight: 800; color: var(--pp-ink); line-height: 1; }
        .pp-stat-lbl { font-size: .74rem; font-weight: 600; color: var(--pp-muted); margin-top: .2rem; }

        /* ── TABS (segmented) ──────────────────────────────── */
        .pp-tabs {
            display: flex; gap: .25rem; margin-bottom: 1.25rem;
            background: #faf2f6; border: 1px solid var(--pp-line);
            padding: .35rem; border-radius: 16px; box-shadow: var(--pp-sh-sm);
            overflow-x: auto; scrollbar-width: none;
        }
        .pp-tabs::-webkit-scrollbar { display: none; }
        .pf-tab {
            flex: 1; min-width: max-content;
            display: inline-flex; align-items: center; justify-content: center; gap: .45rem;
            padding: .6rem 1rem; border-radius: 12px; border: none; background: transparent;
            font-size: .85rem; font-weight: 600; color: var(--pp-muted); cursor: pointer;
            font-family: inherit; transition: all .22s cubic-bezier(.4,0,.2,1); white-space: nowrap;
        }
        .pf-tab:hover { color: var(--pp-ink); }
        .pf-tab.active {
            background: var(--pp-card); color: var(--pp-primary-dk);
            box-shadow: 0 2px 8px rgba(15,23,42,.1);
        }
        @@media (max-width: 560px) { .pf-tab span { display: none; } .pf-tab { flex: 1; padding: .65rem; } }

        .pf-tab-content { display: none; }
        .pf-tab-content.active { display: block; animation: ppPanelIn .35s cubic-bezier(.16,1,.3,1); }
        @@keyframes ppPanelIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .pp-stack { display: flex; flex-direction: column; gap: 1.25rem; }
        .pp-stack-tight { display: flex; flex-direction: column; gap: 1.1rem; }

        /* ── CARDS ─────────────────────────────────────────── */
        .pp-card {
            background: var(--pp-card); border: 1px solid var(--pp-line);
            border-radius: var(--pp-r-md); box-shadow: var(--pp-sh-sm);
            overflow: hidden; margin-bottom: 1.25rem; transition: box-shadow .2s;
        }
        .pp-card:hover { box-shadow: var(--pp-sh-md); }
        .pp-stack .pp-card, .pp-stack-tight .pp-card { margin-bottom: 0; }

        .pp-card-head {
            display: flex; align-items: center; justify-content: space-between; gap: 1rem;
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid var(--pp-line);
        }
        .pp-card-title { display: flex; align-items: center; gap: .9rem; }
        .pp-card-title h3 { margin: 0; font-size: 1.02rem; font-weight: 800; color: var(--pp-ink); letter-spacing: -.01em; }
        .pp-card-title p { margin: .12rem 0 0; font-size: .8rem; color: var(--pp-muted); }
        .pp-card-icon {
            width: 44px; height: 44px; border-radius: 13px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center; font-size: 1.05rem; color: #fff;
        }
        .pp-grad-teal   { background: linear-gradient(135deg, #1baebe, #22c9db); }
        .pp-grad-indigo { background: linear-gradient(135deg, #818cf8, #4f46e5); }
        .pp-grad-purple { background: linear-gradient(135deg, #22c9db, #138fa0); }
        .pp-grad-pink   { background: linear-gradient(135deg, #22c9db, #138fa0); }
        .pp-grad-red    { background: linear-gradient(135deg, #1baebe, #138fa0); }
        .pp-grad-orange { background: linear-gradient(135deg, #fbbf24, #d97706); }
        .pp-grad-green  { background: linear-gradient(135deg, #34d399, #059669); }
        .pp-grad-danger { background: linear-gradient(135deg, #f87171, #b91c1c); }

        .pp-card-body { padding: 1.5rem; }
        .pp-head-actions { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }

        .pp-readonly-tag {
            display: inline-flex; align-items: center; gap: .35rem;
            font-size: .72rem; font-weight: 600; color: var(--pp-faint);
            background: #f1f5f9; padding: .3rem .65rem; border-radius: 20px;
        }

        /* ── BUTTONS ───────────────────────────────────────── */
        .pp-edit-btn {
            display: inline-flex; align-items: center; gap: .4rem;
            padding: .5rem .95rem; border-radius: 11px; border: 1.5px solid var(--pp-line);
            background: #fff; font-size: .82rem; font-weight: 700; color: var(--pp-muted);
            cursor: pointer; font-family: inherit; transition: all .18s;
        }
        .pp-edit-btn:hover { border-color: var(--pp-primary); color: var(--pp-primary-dk); background: var(--pp-primary-lt); }

        .pp-btn-primary {
            display: inline-flex; align-items: center; gap: .45rem;
            padding: .65rem 1.35rem; border-radius: 12px; border: none;
            background: linear-gradient(120deg, var(--pp-primary), #22c9db);
            color: #fff; font-size: .88rem; font-weight: 700; cursor: pointer; font-family: inherit;
            box-shadow: 0 8px 18px rgba(34, 201, 219,.35); transition: all .18s;
        }
        .pp-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 12px 26px rgba(34, 201, 219,.45); }
        .pp-btn-primary:disabled { opacity: .7; cursor: progress; transform: none; }

        .pp-btn-ghost {
            display: inline-flex; align-items: center; gap: .4rem;
            padding: .65rem 1.15rem; border-radius: 12px; border: 1.5px solid var(--pp-line);
            background: #f8fafc; color: var(--pp-muted); font-size: .88rem; font-weight: 700;
            cursor: pointer; font-family: inherit; transition: all .18s;
        }
        .pp-btn-ghost:hover { background: #eef2f6; color: var(--pp-ink); }

        .pp-btn-outline {
            display: inline-flex; align-items: center; gap: .4rem;
            padding: .55rem 1.05rem; border-radius: 11px; border: 1.5px solid var(--pp-line);
            background: #fff; font-size: .82rem; font-weight: 700; color: var(--pp-muted);
            cursor: pointer; font-family: inherit; white-space: nowrap; transition: all .18s;
        }
        .pp-btn-outline:hover { border-color: var(--pp-primary); color: var(--pp-primary-dk); }

        .pp-btn-danger-soft {
            display: inline-flex; align-items: center; gap: .4rem;
            padding: .55rem 1.05rem; border-radius: 11px; border: 1.5px solid #fecaca;
            background: #fef2f2; font-size: .82rem; font-weight: 700; color: #dc2626;
            cursor: pointer; font-family: inherit; white-space: nowrap; transition: all .18s;
        }
        .pp-btn-danger-soft:hover { background: #fee2e2; border-color: #f87171; }

        .pp-actions {
            display: flex; justify-content: flex-end; gap: .6rem;
            padding-top: 1.1rem; margin-top: .25rem; border-top: 1px dashed var(--pp-line);
        }

        /* ── FIELDS ────────────────────────────────────────── */
        .pp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
        .pp-grid-3 { grid-template-columns: 1fr 1fr 1fr; }
        .pp-col-full { grid-column: 1 / -1; }
        @@media (max-width: 640px) { .pp-grid, .pp-grid-3 { grid-template-columns: 1fr; } }

        .pp-field { display: flex; flex-direction: column; gap: .45rem; }
        .pp-field label { font-size: .8rem; font-weight: 700; color: var(--pp-text); }
        .pp-req { color: #ef4444; }

        .pf-input {
            width: 100%; padding: .7rem .95rem; border: 1.5px solid var(--pp-line);
            border-radius: var(--pp-r-sm); font-size: .9rem; font-family: inherit;
            color: var(--pp-text); background: #fff; outline: none;
            transition: border-color .18s, box-shadow .18s, background .18s;
        }
        .pf-input:focus { border-color: var(--pp-primary); box-shadow: 0 0 0 4px rgba(34, 201, 219,.18); }
        .pf-input:disabled { background: #f3f6fb; color: var(--pp-text); opacity: 1; cursor: default; }
        .pp-calc-input { font-weight: 700; }

        .pp-input-icon { position: relative; display: flex; align-items: center; }
        .pp-input-icon > svg.lucide:first-child {
            position: absolute; left: .85rem; width: 1.05rem; height: 1.05rem;
            color: var(--pp-faint); pointer-events: none; z-index: 1;
        }
        .pp-input-icon .pf-input { padding-left: 2.4rem; }
        .pp-inline-verify {
            position: absolute; right: .6rem; display: inline-flex; align-items: center; gap: .25rem;
            font-size: .68rem; font-weight: 700; padding: .2rem .55rem; border-radius: 20px;
        }
        .pp-inline-verify.is-verified { background: #ecfdf5; color: #059669; }
        .pp-inline-verify.is-pending  { background: #fffbeb; color: #d97706; }

        .pp-readout-row { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.25rem; }
        .pp-readout {
            flex: 1; min-width: 150px; display: flex; align-items: center; gap: .7rem;
            padding: .8rem .9rem; border-radius: var(--pp-r-sm); background: #f3f6fb; border: 1px solid var(--pp-line);
        }
        .pp-readout > i { color: var(--pp-primary); font-size: 1.05rem; }
        .pp-readout span { display: block; font-size: .72rem; color: var(--pp-muted); }
        .pp-readout strong { display: block; font-size: .9rem; color: var(--pp-ink); font-weight: 700; }

        .pp-hint { font-size: .73rem; color: var(--pp-faint); display: flex; align-items: center; gap: .3rem; }

        /* input with unit (keep pf- hooks) */
        .pf-input-unit {
            display: flex; border: 1.5px solid var(--pp-line); border-radius: var(--pp-r-sm);
            overflow: hidden; background: #fff; transition: border-color .18s, box-shadow .18s;
        }
        .pf-input-unit:focus-within { border-color: var(--pp-primary); box-shadow: 0 0 0 4px rgba(34, 201, 219,.18); }
        .pf-input-unit .pf-input { border: none; box-shadow: none; }
        .pf-unit-badge {
            padding: .5rem .85rem; font-size: .74rem; font-weight: 700; background: #f1f5f9;
            color: var(--pp-muted); border-left: 1px solid var(--pp-line); display: flex; align-items: center; white-space: nowrap;
        }
        .pf-bmi-badge.normal      { color: #15803d; background: #f0fdf4; }
        .pf-bmi-badge.underweight { color: #1d4ed8; background: #eff6ff; }
        .pf-bmi-badge.overweight  { color: #c2410c; background: #fff7ed; }
        .pf-bmi-badge.obese       { color: #b91c1c; background: #fef2f2; }

        /* ── CALC BOX ──────────────────────────────────────── */
        .pp-calc-box {
            display: flex; flex-direction: column; gap: .2rem;
            padding: .65rem 1rem; border: 1.5px solid var(--pp-line);
            border-radius: var(--pp-r-sm); background: linear-gradient(135deg,#f8fafc,#f1f7f9);
        }
        .pp-calc-main { font-size: 1.05rem; font-weight: 800; color: var(--pp-ink); }
        .pp-calc-sub { font-size: .78rem; color: var(--pp-muted); }

        /* ── DIVIDER ───────────────────────────────────────── */
        .pp-divider { display: flex; align-items: center; gap: .85rem; }
        .pp-divider::before, .pp-divider::after { content: ""; flex: 1; height: 1px; background: var(--pp-line); }
        .pp-divider span { font-size: .76rem; font-weight: 700; color: var(--pp-muted); white-space: nowrap; text-transform: uppercase; letter-spacing: .04em; }

        /* ── RADIO (keep pf- hooks) ────────────────────────── */
        .pf-radio-row { display: flex; gap: .75rem; flex-wrap: wrap; }
        .pf-radio-opt {
            display: flex; align-items: center; gap: .55rem; cursor: pointer; font-size: .88rem;
            color: var(--pp-text); padding: .55rem 1rem; border: 1.5px solid var(--pp-line);
            border-radius: var(--pp-r-sm); background: #fff; transition: all .18s; font-weight: 600;
        }
        .pf-radio-opt:has(input:checked) { border-color: var(--pp-primary); background: var(--pp-primary-lt); color: var(--pp-primary-dk); }
        .pf-radio-opt input { display: none; }
        .pf-radio-box {
            width: 20px; height: 20px; border-radius: 50%; border: 2px solid #cbd5e1;
            display: flex; align-items: center; justify-content: center; color: transparent;
            flex-shrink: 0; transition: all .18s;
        }
        .pf-radio-box i { width: .7rem; height: .7rem; }
        .pf-radio-opt:has(input:checked) .pf-radio-box { border-color: var(--pp-primary); background: var(--pp-primary); color: #fff; }

        /* ── PREGNANCY — gender theme tokens (default: neutral) ── */
        .pp-preg-wrap {
            --pp-baby: #8b9bff;
            --pp-baby-dk: #6d5bd0;
            --pp-baby-soft: #f5f3ff;
            --pp-baby-border: #e4ddf7;
            --pp-baby-grad: linear-gradient(90deg, #fb7baf, #8b9bff);
            --pp-j-bg:
                radial-gradient(720px 300px at 92% -30%, rgba(251,123,175,.20), transparent 60%),
                radial-gradient(620px 300px at 0% 130%, rgba(139,155,255,.20), transparent 60%),
                linear-gradient(135deg, #fff6fb 0%, #f6f3ff 50%, #eef6ff 100%);
            --pp-j-border: #efe1f1;
            --pp-j-shadow: rgba(150,120,185,.16);
        }
        .pp-preg-wrap.pp-gender-female {
            --pp-baby: #ec4899; --pp-baby-dk: #be185d; --pp-baby-soft: #fff0f7; --pp-baby-border: #fbcfe8;
            --pp-baby-grad: linear-gradient(90deg, #f9a8d4, #ec4899);
            --pp-j-bg:
                radial-gradient(720px 300px at 92% -30%, rgba(236,72,153,.20), transparent 60%),
                radial-gradient(620px 300px at 0% 130%, rgba(244,114,182,.16), transparent 60%),
                linear-gradient(135deg, #fff5fa 0%, #ffeef6 55%, #fff0f8 100%);
            --pp-j-border: #fbd6e7; --pp-j-shadow: rgba(190,24,93,.16);
            --pp-primary: #ec4899; --pp-primary-dk: #be185d; --pp-primary-lt: #fff0f7;
        }
        .pp-preg-wrap.pp-gender-male {
            --pp-baby: #3b82f6; --pp-baby-dk: #1d4ed8; --pp-baby-soft: #eff6ff; --pp-baby-border: #bfdbfe;
            --pp-baby-grad: linear-gradient(90deg, #93c5fd, #3b82f6);
            --pp-j-bg:
                radial-gradient(720px 300px at 92% -30%, rgba(59,130,246,.18), transparent 60%),
                radial-gradient(620px 300px at 0% 130%, rgba(96,165,250,.16), transparent 60%),
                linear-gradient(135deg, #f5f9ff 0%, #eef5ff 55%, #f0f6ff 100%);
            --pp-j-border: #cfe0fb; --pp-j-shadow: rgba(29,78,216,.16);
            --pp-primary: #3b82f6; --pp-primary-dk: #1d4ed8; --pp-primary-lt: #eff6ff;
        }
        .pp-grad-baby { background: var(--pp-baby-grad); }

        /* ── PREGNANCY JOURNEY (baby-themed) ───────────────── */
        .pp-journey {
            position: relative; overflow: hidden; border-radius: var(--pp-r-lg);
            margin-bottom: 1.25rem; padding: 2rem;
            background: var(--pp-j-bg);
            border: 1px solid var(--pp-j-border);
            box-shadow: 0 12px 40px var(--pp-j-shadow);
            transition: background .5s ease, border-color .5s ease, box-shadow .5s ease;
        }
        .pp-journey-deco { position: absolute; inset: 0; pointer-events: none; }
        .pp-deco { position: absolute; opacity: .55; }
        .pp-deco-1 { font-size: 1.7rem; top: 16%; right: 9%;  animation: ppFloat 5s ease-in-out infinite; }
        .pp-deco-2 { font-size: 1.1rem; top: 62%; right: 17%; animation: ppFloat 6s ease-in-out infinite .4s; }
        .pp-deco-3 { font-size: 2rem;   top: 8%;  right: 27%; opacity: .4; animation: ppFloat 7s ease-in-out infinite .2s; }
        .pp-deco-4 { font-size: 1.2rem; bottom: 16%; left: 42%; animation: ppFloat 5.5s ease-in-out infinite .6s; }
        .pp-deco-5 { font-size: 1.5rem; bottom: 20%; right: 6%; animation: ppFloat 6.5s ease-in-out infinite .3s; }
        @@keyframes ppFloat { 0%,100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-10px) rotate(7deg); } }

        .pp-journey-top { position: relative; z-index: 1; display: flex; align-items: center; gap: 1.8rem; flex-wrap: wrap; }

        .pp-journey-ring { position: relative; width: 134px; height: 134px; flex-shrink: 0; }
        .pp-journey-ring svg:not(.lucide) { width: 100%; height: 100%; transform: rotate(-90deg); }
        .pp-jring-bg { fill: none; stroke: rgba(255,255,255,.8); stroke-width: 3; }
        .pp-jring-fg { fill: none; stroke: var(--pp-baby); stroke-width: 3; stroke-linecap: round; transition: stroke-dasharray .9s cubic-bezier(.4,0,.2,1), stroke .5s ease; filter: drop-shadow(0 2px 6px rgba(0,0,0,.18)); }
        .pp-journey-ring-c { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .pp-journey-emoji { font-size: 1.6rem; line-height: 1; animation: ppBob 3s ease-in-out infinite; }
        @@keyframes ppBob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
        .pp-journey-week { font-size: 1.75rem; font-weight: 800; color: var(--pp-ink); line-height: 1.05; }
        .pp-journey-wk { font-size: .66rem; font-weight: 700; color: var(--pp-muted); text-transform: uppercase; letter-spacing: .06em; }

        .pp-journey-info { flex: 1; min-width: 240px; }
        .pp-journey-tag {
            display: inline-block; padding: .3rem .85rem; border-radius: 30px;
            background: rgba(255,255,255,.72); border: 1px solid var(--pp-baby-border);
            font-size: .74rem; font-weight: 700; color: var(--pp-baby-dk); margin-bottom: .6rem;
        }
        .pp-journey-title { margin: 0 0 .55rem; font-size: 1.35rem; font-weight: 800; color: var(--pp-ink); letter-spacing: -.01em; }
        .pp-journey-size { margin: 0 0 .9rem; font-size: .95rem; color: var(--pp-text); display: flex; align-items: center; gap: .6rem; }
        .pp-journey-size strong { color: var(--pp-baby-dk); }
        .pp-size-emoji { font-size: 1.7rem; line-height: 1; flex-shrink: 0; }
        .pp-journey-chips { display: flex; flex-wrap: wrap; gap: .5rem; }
        .pp-jchip {
            display: inline-flex; align-items: center; gap: .4rem; padding: .42rem .9rem;
            border-radius: 30px; font-size: .78rem; font-weight: 700;
            background: rgba(255,255,255,.82); border: 1px solid #eef0f6; color: var(--pp-muted);
