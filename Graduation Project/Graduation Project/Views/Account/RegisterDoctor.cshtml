@{
    Layout = null;
    ViewData["Title"] = "Register as Doctor — NABD - نبض";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>
  <link rel="icon" type="image/png" href="~/images/logo.png" asp-append-version="true" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
</head>
<body>

<div class="rg-stage" data-portal="doctor">

  <!-- ── BRAND PANEL ───────────────────────────────────────── -->
  <aside class="rg-brand">
    <span class="rg-brand-glow" aria-hidden="true"></span>
    <svg class="rg-pulse" viewBox="0 0 460 80" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="rgPulse" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#2dd4bf" stop-opacity="0"/>
          <stop offset="45%" stop-color="#2dd4bf"/>
          <stop offset="80%" stop-color="#14B8A6"/>
          <stop offset="100%" stop-color="#14B8A6" stop-opacity="0"/>
        </linearGradient>
      </defs>
      <path d="M0 40 H180 l9 -24 9 48 8 -58 11 74 9 -40 H460" />
    </svg>

    <a class="rg-brand-lockup" href="@Url.Action("Index", "Home")">
      <span class="rg-brand-mark"><img src="~/images/logo.png" alt="NABD Logo" asp-append-version="true" /></span>
      <span>
        <span class="rg-brand-name">NABD <span style="font-weight:600">نبض</span></span>
        <span class="rg-brand-badge" style="display:block">Doctor Portal</span>
      </span>
    </a>

    <div class="rg-brand-mid">
      <h2 class="rg-headline">Join our<br><span class="grad">care network</span></h2>
      <p class="rg-desc">Connect with the patients who need your expertise. Manage appointments, review results, and deliver personalised care — all in one place.</p>
    </div>

    <div class="rg-features">
      <div class="rg-feature">
        <span class="rg-feature-ico"><i class="fas fa-users"></i></span>
        <span class="rg-feature-text">Manage your patient panel efficiently</span>
      </div>
      <div class="rg-feature">
        <span class="rg-feature-ico"><i class="fas fa-file-medical"></i></span>
        <span class="rg-feature-text">AI-assisted lab result review</span>
      </div>
      <div class="rg-feature">
        <span class="rg-feature-ico"><i class="fas fa-bell"></i></span>
        <span class="rg-feature-text">Real-time alerts for critical values</span>
      </div>
    </div>
  </aside>

  <!-- ── FORM COLUMN ───────────────────────────────────────── -->
  <main class="rg-main">
    <div class="rg-main-inner">

      <div class="rg-mobile-brand">
        <span class="rg-brand-mark"><img src="~/images/logo.png" alt="NABD Logo" asp-append-version="true" /></span>
        <span class="nm">NABD <span style="color:var(--rg-accent-deep)">نبض</span></span>
      </div>

      <!-- Portal selection -->
      <nav class="rg-switch" aria-label="Choose portal">
        <a class="rg-switch-item p" href="@Url.Action("RegisterPatient", "Account")">
          <span class="ico"><i class="fas fa-baby"></i></span>
          <span class="tx"><b>Patient</b><span>Mothers</span></span>
        </a>
        <span class="rg-switch-item d is-active" aria-current="page">
          <span class="ico"><i class="fas fa-user-md"></i></span>
          <span class="tx"><b>Doctor</b><span>Care team</span></span>
        </span>
        <a class="rg-switch-item a" href="@Url.Action("RegisterAssistant", "Account")">
          <span class="ico"><i class="fas fa-user-nurse"></i></span>
          <span class="tx"><b>Assistant</b><span>Clinic staff</span></span>
        </a>
      </nav>

      <div class="rg-card">
        <div class="rg-card-head">
          <span class="rg-card-icon"><i class="fas fa-user-md"></i></span>
          <div>
            <div class="rg-card-title">Doctor Registration</div>
            <div class="rg-card-sub">Create your physician account on NABD - نبض</div>
          </div>
        </div>

        <div class="rg-card-body">
          @if (TempData["AuthError"] is string authError)
          {
            <div class="rg-alert-error">
              <i class="fas fa-exclamation-circle"></i>
              <p>@authError</p>
            </div>
          }

          @using (Html.BeginForm("RegisterDoctor", "Account", FormMethod.Post,
                  new { id = "doctorForm", novalidate = "novalidate", enctype = "multipart/form-data" }))
          {
            @Html.AntiForgeryToken()

            <div class="rg-section">
              <span class="rg-section-ico"><i class="fas fa-id-badge"></i></span>
              <div>
                <div class="rg-section-h">Your details</div>
                <div class="rg-section-sub">How patients and colleagues will know you</div>
              </div>
            </div>

            <div class="mc-row">
              <div class="mc-form-group">
                <label class="mc-label" for="FirstName"><i class="fas fa-user"></i> First Name <span class="req">*</span></label>
                <input type="text" id="FirstName" name="FirstName" class="mc-input" placeholder="Dr. Fatima" required autocomplete="given-name" />
              </div>
              <div class="mc-form-group">
                <label class="mc-label" for="LastName"><i class="fas fa-user"></i> Last Name <span class="req">*</span></label>
                <input type="text" id="LastName" name="LastName" class="mc-input" placeholder="Hassan" required autocomplete="family-name" />
              </div>
            </div>

            <div class="mc-form-group">
              <label class="mc-label" for="Email"><i class="fas fa-envelope"></i> Email Address <span class="req">*</span></label>
              <div class="mc-input-wrap">
                <input type="email" id="Email" name="Email" class="mc-input has-icon" placeholder="doctor@hospital.com" required autocomplete="email" />
                <i class="mc-input-icon fas fa-envelope"></i>
              </div>
            </div>

            <div class="mc-form-group">
              <label class="mc-label" for="PhoneNumber"><i class="fas fa-phone"></i> Phone Number <span class="req">*</span></label>
              <div class="mc-input-wrap">
                <input type="tel" id="PhoneNumber" name="PhoneNumber" class="mc-input has-icon" placeholder="+20 xxx xxx xxxx" required autocomplete="tel" />
                <i class="mc-input-icon fas fa-phone"></i>
              </div>
            </div>

            <div class="rg-section">
              <span class="rg-section-ico"><i class="fas fa-lock"></i></span>
              <div>
                <div class="rg-section-h">Account security</div>
                <div class="rg-section-sub">Choose a strong password</div>
              </div>
            </div>

            <div class="mc-row">
              <div class="mc-form-group">
                <label class="mc-label" for="Password"><i class="fas fa-lock"></i> Password <span class="req">*</span></label>
                <div class="mc-input-wrap">
                  <input type="password" id="Password" name="Password" class="mc-input has-eye" placeholder="Min. 8 characters" required data-min-length="8" autocomplete="new-password" />
                  <button type="button" class="mc-input-eye"><i class="fas fa-eye"></i></button>
                </div>
                <div class="mc-pwd-strength">
                  <div class="mc-pwd-strength-bar"><div class="mc-pwd-strength-fill" id="pwdBar"></div></div>
                  <div class="mc-pwd-strength-label" id="pwdLabel"></div>
                </div>
              </div>
              <div class="mc-form-group">
                <label class="mc-label" for="ConfirmPassword"><i class="fas fa-lock"></i> Confirm Password <span class="req">*</span></label>
                <div class="mc-input-wrap">
                  <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="mc-input has-eye" placeholder="Repeat password" required data-match="Password" autocomplete="new-password" />
                  <button type="button" class="mc-input-eye"><i class="fas fa-eye"></i></button>
                </div>
              </div>
            </div>

            <div class="rg-section">
              <span class="rg-section-ico"><i class="fas fa-stethoscope"></i></span>
              <div>
                <div class="rg-section-h">Professional profile</div>
                <div class="rg-section-sub">Helps us verify and route patients to you</div>
              </div>
            </div>

            <div class="mc-form-group">
              <label class="mc-label" for="MedicalSpecialty"><i class="fas fa-stethoscope"></i> Medical Specialty <span class="req">*</span></label>
              <select id="MedicalSpecialty" name="MedicalSpecialty" class="mc-select" required>
                <option value="">— Select specialty —</option>
                <option value="Obstetrics">Obstetrics &amp; Gynaecology</option>
                <option value="MaternalFetal">Maternal-Fetal Medicine</option>
                <option value="InternalMedicine">Internal Medicine</option>
                <option value="GeneralPractice">General Practice</option>
                <option value="Endocrinology">Endocrinology</option>
                <option value="Cardiology">Cardiology</option>
                <option value="Nutrition">Clinical Nutrition</option>
                <option value="Psychiatry">Psychiatry</option>
                <option value="Other">Other</option>
              </select>
            </div>

            <div class="mc-form-group">
              <label class="mc-label"><i class="fas fa-id-card"></i> Proof of Medical License <span class="req">*</span></label>
              <div class="mc-file-zone" id="licenseZone">
                <input type="file" id="LicenseFile" name="LicenseFile" accept=".pdf,.jpg,.jpeg,.png" required />
                <i class="fas fa-cloud-upload-alt"></i>
                <div class="mc-file-title">Upload your medical license</div>
                <div class="mc-file-sub">PDF, JPG, or PNG &nbsp;·&nbsp; Max 5 MB</div>
                <div class="mc-file-name" id="licenseFileName"></div>
              </div>
              <div class="mc-feedback hint"><i class="fas fa-shield-alt"></i> Encrypted and only visible to NABD - نبض administrators for verification.</div>
            </div>

            <div class="rg-note ok">
              <i class="fas fa-clock"></i>
              <span>Your account will be reviewed within <strong>1–2 business days</strong>. You'll receive an email once verified.</span>
            </div>

            <button type="submit" class="mc-btn mc-btn-primary mt-2">
              <i class="fas fa-paper-plane"></i> Submit Registration
            </button>
          }
        </div>

        <div class="rg-card-foot">
          Already registered? <a href="@Url.Action("Login", "Account")" class="mc-link">Sign in</a>
        </div>
      </div>

    </div>
  </main>
</div>

<script src="~/js/auth.js"></script>
<script>
(function () {
  'use strict';
  initLiveValidation('doctorForm');
  initPasswordStrength('Password', 'pwdBar', 'pwdLabel');

  document.getElementById('doctorForm').addEventListener('submit', function (e) {
    if (!validateForm('doctorForm')) {
      e.preventDefault();
      showToast('Please fix the errors before submitting.', 'error');
      return;
    }

    const file = document.getElementById('LicenseFile');
    if (!file.files.length) {
      e.preventDefault();
      setFieldState(file, 'Please upload your medical license.');
      showToast('Medical license upload is required.', 'error');
      return;
    }

    if (file.files[0].size > 5 * 1024 * 1024) {
      e.preventDefault();
      setFieldState(file, 'File must be under 5 MB.');
      showToast('File size exceeds 5 MB.', 'error');
    }
  });

  document.getElementById('LicenseFile').addEventListener('change', function () {
    const el = document.getElementById('licenseFileName');
    if (this.files.length) el.textContent = '✓ ' + this.files[0].name;
  });
}());
</script>
</body>
</html>
