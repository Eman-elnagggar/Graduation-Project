@{
    Layout = null;
    ViewData["Title"] = "Email Sent — NABD - نبض";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>
  <link rel="icon" type="image/png" href="~/images/logo.png" asp-append-version="true" />
  <partial name="_PwaHead" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body>
<div class="auth-shell">
  <aside class="auth-panel">
    <a class="panel-brand panel-brand-link" href="@Url.Action("Index", "Home")">
      <div class="panel-brand-icon"><img src="~/images/logo.png" alt="NABD Logo" asp-append-version="true" /></div>
      <div>
        <div class="panel-brand-name">NABD - نبض</div>
        <div class="panel-brand-badge" style="white-space: nowrap; letter-spacing: .04em; font-size: .62rem;">Securing the pulse of the next generation.</div>
      </div>
    </a>
  </aside>

  <main class="auth-form-area">
    <div class="auth-form-wrap">
      <div class="mobile-brand">
        <div class="mobile-brand-icon"><img src="~/images/logo.png" alt="NABD Logo" asp-append-version="true" /></div>
        <div class="mobile-brand-name">NABD - نبض</div>
      </div>

      <div class="auth-card text-center" style="text-align: center; padding: 3rem 2rem;">
        <i class="fas fa-envelope-open-text" style="font-size: 3rem; color: var(--mc-primary); margin-bottom: 1rem;"></i>
        <h3 style="font-size: 1.5rem; color: var(--mc-text); margin-bottom: 0.5rem;">Check your email</h3>
        <p style="color: var(--mc-muted); margin-bottom: 1.5rem;">
            Please check your email to reset your password. If you don't see it, check your spam folder.
        </p>
        
        <a href="@Url.Action("Login", "Account")" class="mc-btn mc-btn-primary" style="display: inline-block; width: auto; padding: 0.5rem 1.5rem;">
          <i class="fas fa-sign-in-alt"></i> Return to Login
        </a>
      </div>
    </div>
  </main>
</div>
</body>
</html>
