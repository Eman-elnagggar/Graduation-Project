@model Graduation_Project.ViewModels.ResetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Reset Password — NABD - نبض";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>
  <link rel="icon" type="image/png" href="~/images/logo.png" asp-append-version="true" />
  <partial name="_PwaHead" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body>
<div class="auth-shell">
  <aside class="auth-panel">
    <a class="panel-brand panel-brand-link" href="@Url.Action("Index", "Home")">
      <div class="panel-brand-icon"><img src="~/images/logo.png" alt="NABD Logo" asp-append-version="true" /></div>
      <div>
        <div class="panel-brand-name">NABD - نبض</div>
        <div class="panel-brand-badge" style="white-space: nowrap; letter-spacing: .04em; font-size: .62rem;">Securing the pulse of the next generation.</div>
      </div>
    </a>
  </aside>

  <main class="auth-form-area">
    <div class="auth-form-wrap">
      <div class="mobile-brand">
        <div class="mobile-brand-icon"><img src="~/images/logo.png" alt="NABD Logo" asp-append-version="true" /></div>
        <div class="mobile-brand-name">NABD - نبض</div>
      </div>

      <div class="auth-card">
        <div class="auth-card-header">
          <div class="auth-card-title">Create New Password</div>
          <div class="auth-card-sub">Please enter your new password below</div>
        </div>

        <div class="auth-card-body">
          @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { id = "resetForm", novalidate = "novalidate" }))
          {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.Code)
            @Html.ValidationSummary(true, "", new { @class = "text-danger", style = "margin-bottom: 1rem; color: #ef4444;" })

            <div class="mc-form-group">
              <label class="mc-label" for="Email">
                <i class="fas fa-envelope"></i> Email address <span class="req">*</span>
              </label>
              <div class="mc-input-wrap">
                <input type="email" id="Email" name="Email" class="mc-input has-icon"
                       placeholder="you@example.com" required autocomplete="email" />
                <i class="mc-input-icon fas fa-envelope"></i>
              </div>
              @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger mc-feedback invalid" })
            </div>

            <div class="mc-form-group">
              <label class="mc-label" for="Password">
                <i class="fas fa-lock"></i> New Password <span class="req">*</span>
              </label>
              <div class="mc-input-wrap">
                <input type="password" id="Password" name="Password" class="mc-input has-icon has-eye"
                       placeholder="Enter new password" required />
                <i class="mc-input-icon fas fa-lock"></i>
                <button type="button" class="mc-input-eye" aria-label="Toggle password">
                  <i class="fas fa-eye"></i>
                </button>
              </div>
              @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger mc-feedback invalid" })
            </div>

            <div class="mc-form-group">
              <label class="mc-label" for="ConfirmPassword">
                <i class="fas fa-lock"></i> Confirm Password <span class="req">*</span>
              </label>
              <div class="mc-input-wrap">
                <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="mc-input has-icon has-eye"
                       placeholder="Confirm new password" required />
                <i class="mc-input-icon fas fa-lock"></i>
                <button type="button" class="mc-input-eye" aria-label="Toggle password">
                  <i class="fas fa-eye"></i>
                </button>
              </div>
              @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger mc-feedback invalid" })
            </div>

            <button type="submit" class="mc-btn mc-btn-primary mt-2">
              <i class="fas fa-save"></i> Reset Password
            </button>
          }
        </div>
      </div>
    </div>
  </main>
</div>
<script src="~/js/auth.js"></script>
</body>
</html>
