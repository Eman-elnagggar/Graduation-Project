@{
    Layout = null;
    ViewData["Title"] = "Login — NABD - نبض";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>
  <link rel="icon" type="image/png" href="~/images/logo.png" asp-append-version="true" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>

<div class="lg-stage">
  <div class="lg-shell">

    <!-- ── FORM SIDE ─────────────────────────────────────── -->
    <section class="lg-form-side">
      <a class="lg-brand" href="@Url.Action("Index", "Home")">
        <span class="lg-brand-mark"><img src="~/images/logo.png" alt="NABD Logo" asp-append-version="true" /></span>
        <span class="lg-brand-name">NABD <span class="ar">نبض</span></span>
      </a>

      <div class="lg-mobile-brand">
        <span class="lg-brand-mark"><img src="~/images/logo.png" alt="NABD Logo" asp-append-version="true" /></span>
        <span class="lg-brand-name">NABD <span class="ar">نبض</span></span>
      </div>

      <h1 class="lg-title">Welcome back!</h1>
      <p class="lg-subtitle">Sign in to access your dashboard and continue caring for what matters most.</p>

      <div class="lg-form">
        @if (TempData["AuthError"] is string authError)
        {
          <div class="lg-alert lg-alert-error">
            <i class="fas fa-exclamation-circle"></i>
            <span>@authError</span>
          </div>
        }
        @if (TempData["AuthSuccess"] is string authSuccess)
        {
          <div class="lg-alert lg-alert-success">
            <i class="fas fa-check-circle"></i>
            <span>@authSuccess</span>
          </div>
        }

        @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "loginForm", novalidate = "novalidate" }))
        {
          @Html.AntiForgeryToken()

          <div class="mc-form-group">
            <div class="lg-label-row">
              <label class="mc-label" for="Email">Email <span class="req">*</span></label>
            </div>
            <div class="mc-input-wrap">
              <input type="email" id="Email" name="Email" class="mc-input"
                     placeholder="Enter your email" required autocomplete="email" value="@(ViewBag.Email ?? string.Empty)" />
              <i class="mc-input-icon fas fa-envelope"></i>
            </div>
          </div>

          <div class="mc-form-group">
            <div class="lg-label-row">
              <label class="mc-label" for="Password">Password <span class="req">*</span></label>
            </div>
            <div class="mc-input-wrap">
              <input type="password" id="Password" name="Password" class="mc-input has-eye"
                     placeholder="Enter your password" required autocomplete="current-password" />
              <i class="mc-input-icon fas fa-lock"></i>
              <button type="button" class="mc-input-eye" aria-label="Toggle password">
                <i class="fas fa-eye"></i>
              </button>
            </div>
          </div>

          <div class="lg-row">
            <label class="mc-check-group">
              <input type="checkbox" id="RememberMe" name="RememberMe" class="mc-check" value="true" @(ViewBag.RememberMe == true ? "checked" : "") />
              <span class="mc-check-label">Remember me for 30 days</span>
            </label>
            <a href="@Url.Action("ForgotPassword", "Account")" class="lg-forgot">Forgot password?</a>
          </div>

          <button type="submit" class="mc-btn mc-btn-primary" id="loginBtn">
            <i class="fas fa-arrow-right-to-bracket"></i> Sign In
          </button>
        }

        <div class="lg-divider"><span>New to NABD</span></div>

        <div class="lg-roles">
          <a href="@Url.Action("RegisterPatient", "Account")" class="lg-role is-patient">
            <span class="lg-role-ico"><i class="fas fa-baby"></i></span>
            <span class="lg-role-name">Patient</span>
          </a>
          <a href="@Url.Action("RegisterDoctor", "Account")" class="lg-role is-doctor">
            <span class="lg-role-ico"><i class="fas fa-user-md"></i></span>
            <span class="lg-role-name">Doctor</span>
          </a>
          <a href="@Url.Action("RegisterAssistant", "Account")" class="lg-role is-assistant">
            <span class="lg-role-ico"><i class="fas fa-user-nurse"></i></span>
            <span class="lg-role-name">Assistant</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ── BRAND SIDE ────────────────────────────────────── -->
    <aside class="lg-brand-side">
      <svg class="lg-pulse" viewBox="0 0 600 90" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="lgPulseGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%"  stop-color="#2dd4bf" stop-opacity="0"/>
            <stop offset="40%" stop-color="#2dd4bf"/>
            <stop offset="75%" stop-color="#fbcfe2"/>
            <stop offset="100%" stop-color="#fbcfe2" stop-opacity="0"/>
          </linearGradient>
        </defs>
        <path d="M0 45 H230 l11 -28 11 56 10 -66 13 84 11 -46 H600" />
      </svg>

      <div class="lg-brand-head">
        <h2 class="lg-headline">Every pulse,<br><span class="grad">beautifully cared for.</span></h2>
      </div>

      <div class="lg-quote">
        <div class="lg-quote-mark">&ldquo;</div>
        <p class="lg-quote-text">NABD keeps my pregnancy, my doctor, and all my test results in one calm place. I finally feel in control of every step.</p>
        <div class="lg-quote-by">
          <span class="lg-avatar">SA</span>
          <span>
            <span class="lg-quote-name" style="display:block">Sarah Ahmed</span>
            <span class="lg-quote-role">Expecting mother · 2nd Trimester</span>
          </span>
        </div>
      </div>

      <div class="lg-trust">
        <div class="lg-trust-label">Trusted across the journey</div>
        <div class="lg-trust-items">
          <span class="lg-trust-item"><i class="fas fa-shield-halved"></i> Secure health records</span>
          <span class="lg-trust-item"><i class="fas fa-calendar-check"></i> Smart reminders</span>
          <span class="lg-trust-item"><i class="fas fa-robot"></i> AI pregnancy assistant</span>
        </div>
      </div>
    </aside>

  </div>
</div>

<script src="~/js/auth.js"></script>
<script>
(function () {
  'use strict';
  initLiveValidation('loginForm');

  document.getElementById('loginForm').addEventListener('submit', function (e) {
    if (!validateForm('loginForm')) {
      e.preventDefault();
      const firstError = this.querySelector('.mc-feedback.invalid');
      const errorText = firstError
        ? firstError.textContent.replace(/\s+/g, ' ').trim()
        : 'Please check the highlighted fields and try again.';
      showToast(errorText, 'error');
    }
  });
}());
</script>
</body>
</html>
