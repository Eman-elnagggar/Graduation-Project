@model Graduation_Project.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password — NABD - نبض";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>
  <link rel="icon" type="image/png" href="~/images/logo.png" asp-append-version="true" />
  <partial name="_PwaHead" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body>
<div class="auth-shell">
  <aside class="auth-panel">
    <a class="panel-brand panel-brand-link" href="@Url.Action("Index", "Home")">
      <div class="panel-brand-icon"><img src="~/images/logo.png" alt="NABD Logo" asp-append-version="true" /></div>
      <div>
        <div class="panel-brand-name">NABD - نبض</div>
        <div class="panel-brand-badge" style="white-space: nowrap; letter-spacing: .04em; font-size: .62rem;">Securing the pulse of the next generation.</div>
      </div>
    </a>
    <div class="panel-content">
      <h2 class="panel-headline">Lost your key?<br><span>We'll help you get back in.</span></h2>
      <p class="panel-desc">Don't worry, it happens to the best of us. Just enter your email to reset your password.</p>
    </div>
  </aside>

  <main class="auth-form-area">
    <div class="auth-form-wrap">
      <div class="mobile-brand">
        <div class="mobile-brand-icon"><img src="~/images/logo.png" alt="NABD Logo" asp-append-version="true" /></div>
        <div class="mobile-brand-name">NABD - نبض</div>
      </div>

      <div class="auth-card">
        <div class="auth-card-header">
          <div class="auth-card-title">Forgot Password</div>
          <div class="auth-card-sub">Enter your email to receive a reset link</div>
        </div>

        <div class="auth-card-body">
          @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { id = "forgotForm", novalidate = "novalidate" }))
          {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger", style = "margin-bottom: 1rem; color: #ef4444;" })

            <div class="mc-form-group">
              <label class="mc-label" for="Email">
                <i class="fas fa-envelope"></i> Email address <span class="req">*</span>
              </label>
              <div class="mc-input-wrap">
                <input type="email" id="Email" name="Email" class="mc-input has-icon"
                       placeholder="you@example.com" required autocomplete="email" />
                <i class="mc-input-icon fas fa-envelope"></i>
              </div>
              @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger mc-feedback invalid" })
            </div>

            <button type="submit" class="mc-btn mc-btn-primary mt-2" id="forgotBtn">
              <i class="fas fa-paper-plane"></i> Send Reset Link
            </button>
          }
        </div>
        
        <div class="auth-card-footer text-center" style="margin-top: 1.5rem; text-align: center;">
          <a href="@Url.Action("Login", "Account")" class="mc-link">
            <i class="fas fa-arrow-left"></i> Back to Login
          </a>
        </div>
      </div>
    </div>
  </main>
</div>
<script src="~/js/auth.js"></script>
</body>
</html>
