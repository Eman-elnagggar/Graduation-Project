@{
    string? userRole = ViewBag.UserRole as string;
    string? requiredRole = ViewBag.RequiredRole as string;
    string? attemptedUrl = ViewBag.AttemptedUrl as string;

    // Render the page inside the SAME dashboard shell the user already lives in,
    // so 403 feels like part of the app rather than a standalone error screen.
    Layout = (userRole ?? "").ToLowerInvariant() switch
    {
        "doctor"    => "~/Views/Shared/_DoctorLayout.cshtml",
        "admin"     => "~/Views/Shared/_AdminLayout.cshtml",
        "assistant" => "~/Views/Shared/_AssistantLayout.cshtml",
        "patient"   => "~/Views/Shared/_PatientLayout.cshtml",
        _            => "~/Views/Shared/_Layout.cshtml"
    };

    ViewData["Title"] = "Access Restricted";
    ViewData["ActivePage"] = "";
    ViewData["PageTitleHtml"] = "Access Restricted";
    ViewData["PageSubtitle"] = "You don't have permission to view this section.";

    var roleLabel = string.IsNullOrWhiteSpace(userRole) ? "Unknown" : userRole;
    var requiredLabel = string.IsNullOrWhiteSpace(requiredRole) ? "Restricted" : requiredRole;
    var resourceLabel = string.IsNullOrWhiteSpace(attemptedUrl) ? "This page" : attemptedUrl;

    var supportSubject = Uri.EscapeDataString($"Access request: {requiredLabel} area ({resourceLabel})");
    var supportBody = Uri.EscapeDataString(
        $"Hello,\n\nI'm signed in as a {roleLabel} and tried to open {resourceLabel}, " +
        $"which requires the {requiredLabel} role. Please review whether I should be granted access.\n\nThank you.");
    var requestAccessHref = $"mailto:Nabdsys@outlook.com?subject={supportSubject}&body={supportBody}";
}

<section class="ad-shell" role="region" aria-labelledby="ad-heading">

    <header class="ad-header">
        <div class="ad-header-icon" aria-hidden="true">
            <i class="fas fa-shield-halved"></i>
        </div>
        <div class="ad-header-text">
            <span class="ad-status-pill">
                <span class="ad-status-dot" aria-hidden="true"></span>
                403 · Access Restricted
            </span>
            <h1 id="ad-heading" class="ad-title">You don't have access to this section</h1>
            <p class="ad-lead">
                Your account doesn't have permission to open this section with its current role.
                Nothing is wrong with your account — this area is simply reserved for a different group.
            </p>
        </div>
    </header>

    <div class="ad-grid">

        <!-- Request details / permission summary -->
        <section class="ad-card" aria-labelledby="ad-details-title">
            <h2 id="ad-details-title" class="ad-card-title">
                <i class="fas fa-circle-info" aria-hidden="true"></i> Request details
            </h2>
            <dl class="ad-detail-list">
                <div class="ad-detail-row">
                    <dt>Your current role</dt>
                    <dd><span class="ad-badge ad-badge-neutral">@roleLabel</span></dd>
                </div>
                <div class="ad-detail-row">
                    <dt>Required role</dt>
                    <dd><span class="ad-badge ad-badge-info">@requiredLabel</span></dd>
                </div>
                <div class="ad-detail-row">
                    <dt>Requested resource</dt>
                    <dd><code class="ad-code">@resourceLabel</code></dd>
                </div>
                <div class="ad-detail-row">
                    <dt>Access status</dt>
                    <dd>
                        <span class="ad-badge ad-badge-danger">
                            <i class="fas fa-ban" aria-hidden="true"></i> Denied
                        </span>
                    </dd>
                </div>
            </dl>
        </section>

        <!-- Why you're seeing this -->
        <section class="ad-card" aria-labelledby="ad-why-title">
            <h2 id="ad-why-title" class="ad-card-title">
                <i class="fas fa-circle-question" aria-hidden="true"></i> Why you're seeing this
            </h2>
            <ul class="ad-reasons">
                <li>
                    <span class="ad-reason-icon" aria-hidden="true"><i class="fas fa-user-lock"></i></span>
                    <span>Your <strong>@roleLabel</strong> role does not include access to this section.</span>
                </li>
                <li>
                    <span class="ad-reason-icon" aria-hidden="true"><i class="fas fa-users-rectangle"></i></span>
                    <span>This page is reserved for <strong>@requiredLabel</strong> users only.</span>
                </li>
                <li>
                    <span class="ad-reason-icon" aria-hidden="true"><i class="fas fa-key"></i></span>
                    <span>Additional permissions may be required and must be granted by an administrator.</span>
                </li>
            </ul>
        </section>
    </div>

    <!-- Helpful guidance -->
    <aside class="ad-guidance" role="note">
        <i class="fas fa-lightbulb" aria-hidden="true"></i>
        <p>
            If you believe you should have access, contact your administrator or
            <a class="ad-inline-link" href="@requestAccessHref">request additional permissions</a>.
            You can also <a class="ad-inline-link" href="@Url.Action("Login", "Account")">sign in with a different account</a>
            or <a class="ad-inline-link" href="@Url.Action("LogoutGet", "Account")">log out</a>.
        </p>
    </aside>

    <!-- Available actions -->
    <div class="ad-actions" role="group" aria-label="Available actions">
        <a href="@Url.Action("Index", "Home")" class="ad-btn ad-btn-primary">
            <i class="fas fa-table-columns" aria-hidden="true"></i>
            Return to dashboard
        </a>
        <button type="button" class="ad-btn ad-btn-secondary" onclick="history.back()">
            <i class="fas fa-arrow-left" aria-hidden="true"></i>
            Go back
        </button>
 
    </div>
</section>

@section Styles {
<style>
    .ad-shell {
        max-width: 900px;
        margin: 0 auto;
        padding: var(--ds-space-2, .5rem) 0 var(--ds-space-8, 2rem);
        display: flex;
        flex-direction: column;
        gap: var(--ds-space-5, 1.25rem);
        animation: adFade .4s ease both;
    }

    /* ── Header band ─────────────────────────────────────── */
    .ad-header {
        display: flex;
        align-items: flex-start;
        gap: var(--ds-space-5, 1.25rem);
        background: var(--surface-card, #fff);
        border: 1px solid var(--border-subtle, #e4eaf2);
        border-radius: var(--ds-radius-lg, 16px);
        padding: var(--ds-space-6, 1.5rem);
        box-shadow: var(--ds-shadow-md, 0 4px 12px rgba(0,0,0,.08));
    }
    .ad-header-icon {
        flex-shrink: 0;
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        font-size: 1.4rem;
        color: var(--danger, #ef4444);
        background: rgba(239, 68, 68, .1);
        border: 1px solid rgba(239, 68, 68, .2);
    }
    .ad-header-text { min-width: 0; }
    .ad-status-pill {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--danger, #ef4444);
        background: rgba(239, 68, 68, .08);
        border: 1px solid rgba(239, 68, 68, .2);
        padding: .25rem .65rem;
        border-radius: 999px;
    }
    .ad-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--danger, #ef4444);
        box-shadow: 0 0 0 0 rgba(239, 68, 68, .5);
        animation: adPulse 2s ease-in-out infinite;
    }
    .ad-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-strong, #1e293b);
        letter-spacing: -.01em;
        margin: .6rem 0 .4rem;
        line-height: 1.25;
    }
    .ad-lead {
        font-size: .92rem;
        color: var(--text-secondary, #4a5568);
        line-height: 1.6;
        margin: 0;
        max-width: 62ch;
    }

    /* ── Cards grid ──────────────────────────────────────── */
    .ad-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--ds-space-5, 1.25rem);
    }
    .ad-card {
        background: var(--surface-card, #fff);
        border: 1px solid var(--border-subtle, #e4eaf2);
        border-radius: var(--ds-radius-lg, 16px);
        padding: var(--ds-space-6, 1.5rem);
        box-shadow: var(--ds-shadow-sm, 0 1px 2px rgba(0,0,0,.05));
    }
    .ad-card-title {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: var(--text-muted, #8896ab);
        margin: 0 0 var(--ds-space-4, 1rem);
    }
    .ad-card-title i { color: var(--primary, #1baebe); }

    /* ── Detail list ─────────────────────────────────────── */
    .ad-detail-list { margin: 0; display: flex; flex-direction: column; }
    .ad-detail-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--ds-space-4, 1rem);
        padding: .7rem 0;
        border-bottom: 1px solid var(--border-subtle, #e4eaf2);
    }
    .ad-detail-row:last-child { border-bottom: 0; padding-bottom: 0; }
    .ad-detail-row:first-child { padding-top: 0; }
    .ad-detail-row dt {
        font-size: .85rem;
        font-weight: 500;
        color: var(--text-secondary, #4a5568);
    }
    .ad-detail-row dd { margin: 0; text-align: right; min-width: 0; }

    .ad-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        font-size: .76rem;
        font-weight: 700;
        padding: .25rem .7rem;
        border-radius: 999px;
        white-space: nowrap;
    }
    .ad-badge-neutral {
        color: var(--text-strong, #1e293b);
        background: var(--surface-page, #f3f6fb);
        border: 1px solid var(--border-soft, #cdd6e3);
    }
    .ad-badge-info {
        color: var(--primary-dark, #138fa0);
        background: var(--primary-surface-soft, #f0fdfe);
        border: 1px solid rgba(27, 174, 190, .3);
    }
    .ad-badge-danger {
        color: var(--danger, #ef4444);
        background: rgba(239, 68, 68, .1);
        border: 1px solid rgba(239, 68, 68, .25);
    }
    .ad-code {
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .78rem;
        color: var(--text-secondary, #4a5568);
        background: var(--surface-page, #f3f6fb);
        border: 1px solid var(--border-subtle, #e4eaf2);
        padding: .2rem .55rem;
        border-radius: var(--ds-radius-sm, 6px);
        word-break: break-all;
    }

    /* ── Reasons list ────────────────────────────────────── */
    .ad-reasons { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--ds-space-4, 1rem); }
    .ad-reasons li {
        display: flex;
        align-items: flex-start;
        gap: .7rem;
        font-size: .88rem;
        line-height: 1.5;
        color: var(--text-secondary, #4a5568);
    }
    .ad-reasons strong { color: var(--text-strong, #1e293b); font-weight: 600; }
    .ad-reason-icon {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        border-radius: 9px;
        display: grid;
        place-items: center;
        font-size: .8rem;
        color: var(--primary, #1baebe);
        background: var(--primary-surface-soft, #f0fdfe);
        border: 1px solid rgba(27, 174, 190, .2);
    }

    /* ── Guidance ────────────────────────────────────────── */
    .ad-guidance {
        display: flex;
        align-items: flex-start;
        gap: .7rem;
        background: var(--primary-surface-soft, #f0fdfe);
        border: 1px solid rgba(27, 174, 190, .25);
        border-radius: var(--ds-radius-md, 10px);
        padding: var(--ds-space-4, 1rem) var(--ds-space-5, 1.25rem);
    }
    .ad-guidance i { color: var(--primary, #1baebe); margin-top: .15rem; flex-shrink: 0; }
    .ad-guidance p { margin: 0; font-size: .85rem; line-height: 1.6; color: var(--text-secondary, #4a5568); }
    .ad-inline-link { color: var(--primary-dark, #138fa0); font-weight: 600; text-decoration: none; }
    .ad-inline-link:hover { text-decoration: underline; }

    /* ── Actions ─────────────────────────────────────────── */
    .ad-actions { display: flex; flex-wrap: wrap; gap: var(--ds-space-3, .75rem); }
    .ad-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        font-family: inherit;
        font-size: .9rem;
        font-weight: 600;
        padding: .7rem 1.3rem;
        border-radius: var(--ds-radius-md, 10px);
        cursor: pointer;
        text-decoration: none;
        border: 1px solid transparent;
        transition: transform .15s ease, box-shadow .15s ease, background .15s ease, border-color .15s ease;
    }
    .ad-btn:hover { transform: translateY(-1px); text-decoration: none; }
    .ad-btn:focus-visible { outline: 3px solid rgba(27, 174, 190, .4); outline-offset: 2px; }
    .ad-btn-primary {
        color: #fff;
        background: linear-gradient(135deg, var(--primary, #1baebe), var(--primary-dark, #138fa0));
        box-shadow: 0 4px 12px rgba(27, 174, 190, .28);
    }
    .ad-btn-primary:hover { color: #fff; box-shadow: 0 6px 18px rgba(27, 174, 190, .4); }
    .ad-btn-secondary {
        color: var(--text-strong, #1e293b);
        background: var(--surface-card, #fff);
        border-color: var(--border-soft, #cdd6e3);
    }
    .ad-btn-secondary:hover { background: var(--surface-page, #f3f6fb); border-color: var(--text-muted, #8896ab); }
    .ad-btn-tertiary {
        color: var(--text-secondary, #4a5568);
        background: transparent;
        border-color: transparent;
    }
    .ad-btn-tertiary:hover { color: var(--primary-dark, #138fa0); background: var(--primary-surface-soft, #f0fdfe); }

    /* ── Responsive ──────────────────────────────────────── */
    @@media (max-width: 768px) {
        .ad-grid { grid-template-columns: 1fr; }
        .ad-header { flex-direction: column; gap: var(--ds-space-4, 1rem); }
        .ad-actions { flex-direction: column; }
        .ad-btn { width: 100%; }
        .ad-detail-row { flex-direction: column; align-items: flex-start; gap: .35rem; }
        .ad-detail-row dd { text-align: left; }
    }

    @@keyframes adFade { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes adPulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, .5); }
        50% { box-shadow: 0 0 0 5px rgba(239, 68, 68, 0); }
    }
    @@media (prefers-reduced-motion: reduce) {
        .ad-shell { animation: none; }
        .ad-status-dot { animation: none; }
        .ad-btn:hover { transform: none; }
    }
</style>
}
