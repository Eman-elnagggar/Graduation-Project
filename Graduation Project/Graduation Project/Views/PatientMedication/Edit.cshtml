@using Graduation_Project.Models
@model Graduation_Project.ViewModels.PatientMedicationEditViewModel
@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewData["Title"] = "Edit Medication";
    ViewData["PatientId"] = Model.Patient.PatientID;
    ViewData["ActivePage"] = "Medications";
    ViewData["UserName"] = Model.UserName;
    ViewData["HidePageHeader"] = true;

    var med = Model.Medication;
    var pid = Model.Patient.PatientID;
    var durationDays = med.EndDate.HasValue
        ? (int?)(med.EndDate.Value.Date - med.StartDate.Date).Days
        : null;

    // Medications saved before the structured frequency existed only have free text —
    // infer the closest catalogue option so the form opens on something sensible.
    var selectedCode = !string.IsNullOrWhiteSpace(med.FrequencyCode) && MedicationFrequencies.Find(med.FrequencyCode) != null
        ? med.FrequencyCode!
        : MedicationFrequencies.Parse(med.Frequency).Code;

    var scheduleTimes = string.Join(",", med.Schedules
        .OrderBy(s => s.TimeOfDay)
        .Select(s => s.TimeOfDay.ToString(@"hh\:mm")));

    var formTypes = new[] { "Tablet", "Capsule", "Syrup", "Injection", "Drops", "Patch", "Supplement", "Other" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/patient-medications.css" asp-append-version="true" />
}

<section class="pm-page pd-wrap" data-patient-medications>

    @* ── HERO ─────────────────────────────────────────── *@
    <div class="pm-hero">
        <div class="pm-hero-left">
            <span class="pm-hero-eyebrow"><i class="fas fa-pen"></i> Edit Medication</span>
            <h2>@med.Name</h2>
            <p>Update the details below. The daily schedule will be rebuilt when you save.</p>
        </div>
        <div class="pm-hero-actions">
            <a class="btn btn-outline" href="/PatientMedication/Index/@pid">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    @Html.AntiForgeryToken()
    <input type="hidden" id="patientId"    value="@pid" />
    <input type="hidden" id="medicationId" value="@med.MedicationId" />

    @* ── WIZARD STEPS ─────────────────────────────────── *@
    <div class="pm-wizard-steps" id="wizardSteps">
        <div class="pm-wstep active" data-step="1">
            <div class="pm-wstep-num">1</div>
            <div class="pm-wstep-lbl">Basic Info</div>
        </div>
        <div class="pm-wconn" id="conn1"></div>
        <div class="pm-wstep" data-step="2">
            <div class="pm-wstep-num">2</div>
            <div class="pm-wstep-lbl">Dosage</div>
        </div>
        <div class="pm-wconn" id="conn2"></div>
        <div class="pm-wstep" data-step="3">
            <div class="pm-wstep-num">3</div>
            <div class="pm-wstep-lbl">Duration</div>
        </div>
        <div class="pm-wconn" id="conn3"></div>
        <div class="pm-wstep" data-step="4">
            <div class="pm-wstep-num">4</div>
            <div class="pm-wstep-lbl">Instructions</div>
        </div>
        <div class="pm-wconn" id="conn4"></div>
        <div class="pm-wstep" data-step="5">
            <div class="pm-wstep-num">5</div>
            <div class="pm-wstep-lbl">Save</div>
        </div>
    </div>

    @* ── STEP 1 ───────────────────────────────────────── *@
    <div class="pm-wiz-panel active" id="step1">
        <div class="pm-wiz-panel-ttl">Basic Information</div>
        <div class="pm-wiz-panel-sub">Update the medication name and type.</div>
        <div class="pm-wiz-form-grid">
            <div class="pm-fg pm-full">
                <label for="medName">Medication Name <span style="color:#ef4444;">*</span></label>
                <input type="text" id="medName" class="pm-finput" value="@med.Name" required />
                <div class="pm-ferror" data-error-for="medName"></div>
            </div>
            <div class="pm-fg">
                <label for="medType">Medication Type</label>
                <select id="medType" class="pm-fselect">
                    <option value="">Select type…</option>
                    @foreach (var type in formTypes)
                    {
                        <option value="@type" selected="@(string.Equals(med.Form, type, StringComparison.OrdinalIgnoreCase))">@type</option>
                    }
                </select>
            </div>
        </div>
        <div class="pm-wiz-nav">
            <span></span>
            <button class="pm-wbtn next" data-next="2">Next <i class="fas fa-arrow-right"></i></button>
        </div>
    </div>

    @* ── STEP 2 ───────────────────────────────────────── *@
    <div class="pm-wiz-panel" id="step2">
        <div class="pm-wiz-panel-ttl">Dosage &amp; Frequency</div>
        <div class="pm-wiz-panel-sub">Update dosage and how often you take this medication.</div>
        <div class="pm-wiz-form-grid">
            <div class="pm-fg">
                <label for="medDosage">Dosage</label>
                <input type="text" id="medDosage" class="pm-finput" value="@med.Dosage" placeholder="e.g. 500mg" />
            </div>
            <div class="pm-fg">
                <label for="medPillsPerDose">Pills / Units Per Dose</label>
                <input type="number" id="medPillsPerDose" class="pm-finput" min="1" step="1" value="@(med.PillsPerDose?.ToString() ?? "")" placeholder="e.g. 1" />
                <div class="pm-fhint">Optional — leave blank if it doesn't apply.</div>
                <div class="pm-ferror" data-error-for="medPillsPerDose"></div>
            </div>
            <div class="pm-fg pm-full">
                <label for="medFrequency">Frequency <span style="color:#ef4444;">*</span></label>
                <select id="medFrequency" class="pm-fselect" data-frequency-select>
                    @foreach (var group in MedicationFrequencies.All.GroupBy(o => o.Group))
                    {
                        <optgroup label="@group.Key">
                            @foreach (var option in group)
                            {
                                <option value="@option.Code"
                                        data-times-per-day="@option.TimesPerDay"
                                        data-interval-days="@option.IntervalDays"
                                        data-times="@string.Join(",", option.DefaultTimes.Select(t => t.ToString(@"hh\:mm")))"
                                        data-label="@option.Label"
                                        selected="@(option.Code == selectedCode)">
                                    @option.Label
                                </option>
                            }
                        </optgroup>
                    }
                </select>

                <div class="pm-freq-custom" id="freqCustom" hidden>
                    <div class="pm-fg">
                        <label for="freqTimesPerDay">Doses per day</label>
                        <input type="number" id="freqTimesPerDay" class="pm-finput" min="1" max="@MedicationFrequencies.MaxTimesPerDay" step="1"
                               value="@(med.TimesPerDay > 0 ? med.TimesPerDay : 1)" />
                    </div>
                    <div class="pm-fg">
                        <label for="freqIntervalDays">Repeat every (days)</label>
                        <input type="number" id="freqIntervalDays" class="pm-finput" min="1" max="@MedicationFrequencies.MaxIntervalDays" step="1"
                               value="@(med.IntervalDays > 0 ? med.IntervalDays : 1)" />
                        <div class="pm-fhint">1 = every day, 7 = once a week.</div>
                    </div>
                </div>

                <div class="pm-freq-times" id="freqTimes" data-initial-times="@scheduleTimes"></div>
                <div class="pm-freq-summary" id="freqSummary"></div>
                <div class="pm-ferror" data-error-for="medFrequency"></div>
            </div>
        </div>
        <div class="pm-wiz-nav">
            <button class="pm-wbtn back" data-back="1"><i class="fas fa-arrow-left"></i> Back</button>
            <button class="pm-wbtn next" data-next="3">Next <i class="fas fa-arrow-right"></i></button>
        </div>
    </div>

    @* ── STEP 3 ───────────────────────────────────────── *@
    <div class="pm-wiz-panel" id="step3">
        <div class="pm-wiz-panel-ttl">Duration &amp; Supply</div>
        <div class="pm-wiz-panel-sub">Update the treatment period and pill count.</div>
        <div class="pm-wiz-form-grid">
            <div class="pm-fg">
                <label for="medStart">Start Date</label>
                <input type="date" id="medStart" class="pm-finput" value="@med.StartDate.ToString("yyyy-MM-dd")" />
            </div>
            <div class="pm-fg">
                <label for="medDuration">Duration (days)</label>
                <input type="number" id="medDuration" class="pm-finput" min="1" step="1" value="@(durationDays?.ToString() ?? "")" placeholder="Leave blank for ongoing" />
                <div class="pm-fhint">Optional — blank means ongoing.</div>
                <div class="pm-ferror" data-error-for="medDuration"></div>
            </div>
            <div class="pm-fg">
                <label for="medTotalPills">Total Pills in Pack</label>
                <input type="number" id="medTotalPills" class="pm-finput" min="1" step="1" value="@(med.TotalPills?.ToString() ?? "")" placeholder="e.g. 30" />
                <div class="pm-fhint">Optional — used for refill warnings.</div>
                <div class="pm-ferror" data-error-for="medTotalPills"></div>
            </div>
        </div>
        <div class="pm-calc-row" id="calcRow" style="display:none;">
            <div class="pm-calc-item">
                <div class="pm-calc-lbl">Estimated End Date</div>
                <div class="pm-calc-val" id="calcEndDate">—</div>
            </div>
            <div class="pm-calc-item">
                <div class="pm-calc-lbl">Remaining Days</div>
                <div class="pm-calc-val" id="calcDaysLeft">—</div>
            </div>
        </div>
        <div class="pm-wiz-nav">
            <button class="pm-wbtn back" data-back="2"><i class="fas fa-arrow-left"></i> Back</button>
            <button class="pm-wbtn next" data-next="4">Next <i class="fas fa-arrow-right"></i></button>
        </div>
    </div>

    @* ── STEP 4 ───────────────────────────────────────── *@
    <div class="pm-wiz-panel" id="step4">
        <div class="pm-wiz-panel-ttl">Instructions &amp; Notes</div>
        <div class="pm-wiz-panel-sub">Any special instructions for taking this medication?</div>
        <div class="pm-fg">
            <label for="medInstructions">Instructions (optional)</label>
            <textarea id="medInstructions" class="pm-ftextarea" rows="4"
                      placeholder="e.g. Take after meals, avoid dairy…">@med.Instructions</textarea>
        </div>
        <div class="pm-example-chips" id="exampleChips">
            <button type="button" class="pm-echip" data-ex="Take after meals">Take after meals</button>
            <button type="button" class="pm-echip" data-ex="Take before sleep">Before sleep</button>
            <button type="button" class="pm-echip" data-ex="Take on empty stomach">Empty stomach</button>
            <button type="button" class="pm-echip" data-ex="Avoid dairy products">Avoid dairy</button>
            <button type="button" class="pm-echip" data-ex="Avoid sunlight">Avoid sunlight</button>
            <button type="button" class="pm-echip" data-ex="Take with plenty of water">With water</button>
            <button type="button" class="pm-echip" data-ex="Do not crush or chew">Do not crush</button>
        </div>
        <div class="pm-wiz-nav">
            <button class="pm-wbtn back" data-back="3"><i class="fas fa-arrow-left"></i> Back</button>
            <button class="pm-wbtn next" data-next="5">Review <i class="fas fa-arrow-right"></i></button>
        </div>
    </div>

    @* ── STEP 5 ───────────────────────────────────────── *@
    <div class="pm-wiz-panel" id="step5">
        <div class="pm-wiz-panel-ttl">Review &amp; Save</div>
        <div class="pm-wiz-panel-sub">Check the updated details before saving.</div>
        <div class="pm-review-card" id="reviewCard">
            <div class="pm-review-ttl"><i class="fas fa-capsules"></i> <span id="rv-name">Medication</span></div>
            <div class="pm-review-rows">
                <div class="pm-review-row"><span>Type</span>         <strong id="rv-type">—</strong></div>
                <div class="pm-review-row"><span>Dosage</span>       <strong id="rv-dosage">—</strong></div>
                <div class="pm-review-row"><span>Pills / Dose</span> <strong id="rv-pills">—</strong></div>
                <div class="pm-review-row"><span>Frequency</span>    <strong id="rv-freq">—</strong></div>
                <div class="pm-review-row"><span>Dose times</span>   <strong id="rv-times">—</strong></div>
                <div class="pm-review-row"><span>Start Date</span>   <strong id="rv-start">—</strong></div>
                <div class="pm-review-row"><span>Duration</span>     <strong id="rv-duration">—</strong></div>
                <div class="pm-review-row"><span>Total Pills</span>  <strong id="rv-total-pills">—</strong></div>
                <div class="pm-review-row"><span>Instructions</span> <strong id="rv-instructions" style="max-width:60%;text-align:right;">—</strong></div>
            </div>
        </div>
        <div class="pm-wiz-nav">
            <button class="pm-wbtn back" data-back="4"><i class="fas fa-arrow-left"></i> Back</button>
            <button class="pm-wbtn submit" id="submitEditMed">
                <i class="fas fa-save"></i> Save Changes
            </button>
        </div>
    </div>

</section>

@section Scripts {
    <script src="~/js/patient-medications.js" asp-append-version="true"></script>
}
