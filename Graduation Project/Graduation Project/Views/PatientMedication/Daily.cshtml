@using System.Linq
@using Graduation_Project.Models
@model Graduation_Project.ViewModels.PatientMedicationDailyViewModel
@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewData["Title"] = "Daily Medications";
    ViewData["PatientId"] = Model.Patient.PatientID;
    ViewData["ActivePage"] = "Medications";
    ViewData["UserName"] = Model.UserName;
    ViewData["HidePageHeader"] = true;

    var pid = Model.Patient.PatientID;
    var isToday = Model.Date.Date == DateTime.Today;

    var scheduledCount = Model.DueSlots.Count;
    var takenCount     = Model.DueSlots.Count(s => s.Status == MedicationLogStatus.Taken);
    var pendingCount   = Model.DueSlots.Count(s => s.Status == MedicationLogStatus.Scheduled);
    var missedCount    = Model.DueSlots.Count(s => s.Status == MedicationLogStatus.Missed);

    var prevDate = Model.Date.AddDays(-1).ToString("yyyy-MM-dd");
    var nextDate = Model.Date.AddDays(1).ToString("yyyy-MM-dd");

    // Group by time of day
    var earlySlots     = Model.DueSlots.Where(s => s.ScheduledAt.Hour < 5).OrderBy(s => s.ScheduledAt).ToList();
    var morningSlots   = Model.DueSlots.Where(s => s.ScheduledAt.Hour >= 5  && s.ScheduledAt.Hour < 12).OrderBy(s => s.ScheduledAt).ToList();
    var afternoonSlots = Model.DueSlots.Where(s => s.ScheduledAt.Hour >= 12 && s.ScheduledAt.Hour < 18).OrderBy(s => s.ScheduledAt).ToList();
    var eveningSlots   = Model.DueSlots.Where(s => s.ScheduledAt.Hour >= 18).OrderBy(s => s.ScheduledAt).ToList();

    var timeGroups = new (string Emoji, string Label, System.Collections.Generic.List<Graduation_Project.Services.MedicationDueSlot> Slots)[]
    {
        ("🌙", "Early Morning (before 5 AM)", earlySlots),
        ("☀️", "Morning",   morningSlots),
        ("🌤", "Afternoon", afternoonSlots),
        ("🌙", "Evening",   eveningSlots),
    };
}

@Html.AntiForgeryToken()
<input type="hidden" id="patientId" value="@pid" />

<section class="pm-page pd-wrap" data-patient-medications>

    @* ── HEADER ─────────────────────────────────────────── *@
    <div class="pm-hero">
        <div class="pm-hero-left">
            <span class="pm-hero-eyebrow"><i class="fas fa-calendar-check"></i> Daily Dose Timeline</span>
            <h2>@(isToday ? "Today's Schedule" : Model.Date.ToString("MMM dd, yyyy"))</h2>
            <p>@Model.Date.ToString("dddd, MMMM dd, yyyy")</p>
        </div>
        <div class="pm-hero-actions">
            <a class="btn btn-outline" href="/PatientMedication/Index/@pid">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    @* ── SUMMARY STATS ───────────────────────────────────── *@
    <div class="pm-daily-stats">
        <div class="pm-dstat">
            <div class="pm-dstat-ico"><i class="fas fa-calendar-check"></i></div>
            <div class="pm-dstat-val">@scheduledCount</div>
            <div class="pm-dstat-lbl">Scheduled</div>
        </div>
        <div class="pm-dstat">
            <div class="pm-dstat-ico"><i class="fas fa-check-circle"></i></div>
            <div class="pm-dstat-val">@takenCount</div>
            <div class="pm-dstat-lbl">Taken</div>
        </div>
        <div class="pm-dstat">
            <div class="pm-dstat-ico"><i class="fas fa-hourglass-start"></i></div>
            <div class="pm-dstat-val">@pendingCount</div>
            <div class="pm-dstat-lbl">Pending</div>
        </div>
        <div class="pm-dstat">
            <div class="pm-dstat-ico"><i class="fas fa-times-circle"></i></div>
            <div class="pm-dstat-val">@missedCount</div>
            <div class="pm-dstat-lbl">Missed</div>
        </div>
    </div>

    @* ── DATE NAVIGATION ─────────────────────────────────── *@
    <div class="pm-date-nav">
        <a class="pm-date-nav-btn" href="/PatientMedication/Daily/@pid?date=@prevDate">
            <i class="fas fa-chevron-left"></i> Previous
        </a>
        <div class="pm-date-nav-center">
            <span class="pm-date-nav-main">@Model.Date.ToString("MMMM dd, yyyy")</span>
            <span class="pm-date-nav-sub">@Model.Date.ToString("dddd")@(isToday ? " · Today" : "")</span>
        </div>
        @if (!isToday)
        {
            <a class="pm-today-nav-btn" href="/PatientMedication/Daily/@pid">
                <i class="fas fa-calendar-day"></i> Today
            </a>
        }
        <a class="pm-date-nav-btn" href="/PatientMedication/Daily/@pid?date=@nextDate">
            Next <i class="fas fa-chevron-right"></i>
        </a>
    </div>

    @* ── DOSE TIMELINE ───────────────────────────────────── *@
    @if (Model.DueSlots.Any())
    {
            <div class="pm-dose-list">
            @foreach (var grp in timeGroups)
            {
                if (!grp.Slots.Any()) continue;

                @* group heading *@
                <div style="display:flex;align-items:center;gap:10px;padding:6px 0 4px;">
                    <span style="font-size:1.1rem;">@grp.Emoji</span>
                    <span style="font-size:0.88rem;font-weight:700;color:var(--text-primary);">@grp.Label</span>
                    <span style="font-size:0.72rem;font-weight:700;padding:2px 8px;border-radius:999px;background:#f1f5f9;color:#64748b;">
                        @grp.Slots.Count
                    </span>
                </div>

                @foreach (var slot in grp.Slots)
                {
                    var dcClass = slot.Status switch {
                        MedicationLogStatus.Taken   => "dc-taken",
                        MedicationLogStatus.Missed  => "dc-missed",
                        MedicationLogStatus.Skipped => "dc-skipped",
                        _ => ""
                    };
                    var spClass = slot.Status switch {
                        MedicationLogStatus.Taken   => "s-taken",
                        MedicationLogStatus.Missed  => "s-missed",
                        MedicationLogStatus.Skipped => "s-skipped",
                        _ => "s-scheduled"
                    };
                    var spLabel = slot.Status switch {
                        MedicationLogStatus.Taken   => "<i class='fas fa-check-circle'></i> Taken",
                        MedicationLogStatus.Missed  => "<i class='fas fa-times-circle'></i> Missed",
                        MedicationLogStatus.Skipped => "<i class='fas fa-forward'></i> Skipped",
                        _ => "<i class='fas fa-clock'></i> Scheduled"
                    };

                    <article class="pm-dose-card-v2 @dcClass"
                             data-medication-id="@slot.MedicationId"
                             data-scheduled-at="@slot.ScheduledAt.ToString("O")">

                        <div class="pm-dose-card-v2-hdr">
                            <div class="pm-dose-time-badge">
                                <div class="pm-dose-tbadge-h">@slot.ScheduledAt.ToString("h:mm")</div>
                                <div class="pm-dose-tbadge-p">@slot.ScheduledAt.ToString("tt")</div>
                            </div>
                            <div class="pm-dose-card-ico"><i class="fas fa-pills"></i></div>
                            <div class="pm-dose-card-info">
                                <div class="pm-dose-card-name">@slot.MedicationName</div>
                                <div class="pm-dose-card-sub">@(string.IsNullOrWhiteSpace(slot.Dosage) ? "Dosage not specified" : slot.Dosage)</div>
                            </div>
                            <span class="pm-dose-status-pill @spClass med-status">
                                @Html.Raw(spLabel)
                            </span>
                        </div>

                        <div class="pm-dose-card-v2-body">
                            @if (!string.IsNullOrWhiteSpace(slot.Instructions))
                            {
                                <div class="pm-dose-instructions">
                                    <i class="fas fa-note-sticky"></i>
                                    <span>@slot.Instructions</span>
                                </div>
                            }
                            <div class="pm-dose-note-lbl">
                                <i class="fas fa-pen-to-square"></i> Note (optional)
                            </div>
                            <textarea class="pm-dose-note-ta pm-notes-input" rows="2"
                                      placeholder="e.g. felt nauseous, took with food…"></textarea>
                            <div class="pm-dose-btns">
                                <button class="pm-dose-btn-v2 taken" data-action="Taken">
                                    <i class="fas fa-check-circle"></i> Taken
                                </button>
                                <button class="pm-dose-btn-v2 skipped" data-action="Skipped">
                                    <i class="fas fa-forward"></i> Skipped
                                </button>
                                <button class="pm-dose-btn-v2 missed" data-action="Missed">
                                    <i class="fas fa-times-circle"></i> Missed
                                </button>
                            </div>
                        </div>
                    </article>
                }
            }
        </div>
    }
    else
    {
        <div class="pm-empty-v2">
            <div class="pm-empty-ico"><i class="fas fa-check-circle"></i></div>
            <h3>No scheduled doses</h3>
            <p>There are no doses scheduled for this day. Use the arrows above to navigate to another day.</p>
            <a class="btn btn-outline" href="/PatientMedication/Index/@pid">
                <i class="fas fa-arrow-left"></i> Back to Medications
            </a>
        </div>
    }

</section>

@section Scripts {
    <script src="~/js/patient-medications.js" asp-append-version="true"></script>
}
