@{
    ViewData["Title"] = "NABD - نبض | Securing the pulse of the next generation";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="NABD is an AI-powered healthcare companion for pregnant women — early risk detection, gestational diabetes monitoring, and continuous pregnancy follow-up." />
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home-index.css" asp-append-version="true" />
</head>
<body>

    <!-- ══════════════════════════════════════════════════════
     NAVBAR
════════════════════════════════════════════════════════ -->
    <nav class="navbar">
        <div class="container">
            <div class="navbar-inner">
                <a href="@Url.Action("Index", "Home")" class="navbar-logo">
                    <img src="~/images/blue logo.png" alt="NABD" class="logo-icon" />
                </a>
                <ul class="navbar-links">
                    <li><a href="#problems">Problems</a></li>
                    <li><a href="#solution">Solution</a></li>
                    <li><a href="#features">AI Features</a></li>
                    <li><a href="#workflow">Workflow</a></li>
                    <li><a href="#team">Team</a></li>
                </ul>
                <div class="navbar-cta">
                    <a href="@Url.Action("Login", "Account")" class="login">Log In</a>
                    <a href="@Url.Action("Login", "Account")" class="btn btn-primary" style="padding: 10px 22px; font-size: 14px;">Get Started</a>
                </div>
                <div class="hamburger" aria-label="Menu">
                    <span></span><span></span><span></span>
                </div>
            </div>
        </div>
    </nav>

    <div class="mobile-menu">
        <a href="#problems">Problems</a>
        <a href="#solution">Solution</a>
        <a href="#features">AI Features</a>
        <a href="#workflow">Workflow</a>
        <a href="#team">Team</a>
        <a href="@Url.Action("Login", "Account")" style="color: #0ea5e9; font-weight: 700; border: none;">Get Started →</a>
    </div>

    <!-- ══════════════════════════════════════════════════════
     HERO
════════════════════════════════════════════════════════ -->
    <section class="hero" id="home">
        <div class="container">
            <div class="hero-inner">
                <div class="hero-content">
                    <div class="hero-badge reveal">
                        <span class="badge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                            AI-Powered Healthcare Platform
                        </span>
                    </div>
                    <p class="hero-slogan reveal delay-1">Securing the pulse of the next generation.</p>
                    <h1 class="hero-title reveal delay-2">
                        AI-Powered<br>
                        <span class="accent">Pregnancy Care</span>
                    </h1>
                    <p class="hero-desc reveal delay-3">
                        Smarter monitoring &amp; early risk detection. NABD is your intelligent, quiet guardian — providing precise analysis and warm reassurance for expectant mothers 24/7.
                    </p>
                    <div class="hero-buttons reveal delay-4">
                        <a href="#features" class="btn btn-primary">
                            Get Started
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                        </a>
                        <a href="#solution" class="btn btn-outline">Learn More</a>
                    </div>
                    <div class="hero-trust reveal delay-5">
                        <div class="trust-avatars">
                            <span style="background: linear-gradient(135deg, #0ea5e9, #8b5cf6);">A</span>
                            <span style="background: linear-gradient(135deg, #06b6d4, #0ea5e9);">S</span>
                            <span style="background: linear-gradient(135deg, #8b5cf6, #ec4899);">M</span>
                        </div>
                        <div class="trust-text">
                            <strong>Trusted by 1,000+ mothers &amp; clinics</strong>
                            Continuous AI-powered monitoring
                        </div>
                    </div>
                </div>

                <div class="hero-visual reveal-right delay-2">
                    <div class="hero-dashboard">
                        <div class="dash-header">
                            <span class="dash-title">Pregnancy Dashboard</span>
                            <span class="dash-badge">Week 28</span>
                        </div>
                        <div class="dash-stats">
                            <div class="dash-stat">
                                <div class="dash-stat-val" data-count="98" data-suffix="%">0%</div>
                                <div class="dash-stat-lab">Risk Score</div>
                            </div>
                            <div class="dash-stat">
                                <div class="dash-stat-val" data-count="87" data-suffix="">0</div>
                                <div class="dash-stat-lab">BPM</div>
                            </div>
                            <div class="dash-stat">
                                <div class="dash-stat-val" data-count="84" data-suffix="mg">0mg</div>
                                <div class="dash-stat-lab">Glucose</div>
                            </div>
                        </div>
                        <div class="dash-chart">
                            <div class="chart-label">Health Trend — Last 7 Days</div>
                            <div class="chart-bars">
                                <div class="chart-bar" style="height: 55%;"></div>
                                <div class="chart-bar" style="height: 70%;"></div>
                                <div class="chart-bar" style="height: 60%;"></div>
                                <div class="chart-bar" style="height: 85%;"></div>
                                <div class="chart-bar" style="height: 75%;"></div>
                                <div class="chart-bar" style="height: 90%;"></div>
                                <div class="chart-bar" style="height: 80%;"></div>
                            </div>
                        </div>
                        <div class="dash-alerts">
                            <div class="dash-alert">
                                <span class="alert-dot green"></span>
                                <span class="alert-text">All vitals within normal range</span>
                            </div>
                            <div class="dash-alert">
                                <span class="alert-dot blue"></span>
                                <span class="alert-text">Next appointment: Tomorrow, 10:00 AM</span>
                            </div>
                            <div class="dash-alert">
                                <span class="alert-dot purple"></span>
                                <span class="alert-text">AI analysis complete — Low risk detected</span>
                            </div>
                        </div>
                    </div>

                    <div class="dash-float-card top-right">
                        <div class="float-icon" style="background: #dcfce7;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                        </div>
                        <div class="float-info">
                            <span class="float-val" style="color: #16a34a;">Low Risk</span>
                            <span class="float-lab">AI Assessment</span>
                        </div>
                    </div>

                    <div class="dash-float-card bottom-left">
                        <div class="float-icon" style="background: #ede9fe;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                        </div>
                        <div class="float-info">
                            <span class="float-val">99.2%</span>
                            <span class="float-lab">Accuracy Rate</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
     PROBLEMS
════════════════════════════════════════════════════════ -->
    <section class="problems section" id="problems">
        <div class="container">
            <div class="text-center reveal">
                <p class="section-label">The Challenge</p>
                <h2 class="section-title">Real Problems <span>Pregnant Women</span> Face</h2>
                <p class="section-desc">Traditional healthcare systems leave critical gaps in pregnancy monitoring. NABD is designed to close every one of them.</p>
            </div>
            <div class="problems-grid">

                <div class="problem-card reveal delay-1">
                    <div class="problem-icon" style="background: #fee2e2;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                    </div>
                    <h3 class="problem-title">Late Risk Detection</h3>
                    <p class="problem-desc">Many complications are discovered too late due to lack of continuous monitoring. Early intervention is impossible without real-time data.</p>
                </div>

                <div class="problem-card reveal delay-2">
                    <div class="problem-icon" style="background: #fef3c7;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18" /></svg>
                    </div>
                    <h3 class="problem-title">Missed Gestational Diabetes</h3>
                    <p class="problem-desc">Gestational diabetes may go unnoticed without regular AI-powered analysis and predictive monitoring throughout the pregnancy.</p>
                </div>

                <div class="problem-card reveal delay-3">
                    <div class="problem-icon" style="background: #dbeafe;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                    </div>
                    <h3 class="problem-title">Poor Doctor-Patient Communication</h3>
                    <p class="problem-desc">Patients often struggle to contact doctors quickly during critical situations, leading to delays in critical healthcare decisions.</p>
                </div>

                <div class="problem-card reveal delay-4">
                    <div class="problem-icon" style="background: #ede9fe;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14,2 14,8 20,8" /></svg>
                    </div>
                    <h3 class="problem-title">Fragmented Medical Records</h3>
                    <p class="problem-desc">Medical history, test results, and reports are scattered across different systems, making comprehensive care nearly impossible.</p>
                </div>

                <div class="problem-card reveal delay-5">
                    <div class="problem-icon" style="background: #fce7f3;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#ec4899" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                    </div>
                    <h3 class="problem-title">Unsafe Product Usage</h3>
                    <p class="problem-desc">Pregnant women may unknowingly use harmful products or ingredients that pose risks to themselves or their baby's development.</p>
                </div>

                <div class="problem-card reveal delay-6">
                    <div class="problem-icon" style="background: #d1fae5;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                    </div>
                    <h3 class="problem-title">Lack of Continuous Monitoring</h3>
                    <p class="problem-desc">Traditional healthcare provides only periodic check-ups. Without proactive follow-up, silent risks can develop between visits.</p>
                </div>

            </div>
        </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
     SOLUTION
════════════════════════════════════════════════════════ -->
    <section class="solution section" id="solution">
        <div class="container">
            <div class="solution-inner">
                <div>
                    <p class="section-label reveal">The NABD Solution</p>
                    <h2 class="section-title reveal delay-1">One Platform.<br><span>Complete Care.</span></h2>
                    <p class="section-desc reveal delay-2">NABD is an all-in-one AI healthcare companion that unifies pregnancy monitoring, intelligent analysis, and seamless doctor-patient communication.</p>
                    <div class="solution-flow reveal delay-3">
                        <div class="flow-step">
                            <div class="flow-num">1</div>
                            <div class="flow-content">
                                <h4 class="flow-title">Patient Shares Data</h4>
                                <p class="flow-desc">Upload lab results, ultrasound images, or product ingredients directly from your phone or device.</p>
                            </div>
                        </div>
                        <div class="flow-step">
                            <div class="flow-num">2</div>
                            <div class="flow-content">
                                <h4 class="flow-title">AI Analyzes Instantly</h4>
                                <p class="flow-desc">NABD's AI engine processes your data against pregnancy-specific models to detect patterns and risks in seconds.</p>
                            </div>
                        </div>
                        <div class="flow-step">
                            <div class="flow-num">3</div>
                            <div class="flow-content">
                                <h4 class="flow-title">Doctor Reviews Insights</h4>
                                <p class="flow-desc">Your physician receives structured AI-generated reports and can communicate with you directly via the platform.</p>
                            </div>
                        </div>
                        <div class="flow-step">
                            <div class="flow-num">4</div>
                            <div class="flow-content">
                                <h4 class="flow-title">Better Healthcare Decisions</h4>
                                <p class="flow-desc">Personalized recommendations, medication reminders, and continuous monitoring ensure the safest pregnancy journey.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="solution-visual reveal-right delay-2">
                    <div class="sol-card">
                        <div class="sol-card-head">
                            <div class="sol-card-icon" style="background: #dbeafe;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                            </div>
                            <span class="sol-card-title">AI Risk Assessment</span>
                        </div>
                        <div class="sol-progress"><div class="sol-progress-fill" data-width="88%"></div></div>
                        <p style="font-size: 12px; color: #94a3b8; margin-top: 6px;">Confidence: 88% — Low Risk Profile</p>
                    </div>
                    <div class="sol-card">
                        <div class="sol-card-head">
                            <div class="sol-card-icon" style="background: #dcfce7;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                            </div>
                            <span class="sol-card-title">Gestational Diabetes Score</span>
                        </div>
                        <div class="sol-progress"><div class="sol-progress-fill" data-width="25%" style="background: linear-gradient(90deg, #22c55e, #16a34a);"></div></div>
                        <p style="font-size: 12px; color: #94a3b8; margin-top: 6px;">Score: 25 / 100 — Normal Range</p>
                    </div>
                    <div class="sol-card">
                        <div class="sol-card-head">
                            <div class="sol-card-icon" style="background: #ede9fe;">
                                <svg viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                            </div>
                            <span class="sol-card-title">Overall Pregnancy Health</span>
                        </div>
                        <div class="sol-progress"><div class="sol-progress-fill" data-width="92%" style="background: linear-gradient(90deg, #8b5cf6, #06b6d4);"></div></div>
                        <p style="font-size: 12px; color: #94a3b8; margin-top: 6px;">Score: 92 / 100 — Excellent</p>
                    </div>
                    <div style="background: rgba(14,165,233,0.08); border: 1px dashed rgba(14,165,233,0.3); border-radius: 12px; padding: 16px; text-align: center; margin-top: 4px;">
                        <p style="font-size: 13px; color: #0284c7; font-weight: 600;">Next AI Report ready in 5 min.</p>
                        <p style="font-size: 12px; color: #94a3b8; margin-top: 4px;">Continuous monitoring active</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
     AI FEATURES
════════════════════════════════════════════════════════ -->
    <section class="ai-features section" id="features">
        <div class="container">
            <div class="text-center reveal">
                <p class="section-label">AI Capabilities</p>
                <h2 class="section-title">Powered by <span style="-webkit-text-fill-color: transparent; background: linear-gradient(135deg, #38bdf8, #818cf8); -webkit-background-clip: text; background-clip: text;">Intelligent AI</span></h2>
                <p class="section-desc" style="color: rgba(255,255,255,0.6); margin: 0 auto;">The most advanced AI features in pregnancy healthcare, designed to detect, predict, and protect at every stage.</p>
            </div>
            <div class="ai-grid">

                <div class="ai-card reveal delay-1">
                    <div class="ai-card-glow" style="background: rgba(14,165,233,0.15);">
                        <div style="position:absolute;inset:-4px;border-radius:20px;background:rgba(14,165,233,0.1);filter:blur(8px);"></div>
                        <svg viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2">
                            <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18" />
                        </svg>
                    </div>
                    <h3 class="ai-card-title">AI Medical Test Analysis</h3>
                    <p class="ai-card-desc">Upload blood tests, urine reports, and lab results. Our AI interprets every value against pregnancy-specific reference ranges and flags anomalies instantly.</p>
                    <span class="ai-tag" style="background: rgba(14,165,233,0.15); color: #38bdf8;">Lab Reports</span>
                </div>

                <div class="ai-card reveal delay-2">
                    <div class="ai-card-glow" style="background: rgba(139,92,246,0.15);">
                        <div style="position:absolute;inset:-4px;border-radius:20px;background:rgba(139,92,246,0.1);filter:blur(8px);"></div>
                        <svg viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2">
                            <rect x="3" y="3" width="18" height="18" rx="2" />
                            <circle cx="8.5" cy="8.5" r="1.5" />
                            <polyline points="21 15 16 10 5 21" />
                        </svg>
                    </div>
                    <h3 class="ai-card-title">AI Ultrasound Analysis</h3>
                    <p class="ai-card-desc">Advanced computer vision analyzes ultrasound images to assess fetal development, detect abnormalities, and provide detailed growth tracking reports.</p>
                    <span class="ai-tag" style="background: rgba(139,92,246,0.15); color: #a78bfa;">Imaging AI</span>
                </div>

                <div class="ai-card reveal delay-3">
                    <div class="ai-card-glow" style="background: rgba(236,72,153,0.15);">
                        <div style="position:absolute;inset:-4px;border-radius:20px;background:rgba(236,72,153,0.1);filter:blur(8px);"></div>
                        <svg viewBox="0 0 24 24" fill="none" stroke="#f472b6" stroke-width="2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                        </svg>
                    </div>
                    <h3 class="ai-card-title">Product Safety Checker</h3>
                    <p class="ai-card-desc">Scan any product's ingredient list. NABD's AI cross-references thousands of substances against pregnancy safety databases and alerts you to harmful ingredients.</p>
                    <span class="ai-tag" style="background: rgba(236,72,153,0.15); color: #f472b6;">Safety AI</span>
                </div>

                <div class="ai-card reveal delay-4">
                    <div class="ai-card-glow" style="background: rgba(16,185,129,0.15);">
                        <div style="position:absolute;inset:-4px;border-radius:20px;background:rgba(16,185,129,0.1);filter:blur(8px);"></div>
                        <svg viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                        </svg>
                    </div>
                    <h3 class="ai-card-title">Predictive Risk Detection</h3>
                    <p class="ai-card-desc">Machine learning models trained on thousands of pregnancies identify early signs of gestational diabetes, preeclampsia, and other complications before they escalate.</p>
                    <span class="ai-tag" style="background: rgba(16,185,129,0.15); color: #34d399;">Prediction AI</span>
                </div>

            </div>
        </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
     PATIENT EXPERIENCE
════════════════════════════════════════════════════════ -->
    <section class="patient section" id="patient">
        <div class="container">
            <div class="text-center reveal">
                <p class="section-label">Patient Experience</p>
                <h2 class="section-title">Your <span>Complete Pregnancy</span> Companion</h2>
                <p class="section-desc">Everything an expectant mother needs — in one supportive, intelligent platform.</p>
            </div>
            <div class="patient-grid">

                <div class="patient-card reveal delay-1" style="background: linear-gradient(135deg, #eff6ff, #f5f3ff);">
                    <div class="patient-icon" style="background: #dbeafe;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                    </div>
                    <h3 class="patient-title">Real-Time Doctor Chat</h3>
                    <p class="patient-desc">Connect with your healthcare provider instantly. No more waiting rooms or delayed callbacks when you need answers most.</p>
                    <ul class="patient-feature-list">
                        <li>Instant messaging with your OB/GYN</li>
                        <li>Multimedia support — send images, reports</li>
                        <li>Message history and read receipts</li>
                    </ul>
                </div>

                <div class="patient-card reveal delay-2" style="background: linear-gradient(135deg, #f0fdf4, #ecfdf5);">
                    <div class="patient-icon" style="background: #dcfce7;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><path d="M18 8h1a4 4 0 0 1 0 8h-1" /><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z" /><line x1="6" y1="1" x2="6" y2="4" /><line x1="10" y1="1" x2="10" y2="4" /><line x1="14" y1="1" x2="14" y2="4" /></svg>
                    </div>
                    <h3 class="patient-title">Smart Medication Reminders</h3>
                    <p class="patient-desc">Never miss a prenatal vitamin, supplement, or medication. AI-personalized schedules adapted to your trimester and health profile.</p>
                    <ul class="patient-feature-list">
                        <li>Customized medication schedules</li>
                        <li>Dosage and timing reminders</li>
                        <li>Trimester-aware adjustments</li>
                    </ul>
                </div>

                <div class="patient-card reveal delay-3" style="background: linear-gradient(135deg, #faf5ff, #fdf4ff);">
                    <div class="patient-icon" style="background: #ede9fe;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14,2 14,8 20,8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>
                    </div>
                    <h3 class="patient-title">Complete Medical History</h3>
                    <p class="patient-desc">Your entire pregnancy journey — every test, appointment, AI report, and doctor note — organized in one secure, searchable timeline.</p>
                    <ul class="patient-feature-list">
                        <li>Full pregnancy timeline view</li>
                        <li>Shareable with any doctor</li>
                        <li>Secure cloud storage</li>
                    </ul>
                </div>

                <div class="patient-card reveal delay-4" style="background: linear-gradient(135deg, #fff7ed, #fef3c7);">
                    <div class="patient-icon" style="background: #fef3c7;">
