    <!-- ══════════════════════════════════════════════════════
     INTRODUCTION  ·  WHAT IS NABD
════════════════════════════════════════════════════════ -->
    <section class="intro section" id="intro">
        <span class="intro-glow" aria-hidden="true"></span>
        <div class="container">
            <div class="intro-inner">
                <div class="intro-lead">
                    <span class="intro-eyebrow reveal">
                        <span class="pulse-dot"></span>
                        Project Overview
                    </span>
                    <h2 class="section-title reveal delay-1">What is <span>NABD</span>?</h2>
                    <p class="intro-text reveal delay-2">
                        <strong>NABD</strong> is an AI-powered pregnancy health management platform that unifies monitoring, communication, and early risk detection for mothers and their care teams in one intelligent system.
                    </p>
                    <p class="intro-text reveal delay-2">
                        Built on ASP.NET Core, NABD connects everyone involved in the pregnancy journey — turning scattered scans, lab results, and symptoms into clear, actionable insight, available around the clock.
                    </p>
                    <div class="intro-highlights reveal delay-3">
                        <div class="intro-stat">
                            <strong>1</strong>
                            <span>Unified Platform</span>
                        </div>
                        <div class="intro-stat">
                            <strong>4</strong>
                            <span>User Roles</span>
                        </div>
                        <div class="intro-stat">
                            <strong>5+</strong>
                            <span>AI Capabilities</span>
                        </div>
                    </div>
                    <div class="intro-tags reveal delay-4">
                        <span class="intro-tag">Maternal Health</span>
                        <span class="intro-tag">Early Detection</span>
                        <span class="intro-tag">Continuous Care</span>
                    </div>
                </div>

                <div class="intro-panel reveal-right delay-2">
                    <div class="intro-panel-head">
                        <span class="intro-panel-ico">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
                        </span>
                        <p class="intro-panel-title">One Platform · Four Roles</p>
                    </div>

                    <div class="intro-roles">
                        <div class="intro-role">
                            <span class="intro-role-ico" style="background: linear-gradient(135deg,#1baebe,#22c9db);">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                            </span>
                            <div>
                                <h4>Patient</h4>
                                <p>Tracks pregnancy, uploads tests, and chats with doctors & AI.</p>
                            </div>
