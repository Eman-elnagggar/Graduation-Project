    <!-- ══════════════════════════════════════════════════════
     WORKFLOW
════════════════════════════════════════════════════════ -->
    <section class="workflow-section section" id="workflow">
        <div class="container">
            <div class="text-center reveal">
                <p class="section-label">How It Works</p>
                <h2 class="section-title">From <span>Data to Decision</span> in Minutes</h2>
                <p class="section-desc">A seamless four-step process that transforms raw health data into life-changing insights — automatically.</p>
            </div>
            <div class="workflow-steps">

                <div class="wf-step reveal delay-1">
                    <div style="position: relative; margin-bottom: 20px; display: flex; justify-content: center;">
                        <div class="wf-circle" style="background: linear-gradient(135deg, #1baebe, #22c9db);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" width="30" height="30"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>
                        </div>
                        <span class="wf-num">1</span>
                    </div>
                    <h4 class="wf-title">Patient Uploads Data</h4>
                    <p class="wf-desc">Upload lab results, ultrasound images, or product ingredients from any device — instantly and securely.</p>
                </div>

                <div class="wf-step reveal delay-2">
                    <div style="position: relative; margin-bottom: 20px; display: flex; justify-content: center;">
                        <div class="wf-circle" style="background: linear-gradient(135deg, #22c9db, #a78bfa);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" width="30" height="30"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
                        </div>
                        <span class="wf-num">2</span>
                    </div>
                    <h4 class="wf-title">AI Analyzes Results</h4>
                    <p class="wf-desc">NABD's AI engine processes the data against pregnancy-specific models, identifying patterns, risks, and recommendations in seconds.</p>
                </div>

                <div class="wf-step reveal delay-3">
                    <div style="position: relative; margin-bottom: 20px; display: flex; justify-content: center;">
                        <div class="wf-circle" style="background: linear-gradient(135deg, #22c9db, #22c9db);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" width="30" height="30"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                        </div>
                        <span class="wf-num">3</span>
                    </div>
                    <h4 class="wf-title">Doctor Reviews Insights</h4>
                    <p class="wf-desc">Physicians receive structured AI-generated reports and can review, annotate, and respond directly from the clinic dashboard.</p>
                </div>

                <div class="wf-step reveal delay-4">
                    <div style="position: relative; margin-bottom: 20px; display: flex; justify-content: center;">
                        <div class="wf-circle" style="background: linear-gradient(135deg, #10b981, #34d399);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" width="30" height="30"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                        </div>
                        <span class="wf-num">4</span>
                    </div>
                    <h4 class="wf-title">Recommendations Delivered</h4>
                    <p class="wf-desc">Personalized healthcare recommendations, medication reminders, and follow-up actions are delivered directly to the patient.</p>
                </div>

            </div>
        </div>
    </section>

