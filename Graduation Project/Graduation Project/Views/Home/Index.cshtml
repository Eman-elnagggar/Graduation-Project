    <div class="mobile-menu">
        <a href="#problems">Problem</a>
        <a href="#related">Comparison</a>
        <a href="#intro">About</a>
        <a href="#solution">Solution</a>
        <a href="#patient">For Patients</a>
        <a href="#doctor">For Doctors</a>
