@{
    ViewData["Title"] = "NABD - نبض | Securing the pulse of the next generation";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="NABD is an AI-powered healthcare companion for pregnant women — early risk detection, gestational diabetes monitoring, and continuous pregnancy follow-up." />
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/home-index.css" asp-append-version="true" />
</head>
<body>

    <!-- ══════════════════════════════════════════════════════
     NAVBAR
════════════════════════════════════════════════════════ -->
    <nav class="navbar">
        <div class="container">
            <div class="navbar-inner">
                <a href="@Url.Action("Index", "Home")" class="navbar-logo">
                    <img src="~/images/logo name.png" alt="NABD" class="logo-icon" />
                </a>
                <ul class="navbar-links">
                    <li><a href="#problems">Problems</a></li>
                    <li><a href="#solution">Solution</a></li>
                    <li><a href="#features">AI Features</a></li>
                    <li><a href="#workflow">Workflow</a></li>
                    <li><a href="#team">Team</a></li>
                </ul>
                <div class="navbar-cta">
                    <a href="@Url.Action("Login", "Account")" class="login">Log In</a>
                    <a href="@Url.Action("RegisterPatient", "Account")" class="btn btn-primary" style="padding: 10px 22px; font-size: 14px;">Get Started</a>
                </div>
                <div class="hamburger" aria-label="Menu">
                    <span></span><span></span><span></span>
                </div>
            </div>
        </div>
    </nav>

    <div class="mobile-menu">
        <a href="#problems">Problems</a>
        <a href="#solution">Solution</a>
        <a href="#features">AI Features</a>
        <a href="#workflow">Workflow</a>
        <a href="#team">Team</a>
        <a href="@Url.Action("RegisterPatient", "Account")" style="color: #1baebe; font-weight: 700; border: none;">Get Started →</a>
    </div>

    <!-- ══════════════════════════════════════════════════════
     HERO
════════════════════════════════════════════════════════ -->
    <section class="hero" id="home">
        <div class="hero-bg" aria-hidden="true">
            <span class="hero-blob blob-1"></span>
            <span class="hero-blob blob-2"></span>
            <span class="hero-blob blob-3"></span>
            <span class="hero-mesh"></span>
        </div>
        <div class="container">
            <div class="hero-inner">

                <!-- ── LEFT: STORY ───────────────────────────── -->
                <div class="hero-content">
                    <h1 class="hero-title reveal delay-1">
                        Two heartbeats.<br>
                        <span class="accent">One intelligent guardian.</span>
                    </h1>
                    <p class="hero-desc reveal delay-2">
                        NABD listens to you and your baby — reading every scan, lab result, and symptom to catch what matters, early. Calm, continuous, AI-powered care.
                    </p>
                    <div class="hero-buttons reveal delay-3">
                        <a href="@Url.Action("RegisterPatient", "Account")" class="btn btn-primary">
                            Start Your Journey
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                        </a>
                        <a href="#workflow" class="btn btn-outline">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" /><polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none" /></svg>
                            How It Works
                        </a>
                    </div>
                    <div class="hero-proof reveal delay-4">
                        <div class="hero-metric">
                            <strong>99.2%</strong>
                            <span>AI Accuracy</span>
                        </div>
                        <div class="hero-metric">
                            <strong>24/7</strong>
                            <span>Monitoring</span>
                        </div>
                        <div class="hero-metric">
                            <strong>1,000+</strong>
                            <span>Mothers Trust Us</span>
                        </div>
                    </div>
                </div>

                <!-- ── RIGHT: PRODUCT COMPOSITION ────────────── -->
                <div class="hero-visual reveal-right delay-2">

                    <!-- pregnancy progress ring behind the cards -->
                    <svg class="hero-ring" viewBox="0 0 440 440" aria-hidden="true">
                        <defs>
                            <linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0" stop-color="#22c9db" />
                                <stop offset="1" stop-color="#1baebe" />
                            </linearGradient>
                        </defs>
                        <circle class="hr-track" cx="220" cy="220" r="180" />
                        <circle class="hr-prog" cx="220" cy="220" r="180" />
                    </svg>
                    <span class="hero-ring-dashed" aria-hidden="true"></span>

                    <div class="hero-collage">

                        <!-- 1 · Pregnancy week tracking -->
                        <article class="hc hc-week">
                            <div class="week-ring">
                                <svg viewBox="0 0 120 120" aria-hidden="true">
                                    <defs>
                                        <linearGradient id="wkGrad" x1="0" y1="0" x2="1" y2="1">
                                            <stop offset="0" stop-color="#22c9db" />
                                            <stop offset="1" stop-color="#138fa0" />
                                        </linearGradient>
                                    </defs>
                                    <circle class="wk-track" cx="60" cy="60" r="52" />
                                    <circle class="wk-prog" cx="60" cy="60" r="52" />
                                </svg>
                                <div class="week-center">
                                    <strong>28</strong>
                                    <span>weeks</span>
                                </div>
                            </div>
                            <div class="week-meta">
                                <span class="hc-badge tri">Third Trimester</span>
                                <p class="week-title">Pregnancy Progress</p>
                                <p class="week-sub">12 weeks to go · Due Sep 12</p>
                                <div class="week-line"><span></span></div>
                            </div>
                        </article>

                        <!-- 2 · Baby development -->
                        <article class="hc hc-baby">
                            <div class="hc-ico ico-baby">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="9" r="5" /><path d="M12 14c-3.5 0-6 2.2-6 5v1h12v-1c0-2.8-2.5-5-6-5z" /><circle cx="10" cy="8.5" r="0.6" fill="currentColor" stroke="none" /><circle cx="14" cy="8.5" r="0.6" fill="currentColor" stroke="none" /></svg>
                            </div>
                            <p class="hc-eyebrow">Baby Development</p>
                            <p class="hc-strong">Size of an eggplant</p>
                            <div class="hc-mini">
                                <span>37.6 cm</span><i></i><span>1.0 kg</span>
                            </div>
                        </article>

                        <!-- 3 · Lab test analysis -->
                        <article class="hc hc-lab">
                            <div class="hc-ico ico-lab">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 3h6M10 3v6.5L5.5 17a2 2 0 0 0 1.8 3h9.4a2 2 0 0 0 1.8-3L14 9.5V3" /><line x1="8" y1="15" x2="16" y2="15" /></svg>
                            </div>
                            <p class="hc-eyebrow">Lab Test Analysis</p>
                            <p class="hc-strong">Glucose 84 <small>mg/dL</small></p>
                            <span class="hc-pill ok">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12" /></svg>
                                Normal · 14 markers read
                            </span>
                        </article>

                        <!-- 4 · Product safety scan -->
                        <article class="hc hc-safety">
                            <div class="hc-ico ico-safe">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><line x1="9" y1="11" x2="15" y2="11" /></svg>
                            </div>
                            <div class="safe-body">
                                <p class="hc-eyebrow">Product Safety Scan</p>
                                <p class="hc-strong">Retinol Night Cream</p>
                            </div>
                            <span class="hc-pill warn">Avoid in pregnancy</span>
                        </article>

                        <!-- 5 · AI recommendation -->
                        <article class="hc hc-ai">
                            <div class="ai-spark">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z" /></svg>
                            </div>
                            <div class="ai-body">
                                <p class="ai-label">NABD AI Insight</p>
                                <p class="ai-text">Your glucose trend looks excellent — keep up the morning walks. <span>Low risk this week.</span></p>
                            </div>
                        </article>

                    </div>

                    <!-- floating vitals chips -->
                    <span class="hero-chip chip-bpm">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M3 12h4l2-6 4 12 2-6h4" /></svg>
                        147 <small>bpm</small>
                    </span>
                    <span class="hero-chip chip-risk">
                        <span class="chip-dot"></span>
                        Low Risk
                    </span>
                </div>
            </div>
        </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
     PROBLEMS
════════════════════════════════════════════════════════ -->
    <section class="problems section" id="problems">
        <div class="container">
            <div class="text-center reveal">
                <p class="section-label">The Challenge</p>
                <h2 class="section-title">Real Problems <span>Pregnant Women</span> Face</h2>
                <p class="section-desc">Traditional healthcare systems leave critical gaps in pregnancy monitoring. NABD is designed to close every one of them.</p>
            </div>
            <div class="problems-grid">

                <div class="problem-card reveal delay-1" style="--c:#ef4444; --c-soft:#fef2f2; --c-glow:rgba(239,68,68,0.22);">
                    <span class="problem-num">01</span>
                    <div class="problem-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                    </div>
                    <h3 class="problem-title">Late Risk Detection</h3>
                    <p class="problem-desc">Many complications are discovered too late due to lack of continuous monitoring. Early intervention is impossible without real-time data.</p>
                </div>

                <div class="problem-card reveal delay-2" style="--c:#f59e0b; --c-soft:#fffbeb; --c-glow:rgba(245,158,11,0.22);">
                    <span class="problem-num">02</span>
                    <div class="problem-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18" /></svg>
                    </div>
                    <h3 class="problem-title">Missed Gestational Diabetes</h3>
                    <p class="problem-desc">Gestational diabetes may go unnoticed without regular AI-powered analysis and predictive monitoring throughout the pregnancy.</p>
                </div>

                <div class="problem-card reveal delay-3" style="--c:#1baebe; --c-soft:#eefcfd; --c-glow:rgba(27,174,190,0.22);">
                    <span class="problem-num">03</span>
                    <div class="problem-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>
                    </div>
                    <h3 class="problem-title">Poor Doctor-Patient Communication</h3>
                    <p class="problem-desc">Patients often struggle to contact doctors quickly during critical situations, leading to delays in critical healthcare decisions.</p>
                </div>

                <div class="problem-card reveal delay-4" style="--c:#22c9db; --c-soft:#effdfe; --c-glow:rgba(34,201,219,0.22);">
                    <span class="problem-num">04</span>
                    <div class="problem-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14,2 14,8 20,8" /></svg>
                    </div>
                    <h3 class="problem-title">Fragmented Medical Records</h3>
                    <p class="problem-desc">Medical history, test results, and reports are scattered across different systems, making comprehensive care nearly impossible.</p>
                </div>

                <div class="problem-card reveal delay-5" style="--c:#ec4899; --c-soft:#fdf2f8; --c-glow:rgba(236,72,153,0.22);">
                    <span class="problem-num">05</span>
                    <div class="problem-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" /></svg>
                    </div>
                    <h3 class="problem-title">Unsafe Product Usage</h3>
                    <p class="problem-desc">Pregnant women may unknowingly use harmful products or ingredients that pose risks to themselves or their baby's development.</p>
                </div>

                <div class="problem-card reveal delay-6" style="--c:#10b981; --c-soft:#ecfdf5; --c-glow:rgba(16,185,129,0.22);">
                    <span class="problem-num">06</span>
                    <div class="problem-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                    </div>
                    <h3 class="problem-title">Lack of Continuous Monitoring</h3>
                    <p class="problem-desc">Traditional healthcare provides only periodic check-ups. Without proactive follow-up, silent risks can develop between visits.</p>
                </div>

            </div>
        </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
     SOLUTION  ·  WHY NABD
════════════════════════════════════════════════════════ -->
    <section class="why section" id="solution">
        <div class="container">
            <div class="text-center reveal">
                <p class="section-label">The NABD Solution</p>
                <h2 class="section-title">What Makes <span>NABD Different</span></h2>
                <p class="section-desc">Traditional pregnancy care is reactive. NABD is proactive — intelligent, unified, and always one step ahead.</p>
            </div>
            <div class="why-grid">

                <div class="why-card reveal delay-1" style="background: linear-gradient(135deg, #eff6ff, #f5f3ff);">
                    <div class="why-num" style="color: #1baebe;">01</div>
                    <div class="why-icon" style="background: #dbeafe;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#1baebe" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" /></svg>
                    </div>
                    <h3 class="why-title">All-in-One Platform</h3>
                    <p class="why-desc">Every pregnancy tool, record, and communication channel unified in a single platform. No more juggling apps and clinics.</p>
                </div>

                <div class="why-card reveal delay-2" style="background: linear-gradient(135deg, #f0fdf4, #ecfdf5);">
                    <div class="why-num" style="color: #22c55e;">02</div>
                    <div class="why-icon" style="background: #dcfce7;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>
                    </div>
                    <h3 class="why-title">AI-Powered Monitoring</h3>
                    <p class="why-desc">Machine learning models trained specifically on pregnancy data — analyzing your health around the clock with clinical-grade precision.</p>
                </div>

                <div class="why-card reveal delay-3" style="background: linear-gradient(135deg, #fef2f2, #fff7ed);">
                    <div class="why-num" style="color: #ef4444;">03</div>
                    <div class="why-icon" style="background: #fee2e2;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                    </div>
                    <h3 class="why-title">Early Risk Detection</h3>
                    <p class="why-desc">NABD detects gestational diabetes, preeclampsia, and other risks weeks before they become critical — giving doctors time to act.</p>
                </div>

                <div class="why-card reveal delay-4" style="background: linear-gradient(135deg, #faf5ff, #fdf4ff);">
                    <div class="why-num" style="color: #22c9db;">04</div>
                    <div class="why-icon" style="background: #f0fdfe;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#22c9db" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2" /></svg>
                    </div>
                    <h3 class="why-title">Continuous Follow-Up</h3>
                    <p class="why-desc">Unlike traditional care that waits for appointments, NABD continuously monitors your health and proactively alerts you and your doctor.</p>
                </div>

                <div class="why-card reveal delay-5" style="background: linear-gradient(135deg, #fff7ed, #fef3c7);">
                    <div class="why-num" style="color: #f59e0b;">05</div>
                    <div class="why-icon" style="background: #fef3c7;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                    </div>
                    <h3 class="why-title">Smart Healthcare Experience</h3>
                    <p class="why-desc">Designed with mothers in mind — beautiful, intuitive interface that makes medical data accessible, understandable, and actionable.</p>
                </div>

                <div class="why-card reveal delay-6" style="background: linear-gradient(135deg, #ecfdf5, #d1fae5);">
                    <div class="why-num" style="color: #10b981;">06</div>
                    <div class="why-icon" style="background: #d1fae5;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                    </div>
                    <h3 class="why-title">Doctor-Patient Unity</h3>
                    <p class="why-desc">Real-time communication, shared records, and AI-assisted reporting keep patients and doctors perfectly aligned throughout the pregnancy.</p>
                </div>

            </div>
        </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
     AI FEATURES
════════════════════════════════════════════════════════ -->
    <section class="ai-features section" id="features">
        <div class="container">
            <div class="text-center reveal">
                <p class="section-label">AI Capabilities</p>
                <h2 class="section-title">Powered by <span style="-webkit-text-fill-color: transparent; background: linear-gradient(135deg, #22c9db, #22c9db); -webkit-background-clip: text; background-clip: text;">Intelligent AI</span></h2>
                <p class="section-desc" style="color: rgba(255,255,255,0.6); margin: 0 auto;">The most advanced AI features in pregnancy healthcare, designed to detect, predict, and protect at every stage.</p>
            </div>
            <div class="ai-grid">

                <div class="ai-card reveal delay-1">
                    <div class="ai-card-glow" style="background: rgba(27, 174, 190,0.15);">
                        <div style="position:absolute;inset:-4px;border-radius:20px;background:rgba(27, 174, 190,0.1);filter:blur(8px);"></div>
                        <svg viewBox="0 0 24 24" fill="none" stroke="#22c9db" stroke-width="2">
                            <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18" />
                        </svg>
                    </div>
                    <h3 class="ai-card-title">AI Medical Test Analysis</h3>
                    <p class="ai-card-desc">Upload blood tests, urine reports, and lab results. Our AI interprets every value against pregnancy-specific reference ranges and flags anomalies instantly.</p>
                    <span class="ai-tag" style="background: rgba(27, 174, 190,0.15); color: #22c9db;">Lab Reports</span>
                </div>

                <div class="ai-card reveal delay-2">
                    <div class="ai-card-glow" style="background: rgba(34, 201, 219,0.15);">
                        <div style="position:absolute;inset:-4px;border-radius:20px;background:rgba(34, 201, 219,0.1);filter:blur(8px);"></div>
                        <svg viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2">
                            <rect x="3" y="3" width="18" height="18" rx="2" />
                            <circle cx="8.5" cy="8.5" r="1.5" />
                            <polyline points="21 15 16 10 5 21" />
                        </svg>
                    </div>
                    <h3 class="ai-card-title">AI Ultrasound Analysis</h3>
                    <p class="ai-card-desc">Advanced computer vision analyzes ultrasound images to assess fetal development, detect abnormalities, and provide detailed growth tracking reports.</p>
                    <span class="ai-tag" style="background: rgba(34, 201, 219,0.15); color: #a78bfa;">Imaging AI</span>
                </div>

                <div class="ai-card reveal delay-3">
                    <div class="ai-card-glow" style="background: rgba(27, 174, 190,0.15);">
                        <div style="position:absolute;inset:-4px;border-radius:20px;background:rgba(27, 174, 190,0.1);filter:blur(8px);"></div>
                        <svg viewBox="0 0 24 24" fill="none" stroke="#1baebe" stroke-width="2">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                        </svg>
                    </div>
                    <h3 class="ai-card-title">Product Safety Checker</h3>
                    <p class="ai-card-desc">Scan any product's ingredient list. NABD's AI cross-references thousands of substances against pregnancy safety databases and alerts you to harmful ingredients.</p>
                    <span class="ai-tag" style="background: rgba(27, 174, 190,0.15); color: #1baebe;">Safety AI</span>
                </div>

                <div class="ai-card reveal delay-4">
                    <div class="ai-card-glow" style="background: rgba(16,185,129,0.15);">
                        <div style="position:absolute;inset:-4px;border-radius:20px;background:rgba(16,185,129,0.1);filter:blur(8px);"></div>
                        <svg viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                        </svg>
                    </div>
                    <h3 class="ai-card-title">Predictive Risk Detection</h3>
                    <p class="ai-card-desc">Machine learning models trained on thousands of pregnancies identify early signs of gestational diabetes, preeclampsia, and other complications before they escalate.</p>
                    <span class="ai-tag" style="background: rgba(16,185,129,0.15); color: #34d399;">Prediction AI</span>
                </div>

            </div>
        </div>
    </section>

    <!-- ══════════════════════════════════════════════════════
     PATIENT EXPERIENCE
════════════════════════════════════════════════════════ -->
    <section class="patient section" id="patient">
        <div class="container">
            <div class="text-center reveal">
                <p class="section-label">Patient Experience</p>
                <h2 class="section-title">Your <span>Complete Pregnancy</span> Companion</h2>
