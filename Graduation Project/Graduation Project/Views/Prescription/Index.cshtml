@model Graduation_Project.ViewModels.PrescriptionsViewModel
@using System.Linq
@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewData["Title"] = "My Prescriptions";
    ViewData["PatientId"]  = Model.Patient.PatientID;
    ViewData["ActivePage"] = "Prescriptions";
    ViewData["HidePageHeader"] = true;

    var firstName = (Model.UserName ?? "Mama").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Mama";
    var totalCount = Model.TotalCount;
    var doctorCount = Model.Prescriptions.Select(r => r.Doctor?.DoctorID).Where(id => id != null).Distinct().Count();
    var recentCount = Model.Prescriptions.Count(r => (DateTime.Today - r.PrescriptionDate.Date).TotalDays <= 30);
}

@section Styles {
    <link rel="stylesheet" href="~/css/patient-prescriptions.css" asp-append-version="true" />
}

<div class="px">

    <!-- ════════ HEADER ════════ -->
    <header class="px-head">
        <div class="px-head-botanical" aria-hidden="true">
            <svg viewBox="0 0 100 140" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
                <path d="M50 138 C50 104 50 72 50 32" />
                <path d="M50 112 C35 107 27 95 31 80 C47 84 54 98 50 112Z" />
                <path d="M50 112 C65 107 73 95 69 80 C53 84 46 98 50 112Z" />
                <path d="M50 88 C37 83 31 71 35 58 C49 62 54 76 50 88Z" />
                <path d="M50 88 C63 83 69 71 65 58 C51 62 46 76 50 88Z" />
            </svg>
        </div>
        <div class="px-head-bar">
            <div class="px-head-intro">
                <span class="px-eyebrow"><i class="fas fa-prescription"></i> My Health Records</span>
                <h1 class="px-head-title">@firstName's <b>Prescriptions</b></h1>
                <p class="px-head-sub">Every medication your doctors have prescribed, gathered in one place.</p>
            </div>
            <div class="px-head-chips">
                <div class="px-chip">
                    <span class="px-chip-ico rose"><i class="fas fa-file-prescription"></i></span>
                    <span>
                        <span class="px-chip-val">@totalCount</span>
                        <span class="px-chip-lbl">Prescription@(totalCount != 1 ? "s" : "")</span>
                    </span>
                </div>
                <div class="px-chip">
                    <span class="px-chip-ico violet"><i class="fas fa-user-md"></i></span>
                    <span>
                        <span class="px-chip-val">@doctorCount</span>
                        <span class="px-chip-lbl">Doctor@(doctorCount != 1 ? "s" : "")</span>
                    </span>
                </div>
                <div class="px-chip">
                    <span class="px-chip-ico sky"><i class="fas fa-calendar-day"></i></span>
                    <span>
                        <span class="px-chip-val px-chip-val-sm">@(Model.LatestDate.HasValue ? Model.LatestDate.Value.ToString("MMM dd") : "—")</span>
                        <span class="px-chip-lbl">Latest</span>
                    </span>
                </div>
            </div>
        </div>
    </header>

    @if (!Model.Prescriptions.Any())
    {
        <div class="px-empty">
            <div class="px-empty-ico"><i class="fas fa-prescription-bottle"></i></div>
            <h3>No prescriptions yet</h3>
            <p>When a doctor issues you a prescription, it will appear here — neatly organised and ready whenever you need it.</p>
        </div>
    }
    else
    {
        <!-- ════════ TOOLBAR ════════ -->
        <div class="px-toolbar">
            <div class="px-search">
                <i class="fas fa-search"></i>
                <input type="text" id="pxSearch" placeholder="Search by medicine, doctor or date…" />
                <button class="px-search-clear" id="pxClear" type="button" style="display:none;"><i class="fas fa-times"></i></button>
            </div>
            <div class="px-tabs">
                <button class="px-tab active" data-filter="all" type="button">All <span class="px-tab-count">@totalCount</span></button>
                <button class="px-tab" data-filter="recent" type="button">Last 30 Days <span class="px-tab-count">@recentCount</span></button>
            </div>
            <div class="px-expand-controls">
                <button class="px-ctl" id="pxExpandAll" type="button"><i class="fas fa-chevron-down"></i> Expand</button>
                <button class="px-ctl" id="pxCollapseAll" type="button"><i class="fas fa-chevron-up"></i> Collapse</button>
            </div>
        </div>

        <!-- ════════ PRESCRIPTIONS ════════ -->
        <div class="px-list">
            @{ var first = true; }
            @foreach (var rx in Model.Prescriptions)
            {
                var doctorName = rx.Doctor?.User != null
                    ? $"Dr. {rx.Doctor.User.FirstName} {rx.Doctor.User.LastName}".Trim()
                    : "Unknown Doctor";
                var specialization = rx.Doctor?.Specialization ?? "";
                var itemCount = rx.Items?.Count ?? 0;
                var isRecent = (DateTime.Today - rx.PrescriptionDate.Date).TotalDays <= 30;
                var medsSearch = string.Join(" ", rx.Items?.Select(i => i.MedicineName?.ToLower() ?? "") ?? Enumerable.Empty<string>());
                var open = first;
                first = false;

                <article class="px-rx @(open ? "open" : "")"
                         data-date="@rx.PrescriptionDate.ToString("yyyy-MM-dd")"
                         data-doctor="@doctorName.ToLower()"
                         data-medicines="@medsSearch"
                         data-recent="@isRecent.ToString().ToLower()">

                    <!-- top / always visible -->
                    <div class="px-rx-top" role="button" tabindex="0" aria-expanded="@(open ? "true" : "false")">
                        <div class="px-rx-doctor">
                            <div class="px-rx-avatar">@(doctorName.Replace("Dr. ", "").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.Substring(0, 1).ToUpper() ?? "D")</div>
                            <div class="px-rx-doctor-info">
                                <span class="px-rx-doctor-name">@doctorName</span>
                                @if (!string.IsNullOrWhiteSpace(specialization))
                                {
                                    <span class="px-rx-doctor-spec"><i class="fas fa-stethoscope"></i> @specialization</span>
                                }
                            </div>
                        </div>

                        <div class="px-rx-summary">
                            <div class="px-rx-meta">
                                <span class="px-rx-no">Prescription #@rx.PrescriptionID</span>
                                @if (isRecent)
                                {
                                    <span class="px-rx-recent"><i class="fas fa-star"></i> Recent</span>
                                }
                            </div>
                            <div class="px-rx-meta-line">
                                <span><i class="fas fa-calendar-alt"></i> @rx.PrescriptionDate.ToString("MMMM dd, yyyy")</span>
                                <span class="px-dot">·</span>
                                <span><i class="fas fa-pills"></i> @itemCount medication@(itemCount != 1 ? "s" : "")</span>
                            </div>
                        </div>

                        <div class="px-rx-actions">
                            <a class="px-print"
                               href="@Url.Action("Print", "Prescription", new { id = Model.Patient.PatientID, prescriptionId = rx.PrescriptionID })"
                               target="_blank" rel="noopener noreferrer"
                               onclick="event.stopPropagation();">
                                <i class="fas fa-print"></i><span>Print</span>
                            </a>
                            <button class="px-toggle" type="button" aria-label="Toggle details"><i class="fas fa-chevron-down"></i></button>
                        </div>
                    </div>

                    <!-- collapsible body -->
                    <div class="px-rx-body">
                        <div class="px-rx-body-inner">
                            @if (!string.IsNullOrWhiteSpace(rx.Notes))
                            {
                                <div class="px-note">
                                    <i class="fas fa-quote-left"></i>
                                    <div>
                                        <span class="px-note-lbl">Doctor's note</span>
                                        <p class="px-note-text">@rx.Notes</p>
                                    </div>
                                </div>
                            }

                            @if (rx.Items != null && rx.Items.Any())
                            {
                                <div class="px-meds">
                                    @foreach (var item in rx.Items)
                                    {
                                        <div class="px-med">
                                            <div class="px-med-ico"><i class="fas fa-capsules"></i></div>
                                            <div class="px-med-main">
                                                <div class="px-med-name">@item.MedicineName</div>
                                                <div class="px-med-pills">
                                                    @if (!string.IsNullOrWhiteSpace(item.Dosage))
                                                    {
                                                        <span class="px-pill"><i class="fas fa-weight-hanging"></i> @item.Dosage</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(item.Frequency))
                                                    {
                                                        <span class="px-pill"><i class="fas fa-redo"></i> @item.Frequency</span>
                                                    }
                                                    @if (item.DurationDays > 0)
                                                    {
                                                        <span class="px-pill"><i class="fas fa-hourglass-half"></i> @item.DurationDays day@(item.DurationDays != 1 ? "s" : "")</span>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(item.Instructions))
                                                {
                                                    <div class="px-med-instr"><i class="fas fa-circle-info"></i> <span>@item.Instructions</span></div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="px-no-items"><i class="fas fa-circle-info"></i> No medication items recorded for this prescription.</p>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>

        <div class="px-no-results" id="pxNoResults" hidden>
            <i class="fas fa-search"></i>
            <p>No prescriptions match your search.</p>
        </div>
    }

</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {

    function setOpen(card, open) {
        const body = card.querySelector(".px-rx-body");
        const top = card.querySelector(".px-rx-top");
        const icon = card.querySelector(".px-toggle i");
        if (!body) return;
        if (open) {
            card.classList.add("open");
            body.style.maxHeight = body.scrollHeight + "px";
            top?.setAttribute("aria-expanded", "true");
            if (icon) icon.style.transform = "rotate(180deg)";
        } else {
            card.classList.remove("open");
            body.style.maxHeight = body.scrollHeight + "px";
            requestAnimationFrame(() => { body.style.maxHeight = "0px"; });
            top?.setAttribute("aria-expanded", "false");
            if (icon) icon.style.transform = "rotate(0deg)";
        }
    }

    // initialise: open cards get their natural height
    document.querySelectorAll(".px-rx").forEach(card => {
        const body = card.querySelector(".px-rx-body");
        if (!body) return;
        if (card.classList.contains("open")) {
            body.style.maxHeight = body.scrollHeight + "px";
            card.querySelector(".px-toggle i").style.transform = "rotate(180deg)";
        } else {
            body.style.maxHeight = "0px";
        }
    });

    function toggle(card) {
        setOpen(card, !card.classList.contains("open"));
    }

    document.querySelectorAll(".px-rx-top").forEach(top => {
        top.addEventListener("click", () => toggle(top.closest(".px-rx")));
        top.addEventListener("keydown", e => {
            if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggle(top.closest(".px-rx")); }
        });
    });

    document.getElementById("pxExpandAll")?.addEventListener("click", () => {
        document.querySelectorAll(".px-rx").forEach(c => { if (c.style.display !== "none") setOpen(c, true); });
    });
    document.getElementById("pxCollapseAll")?.addEventListener("click", () => {
        document.querySelectorAll(".px-rx").forEach(c => setOpen(c, false));
    });

    // recalc heights on resize so open cards stay correct
    let rt;
    window.addEventListener("resize", () => {
        clearTimeout(rt);
        rt = setTimeout(() => {
            document.querySelectorAll(".px-rx.open .px-rx-body").forEach(b => { b.style.maxHeight = b.scrollHeight + "px"; });
        }, 150);
    });

    // ── search + filter ──
    const search = document.getElementById("pxSearch");
    const clearBtn = document.getElementById("pxClear");
    const noResults = document.getElementById("pxNoResults");

    function applyFilters() {
        const query = (search?.value || "").toLowerCase().trim();
        const filter = document.querySelector(".px-tab.active")?.dataset.filter ?? "all";
        let visible = 0;

        document.querySelectorAll(".px-rx").forEach(card => {
            const doctor = card.dataset.doctor ?? "";
            const meds = card.dataset.medicines ?? "";
            const date = card.dataset.date ?? "";
            const isRecent = card.dataset.recent === "true";

            const matchesSearch = !query || doctor.includes(query) || meds.includes(query) || date.includes(query);
            const matchesFilter = filter === "all" || (filter === "recent" && isRecent);
            const show = matchesSearch && matchesFilter;
            card.style.display = show ? "" : "none";
            if (show) visible++;
        });

        if (noResults) noResults.hidden = visible !== 0;
    }

    search?.addEventListener("input", function () {
        clearBtn.style.display = this.value ? "flex" : "none";
        applyFilters();
    });
    clearBtn?.addEventListener("click", function () {
        search.value = "";
        this.style.display = "none";
        applyFilters();
    });
    document.querySelectorAll(".px-tab").forEach(tab => {
        tab.addEventListener("click", function () {
            document.querySelectorAll(".px-tab").forEach(t => t.classList.remove("active"));
            this.classList.add("active");
            applyFilters();
        });
    });
});
</script>
}
