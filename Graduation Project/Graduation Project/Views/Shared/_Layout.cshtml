<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NABD - نبض</title>
    <!-- ═══ PWA — required for NABD logo on home screen ═══ -->
    <meta name="application-name" content="NABD - نبض" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="NABD" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="theme-color" content="#1baebe" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" sizes="32x32"  href="/images/pwa-icon-192.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/images/pwa-icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/images/pwa-icon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/pwa-icon-192.png" />
    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Fonts: same stack used by Doctor / Admin portals -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Design system — MUST come first (defines all CSS variables) -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <!-- Shared layout primitives (sidebar, topbar, cards, etc.) -->
    <link rel="stylesheet" href="~/css/shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive-fixes.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    @await RenderSectionAsync("Styles", required: false)
    <style>
        /* ── Minimal default-layout navbar (no Bootstrap required) ── */
        .nabd-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 60px;
            padding: 0 28px;
            background: var(--surface-card, #fff);
            border-bottom: 1px solid var(--border-subtle, #e2e8f0);
            box-shadow: 0 1px 4px rgba(15,23,42,0.06);
            position: sticky;
            top: 0;
            z-index: 900;
        }

        .nabd-nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.05rem;
            color: var(--text-strong, #1e293b);
            text-decoration: none;
        }

        .nabd-nav-brand img {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            object-fit: contain;
        }

        .nabd-nav-links {
            display: flex;
            align-items: center;
            gap: 6px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .nabd-nav-links a {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 14px;
            border-radius: 8px;
            font-size: 0.88rem;
            font-weight: 500;
            color: var(--text-muted, #64748b);
            text-decoration: none;
            transition: background 0.18s, color 0.18s;
        }

        .nabd-nav-links a:hover {
            background: #f1f5f9;
            color: var(--primary, #1baebe);
        }

        .nabd-nav-auth {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nabd-nav-auth .btn-login {
            padding: 7px 16px;
            border-radius: 8px;
            font-size: 0.87rem;
            font-weight: 600;
            color: var(--primary, #1baebe);
            border: 1.5px solid var(--primary, #1baebe);
            background: transparent;
            text-decoration: none;
            transition: background 0.18s, color 0.18s;
        }

        .nabd-nav-auth .btn-login:hover {
            background: var(--primary, #1baebe);
            color: #fff;
        }

        .nabd-nav-auth .btn-logout {
            padding: 7px 16px;
            border-radius: 8px;
            font-size: 0.87rem;
            font-weight: 600;
            color: #ef4444;
            border: 1.5px solid #fca5a5;
            background: #fff5f5;
            text-decoration: none;
            transition: background 0.18s, border-color 0.18s;
        }

        .nabd-nav-auth .btn-logout:hover {
            background: #fee2e2;
            border-color: #ef4444;
        }

        .nabd-main-wrapper {
            min-height: calc(100vh - 60px - 52px);
            padding: 32px 28px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .nabd-footer {
            border-top: 1px solid var(--border-subtle, #e2e8f0);
            padding: 14px 28px;
            text-align: center;
            font-size: 0.82rem;
            color: var(--text-muted, #64748b);
        }

        .nabd-footer a {
            color: var(--primary, #1baebe);
            text-decoration: none;
        }

        .nabd-footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body style="background: var(--surface-page, #f8fafc); font-family: var(--ds-font-sans, 'Inter', sans-serif);">

    <nav class="nabd-nav">
        <a class="nabd-nav-brand" asp-controller="Home" asp-action="Index">
            <img src="~/images/logo.png" alt="NABD Logo" asp-append-version="true" />
            NABD - نبض
        </a>

        <ul class="nabd-nav-links">
            <li><a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> Home</a></li>
            <li><a asp-controller="Home" asp-action="Privacy"><i class="fas fa-shield-alt"></i> Privacy</a></li>
        </ul>

        <div class="nabd-nav-auth">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span style="font-size:0.84rem; color:var(--text-muted,#64748b); margin-right:4px;">
                    <i class="fas fa-user-circle"></i> @User.Identity.Name
                </span>
                <a class="btn-logout" asp-controller="Account" asp-action="LogoutGet">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            }
            else
            {
                <a class="btn-login" asp-controller="Account" asp-action="Login">
                    <i class="fas fa-sign-in-alt"></i> Login
                </a>
            }
        </div>
    </nav>

    <div class="nabd-main-wrapper">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="nabd-footer">
        &copy; @DateTime.Now.Year NABD - نبض &mdash;
        <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js');
            });
        }
    </script>
</body>
</html>
