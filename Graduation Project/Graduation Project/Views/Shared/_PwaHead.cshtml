@* PWA / "Add to Home Screen" metadata — Nabd logo + name on every page *@
<link rel="manifest" href="~/site.webmanifest" asp-append-version="true" />
<meta name="theme-color" content="#1baebe" />

@* iOS home-screen icon & app name (iOS ignores the manifest icons) *@
<link rel="apple-touch-icon" sizes="180x180" href="~/icons/apple-touch-icon.png" asp-append-version="true" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="Nabd" />
<meta name="application-name" content="Nabd" />
