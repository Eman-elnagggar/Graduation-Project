@model Graduation_Project.ViewModels.AssistantPatientsViewModel
@using System.Globalization
@{
    Layout = "~/Views/Shared/_AssistantLayout.cshtml";
    ViewData["Title"] = "Patients";
    ViewData["AssistantId"] = Model.Assistant.AssistantID;
    ViewData["AssistantName"] = Model.AssistantName;
    ViewData["ActivePage"] = "Patients";

    var avatarPalette = new[] { "#7c3aed", "#2563eb", "#059669", "#d97706", "#dc2626", "#0891b2", "#6366f1" };
}

<div class="dash-v2">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="appt-banner appt-banner--success">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="appt-banner appt-banner--error">
            <i class="fas fa-exclamation-circle"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Page Hero -->
    <div class="dcard page-hero">
        <div class="page-hero-icon">
            <i class="fas fa-users"></i>
        </div>
        <div class="page-hero-text">
            <h1 class="page-hero-title">Doctor Patients</h1>
            <p class="page-hero-sub">View clinic patients and all appointments per patient</p>
        </div>
    </div>

    <div class="dcard">

        <!-- Page header -->
        <div class="dcard-header appt-card-header">
            <div class="dcard-title-group">
                <h3 class="dcard-title"><i class="fas fa-users"></i> Doctor Patients</h3>
                <span class="dcard-subtitle">Clinic patients and their appointment history</span>
            </div>
            <div class="dcard-controls">
                <a href="@Url.Action("CreatePatient", new { id = Model.Assistant.AssistantID })"
                   class="btn btn-primary btn-sm">
                    <i class="fas fa-user-plus"></i> Add Patient
                </a>
            </div>
        </div>

        <!-- Doctor filter toolbar -->
        @if (Model.Doctors.Count > 1)
        {
            <div class="appt-toolbar">
                <i class="fas fa-filter" style="color:#94a3b8;font-size:0.75rem;flex-shrink:0"></i>
                <div class="toolbar-doctors">
                    <a href="@Url.Action("Patients", new { id = Model.Assistant.AssistantID })"
                       class="filter-pill @(Model.SelectedDoctorID == null ? "filter-pill--active" : "")">
                        All Doctors
                    </a>
                    @foreach (var doctor in Model.Doctors)
                    {
                        var isSel = Model.SelectedDoctorID == doctor.DoctorID;
                        <a href="@Url.Action("Patients", new { id = Model.Assistant.AssistantID, doctorId = doctor.DoctorID })"
                           class="filter-pill @(isSel ? "filter-pill--active" : "")">
                            @doctor.FullName
                        </a>
                    }
                </div>
            </div>
        }

        @if (!Model.Patients.Any())
        {
            <div class="empty-state">
                <i class="fas fa-folder-open"></i>
                <p>No approved patients found for the selected doctor scope.</p>
            </div>
        }
        else
        {
            var groupedPatients = Model.Patients
                .GroupBy(p => new { p.DoctorID, p.DoctorName, p.DoctorSpecialization })
                .OrderBy(g => g.Key.DoctorName)
                .ToList();

            foreach (var doctorGroup in groupedPatients)
            {
                var docName = doctorGroup.Key.DoctorName ?? "Doctor";
                var docInitials = string.Concat(
                    docName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries)
                           .Take(2).Select(w => w[0])).ToUpper();
                var docSpec = string.IsNullOrWhiteSpace(doctorGroup.Key.DoctorSpecialization)
                    ? "General" : doctorGroup.Key.DoctorSpecialization;

                <div class="pts-doctor-group">

                    <!-- Doctor section header -->
                    <div class="pts-doctor-header">
                        <div class="pts-doctor-avatar">@docInitials</div>
                        <div>
                            <span class="pts-doctor-name">@docName</span>
                            <span class="pts-doctor-spec">&nbsp;· @docSpec</span>
                        </div>
                        <span class="pts-doctor-count">@doctorGroup.Count() patients</span>
                    </div>

                    <!-- Patient rows -->
                    <div class="pts-patient-list">
                        @foreach (var patient in doctorGroup)
                        {
                            var fullName  = patient.FullName ?? "Unknown";
                            var patInitials = string.Concat(
                                fullName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries)
                                        .Take(2).Select(w => w[0])).ToUpper();
                            var patColor = avatarPalette[(int)fullName[0] % avatarPalette.Length];
                            var apptCount = patient.Appointments.Count;
                            var detailUrl = Url.Action("PatientDetails", "Assistant",
                                new { id = Model.Assistant.AssistantID, patientId = patient.PatientID, doctorId = patient.DoctorID });

                            <details class="pts-patient-item">
                                <summary class="pts-patient-row">
                                    <div class="pts-chevron"><i class="fas fa-chevron-right"></i></div>
                                    <div class="pts-patient-avatar" style="background:@patColor">@patInitials</div>
                                    <div class="pts-patient-info">
                                        <span class="pts-patient-name">@fullName</span>
                                        @if (!string.IsNullOrWhiteSpace(patient.PhoneNumber))
                                        {
                                            <span class="pts-patient-phone">@patient.PhoneNumber</span>
                                        }
                                    </div>
                                    <span class="pts-appt-badge @(apptCount == 0 ? "pts-appt-badge--zero" : "")">
                                        <i class="fas fa-calendar-check"></i> @apptCount
                                    </span>
                                    <a class="appt-icon-btn appt-icon-btn--blue"
                                       href="@detailUrl"
                                       onclick="event.stopPropagation()"
                                       title="View full profile">
                                        <i class="fas fa-arrow-right"></i>
                                    </a>
                                </summary>

                                <div class="pts-appt-panel">
                                    <div class="pts-panel-actions">
                                        <a class="btn btn-outline btn-sm" href="@detailUrl">
                                            <i class="fas fa-id-card"></i> View Full Profile &amp; Details
                                        </a>
                                    </div>

                                    @if (!patient.Appointments.Any())
                                    {
                                        <p class="pts-empty-panel">No appointments found for this patient.</p>
                                    }
                                    else
                                    {
                                        foreach (var appointment in patient.Appointments)
                                        {
                                            var booking    = appointment.Booking;
                                            var aptStatus  = booking?.Status ?? "Confirmed";
                                            var aptBadge   = aptStatus.ToLowerInvariant() switch
                                            {
                                                "cancelled" => "pts-appt-sbadge--cancelled",
                                                "modified"  => "pts-appt-sbadge--modified",
                                                "completed" => "pts-appt-sbadge--confirmed",
                                                "missed"    => "pts-appt-sbadge--cancelled",
                                                _           => "pts-appt-sbadge--confirmed"
                                            };
                                            var aptReason = string.IsNullOrWhiteSpace(booking?.Reason) ? "—" : booking.Reason;
                                            var aptNotes  = booking?.Notes;

                                            <div class="pts-appt-row">
                                                <div class="pts-appt-datetime">
                                                    @appointment.Date.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
                                                    &nbsp;<span style="color:#64748b">@DateTime.Today.Add(appointment.Time).ToString("h:mm tt", CultureInfo.InvariantCulture)</span>
                                                </div>
                                                <div class="pts-appt-reason" title="@aptReason">@aptReason</div>
                                                <span class="pts-appt-sbadge @aptBadge">@aptStatus</span>
                                                <a class="appt-icon-btn" href="@detailUrl" title="View patient details">
                                                    <i class="fas fa-external-link-alt"></i>
                                                </a>
                                            </div>
                                        }
                                    }
                                </div>
                            </details>
                        }
                    </div>

                </div>
            }
        }

    </div>
</div>
