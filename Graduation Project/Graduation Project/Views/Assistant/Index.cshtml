@using System.Globalization
@using System.Linq
@model Graduation_Project.ViewModels.AssistantDashboardViewModel
@{
    Layout = "~/Views/Shared/_AssistantLayout.cshtml";
    ViewData["Title"] = "Dashboard";
    ViewData["AssistantId"] = Model.Assistant.AssistantID;
    ViewData["AssistantName"] = Model.AssistantName;
    ViewData["ActivePage"] = "Dashboard";

    var now = DateTime.Now;
    var greeting = now.Hour < 12 ? "Good morning" : now.Hour < 17 ? "Good afternoon" : "Good evening";
    var assistantFirstName = (Model.AssistantName ?? "Assistant").Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Assistant";
    ViewData["PageTitle"] = $"{greeting}, {assistantFirstName} 👋";
    ViewData["PageTitleHtml"] = $"{greeting}, <span class='topbar-accent'>{assistantFirstName}</span> 👋";
    ViewData["PageSubtitle"] = now.ToString("dddd, MMMM dd, yyyy", CultureInfo.InvariantCulture);
}

@section Head {
    <meta name="assistant-id" content="@Model.Assistant.AssistantID" />
    <meta name="selected-date" content="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
    <meta name="selected-doctor-id" content="@(Model.SelectedDoctorID?.ToString() ?? string.Empty)" />
    <meta name="selected-schedule-status" content="@Model.SelectedScheduleStatus" />
    <meta name="assistant-stats-url" content="@Url.Action("GetDashboardStats", "Assistant")" />
    <meta name="assistant-schedule-url" content="@Url.Action("GetScheduleByDate", "Assistant")" />
    <meta name="assistant-index-url" content="@Url.Action("Index", "Assistant")" />
}

<div class="dash-v2">

    <!-- Page Hero -->

    <div class="dcard page-hero">
        <div class="page-hero-icon">
            <i class="fas fa-th-large"></i>
        </div>
        <div class="page-hero-text">
            <h1 class="page-hero-title">Dashboard</h1>
            <p class="page-hero-sub">Your clinic at a glance &middot; @now.ToString("dddd, MMMM dd, yyyy", CultureInfo.InvariantCulture)</p>
        </div>
    </div>

    <!-- KPI Strip -->
    <div class="kpi-row">
        <div class="kpi-card kpi-card--primary">
            <div class="kpi-icon"><i class="fas fa-calendar-check"></i></div>
            <div class="kpi-body">
                <div class="kpi-value" id="stat-today-appointments">--</div>
                <div class="kpi-label">Today's Appointments</div>
            </div>
        </div>
        <div class="kpi-card kpi-card--blue">
            <div class="kpi-icon"><i class="fas fa-user-md"></i></div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.Doctors.Count</div>
                <div class="kpi-label">Active Doctors</div>
            </div>
        </div>
        <div class="kpi-card kpi-card--success">
            <div class="kpi-icon"><i class="fas fa-users"></i></div>
            <div class="kpi-body">
                <div class="kpi-value" id="stat-total-patients">--</div>
                <div class="kpi-label">Clinic Patients</div>
            </div>
        </div>
        <div class="kpi-card kpi-card--warning">
            <div class="kpi-icon"><i class="fas fa-exclamation-triangle"></i></div>
            <div class="kpi-body">
                <div class="kpi-value" id="stat-pending-alerts">@Model.RecentAlerts.Count(a => !a.IsRead)</div>
                <div class="kpi-label">Pending Alerts</div>
            </div>
        </div>
    </div>

    <!-- 2-Column Grid -->
    <div class="dash-grid">

        <!-- Left: Primary Content (70%) -->
        <div class="dash-main">

            <!-- Schedule Card (date nav + doctor filter inline) -->
            <div class="dcard">
                <div class="dcard-header">
                    <div class="dcard-title-group">
                        <h3 class="dcard-title">
                            <i class="fas fa-clock"></i> Schedule
                        </h3>
                        <span id="schedule-doctor-label" class="dcard-subtitle @(Model.SelectedDoctorID == null ? "is-hidden" : "")">
                            &mdash; <span id="schedule-doctor-name">@Model.SelectedDoctorName</span>
                        </span>
                    </div>
                    <div class="dcard-controls">
                        <div class="date-nav-group">
                            <button type="button" class="icon-btn-sm" id="prevDateBtn" title="Previous day">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <input type="date" id="dashboardDatePicker"
                                   class="date-nav-input"
                                   value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                            <button type="button" class="icon-btn-sm" id="nextDateBtn" title="Next day">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                            <button type="button" class="btn-today" id="todayBtn">Today</button>
                        </div>
                        <a href="@Url.Action("Appointments", "Assistant", new { id = Model.Assistant.AssistantID })"
                           class="dcard-link">View all</a>
                    </div>
                </div>

                @if (Model.Doctors.Count > 1)
                {
                    <div class="dcard-filters">
                        <a href="@Url.Action("Index", new { id = Model.Assistant.AssistantID, date = Model.SelectedDate.ToString("yyyy-MM-dd"), status = Model.SelectedScheduleStatus })"
                           class="filter-pill @(Model.SelectedDoctorID == null ? "filter-pill--active" : "")"
                           data-doctor-id="" data-doctor-name="All Doctors">
                            All Doctors
                            <span id="all-doctors-tab-count" class="filter-pill-count">--</span>
                        </a>
                        @foreach (var doc in Model.Doctors)
                        {
                            var isSelected = Model.SelectedDoctorID == doc.DoctorID;
                            <a href="@Url.Action("Index", new { id = Model.Assistant.AssistantID, doctorId = doc.DoctorID, date = Model.SelectedDate.ToString("yyyy-MM-dd"), status = Model.SelectedScheduleStatus })"
                               class="filter-pill @(isSelected ? "filter-pill--active" : "")"
                               data-doctor-id="@doc.DoctorID"
                               data-doctor-name="@doc.FullName">
                                @doc.FullName
                                <span id="doctor-tab-count-@doc.DoctorID" class="filter-pill-count">--</span>
                            </a>
                        }
                    </div>
                }

                <div class="dcard-status-bar">
                    <div class="status-toggle">
                        <button type="button"
                                class="status-toggle-btn schedule-status-btn @(Model.SelectedScheduleStatus == "Booked" ? "active" : "")"
                                data-status="Booked">
                            <i class="fas fa-check-circle"></i> Booked
                        </button>
                        <button type="button"
                                class="status-toggle-btn schedule-status-btn @(Model.SelectedScheduleStatus == "Cancelled" ? "active" : "")"
                                data-status="Cancelled">
                            <i class="fas fa-times-circle"></i> Cancelled
                        </button>
                    </div>
                    <span class="schedule-date-label" id="todayDate">
                        @Model.SelectedDate.ToString("dddd, MMM dd", CultureInfo.InvariantCulture)
                    </span>
                </div>

                <div id="schedule-container">
                    <div class="loading-state">
                        <i class="fas fa-spinner fa-spin"></i>
                        <p>Loading schedule...</p>
                    </div>
                </div>
            </div>

            <!-- Alerts Card -->
            <div class="dcard">
                <div class="dcard-header">
                    <div class="dcard-title-group">
                        <h3 class="dcard-title">
                            <i class="fas fa-exclamation-triangle"></i> Patient Alerts
                        </h3>
                        @if (Model.RecentAlerts.Any(a => !a.IsRead))
                        {
                            <span class="badge-pill badge-pill--danger">
                                @Model.RecentAlerts.Count(a => !a.IsRead) unread
                            </span>
                        }
                    </div>
                    <a href="@Url.Action("Alerts", "Assistant", new { id = Model.Assistant.AssistantID })"
                       class="dcard-link">View all</a>
                </div>

                @if (!Model.RecentAlerts.Any())
                {
                    <div class="empty-notice">
                        <i class="fas fa-check-circle" style="color:#10b981;"></i>
                        <span>No patient alerts at this time</span>
                    </div>
                }
                else
                {
                    <div class="alert-list">
                        @foreach (var alert in Model.RecentAlerts.Take(5))
                        {
                            var rowClass = alert.AlertType?.ToLower() switch
                            {
                                "danger"  => "alert-row--danger",
                                "warning" => "alert-row--warning",
                                "success" => "alert-row--success",
                                _         => "alert-row--info"
                            };
                            var alertIcon = alert.AlertType?.ToLower() switch
                            {
                                "danger"  => "fa-exclamation-circle",
                                "warning" => "fa-exclamation-triangle",
                                "success" => "fa-check-circle",
                                _         => "fa-info-circle"
                            };
                            var patientName = alert.Patient?.User != null
                                ? $"{alert.Patient.User.FirstName} {alert.Patient.User.LastName}".Trim()
                                : "Patient";
                            <div class="alert-row @rowClass">
                                <div class="alert-row-indicator"></div>
                                <div class="alert-row-icon">
                                    <i class="fas @alertIcon"></i>
                                </div>
                                <div class="alert-row-body">
                                    <div class="alert-row-title">@alert.Title</div>
                                    <div class="alert-row-meta">
                                        @patientName &nbsp;&middot;&nbsp; @alert.DateCreated.ToString("MMM dd, hh:mm tt")
                                    </div>
                                </div>
                                <span class="alert-row-type">@alert.AlertType</span>
                            </div>
                        }
                    </div>
                }
            </div>

        </div>

        <!-- Right: Sidebar Widgets (30%) -->
        <div class="dash-sidebar">

            <!-- Linked Doctors (compact list) -->
            <div class="dcard">
                <div class="dcard-header">
                    <h3 class="dcard-title"><i class="fas fa-user-md"></i> Linked Doctors</h3>
                    <a href="@Url.Action("Patients", "Assistant", new { id = Model.Assistant.AssistantID })"
                       class="dcard-link">View patients</a>
                </div>
                @if (Model.Doctors.Any())
                {
                    <div class="doctor-list">
                        @foreach (var doc in Model.Doctors)
                        {
                            <div class="doctor-row team-card--clickable" data-doctor-id="@doc.DoctorID">
                                <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(doc.FullName)&background=7c3aed&color=fff&size=64"
                                     alt="@doc.FullName" class="doctor-row-avatar" />
                                <div class="doctor-row-info">
                                    <div class="doctor-row-name">@doc.FullName</div>
                                    <div class="doctor-row-spec">@doc.Specialization</div>
                                </div>
                                <div class="doctor-row-stats">
                                    <span class="doctor-stat">
                                        <span id="doctor-today-@doc.DoctorID">--</span> appts
                                    </span>
                                    <span class="doctor-stat secondary">
                                        <span id="doctor-patients-@doc.DoctorID">--</span> patients
                                    </span>
                                </div>
                                <span class="status-dot-sm online"></span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-notice">
                        <i class="fas fa-exclamation-triangle" style="color:#f59e0b;"></i>
                        <span>No linked doctors. Contact your admin.</span>
                    </div>
                }
            </div>

            <!-- Quick Actions -->
            <div class="dcard">
                <div class="dcard-header">
                    <h3 class="dcard-title"><i class="fas fa-bolt"></i> Quick Actions</h3>
                </div>
                <div class="quick-actions-grid">
                    <a href="@Url.Action("CreateAppointment", "Assistant", new { id = Model.Assistant.AssistantID })"
                       class="qa-btn">
                        <div class="qa-icon qa-icon--primary"><i class="fas fa-calendar-plus"></i></div>
                        <span>New Appointment</span>
                    </a>
                    <a href="@Url.Action("CreatePatient", "Assistant", new { id = Model.Assistant.AssistantID })"
                       class="qa-btn">
                        <div class="qa-icon qa-icon--success"><i class="fas fa-user-plus"></i></div>
                        <span>Register Patient</span>
                    </a>
                    <a href="@Url.Action("Patients", "Assistant", new { id = Model.Assistant.AssistantID })"
                       class="qa-btn">
                        <div class="qa-icon qa-icon--blue"><i class="fas fa-users"></i></div>
                        <span>View Patients</span>
                    </a>
                    <a href="@Url.Action("Availability", "Assistant", new { id = Model.Assistant.AssistantID })"
                       class="qa-btn">
                        <div class="qa-icon qa-icon--warning"><i class="fas fa-clock"></i></div>
                        <span>Availability</span>
                    </a>
                </div>
            </div>

            <!-- Clinic Invitations -->
            <div class="dcard" id="clinicInvitationsSection">
                <div class="dcard-header">
                    <h3 class="dcard-title"><i class="fas fa-envelope-open-text"></i> Invitations</h3>
                    <a href="@Url.Action("ClinicInvitations", "Assistant", new { id = Model.Assistant.AssistantID })"
                       class="dcard-link">Open</a>
                </div>
                <div class="empty-notice">
                    <i class="fas fa-inbox" style="color:#94a3b8;"></i>
                    <span>No pending clinic invitations</span>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/assistant-dashboard.js" asp-append-version="true"></script>
}
