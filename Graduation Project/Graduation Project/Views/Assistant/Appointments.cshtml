@using System.Globalization
@model Graduation_Project.ViewModels.AssistantAppointmentsViewModel
@{
    Layout = "~/Views/Shared/_AssistantLayout.cshtml";
    ViewData["Title"] = "Appointments";
    ViewData["AssistantId"] = Model.Assistant.AssistantID;
    ViewData["AssistantName"] = Model.AssistantName;
    ViewData["ActivePage"] = "Appointments";
    ViewData["PageSubtitle"] = "Manage patient appointments for " + Model.ClinicName;
}

@* Hidden CSRF token for JS fetch calls *@
<div class="is-hidden">
    @Html.AntiForgeryToken()
</div>

@* Hidden elements preserving hero IDs consumed by applyCountsToUI() in assistant-appointments.js *@
<span id="heroConfirmedCount" class="is-hidden"></span>
<span id="heroModifiedCount"  class="is-hidden"></span>
<span id="heroCancelledCount" class="is-hidden"></span>
<span id="heroMissedCount"    class="is-hidden"></span>
<span id="appointmentsHeroDate" class="is-hidden"></span>

<div class="dash-v2">

    @* Feedback banners *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="appt-banner appt-banner--success">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="appt-banner appt-banner--error">
            <i class="fas fa-exclamation-circle"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Page Hero -->
    <div class="dcard page-hero">
        <div class="page-hero-icon">
            <i class="fas fa-calendar-alt"></i>
        </div>
        <div class="page-hero-text">
            <h1 class="page-hero-title">Appointments</h1>
            <p class="page-hero-sub">Manage patient appointments for @Model.ClinicName</p>
        </div>
    </div>

    <!-- KPI Strip -->
    <div class="kpi-row">
        <div class="kpi-card kpi-card--primary">
            <div class="kpi-icon"><i class="fas fa-clipboard-list"></i></div>
            <div class="kpi-body">
                <div class="kpi-value" id="statTotal">--</div>
                <div class="kpi-label">Total</div>
            </div>
        </div>
        <div class="kpi-card kpi-card--success">
            <div class="kpi-icon"><i class="fas fa-calendar-check"></i></div>
            <div class="kpi-body">
                <div class="kpi-value" id="statConfirmed">--</div>
                <div class="kpi-label">Confirmed</div>
            </div>
        </div>
        <div class="kpi-card kpi-card--blue">
            <div class="kpi-icon"><i class="fas fa-pen-square"></i></div>
            <div class="kpi-body">
                <div class="kpi-value" id="statModified">--</div>
                <div class="kpi-label">Modified</div>
            </div>
        </div>
        <div class="kpi-card kpi-card--warning">
            <div class="kpi-icon"><i class="fas fa-times-circle"></i></div>
            <div class="kpi-body">
                <div class="kpi-value" id="statCancelled">--</div>
                <div class="kpi-label">Cancelled</div>
            </div>
        </div>
        <div class="kpi-card kpi-card--missed">
            <div class="kpi-icon"><i class="fas fa-user-clock"></i></div>
            <div class="kpi-body">
                <div class="kpi-value" id="statMissed">--</div>
                <div class="kpi-label">Missed</div>
            </div>
        </div>
    </div>

    <!-- Main Appointments Card -->
    <div class="dcard">

        <!-- Header: title + primary actions -->
        <div class="dcard-header appt-card-header">
            <div class="dcard-title-group">
                <h3 class="dcard-title">
                    <i class="fas fa-calendar-alt"></i> Appointments
                </h3>
                <span class="dcard-subtitle" id="appointmentsHeaderDate">
                    @Model.SelectedDate.ToString("ddd, MMM d", CultureInfo.InvariantCulture)
                </span>
            </div>
            <div class="dcard-controls">
                <a href="@Url.Action("CreateAppointment", new { id = Model.Assistant.AssistantID })"
                   class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> New Appointment
                </a>
                <button class="appt-export-btn" onclick="exportAppointmentsCsv()" title="Export CSV">
                    <i class="fas fa-download"></i>
                    <span>Export</span>
                </button>
            </div>
        </div>

        <!-- Unified toolbar: date nav + doctor filter + search -->
        <div class="appt-toolbar">
            <div class="date-nav-group">
                <button type="button" class="icon-btn-sm" id="prevAppointmentsDateBtn" title="Previous day">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <input type="date" id="appointmentsDatePicker"
                       class="date-nav-input"
                       value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                <button type="button" class="icon-btn-sm" id="nextAppointmentsDateBtn" title="Next day">
                    <i class="fas fa-chevron-right"></i>
                </button>
                <button type="button" class="btn-today" id="todayAppointmentsDateBtn">Today</button>
            </div>

            @if (Model.Doctors.Count > 1)
            {
                <div class="toolbar-divider"></div>
                <div class="toolbar-doctors">
                    <a href="@Url.Action("Appointments", new { id = Model.Assistant.AssistantID, date = Model.SelectedDate.ToString("yyyy-MM-dd") })"
                       data-doctor-id=""
                       class="filter-pill @(Model.SelectedDoctorID == null ? "filter-pill--active" : "") doctor-pill">
                        All
                    </a>
                    @foreach (var doc in Model.Doctors)
                    {
                        var isSelected = Model.SelectedDoctorID == doc.DoctorID;
                        <a href="@Url.Action("Appointments", new { id = Model.Assistant.AssistantID, doctorId = doc.DoctorID, date = Model.SelectedDate.ToString("yyyy-MM-dd") })"
                           data-doctor-id="@doc.DoctorID"
                           class="filter-pill @(isSelected ? "filter-pill--active" : "") doctor-pill">
                            @doc.FullName
                        </a>
                    }
                </div>
            }

            <div class="toolbar-search">
                <i class="fas fa-search"></i>
                <input type="text" id="appointmentSearch"
                       placeholder="Search patient, doctor, phone…"
                       oninput="handleSearchInput(this.value)" />
            </div>
        </div>

        <!-- Segmented tab controls -->
        <div class="appt-tabs">
            <button class="appt-tab tab-btn active" data-tab="All" onclick="switchTab('All')">
                <i class="fas fa-layer-group"></i>
                All
                <span class="appt-tab-badge appt-tab-badge--all" id="allTabCount">–</span>
            </button>
            <button class="appt-tab tab-btn" data-tab="Confirmed" onclick="switchTab('Confirmed')">
                <i class="fas fa-calendar-check"></i>
                Confirmed
                <span class="appt-tab-badge appt-tab-badge--success" id="confirmedTabCount">–</span>
            </button>
            <button class="appt-tab tab-btn" data-tab="Modified" onclick="switchTab('Modified')">
                <i class="fas fa-edit"></i>
                Modified
                <span class="appt-tab-badge appt-tab-badge--blue" id="modifiedTabCount">–</span>
            </button>
            <button class="appt-tab tab-btn" data-tab="Cancelled" onclick="switchTab('Cancelled')">
                <i class="fas fa-times-circle"></i>
                Cancelled
                <span class="appt-tab-badge appt-tab-badge--danger" id="cancelledTabCount">–</span>
            </button>
            <button class="appt-tab tab-btn" data-tab="Missed" onclick="switchTab('Missed')">
                <i class="fas fa-user-clock"></i>
                Missed
                <span class="appt-tab-badge appt-tab-badge--missed" id="missedTabCount">–</span>
            </button>
        </div>

        <!-- Column headers (matches .appt-row grid) -->
        <div class="appt-list-header">
            <div></div>
            <div>Patient</div>
            <div>Time</div>
            <div class="appt-col-phone">Phone</div>
            <div>Status</div>
            <div class="appt-col-actions">Actions</div>
        </div>

        <!-- Tab content panes -->
        <div class="appt-tab-body">
            <div class="tab-content active" id="All-tab">
                <div class="appt-list" id="AllAppointmentsList">
                    <div class="empty-state">
                        <i class="fas fa-spinner fa-spin"></i>
                        <p>Loading appointments…</p>
                    </div>
                </div>
            </div>
            <div class="tab-content is-hidden" id="Confirmed-tab">
                <div class="appt-list" id="ConfirmedAppointmentsList"></div>
            </div>
            <div class="tab-content is-hidden" id="Modified-tab">
                <div class="appt-list" id="ModifiedAppointmentsList"></div>
            </div>
            <div class="tab-content is-hidden" id="Cancelled-tab">
                <div class="appt-list" id="CancelledAppointmentsList"></div>
            </div>
            <div class="tab-content is-hidden" id="Missed-tab">
                <div class="appt-list" id="MissedAppointmentsList"></div>
            </div>
            <div id="appointmentsPager" class="appointments-pager"></div>
        </div>

    </div>
</div>

<!-- Modify Appointment Modal -->
<div class="modal-overlay is-hidden" id="modifyModal">
    <div class="modal modal-medium">
        <div class="modal-header">
            <h3><i class="fas fa-edit"></i> Modify Appointment</h3>
            <button class="btn-close" onclick="closeModifyModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label>Patient</label>
                <p id="modifyPatientName" class="appointment-primary-text">–</p>
            </div>
            <div class="form-group">
                <label>Current Date &amp; Time</label>
                <p id="modifyCurrentDateTime" class="appointment-secondary-text">–</p>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="newDate">New Date</label>
                    <input type="date" class="form-input" id="newDate" />
                </div>
                <div class="form-group">
                    <label for="newTime">New Time</label>
                    <input type="time" class="form-input" id="newTime" />
                </div>
            </div>
            <div class="form-group">
                <label for="modifyReason">Reason for Change (optional)</label>
                <textarea class="form-textarea" id="modifyReason"
                          placeholder="Enter reason for rescheduling…"></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModifyModal()">Cancel</button>
            <button class="btn btn-danger" id="modalCancelBtn" onclick="handleCancelAppointment()">
                <i class="fas fa-times"></i> Cancel Appointment
            </button>
            <button class="btn btn-primary" id="modalSaveBtn" onclick="handleSaveModification()">
                <i class="fas fa-check"></i> Save Changes
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.assistantAppointmentsConfig = {
            assistantId: @Model.Assistant.AssistantID,
            selectedDoctorId: @(Model.SelectedDoctorID.HasValue ? Model.SelectedDoctorID.Value.ToString() : "null"),
            selectedDate: '@Model.SelectedDate.ToString("yyyy-MM-dd")',
            urls: {
                getAppointments:       '@Url.Action("GetAppointments",       "Assistant")',
                getAppointmentCounts:  '@Url.Action("GetAppointmentCounts",  "Assistant")',
                getAppointmentDetail:  '@Url.Action("GetAppointmentDetail",  "Assistant")',
                modifyAppointment:     '@Url.Action("ModifyAppointment",     "Assistant")',
                cancelAppointment:     '@Url.Action("CancelAppointment",     "Assistant")',
                reinstateAppointment:  '@Url.Action("ReinstateAppointment",  "Assistant")',
                checkInPatient:        '@Url.Action("CheckInPatient",        "Assistant")',
                exportAppointmentsCsv: '@Url.Action("ExportAppointmentsCsv","Assistant")'
            }
        };
    </script>
    <script src="~/js/assistant-appointments.js" asp-append-version="true"></script>
}
